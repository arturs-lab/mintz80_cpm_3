                	;			[HL] = MEMORY POINTER
                	;			[BC] = REPETITION COUNT
                	;
                	;	ON EXIT:	[BC] = 0
                	;			[HL] = PTR TO NEXT MEMORY LOCATION
                	;			[E] = PATTERN
                	;			[AF] ALTERED, [D] UNALTERED
                	;
                RPTFMT:
                	; CHECK FOR END OF LOOP:
 0453 79        	MOV	A,C
 0454 B0        	ORA	B		; = 0 IF DONE
 0455 C8        	RZ
                
