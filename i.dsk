 0003 C36C00    ?wboot:	jmp wboot	; reentry on program exit, warm start
                
 0006 C3E400    ?const:	jmp const	; return console input status
 0009 C3FF00    ?conin:	jmp conin	; return console input character
 000C C34700    ?cono:	jmp conout	; send console output character
 000F C35300    ?list:	jmp list	; send list output character
 0012 C34D00    ?auxo:	jmp auxout	; send auxilliary output character
 0015 C30501    ?auxi:	jmp auxin	; return auxilliary input character
                
 0018 C3D701    ?home:	jmp home	; set disks to logical home
 001B C3A801    ?sldsk:	jmp seldsk	; select disk drive, return disk parameter info
 001E C3DA01    ?sttrk:	jmp settrk	; set disk track
 0021 C3E001    ?stsec:	jmp setsec	; set disk sector
 0024 C3E601    ?stdma:	jmp setdma	; set disk I/O memory address
 0027 C3FD01    ?read:	jmp read	; read physical block(s)
 002A C31302    ?write:	jmp write	; write physical block(s)
                
 002D C37F00    ?lists:	jmp listst	; return list device status
 0030 C3F201    ?sctrn:	jmp sectrn	; translate logical to physical sector
CP/M RMAC ASSEM 1.1	#003	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

                
 0033 C37300    ?conos:	jmp conost	; return console output status
 0036 C3EA00    ?auxis:	jmp auxist	; return aux input status
 0039 C37900    ?auxos:	jmp auxost	; return aux output status
 003C C30000    ?dvtbl:	jmp devtbl	; return address of device def table
 003F C30000    ?devin:	jmp ?cinit	; change baud rate of device
                
 0042 C34300    ?drtbl:	jmp getdrv	; return address of disk drive table
 0045 C33402    ?mltio:	jmp multio	; set multiple record count for disk I/O
 0048 C33802    ?flush:	jmp flush	; flush BIOS maintained disk caching
                
 004B C30000    ?mov:	jmp ?move	; block move memory to memory
 004E C30000    ?tim:	jmp ?time	; Signal Time and Date operation
 0051 C39201    ?bnksl:	jmp bnksel	; select bank for code execution and default DMA
 0054 C3EE01    ?stbnk:	jmp setbnk	; select different bank for disk I/O DMA operations.
 0057 C30000    ?xmov:	jmp ?xmove	; set source and destination banks for one operation
 005A C30000    ?userf:	jmp usrfunc
                
 005D C30000    	jmp 0		; reserved for future expansion
 0060 C30000    	jmp 0		; reserved for future expansion
                	;jmp 0		; reserved for future expansion
                
                
                	; BOOT
                	;	Initial entry point for system startup.
                	dseg	; this part can be banked
                	
                boot:
 0000 31D200    	lxi sp,boot$stack
 0003 CD0000    	call storeregs
 0006 0E0F      	mvi c,15	; initialize all 16 character devices
                c$init$loop:
 0008 C5CD0000C1	push b ! call ?cinit ! pop b
 000D 0DF20800  	dcr c ! jp c$init$loop
                
 0011 CD0000    	call ?init	; perform any additional system initialization
                			; and print signon message
                
 0014 0100102100	lxi b,16*256+0 ! lxi h,@dtbl	; init all 16 logical disk drives
                if debug
                	call iputs
                	db 'DINIT ',0
                endif
                d$init$loop:
 001A C5        	push b		; save remaining count and abs drive
 001B 5E235623  	mov e,m ! inx h ! mov d,m ! inx h	; grab @drv entry
 001F 7BB2CA3900	mov a,e ! ora d ! jz d$init$next	; if null, no drive
 0024 E5        	push h					; save @drv pointer
 0025 EB        	xchg					; XDPH address in <HL>
 0026 2B2B7E3257	dcx h ! dcx h ! mov a,m ! sta @RDRV	; get relative drive code
 002C 79325602  	mov a,c ! sta @ADRV			; get absolute drive code
 0030 2B        	dcx h					; point to init pointer
 0031 562B5E    	mov d,m ! dcx h ! mov e,m		; get init pointer
 0034 EBCD2301  	xchg ! call ipchl			; call init routine
 0038 E1        	pop h					; recover @drv pointer
                d$init$next:
CP/M RMAC ASSEM 1.1	#004	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

