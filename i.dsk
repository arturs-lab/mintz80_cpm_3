;
; 5", IBM PC, MSDOS 2.x, 512 byte, DDDS, 9 sector format
MSDOS2:	DB	9		;sectors per track
	DB	40		;tracks per side
	DB	01110000B	;Disk HW_BYTE (DDDS)
	DB	80		;index header gap
	DB	12		;GAP 1
	DB	22		;GAP 2
	DB	80		;GAP 3
	DB	193		;GAP 4 (4E's)
	DB	2		;GAPR (Flag for multiple repeats of GAP4)
	DB	2		;512 Bytes/sec
