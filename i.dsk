                	;;;;; DPY$ERROR
                	; DISPLAY DISK FORMATTING ERROR MESSAGE AND GIVE USER AN OPPORTUNITY
                	; TO ABORT OR CONTINUE --
                	;
                	;	ON ENTRY:	[A] = DISK ERROR CODE
                	;
                	;	ON EXIT:	C=0 --> USER WISHES TO IGNORE ERROR
                	;			C=1 --> USER WANTS TO ABORT THE FORMAT OP
                	;
                	;	REGISTERS:	ALL UNALTERED BUT [AF]
                	;
                DPY$ERROR:
                	; SAVE REGISTER STATE:
 045B C5        	PUSH	B
 045C D5        	PUSH	D
 045D E5        	PUSH	H
                
                	; DISPLAY THE APPROPRIATE ERROR MESSAGE:
 045E 21550A    	LXI	H,ERRMPTRS	;POINT TO BASE OF POINTER TABLE
 0461 5F        	MOV	E,A		;GET MESSAGE # TO [DE]
 0462 1600      	MVI	D,0
 0464 19        	DAD	D		;GET OUR PARTICULAR MESSAGE POINTER
 0465 19        	DAD	D
 0466 5E        	MOV	E,M
 0467 23        	INX	H
 0468 56        	MOV	D,M		;GOT MESSAGE ADDRESS TO [DE]
 0469 CDF501    	CALL	PBUFF		;DISPLAY IT FOR USER TO SEE!
                
                	; NOW WAIT FOR THE USER TO CHOOSE THEIR OPTION:
 046C 112C09    	LXI	D,BRK1MSG	;DISPLAY BREAK MESSAGE
 046F CDF501    	CALL	PBUFF
 0472 CD3402    DPYE00:	CALL	CONIN		;GET INPUT CHARACTER
 0475 FE1B      	CPI	ESC		;USER ABORT ?
 0477 37        	STC			;SET CARRY IN CASE IT IS
                	JRZ	DPYE99		;YES -- THEN SKIP REMAINING...
 0478+28        	DB	28H
 0479+08        	DB	DPYE99-$-1
 047A FE0D      	CPI	CR		;CR TO CONTINUE ?
                	JRNZ	DPYE00		;LOOP FOR 1 OPTION OR THE OTHER...
 047C+20        	DB	20H
 047D+F4        	DB	DPYE00-$-1
 047E CD8604    	CALL	DPYFMT		;CONTINUING -- REDISPLAY FORMAT SCREEN
 0481 B7        	ORA	A		;C=0 FOR CONTINUATION RETURN
                
                	; RESTORE REGISTER STATE:
 0482 E1        DPYE99:	POP	H
 0483 D1        	POP	D
 0484 C1        	POP	B
 0485 C9        	RET
                
                
                	;;;;; DPYFMT
                	; DISPLAY SCREEN SHOW USER THE FORMAT CHOSEN --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL ALTERED
                	;
                DPYFMT:
                	; DISPLAY SCREEN HEADER MESSAGE
 0486 116408    	LXI	D,HDRMSG
 0489 CDF501    	CALL	PBUFF
                
                	; SET UP FORMAT TYPE MESSAGE:
 048C 010000    	LXI	B,0		;ASSUME SDSS AT FIRST
                	LDX	A,DENSITY	;GET FORMAT DENSITY
 048F+DD7E01    	DB	0DDH,A*8+46H,DENSITY
 0492 FE00      	CPI	SDEN		;SINGLE DENSITY ?
                	JRZ	DPYF00		;YES -- SKIP NEXT...
 0494+28        	DB	28H
 0495+01        	DB	DPYF00-$-1
 0496 0C        	INR	C		;BUMP IT IF DOUBLE DENSITY
                DPYF00:	LDX	A,ACTSIDES	;GET # SIDES TO FORMAT
 0497+DD7E02    	DB	0DDH,A*8+46H,ACTSIDES
 049A FE01      	CPI	ONEHEAD		;SINGLE-SIDED DISK ?
                	JRZ	DPYF01		;YES -- SKIP NEXT...
 049C+28        	DB	28H
 049D+02        	DB	DPYF01-$-1
 049E 0C        	INR	C		;BUMP BY TWO IF DOUBLE-SIDED
 049F 0C        	INR	C
 04A0 21EA0E    DPYF01:	LXI	H,SDSSMSG	;POINT TO 1ST DISK TYPE MESSAGE
 04A3 09        	DAD	B		;ADD IN OFFSET TO OUR SPECIFIC TYPE MESSAGE
 04A4 09        	DAD	B
 04A5 09        	DAD	B
 04A6 09        	DAD	B
 04A7 09        	DAD	B
 04A8 09        	DAD	B
 04A9 09        	DAD	B		;7 BYTES / MESSAGE
 04AA 225A0E    	SHLD	TYP0PTR		;STORE INTO MESSAGE TO DISPLAY
                	LDX	C,FMTTYP	;GET THIS FORMAT TYPE #
 04AD+DD4E0F    	DB	0DDH,C*8+46H,FMTTYP
 04B0 219D12    	LXI	H,TYPTBL	;POINT TO TABLE OF POINTERS TO PARTICULAR
                				; FORMAT TYPE MESSAGES
 04B3 09        	DAD	B		;ADD IN OFFSET TO OUR POINTER
 04B4 09        	DAD	B
 04B5 5E        	MOV	E,M
 04B6 23        	INX	H		;GET OUR FORMAT TYPE MESSAGE ADDRESS
 04B7 56        	MOV	D,M
 04B8 EB        	XCHG
 04B9 225D0E    	SHLD	TYP1PTR		;STORE INTO MESSAGE TO DISPLAY
 04BC 113F0E    	LXI	D,TYPMSG	;POINT TO FINAL MESSAGE TO DISPLAY
 04BF C3F501    	JMP	PBUFF		;AND DO IT...
                
                
                	;;;;; DPY$TRKHD
                	; DISPLAY CURRENT TRACK # AND HEAD # FOR FORMAT OPERATION --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL ALTERED
                	;
                DPY$TRKHD:
 04C2 2A6113    	LHLD	SECIDS		;GET CURRENT TRACK # TO [A]
 04C5 7E        	MOV	A,M
 04C6 21720E    	LXI	H,TRKNUM	;DEPOSIT ASCII DECIMAL # HERE
 04C9 CDDB04    	CALL	MBTOD		;CONVERT TO ASCII DECIMAL
 04CC 3ADF13    	LDA	PHYHEAD		;GET CURRENT PHYSICAL HEAD #
 04CF 217E0E    	LXI	H,HEADNUM	;DEPOSIT ASCII DECIMAL # HERE
 04D2 CDDB04    	CALL	MBTOD		;CONVERT TO ASCII DECIMAL IN MEMORY
 04D5 11680E    	LXI	D,TRKHDMSG	;NOW DISPLAY
 04D8 C3F501    	JMP	PBUFF
                
                
                	;;;;; MBTOD
                	; CONVERT BINARY # IN [A] TO DECIMAL # IN MEMORY --
                	;
                	;	ON ENTRY:	[A] = BINARY #
                	;			[HL] = MEMORY LOCATION TO DEPOSIT DECIMAL #
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL ALTERED
                	;
 04DB 3630      MBTOD:	MVI	M,'0'		;ASSUME 0 100'S DIGIT
 04DD FE64      	CPI	100		;< 100 ?
                	JRC	MB00		;YES -- SKIP NEXT...
 04DF+38        	DB	38H
 04E0+02        	DB	MB00-$-1
 04E1 3631      	MVI	M,'1'		;ELSE SET TO A 1 100'S DIGIT
 04E3 23        MB00:	INX	H		;POINT TO WHERE 10'S DIGIT WILL GO
 04E4 01300A    	LXI	B,((10*256)+'0')
 04E7 90        MB01:	SUB	B		;[A] = [A] - 10
 04E8 FAEE04    	JM	MB02		;IF WE HAD UNDERFLOW WE ARE DONE...
 04EB 0C        	INR	C		;ELSE BUMP 10'S DIGIT
                	JR	MB01		;LOOP UNTIL WE HAVE UNDERFLOW
 04EC+18        	DB	18H
 04ED+F9        	DB	MB01-$-1
 04EE C63A      MB02:	ADI	10+'0'		;CONVERT 1'S DIGIT TO ASCII ALSO
 04F0 71        	MOV	M,C		;DEPOSIT 10'S DIGIT
 04F1 23        	INX	H
 04F2 77        	MOV	M,A		;THEN THE 1'S DIGIT
 04F3 C9        	RET
                
                ;*									     *
                ;*****************************************************************************
                
                
                ;******************************************************************************
                ;*									      *
                ;*	AUXILLIARY CODE FOR IBM PC, CPM-86 DISK INITIALIZATION:		      *
                ;*									      *
                
                
                	;;;;; CPM86$1
                	; CODE TO INITIALIZE IBM PC, CPM-86 SINGLE-SIDED DISKS:
                	;
                CPM86$1:
                	; SET UP ID BYTE FOR SS DISKS AND FALL THROUGH TO INIT CODE:
 04F4 AF        	XRA	A		;=0 FOR SS DISKS
                
                
                CPMINIT:
                	; INITIALIZE A SECTORS WORTH OF BYTES TO THE CPM FORMATTING CHARACTER:
 04F5 F5        	PUSH	PSW		;SAVE ID BYTE
 04F6 216118    	LXI	H,TRK$BUFFER
 04F9 010002    	LXI	B,512
 04FC 36E5      C0LP:	MVI	M,CPMFMT
 04FE 23        	INX	H
 04FF 0B        	DCX	B
 0500 78        	MOV	A,B
 0501 B1        	ORA	C
                	JRNZ	C0LP		;LOOP FOR ALL BYTES TO INITIALIZE...
 0502+20        	DB	20H
 0503+F8        	DB	C0LP-$-1
                
                	; FOR CPM-86 SINGLE-SIDED DISKS THE LAST BYTE OF THE 1ST SECTOR
                	; MUST BE INITIALIZED:
 0504 F1        	POP	PSW		;RECOVER ID BYTE
 0505 32601A    	STA	TRK$BUFFER+511	;OK -- FALL THROUGH TO SECTOR WRITE
                				; ROUTINE...
                
                	; SET UP PHYSICAL PARAMETERS:
 0508 216118    	LXI	H,TRK$BUFFER	;POINT TO TRANSFER ADDRESS
 050B 22E513    	SHLD	DMAADR		;SET DMA ADDRESS TO THAT
 050E 3E01      	MVI	A,1		;WILL BE WRITING PHYSICAL SECTOR 1 ON TRACK 0
 0510 32E013    	STA	PHYSEC
 0513 3D        	DCR	A		;SO SET UP FOR HEAD 0
 0514 32DF13    	STA	PHYHEAD
 0517 32E413    	STA	BYTCNT		;=0 FOR TRANSFER OF 256 BYTES EACH I/O
 051A 3E02      	MVI	A,2		;BLOCK I/O REPEAT FACTOR (2 XFERS OF
 051C 32E313    	STA	RPTXFER		; 256 BYTES EACH)
                
                	; NOW TRY ACTUAL SECTOR WRITE:
 051F CDCC07    	CALL	DCBWRT
 0522 D0        	RNC			;JUST RETURN IF EVERYTHING HUNKY-DORY...
 0523 C35B04    	JMP	DPY$ERROR	;ELSE DISPLAY ERROR FOR USER TO SEE & RETURN
                				; TO CALLER FROM ERROR ROUTINE...
                
                
                	;;;;; CPM86$2
                	; INITIALIZE AN IBM PC, CPM-86 DS DISK:
                	;
                CPM86$2:
                	; SET UP ID BYTE FOR DS DISKS AND GO TO CODE TO INITIALIZE:
 0526 3E01      	MVI	A,1		;ID BYTE = 1 FOR DS DISKS
 0528 C3F504    	JMP	CPMINIT
                
                ;*									      *
                ;******************************************************************************
                
                
                ;******************************************************************************
                ;*									      *
                ;*	AUXILLIARY CODE FOR INITIALIZING IBM PC, MSDOS 1.1 & 2.X DISKS:	      *
                ;*									      *
                
                
                	;;;;; MS11$1
                	; INITIALIZE A SS MSDOS 1.1 DISK:
                	;
                MS11$1:
                	; BUILD UP TRACK 0 SECTOR IMAGES IN MEMORY:
                	LXIY	MS11$1TBL	;POINT TO IMAGE TABLE
 052B+FD21      	DB	0FDH,21H
 052D+E805      	DW	MS11$1TBL
                MSCOMMON:
 052F 216118    	LXI	H,TRK$BUFFER	;AND TO PLACE TO DEPOSIT IMAGE
 0532 E5        	PUSH	H
 0533 CDA205    	CALL	INITFMT		;BUILD IT UP IN MEMORY
 0536 E1        	POP	H
 0537 010801    	LXI	B,(1*256)+8	;[B] = 1 = 1ST SECTOR TO WRITE
                				;[C] = 8 = LAST SECTOR TO WRITE
 053A AF        	XRA	A		;[A] = 0 = HEAD TO WRITE TO
                				; FALL THROUGH TO ROUTINE TO WRITE MULTISECTORS
                
                
                	;;;;; MSWRITE
                	; MULTISECTOR WRITE ROUTINE:
                	;
                	;	ON ENTRY:	[A] = HEAD TO WRITE TO
                	;			[B] = 1ST SECTOR TO WRITE
                	;			[C] = LAST SECTOR TO WRITE TO
                	;			[HL] = INITIAL DMA ADDRESS
                	;
                MSWRITE:
                	; SOME INITIALIZATIONS:
 053B 32DF13    	STA	PHYHEAD
 053E 22E513    	SHLD	DMAADR
 0541 AF        	XRA	A		;[A] = 0 = 256 BYTES XFERRED IN 1 BLOCK I/O
 0542 32E413    	STA	BYTCNT
 0545 3C        	INR	A
 0546 3C        	INR	A		;[A] = 2 = # TIMES TO REPEAT BLOCK I/O
 0547 32E313    	STA	RPTXFER
                
                	; LOOP FOR WRITING:
 054A C5        MSWLP:	PUSH	B		;SAVE START AND END SECTORS
 054B 78        	MOV	A,B		;GET NEXT SECTOR TO WRITE
 054C 32E013    	STA	PHYSEC		;AND STORE IT FOR PHYSICAL WRITE ROUTINE
 054F CDCC07    	CALL	DCBWRT		;TRY TO WRITE SECTOR
 0552 DC5B04    	CC	DPY$ERROR	;SHOW USER ERROR IF 1 OCCURRED
 0555 C1        	POP	B		;GET BACK LAST AND END SECTORS
 0556 D8        	RC			;ABORT IF USER SAID TO
 0557 2AE513    	LHLD	DMAADR		;GET LAST DMA ADDRESS
 055A 110002    	LXI	D,512		;SECTOR SIZE
 055D 19        	DAD	D		;UPDATE TO NEXT DMA ADDRESS
 055E 22E513    	SHLD	DMAADR
 0561 04        	INR	B		;BUMP TO NEXT SECTOR #
 0562 79        	MOV	A,C		;GET END SECTOR
 0563 90        	SUB	B		; - NEXT SECTOR
 0564 F24A05    	JP	MSWLP		;LOOP IF MORE SECTORS TO WRITE...
 0567 B7        	ORA	A		;ELSE C=0 FOR GOOD RETURN
 0568 C9        	RET
                
                
                	;;;;; MS11$2
                	; INITIALIZE A DS MSDOS 1.1 DISK:
                	;
                MS11$2:
                	; POINT TO TABLE FOR THIS MSDOS FORMAT:
                	LXIY	MS11$2TBL
 0569+FD21      	DB	0FDH,21H
 056B+0A06      	DW	MS11$2TBL
 056D CD2F05    	CALL	MSCOMMON	;WRITE 1ST 8 SECTORS
 0570 D8        	RC			;RETURN IF USER ABORT!
 0571 010201    	LXI	B,(1*256)+2	;[B] = 1 = START SECTOR ON 2ND SIDE
                				;[C] = 2 = END SECTOR ON 2ND SIDE
 0574 2AE513    	LHLD	DMAADR		;GET NEXT DMA ADDRESS
 0577 3E01      	MVI	A,1		;NOW GET SET FOR WRITE TO 2ND SIDE
 0579 C33B05    	JMP	MSWRITE		;AND GO TO MULTISECTOR WRITE ROUTINE...
                
                
                	;;;;; MS2X$1
                	; INITIALIZE A SS MSDOS 2.X DISK:
                	;
                MS2X$1:
                	; BUILD UP TRACK 0 SECTOR IMAGES IN MEMORY:
                	LXIY	MS2X$1TBL	;POINT TO IMAGE TABLE
 057C+FD21      	DB	0FDH,21H
 057E+2606      	DW	MS2X$1TBL
                MS2COMMON:
 0580 216118    	LXI	H,TRK$BUFFER	;AND TO PLACE TO DEPOSIT IMAGE
 0583 E5        	PUSH	H
 0584 CDA205    	CALL	INITFMT		;BUILD IT UP IN MEMORY
 0587 E1        	POP	H
 0588 010901    	LXI	B,(1*256)+9	;[B] = 1 = 1ST SECTOR TO WRITE
                				;[C] = 9 = LAST SECTOR TO WRITE
 058B AF        	XRA	A		;[A] = 0 = HEAD TO WRITE TO
 058C C33B05    	JMP	MSWRITE		;WRITE TRACK 0 SECTORS NOW...
                
                
                	;;;;; MS2X$2
                	; INITIALIZE A DS MSDOS 2.X DISK:
                	;
                MS2X$2:
                	; BUILD UP SECTOR IMAGE IN MEMORY AND WRITE 0 TRACK SECTORS
                	LXIY	MS2X$2TBL	;POINT TO IMAGE BUILDING TABLE
 058F+FD21      	DB	0FDH,21H
 0591+4206      	DW	MS2X$2TBL
 0593 CD8005    	CALL	MS2COMMON	;BUILD IMAGE AND WRITE 1ST 9 SECTORS
 0596 D8        	RC			;RETURN IF USER ABORT...
                
                	; WRITE 2ND SIDE SECTORS:
 0597 010301    	LXI	B,(1*256)+3	;[B] = 1 = START SECTOR ON 2ND SIDE
                				;[C] = 3 = END SECTOR ON 2ND SIDE
 059A 2AE513    	LHLD	DMAADR		;GET NEXT DMA ADDRESS
 059D 3E01      	MVI	A,1		;NOW GET SET FOR WRITE TO 2ND SIDE
 059F C33B05    	JMP	MSWRITE		;AND GO TO MULTISECTOR WRITE ROUTINE...
                
                
                	;;;;; INITFMT
                	; BUILD UP A MULTIPLE BYTE IMAGE IN MEMORY FROM TABLE POINTED TO BY
                	; [IY] --
                	;
                	;	ON ENTRY:	[IY] = POINTER TO IMAGE TABLE
                	;			[HL] = MEMORY POINTER
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:
                	;
                INITFMT:
                	LDY	C,0		;GET LO BYTE OF REPEAT COUNT TO [C]
 05A2+FD4E00    	DB	0FDH,C*8+46H,0
                	LDY	B,1		;AND THE HI BYTE OF REPEAT COUNT TO [B]
 05A5+FD4601    	DB	0FDH,B*8+46H,1
                	INXIY
 05A8+FD23      	DB	0FDH,23H
                	INXIY			;POINT PAST REPEAT COUNT TO FILL BYTE
 05AA+FD23      	DB	0FDH,23H
                	BIT	7,B		;IS THIS A MACRO INVOCATION ?
 05AC+CB78      	DB	0CBH,7*8+B+40H
                	JRNZ	INITMACRO	;YES -- GO TO CODE TO HANDLE THAT...
 05AE+20        	DB	20H
 05AF+0D        	DB	INITMACRO-$-1
                
                	; HERE TO DO SIMPLE NON-MACRO IMAGE BUILDING:
 05B0 79        	MOV	A,C
 05B1 B0        	ORA	B		;CHECK FOR END OF IMAGE TABLE
 05B2 C8        	RZ			;RETURN IF END OF TABLE...
                	LDY	E,0		;GET FILL CHARACTER TO [E]
 05B3+FD5E00    	DB	0FDH,E*8+46H,0
 05B6 CD5304    	CALL	RPTFMT		;BUILD IMAGE
                	INXIY			;POINT TO NEXT REPEAT FIELD
 05B9+FD23      	DB	0FDH,23H
                	JR	INITFMT		;LOOP FOR ALL TABLE ENTRIES...
 05BB+18        	DB	18H
 05BC+E5        	DB	INITFMT-$-1
                
                	; HERE TO DO COMPLEX MACRO IMAGE BUILDING:
                INITMACRO:
                	RES	7,B		;RESET MACRO INVOCATION BIT
 05BD+CBB8      	DB	0CBH,7*8+B+80H
                INITF0:	PUSHIY			;SAVE TABLE STARTING MACRO POINT
 05BF+FDE5      	DB	0FDH,0E5H
 05C1 C5        	PUSH	B		;SAVE MACRO REPEAT COUNT
                INITFA:	LDY	C,0		;GET LO BYTE OF REPEAT COUNT TO [C]
 05C2+FD4E00    	DB	0FDH,C*8+46H,0
                	LDY	B,1		;GET HI BYTE OF REPEAT COUNT TO [B]
 05C5+FD4601    	DB	0FDH,B*8+46H,1
                	INXIY
 05C8+FD23      	DB	0FDH,23H
                	INXIY			;POINT PAST REPEAT COUNT TO FILL BYTE
 05CA+FD23      	DB	0FDH,23H
 05CC 79        	MOV	A,C
 05CD B0        	ORA	B		;CHECK FOR END OF MACRO
                	JRNZ	INITF2
 05CE+20        	DB	20H
 05CF+0E        	DB	INITF2-$-1
                
                	; HERE FOR PROCESSING AT END OF MACRO:
 05D0 C1        	POP	B		;GET BACK MACRO REPEAT COUNT
 05D1 0B        	DCX	B		;DROP IT DOWN 1
 05D2 79        	MOV	A,C
 05D3 B0        	ORA	B		;DONE WITH MACRO LOOPS ?
                	JRZ	INITF1		;YES -- THEN SKIP NEXT...
 05D4+28        	DB	28H
 05D5+04        	DB	INITF1-$-1
                	POPIY			;NO -- GET BACK OF MACRO START POINT
 05D6+FDE1      	DB	0FDH,0E1H
                	JR	INITF0		;LOOP BACK UP...
 05D8+18        	DB	18H
 05D9+E5        	DB	INITF0-$-1
 05DA C1        INITF1:	POP	B		;THROW AWAY MACRO START ADDRESS
 05DB C3A205    	JMP	INITFMT		;REPEAT FROM ABOVE...
                
                	; HERE TO DO MACRO IMAGE BUILDING:
                INITF2:	LDY	E,0		;GET FILL CHARACTER
 05DE+FD5E00    	DB	0FDH,E*8+46H,0
                	INXIY
 05E1+FD23      	DB	0FDH,23H
 05E3 CD5304    	CALL	RPTFMT		;BUILD IMAGE
                	JR	INITFA		;LOOP BACK UP...
 05E6+18        	DB	18H
 05E7+DA        	DB	INITFA-$-1
                
                
                	; TABLE FOR MSDOS 1.1, SS, TRACK 0 IMAGE:
                MS11$1TBL:
 05E8 0002      	DW	512
 05EA F6        	DB	MSDOSFMT
 05EB 0280      	DW	8000H + 2
 05ED 0100      	DW	1
 05EF FE        	DB	0FEH
 05F0 0200      	DW	2
 05F2 FF        	DB	0FFH
 05F3 D601      	DW	470
 05F5 00        	DB	0
 05F6 2700      	DW	39
 05F8 F6        	DB	MSDOSFMT
 05F9 0000      	DW	0
 05FB 4080      	DW	8000H + 64
 05FD 0100      	DW	1
 05FF E5        	DB	0E5H
 0600 1F00      	DW	31
 0602 F6        	DB	MSDOSFMT
 0603 0000      	DW	0
 0605 0002      	DW	512
 0607 F6        	DB	MSDOSFMT
 0608 0000      	DW	0	;END OF TABLE
                
                
                	; TABLE FOR MSDOS 1.1, DS, 8 SECTOR FORMAT:
                MS11$2TBL:
 060A 0002      	DW	512
 060C F6        	DB	MSDOSFMT
 060D 0280      	DW	8000H + 2
 060F 0300      	DW	3
 0611 FF        	DB	0FFH
 0612 D901      	DW	473
 0614 00        	DB	0
 0615 2400      	DW	36
 0617 F6        	DB	MSDOSFMT
 0618 0000      	DW	0
 061A 7080      	DW	8000H + (7 * 16)	;7 SECTORS FOR DIRECTORY
 061C 0100      	DW	1
 061E E5        	DB	0E5H
 061F 1F00      	DW	31
 0621 F6        	DB	MSDOSFMT
 0622 0000      	DW	0
 0624 0000      	DW	0	;END OF TABLE
                
                	; TABLE FOR MSDOS 2.X, SS, 9 SECTOR FORMAT:
                MS2X$1TBL:
 0626 0002      	DW	512
 0628 F6        	DB	MSDOSFMT
 0629 0280      	DW	8000H + 2
 062B 0100      	DW	1
 062D FC        	DB	0FCH
 062E 0200      	DW	2
 0630 FF        	DB	0FFH
 0631 FD03      	DW	1021
 0633 00        	DB	0
 0634 0000      	DW	0
 0636 4080      	DW	8000H + (4 * 16)	;4 SECTORS FOR DIRECTORY
 0638 0100      	DW	1
 063A 00        	DB	0
 063B 1F00      	DW	31
 063D F6        	DB	MSDOSFMT
 063E 0000      	DW	0
 0640 0000      	DW	0	;END OF TABLE
                
                	; TABLE FOR MSDOS 2.X, DS, 9 SECTOR FORMAT:
                MS2X$2TBL:
 0642 0002      	DW	512
 0644 F6        	DB	MSDOSFMT
 0645 0280      	DW	8000H + 2
 0647 0100      	DW	1
 0649 FD        	DB	0FDH
 064A 0200      	DW	2
 064C FF        	DB	0FFH
 064D FD03      	DW	1021
 064F 00        	DB	0
 0650 0000      	DW	0
 0652 7080      	DW	8000H + (7 * 16)	;7 SECTORS FOR DIRECTORY
 0654 0100      	DW	1
 0656 00        	DB	0
 0657 1F00      	DW	31
 0659 F6        	DB	MSDOSFMT
 065A 0000      	DW	0
 065C 0000      	DW	0	;END OF TABLE
                
                ;*									      *
                ;******************************************************************************
                
                
                ;******************************************************************************
                ;*									      *
                ;*	PRIMITIVE DISK INTERFACE ROUTINES:				      *
                ;*									      *
                
                	;;;;; DCBLOGIN
                	;
                DCBLOGIN:
                	; SET UP DRIVE SELECT BITS:
                	LDX	A,DISKSIZE	;GET DRIVE SIZE SELECT BIT PATTERN
 065E+DD7E00    	DB	0DDH,A*8+46H,DISKSIZE
 0661 FE20      	CPI	SIZE5		;5" DRIVE ?
                	LBCD	STEP5RATE	;ASSUME IT IS -- SET UP...
 0663+ED4B      	DB	0EDH,4BH
 0665+0A01      	DW	STEP5RATE
                	JRZ	LOG00
 0667+28        	DB	28H
 0668+04        	DB	LOG00-$-1
                	LBCD	STEP8RATE	;ELSE SET UP FOR 8" DRIVE
 0669+ED4B      	DB	0EDH,4BH
 066B+0C01      	DW	STEP8RATE
 066D B0        LOG00:	ORA	B		;ADD IN RELATIVE DRIVE SELECT BITS
                	ORX	DENSITY		;ADD IN DENSITY SELECTION BIT
 066E+DDB601    	DB	0DDH,0B6H,DENSITY
 0671 32E213    	STA	DSELBITS	;SAVE AS OUR DRIVE SELECT BYTE
 0674 CDAC06    	CALL	DRVSET		;SET UP IN HARDWARE ALSO!
 0677 79        	MOV	A,C		;SET UP DEFAULT STEP RATE ALSO
 0678 32E113    	STA	STEPRATE
                
                	; SET UP TRANSFER PARAMETERS:
 067B 3AE213    	LDA	DSELBITS	;GET SELECT BYTE
                	BIT	1,A		;8" DRIVE ?
 067E+CB4F      	DB	0CBH,1*8+A+40H
                	JRZ	LOG01		;NO -- SKIP NEXT...
 0680+28        	DB	28H
 0681+0A        	DB	LOG01-$-1
                	BIT	DENBIT,A	;DOUBLE DENSITY ?
 0682+CB77      	DB	0CBH,DENBIT*8+A+40H
 0684 3E29      	MVI	A,(DD8BYTES/256)+1	;ASSUME SO
                	JRNZ	LOG02
 0686+20        	DB	20H
 0687+0C        	DB	LOG02-$-1
 0688 3E15      	MVI	A,(SD8BYTES/256)+1	;ELSE SET UP FOR SD # BYTES
                	JR	LOG02
 068A+18        	DB	18H
 068B+08        	DB	LOG02-$-1
                LOG01:	BIT	DENBIT,A	;DOUBLE DENSITY ?
 068C+CB77      	DB	0CBH,DENBIT*8+A+40H
 068E 3E1A      	MVI	A,(DD5BYTES/256)+1	;ASSUME SO
                	JRNZ	LOG02
 0690+20        	DB	20H
 0691+02        	DB	LOG02-$-1
 0692 3E0D      	MVI	A,(SD5BYTES/256)+1	;ELSE SET UP FOR SD # BYTES
 0694 32E313    LOG02:	STA	RPTXFER		;STORE TRANSFER REPETITION FACTOR
                
