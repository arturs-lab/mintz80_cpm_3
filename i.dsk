  3011  13F5  C5               	PUSH   	BC
  3012  13F6  D5               	PUSH   	DE
  3013  13F7  5F               	LD     	E,A    	       	
  3014  13F8  0608             	LD     	B,8
  3015  13FA  CB23      BQ2:   	SLA    	E
  3016  13FC  3E18             	LD     	A,18H
  3017  13FE  8F               	ADC    	A
  3018  13FF  4F               	LD     	C,A
  3019  1400  CD1B01           	CALL   	CO
  3020  1403  10F5             	DJNZ   	BQ2
  3021  1405  D1               	POP    	DE
  3022  1406  C1               	POP    	BC
  3023  1407  F1               	POP    	AF
  3024  1408  C9               	RET
  3025                  ;
  3026                  ;
  3027                  ; CHECK IF AN ABORT (ESC) CHARACTER IS PRESENT AT THE C
  3028                  ; HOLD EVERYTHING IF SPACEBAR IS PRESSED
  3029                  ;
  3030  1409            CHECKABORT:    	       	       	;see if an abort is req
  3031  1409  CD0A01           	CALL   	CONST
  3032  140C  C8               	RET    	Z      	
  3033  140D  CD1201    CHECK1:	CALL   	CI
  3034  1410  FE1B             	CP     	A,ESC  	       	;ESC to abort
  3035  1412  2806             	JR     	Z,CABORT
  3036  1414  FE20             	CP     	A,' '  	       	;If spacebar then freez
  3037  1416  28F5             	JR     	Z,CHECK1
  3038  1418  AF               	XOR    	A,A
  3039  1419  C9               	RET
  3040  141A  AF        CABORT:	XOR    	A,A    	       	;Was ESC, so return wit
  3041  141B  3D               	DEC    	A      	       	;return NZ, & 0FFH in A
  3042  141C  C9               	RET
