  2985  13D6  F5        PACC:  	PUSH   	AF
  2986  13D7  C5               	PUSH   	BC
  2987  13D8  F5               	PUSH   	AF
  2988  13D9  0F               	RRCA
  2989  13DA  0F               	RRCA
  2990  13DB  0F               	RRCA
  2991  13DC  0F               	RRCA
  2992  13DD  CDE713           	CALL   	ZCONV
  2993  13E0  F1               	POP    	AF
  2994  13E1  CDE713           	CALL   	ZCONV
  2995  13E4  C1               	POP    	BC
  2996  13E5  F1               	POP    	AF
  2997  13E6  C9               	RET
  2998  13E7            
  2999  13E7  E60F      ZCONV: 	AND    	A,0FH  	       	;HEX to ASCII
  3000  13E9  C690             	ADD    	90H
  3001  13EB  27               	DAA
  3002  13EC  CE40             	ADC    	40H
  3003  13EE  27               	DAA
  3004  13EF  4F               	LD     	C,A
  3005  13F0  CD1B01           	CALL   	CO
  3006  13F3  C9               	RET
