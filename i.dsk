;******************************************************************************
;*									      *
;*	DOUBLE DENSITY, DOUBLE-SIDED formats:				      *
;*									      *

	; 8", 1024 byte, DDDS, 9 sector format:
DS8$0:		db	SIZE8		;8" disk
		db	DDEN		;double density
		db	TWOHEAD		;double side
		dw	NOSKEW		;no sector skew
		db	9		;9 sectors / track
		db	154		;154 tracks
		db	50		;GAP3
		dw	128		;GAP4
		db	CPMFMT		;format character
		db	SEC1024		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	7		;format type 7
		db	-1		;no auxilliary code

	; 5", IBM PC CPM-86,  512 byte, DDDS, 8 sector format:
DS5$0:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double sided
		dw	NOSKEW		;no sector skew
		db	8		;8 sectors / track
		db	80		;80 tracks
		db	80		;GAP3
		dw	1038		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	8		;format type 8
		db	3		;auxilliary code #3

	; 5", IBM PC, MSDOS 1.1, 512 byte, DDDS, 8 sector format:
DS5$1:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double sided
		dw	NOSKEW		;no sector skew
		db	8		;8 sectors / track
		db	80		;80 tracks
		db	80		;GAP3
		dw	386		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	9		;format type 9
		db	4		;auxilliary code #4

	; MAGIC Computer, DS format:
DS5$2:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$2skw	;skew pointer
		db	10		;10 sectors / track
		db	80		;80 tracks
		db	16		;GAP3
		dw	374		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	23		;format type 23
		db	-1		;no auxilliary code
DS5$2skw:	skew	10,7,1

	; DEC VT180, DS format:
DS5$3:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no sector skew
		db	9		;9 sectors / track
		db	80		;80 tracks
		db	26		;GAP3
		dw	872		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	22		;format type 22
		db	-1		;no auxilliary code

	; DATAVUE, DDDS, 512 byte, 10 sector format:
DS5$4:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$4skw	;pointer to sector skew table
		db	10		;10 sectors / track
		db	80		;80 tracks
		db	26		;GAP3
		dw	274		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	0		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	24		;format type 24
		db	-1		;no auxilliary code
DS5$4skw:	skew	10,7,81h

	; KAYPRO 4/10, DDDS format:
DS5$5:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$5skw	;pointer to hard sector skew table
		db	10		;10 sectors / track
		db	80		;80 tracks
		db	26		;GAP3
		dw	254		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	0		;1st sector # bias
		db	10		;2nd side continuation factor
		db	0		;2nd side is head #0
		db	25		;format type 25
		db	-1		;no auxilliary code
DS5$5skw:	db	0,8,3,6,1,9,4,7,2,5

	; CROMEMCO CDOS (SINGLE density):
DS5$6:		db	SIZE5		;5" disk
		db	SDEN		;single density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no sector skew
		db	18		;18 sectors / track
		db	80		;80 tracks
		db	8		;GAP3
		dw	185		;GAP4
		db	CPMFMT		;format character
		db	SEC128		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	26		;format type 26
		db	-1		;no auxillliary code

	; CROMEMCO CDOS w/INTL TERM. CP/M:
DS5$7:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no sector skew
		db	10		;10 sectors / track
		db	80		;80 tracks
		db	30		;GAP3
		dw	214		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	19		;format type 19
		db	-1		;no auxilliary code

	; EPSON QX-10:
DS5$8:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$8skw	;pointer to hard sector skew table
		db	10		;10 sectors / track
		db	80		;80 tracks
		db	30		;GAP3
		dw	214		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	27		;format type 27
		db	-1		;no auxilliary code
DS5$8skw:	skew	10,2,1

	; HEWLETT PACKARD HP-125:
DS5$9:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$9skw	;pointer to hard sector skew table
		db	16		;16 sectors / track
		db	66		;66 tracks
		db	45		;GAP3
		dw	446		;GAP4
		db	CPMFMT		;format character
		db	SEC256		;sector size code
		db	0		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	28		;format type 28
		db	-1		;no auxilliary code
DS5$9skw:	skew	16,4,0

	; MORROW MD3:
DS5$10:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no hard sector skew
		db	5		;5 sectors / track
		db	80		;80 tracks
		db	50		;GAP3
		dw	574		;GAP4
		db	CPMFMT		;format character
		db	SEC1024		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	29		;format type 29
		db	-1		;no auxilliary code

	; NEC PC8801A:
DS5$11:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$11skw	;pointer to hard sector skew table
		db	16		;16 sectors / track
		db	80		;80 tracks
		db	50		;GAP3
		dw	366		;GAP4
		db	CPMFMT		;format character
		db	SEC256		;sector size code
		db	0		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	13		;format type 13
		db	-1		;no auxilliary code
DS5$11skw:	skew	16,11,1

	; OTRONA ATTACHE:
DS5$12:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$12skw	;pointer to hard sector skew table
		db	10		;10 sectors / track
