  3825  1A14  2B               	DEC    	HL
  3826  1A15  ED52             	SBC    	HL,DE
  3827  1A17  EB               	EX     	DE,HL  	       	;Count now in DE
  3828  1A18  E1               	POP    	HL     	       	;DE on stack to HL
  3829  1A19  7E        HGAP3X:	LD     	A,(HL)
  3830  1A1A  CDD41A           	CALL   	PACC   	       	;Print out HEX values o
  3831  1A1D  23               	INC    	HL     	       	
  3832  1A1E  1B               	DEC    	DE     	       	;Decrease DE count by 1
  3833  1A1F  7B               	LD     	A,E
  3834  1A20  B7               	OR     	A,A    	       	;Not XX00 at least
  3835  1A21  20F6             	JR     	NZ,HGAP3X
  3836  1A23  B2               	OR     	A,D    	       	
  3837  1A24  20F3             	JR     	NZ,HGAP3X      	;Not 0000
  3838  1A26            
  3839  1A26                   	       	       	       	;Now display the Track 
  3840  1A26  21C627           	LD     	HL,SEC_GAP4_MSG	
