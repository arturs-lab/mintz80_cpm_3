RDTCMD_ERROR:	DB	CR,LF,BELL,'TRACK 
    95                         	list on
    96                  ;      	
    97        (0000)    FALSE  	EQU    	0
    98        (0001)    TRUE   	EQU    	1
    99                  ;
   100        (0000)    CHIP_1795 EQU  	FALSE  	       	;<---- RD & WR sector c
   101        (0001)    CHIP_1791 EQU  	TRUE
   102  0100            
   103        (0080)    NBYTES 	EQU    	128    	       	;BYTES PER SECTOR UNIT 
   104        (000A)    LF     	EQU    	0AH
   105        (000D)    CR     	EQU    	0DH
   106        (0007)    BELL   	EQU    	07H
   107        (001A)    CLEAR  	EQU    	1AH    	       	;SD Systems Video Board
   108        (0009)    TAB    	EQU    	09H
   109        (001B)    ESC    	EQU    	1BH
   110        (001C)    EOL    	EQU    	1CH    	       	;SD Systems Video Board
   111        (0010)    PAGE_SIZE EQU  	16     	       	;Number of lines at a t
   112        (0005)    STATUS_DELAY EQU 5     	       	;Time-out for waiting f
   113                  ;
   114        (0001)    RO_FLAG	EQU    	01     	       	;Flag for sequental sec
   115        (0002)    WO_FLAG	EQU    	02     	       	;Flag for sequental sec
   116        (0003)    RW_FLAG	EQU    	03     	       	;Flag for sequental sec
   117        (0004)    RRW_FLAG EQU   	04     	       	;Flag for random track 
   118        (0005)    TRK_RO_FLAG EQU	05     	       	;Flag for reading secto
   119        (0001)    CPM86_FLAG  EQU	01     	       	;Flag to indicate after
   120  0100                   	       	       	       	;needs to be modified
   121        (0001)    TEST_FILL EQU  	01     	       	;Character to write for
   122                  ;
   123        (0000)    SIMPLE 	EQU    	00h    	       	;Output information det
   124        (00FF)    COMPLEX	EQU    	0FFH   	
   125                  ;
   126  0100                   	       	       	       	;Will place these value
   127  0100                   	       	       	       	;The rest go to the end
   128        (0040)    TADDR  	EQU    	40H    	       	;STORE FOR DMA ADDRESS
   129        (0043)    TRK    	EQU    	43H    	       	;NEW TRACK
   130        (0044)    SIDE   	EQU    	44H    	       	;NEW SIDE
   131        (0045)    SCTR   	EQU    	45H    	       	;NEW SECTOR
   132        (002E)    DRIVE  	EQU    	46     	       	;CURRENT DRIVE SELECT B
   133                  ;
   134                  ;
   135                  ;      	PORTS & COMMANDS FOR FOR 1791 or 1795
   136                  ;
   137        (0050)    RSET   	EQU    	50H    	       	;<----- VERSAFLOPPY BAS
   138        (0053)    SELECT 	EQU    	53H    	       	;DRIVE SELECT PORT
   139        (0054)    STATUS 	EQU    	54H    	       	;STATUS PORT
   140        (0055)    TRACK  	EQU    	55H    	       	;TRACK PORT
   141        (0056)    SECTOR 	EQU    	56H    	       	;SECTOR PORT
   142        (0057)    DATA   	EQU    	57H    	       	;DATA PORT
   143        (0054)    CMD    	EQU    	54H    	       	;COMMAND PORT
   144                  ;
   145                  ;Note: the 1791/5 chip for most commands used bits 0&1 
   146                  ;motor stepping rate. 00 being 3ms (@2MH clock),11 bein
   147                  ;Tandon 8" drives take the fastest rate. Older drives m
   148                  ;
   149        (000C)    RSCMD  	EQU    	00001100B      	;(0CH),RESTORE CMD     
   150        (0018)    SKNCMD 	EQU    	00011000B      	;(18H),SEEK NO VERIFY C
   151        (001C)    SKCMD  	EQU    	00011100B      	;(1CH),SEEK WITH VERIFY
   152        (00C4)    RDACMD 	EQU    	11000100B      	;(C0H),READ TRACK/SECTO
   153        (005C)    STEPIN 	EQU    	01011100B      	; Step-in verify on dst
   154  0100                   	
   155  0100                   	IF     	CHIP_1791
   156        (0080)    RDCMD91	EQU    	10000000B      	;(80H),READ SECTOR CMD 
   157        (00A0)    WRCMD91	EQU    	10100000B      	;(A0H),WRITE SECTOR CMD
   158  0100                   	endif
   159  0100            
   160                         	IF     	CHIP_1795
   161                  RDCMD95	EQU    	10000000B      	;(80H),READ SECTOR CMD 
   162                  WRCMD95	EQU    	10100000B      	;(A0H),WRITE SECTOR CMD
   163  0100                   	ENDIF
   164  0100            
   165        (00F4)    WRTCMD 	EQU    	11110100B      	;(F4H),Write a whole tr
   166        (00E4)    RDTCMD 	EQU    	11100100B      	;(E4H),Read a whole tra
   167                  ;
   168                  ;
   169        (0004)    RETRY_MAX EQU  	4      	       	;Number of times to try
   170        (0080)    HOME_ERR_MASK   EQU 80H	       	;Error mask for Type I 
   171        (0090)    SIN_ERR_MASK   	EQU 90H	       	;Step head in one track
   172        (0090)    SK_ERR_MASK     EQU 90H	       	;Track Seek error bits 
   173        (009F)    ID_ERR_MASK     EQU 9FH	       	;Sector ID read error m
   174        (00BF)    RS_ERR_MASK     EQU 0BFH       	;Read sector data error
   175        (00EF)    WS_ERR_MASK    	EQU 0EFh       	;Write sector data erro
   176        (0080)    RT_ERR_MASK     EQU 80H	       	;Read Track error mask
   177        (00E0)    WT_ERR_MASK     EQU 0E0H       	;Write Track error mask
   178                  ;
   179                  ;
   180        (4000)    FBUFFER	EQU    4000H   	       	;Buffer to build track 
   181        (5000)    FBUFFER2 EQU   5000H   	       	;2nd buffer here for se
   182                  ;
   183                  ;The Index register IX is used throughout the program t
   184                  ;table of the currently selected drive/disk format
   185                  ;[IX+HW_BYTE] will point to (DRIVE) and will contain th
   186                  ;hardware selection bits. Drive select 0,1,2,3 and side
   187                  ;other flags (see below) 
   188                  ;Remember the bits for disk selection, density and side
   189                  ;the actual Versafloppy II board hardware
   190                  ;Register IX is not used for anything else in this prog
   191  0100            
   192                  ; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
   193                  ;
   194        (0000)    NSCTRS 	EQU    	0      	;Sectors/Track for disk
   195        (0001)    NTRKS  	EQU    	1      	;Tracks/Side
   196        (0002)    HW_BYTE	EQU    	2      	;Will contain bit flags for:-
   197  0100                   	       	       	       	       	;Bits 0,1 are u
   198  0100                   	       	       	       	       	;Bits 2 & 3 are
   199  0100                   	       	       	       	       	;Bit 4=0 For SS
   200  0100                   	       	       	       	       	;Bit 5=0 8" dis
   201  0100                   	       	       	       	       	;Bit 6=0 Single
   202  0100                   	       	       	       	       	;Bit 7=0 if CUR
   203  0100                   	       	       	       	       	;      1 if CUR
   204  0100                   	       	       	       	       	;Note: handle t
   205  0100                   	       	       	       	       	;central to man
   206  0100                   	       	       	       	       	;program.
   207        (0003)    HEADR  	EQU    	3      	;For Formatting
   208        (0004)    GAP1   	EQU    	4      	;      	"
   209        (0005)    GAP2   	EQU    	5      	;      	"
   210        (0006)    GAP3   	EQU    	6      	;      	"
   211        (0007)    GAP4   	EQU    	7      	;      	"
   212        (0008)    GAP4R  	EQU    	8      	;      	"
   213        (0009)    SIZE   	EQU    	9      	;1=128 Byte sectors.....4=1024 
   214        (000A)    GAP_FILL_CHAR  EQU 10  	;Byte used in disk formating
   215        (000B)    DATA_FILL_CHAR EQU 11  	;     "       "       "
   216        (000C)    TRK_SIZE       EQU 12  	;TWO bytes containing the track
   217        (000E)    SPECIAL_FLAG   EQU 14  	;flag byte for cases where afte
   218  0100                   	       	       	;normally 0, CPM86_FLAG = 1
   219        (000F)    SKEW   	       EQU 15  	;Low address of sector skew tab
   220        (0010)    SKEW1        ;*
;*		Versafloppy II/696 5" and 8" Disk Formatter		      *
;*		-------------------------------------------		      *
;*		written	by		Geoffrey Shapiro		      *
;*					AJS Industries Corp.		      *
;*		version 1.0		March, 1984			      *
;*		(8-24-1984) -- corrected formatting of IBM PC CPM-86 disks    *
;*									      *
;*	General Equates:						      *
;*									      *

	; define logical values:
FALSE		equ	0
TRUE		equ	not FALSE

	; define which WD chip controller is being used:
WD1795		equ	FALSE

	; define Z-80 clock speed:
MHZ		equ	5
SEEKDLY		set	6
	rept	(MHZ-4)
SEEKDLY		set	SEEKDLY+2
	endm

	; include z-80 macro library:
	maclib	z80

	; include CP/M 3.0 macro library:
	maclib	cpm3

;SD Systems S100 VERSAFLOPPY II HARDWARE
;Base port for 179x floppy controller
;
vfl$base	equ	50h	;<<<<<-- Note I use a different port to SD Systems >>>>	
vfl$reset	equ	vfl$base	;They use 60H. This conflicts with the Lomas video board
vfl$select	equ	vfl$base+3
vfl$status	equ	vfl$base+4
vfl$command	equ	vfl$base+4
vfl$track	equ	vfl$base+5
vfl$sector	equ	vfl$base+6
vfl$data	equ	vfl$base+7
;
	; some screen oriented definitions:
CLR1		equ	1ah	;for clear screen on SD Systems 8024 VDB Board
CLR2		equ	0
CLR3		equ	0
RPTCMD		equ	80h	;character repetition command for line output
PTRCMD		equ	0ffh	;recursive string print command
BACKSPACE	equ	8	;ascii backspace character
DELIMITER	equ	0	;string terminator
CR		equ	13	;ascii carriage return
LF		equ	10	;ascii linefeed
ESC		equ	1bh	;ascii escape character

	; WD179X disk operation opcodes:
FRCINT		equ	0d0h	;force interrupt commmand
SKNV$179X	equ	18h	;seek with no verify command
RECAL$179X	equ	8	;recalibrate command
	if	WD1795
RTRK$179X	equ	98h	;read track command for WD1795
WRT$179X	equ	0a8h	;write sector command for WD1795
	else
RTRK$179X	equ	90h	;read track command for WD1791
WRT$179X	equ	0a2h	;write sector command for WD1791-4
	endif
WRTRK$179X	equ	0f4h	;write track and format command
SEEKRETRY	equ	2	;# times to retry restores or seeks
RWRETRY		equ	3	;# times to retry reads or writes
WDBUSY		equ	0	;bit to test for WD179X busy state
TRK00		equ	2	;bit to test for head at track 0
WRTPROT		equ	6	;bit to test for write-protected disk
DRVRDY		equ	7	;bit to test for drive not ready
SKERMSK		equ	90h	;error bits to test for after seek
RDERMSK		equ	8ch	;error bits to test after multiple read sector
WRTERMSK	equ	0e4h	;error bits to test for after write track
;WRTERMSK	equ	0e0h	;<--- 0e4H does not seem to work for my 1791 board
				;With greater than 128 byte sectors I get
				;the DRQ bit set. yet the track seems fine.
WRERMSK		equ	0bch	;error bits to test for after write sector

	; BDOS function #'s and other related variables:
WBOOT		equ	0	;warm boot vector
BDOS		equ	5	;BDOS entry point
FCB0		equ	05dh	;address of default fcb
COUTF		equ	2	;normal console output function #
DCONOUT		equ	6	;direct console output
DCONIN		equ	6	;direct console input
DCONSTAT	equ	6	;direct console status
CURCOUTF	equ	DCONOUT	;current method of character output

;******************************************************************************
;*									      *
;*	Code follows:							      *
;*									      *

	ORG	100H

	; some initializations follow:
start:	lxi	sp,stktop	;set up our local stack
	jmp	start2		;skip over clear screen codes...

	;----------------------------------------------------------------------
	;	CONFIGURATION SECTION
	;
	; clear screen codes kept here:
clrmsg:
	db	CLR1		;1ah for clear screen on SD Systems 8024 VDB Board
	db	CLR2
	db	CLR3
	db	DELIMITER

	; controller select bits and step rate for 5" drive:
step5rate:
	db	0000$0000b	;6 millisecond step rate for 5" drives
rdrv2:	db	0000$0100b	;select bits for 5" drive

	; controller select bits and step rate for 8" drives (Tandon's):
step8rate:
	db	0000$0001b	;6 millsecond step rate for 8" drives
rdrv1:	db	0000$0010b	;select bits for 8" drive

	; verify flag:
verflg:	db	FALSE		;=TRUE if verification of track formatting
	;
	;
;
ZCIN:	IN	0		;console input (For debugging only)
	ANI	02H
	JRZ	ZCIN
	IN	1H		;return with character in A
	RET
;		
ZCO:	IN	0H		;console output (arrive with character in C)
	ANI	04H		;Note character is in C and A on return.
	JRZ	ZCO
	MOV	A,C
	OUT	1H
	RET

	;	END CONFIGURATION SECTION
	;----------------------------------------------------------------------


	; continue...
start2:	lda	FCB0		;was a command line parameter entered ?
	cpi	' '		;if empty fcb then apparently not
	jnz	autoexec	;yes -- go to code to process it...

	; this is the menu printing loop:
menuloop:
	lhld	menu$entry	;get current menu entry address
	pchl			;go to it...

	; display menu #1 -- get user option:
menu1:	lxi	h,menu1		;set up for menu 1 always
	shld	menu$entry
	lxi	d,hdrmsg	;point to header message
	call	pbuff		; and display it
	lxi	d,menu1msg	;point to 1st menu
	call	pbuff		; and display it
in1lp:	call	conin		;get user option
	cpi	'0'		;0 entered -- return to opsys
	jz	fmat$ret
	cpi	'2'		;display menu 2 ?
	jrz	menu2		;yes -- then go to code for it...
	cpi	'3'		;display menu 3 ?
	jz	menu3		;yes -- then go to code for it...
	call	ucase		;make sure upper case
	cpi	'A'		;make sure in range on low end
	jrc	in1lp
	cpi	MENU1MAX+1	;make sure in range on hi end
	jrnc	in1lp
	lxi	h,menu1tbl	;point to table pointers for menu 1
	jr	fmtjmp		;go to common code below...

	; display menu #2 -- get user option:
menu2:	lxi	h,menu2		;set up for menu 2
	shld	menu$entry
	lxi	d,hdrmsg	;point to header message
	call	pbuff		; and display it
	lxi	d,menu2msg	;point to 2nd menu
	call	pbuff		; and display it
in2lp:	call	conin		;get user option
	cpi	'0'		;0 entered -- return to opsys
	jz	fmat$ret
	cpi	'1'		;display menu 1 ?
	jrz	menu1		;yes -- then go to code for it...
	cpi	'3'		;display menu 3 ?
	jrz	menu3		;yes -- then go to code for it...
	call	ucase		;make sure upper case
	cpi	'A'		;make sure in range on low end
	jrc	in2lp
	cpi	MENU2MAX+1	;make sure in range on hi end
	jrnc	in2lp
	lxi	h,menu2tbl	;point to table pointers for menu 2
	jr	fmtjmp		;go to format dispatcher...

	; display menu #3 -- get user option:
menu3:	lxi	h,menu3		;set up for menu 3
	shld	menu$entry
	lxi	d,hdrmsg	;point to header message
	call	pbuff		; and display it
	lxi	d,menu3msg	;point to 3nd menu
	call	pbuff		; and display it
in3lp:	call	conin		;get user option
	cpi	'0'		;0 entered -- return to opsys
	jz	fmat$ret
	cpi	'1'		;display menu 1 ?
	jz	menu1		;yes -- then go to code for it...
	cpi	'2'		;display menu 2 ?
	jrz	menu2		;yes -- then go to code for it...
	call	ucase		;make sure upper case
	cpi	'A'		;make sure in range on low end
	jrc	in3lp
	cpi	MENU3MAX+1	;make sure in range on hi end
	jrnc	in3lp
	lxi	h,menu3tbl	;point to table pointers for menu 3

	; common code to dispatch to format routine:
fmtjmp:	call	conout		;display character entered
	sui	'A'		;subtract ascii bias from format type
	mov	e,a		;make double precision in [de]
	mvi	d,0
	dad	d		;add to table base
	dad	d
	mov	e,m		;get our format block address to [de]
	inx	h
	mov	d,m
	push	d		;then to [ix]
	popix
	call	fmtdsk		;go to disk format code
	jmp	menuloop	;loop for now

	; here to return to operating system:
fmat$ret:
	call	clrscn		;clear screen at end
	jmp	WBOOT		;now back to opsys...


	;;;;; Clrscn
	; clear video display --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all unaltered
	;
clrscn:
	push	psw
	lda	clrmsg+0
	call	conout
	lda	clrmsg+1
	call	conout
	lda	clrmsg+2
	call	conout
	pop	psw
	ret


	;;;;; Pbuff
	; print buffer of characters to the console --
	;
	;	on entry:	[de] = pointer to sring buffer
	;
	;	on exit:	no parameters returned
	;
	;	registers:	[af],[bc],[hl] unaltered
	;
pbuff:
	; save register state:
	push	psw
	push	b
	push	h

	; send buffer characters to console until terminator recognized:
	xchg			;get buffer address to [hl]
pbuff0:	mov	a,m		;get next buffer character to [a]
	cpi	DELIMITER	;buffer terminator ?
	jrz	pbuff$ret	;yes -- return to caller...
	cpi	PTRCMD		;pointer to nested string ?
	jrnz	pbuffa		;no continue on below...

	; here to display a nested string -- to be safe you should only
	; nest 1 or 2 strings at the most -- our stack is limited you know:
	inx	h		;get nested string pointer to [de]
	mov	e,m
	inx	h
	mov	d,m
	call	pbuff		;old recursive JOE!
	jr	pbuff3		;continue below with rest of string...

	; here if not recursive call:
pbuffa:	bit	7,a		;repetition bit set ?
	jrz	pbuff2		;no -- then skip repetition loop...

	; here to repetitively display a character:
	ani	127		;get repeat count and put in [b]
	mov	b,a
	inx	h		;get character to repetitively send out
	mov	a,m
pbuff1:	call	conout		;output character
	djnz	pbuff1		;the required # of times...
	jr	pbuff3		;continue down below...

	; send a single character to the console:
pbuff2:	call	conout		;output character
pbuff3:	inx	h		;update string pointer
	jr	pbuff0		;loop for full string...

	; orderly return at end...
pbuff$ret:
	pop	h		;restore register state
	pop	b
	pop	psw
	ret


	;;;;; Conout
	; send character to console device --
	;
	;	on entry:	[a] = character to output
	;
	;	on exit:	no parameters returned
	;
	;	registers:	[af],[bc],[de],[hl] unaltered
	;
conout:
	; save register state:
	push	psw
	push	b
	push	d
	push	h

	; now do actual console output:
	mov	e,a		;put character in [e] for CP/M
	mvi	c,CURCOUTF	;[c] = BDOS function #
	call	BDOS		;let BDOS do output

	; restore register state:
	pop	h
	pop	d
	pop	b
	pop	psw
	ret


	;;;;; Conin
	; get character from console keyboard --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	[a] = console character gotten
	;
	;	registers:	[bc],[de],[hl] unaltered
	;
conin:
	; save register state:
	push	b
	push	d
	push	h

	; check local 1 character buffer for current console character:
conin0:	lda	conchar		;get buffer character
	ora	a		;will be 0 if none available
	jrnz	conin$ret	;return input character if non-zero...
	call	constat		;else poll console
	jr	conin0		;and loop back up...

	; orderly return to caller with input character:
conin$ret:
	lxi	h,conchar	;point to 1 character buffer
	mvi	m,0		;invalidate it
	pop	h		;restore registers
	pop	d
	pop	b
	ret			;with input character in [a]


	;;;;; Constat
	; check console for input status --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	[a] = 0 if no character available
	;			      255 if character is available
	;			      flags are set to reflect the above
	;
	;	registers:	[bc],[de],[hl] unaltered
	;
constat:
	; save register state:
	push	b
	push	d
	push	h

	; let BDOS do console status polling:
	mvi	c,DCONSTAT	;[c] = BDOS function #
	mvi	e,255		;[e] = status request flag
	call	BDOS		;execute status request...
	sta	conchar		;save character if 1 was gotten
	ora	a		;set flags on result
	jrz	const0
	mvi	a,TRUE		;[a] = TRUE if character gotten
const0:

	; restore register state:
	pop	h
	pop	d
	pop	b
	ret			;with results in [a] and flags


	;;;;; Mult$erase
	; erase multiple characters previously displayed on cursor line --
	;
	;	on entry:	[a] = # characters to erase
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all saved but [af]
	;
mult$erase:
	; save register state:
	push	b
	push	d
	push	h

	; setup...
	mov	b,a		;keep count in [b]

	; erase loop:
multelp:
	mvi	a,BACKSPACE	;1st a backspace
	call	conout
	mvi	a,' '		;then erase the character there
	call	conout
	mvi	a,BACKSPACE	;then bring the cursor back
	call	conout
	djnz	multelp		;loop for all characters to erase

	; restore registers:
	pop	h
	pop	d
	pop	b
	ret


	;;;;; Ucase
	; translate lower case to upper case --
	;
	;	on entry:	[a] = character to translate
	;
	;	on exit:	[a] = translated character
	;
	;	registers:	none destroyed
	;
ucase:	cpi	'a'		;must be >= lowercase a
	rc			; else go back...
	cpi	'z'+1		;must be <= lowercase z
	rnc			; else go back...
	sui	'a'-'A'		;subtract lowercase bias
	ret


	;;;;; Autoexec
	; process command line tail and autoexecute request --
	;
	;	on entry:	[a] = 1st command line tail character
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all altered
	;
autoexec:
	; get our command line parameter and parse:
	cpi	'H'		;help request ?
	jrnz	auto02		;no -- try next possibility...

	; here to display some help for the user:
	jmp	WBOOT		;just return for now...

	; here to parse other possible requests:
auto02:
	lbcd	FCB0		;get menu item letter to [b]
	cpi	'1'		;menu #1 request ?
	jrnz	auto03
	lxi	h,menu1tbl
	lxi	d,menu1
	mvi	c,MENU1MAX+1	;[c] = max. menu item on menu #1
	jr	auto10		;go to common code below...
auto03:	cpi	'2'		;menu #2 request ?
	jrnz	auto04		;no -- skip on down...
	lxi	h,menu2tbl	;point to menu 2 format table pointers
	lxi	d,menu2
	mvi	c,MENU2MAX+1	;[c] = max. menu item on menu #2
	jr	auto10		;go to common code below...
auto04:	cpi	'3'		;menu #3 request ?
	jrnz	auto05		;no -- skip on down...
	lxi	h,menu3tbl	;point to menu 3 format table pointers
	lxi	d,menu3
	mvi	c,MENU3MAX+1	;[c] = max. menu item on menu #3
	jr	auto10		;go to common code below...
auto05:
autoerr:
	lxi	d,cmderrmsg	;point to error message
	call	pbuff		;display it
	jmp	WBOOT		;and go back to CP/M...

	; here when we have correct menu #:
auto10:	mov	a,b		;get menu item to [a]
	cpi	' '		;end of command line options ?
	jrnz	auto11		;no -- skip next code then...

	; here to dispatch directly to specified menu:
	xchg			;get menu display code address to [hl]
	pchl			;go display the menu...

	; here to continue with command line parsing:
auto11:	cpi	'A'		;must be >= A
	jrc	autoerr		;if not go to error code...
	cmp	c		;must be <= max menu item
	jrnc	autoerr		;if greater then go to error code...
	sui	'A'		;subtract ascii bias
	mov	e,a		;make double precision in [de]
	mvi	d,0
	dad	d		;add to table base
	dad	d
	mov	e,m		;get our format block address to [de]
	inx	h
	mov	d,m
	push	d		;then to [ix]
	popix
	call	fmtdsk		;do disk formatting now
	call	clrscn		;blank the screen
	jmp	WBOOT


	;;;;; Fmtdsk
	; routine conducts the actual formatting of disks --
	;
	;	on entry:	[ix] = pointer to format block for
	;			       type of disk to be formatted
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all destroyed
	;
fmtdsk:
	; show user the format he/she has selected:
	call	dpyfmt

	; set up the single or double density master format table:
	bitx	DENBIT,DENSITY	;formatting single or double density ?
	lxiy	DDfmttbl	;assume double density
	jrnz	fmt000
	lxiy	SDfmttbl	;else switch to single density table
fmt000:	ldx	a,GAP3		;get length of gap 3
	sty	a,GP3OFF	;store it into master format table
	ldx	a,GAP4		;get length of gap 4
	sty	a,GP4OFF	;store it into master format table
	ldx	a,GAP4+1	; do the same for hi byte of gap 4
	sty	a,GP4OFF+1
	ldx	a,FMTCHR	;get format character
	sty	a,FMTOFF	;store into master format table
	ldx	e,SECSIZE	;get sector size encoding
	mvi	d,0
	lxi	h,sizetbl
	dad	d
	dad	d
	mov	c,m
	inx	h
	mov	b,m
	sty	e,BYTOFF	;store sector size encoding into master format
	sty	c,DATOFF	;store low byte of sector size
	sty	b,DATOFF+1	; then the hi byte

	; create track image in memory -- 1st that part of the track preceding
	; the 1st sector:
	lxi	h,trk$buffer	;point to where in memory we will build image
	mvi	b,5		;loop count
	call	bldfmt		;build partial format

	; create N sectors worth of track image:
	lxi	d,secids	;initialize sector id address table
	sded	secidptr
	ldx	b,SECTORS	;get # sectors to repeat loop for
seclp0:	pushiy			;save pointer to master format table
	push	b		;save sector repeat count
	mvi	b,3		;build next 3 fields
	call	bldfmt
	xchg			;save current memory pointer in [de]
	lhld	secidptr	;get address of next slot for sector id addr
	mov	m,e		;store current sector id pointer
	inx	h
	mov	m,d
	inx	h		;point to next slot for next time
	shld	secidptr
	xchg			;get back current memory pointer to [hl]
	mvi	b,9		;build next 9 fields
	call	bldfmt
	ldy	c,0		;get lo byte of sector size
	ldy	b,1		;then the hi byte of the sector size
	ldy	e,2		;then the format character to [e]
	inxiy			;update [iy]
	inxiy
	inxiy
	call	rptfmt		;get a sector worth of format characters
	mvi	b,2		;build next 2 fields
	call	bldfmt
	pop	b		;get back sector repeat count
	dcr	b		;sector count = sector count - 1
	jrz	seclp1		;out of loop if done...
	popiy			;restore original [iy]
	jr	seclp0		;and loop for more sector imaging
seclp1:	pop	d		;synch stack

	; at end pad track image with GAP 4:
	ldy	c,0		;get lo byte of GAP 4 size
	ldy	b,1		;get hi byte of GAP 4 size
	ldy	e,2		;then the character to pad with to [e]
	call	rptfmt		;build GAP 4

	; here we go -- our track image is built up and in memory -- now we
	; repeatedly format the required # of tracks adjusting the sector
	; id fields as we go:
	call	DCBlogin	;log in the required drive for formatting
	cc	dpy$error	;display error if login failure
	rc			;return if user wants to abort
	ldx	b,TRACKS	;get # tracks to format to [b]
fmtlp0:	call	constat		;user abort ?
	inr	a		;will = 0 if character available
	jrnz	fmtlp1
	call	conin		;purge break character
	lxi	d,brkmsg	;display break message
	call	pbuff
fmtlpbrk:
	call	conin		;get input character
	cpi	ESC		;user abort ?
	rz			;yes -- then skip out...
	cpi	CR		;CR to continue ?
	jrnz	fmtlpbrk	;loop for 1 option or the other
	mvi	a,BRKMLEN	;erase displayed break message
	call	mult$erase
fmtlp1:	push	b		;save loop count
	call	setid		;set up the sector id fields
	call	dpy$trkhd	;display current track # and head #
	call	DCBwtrk		;format track
	pop	b		;get back the loop count
	cc	dpy$error	;display formatting error
	rc			;return if user wishes to abort
	push	b		;save loop count once more
	lda	verflg		;are we verifying ?
	ora	a
	cnz	DCBrtrk		;verify formatted track
	pop	b		;get back loop count
	cc	dpy$error	;display verify error
	rc			;return if user wishes to abort
	djnz	fmtlp0		;loop for all tracks to format...

	; now we see if the particular format we just executed has special
	; circumstance code to be executed:
	ldx	a,AUXCODE	;get auxilliary code #
	mov	e,a		;keep copy in [e] in case
	mvi	d,0		;make it double precision
	inr	a		;will = 0 after increment if no auxilliary code
	rz			;no auxilliary code ? -- just return...
	push	d		;save index offset into jump table
	call	DCBrecalibrate	;restore drive head
	pop	d		;restore index offset
	cc	dpy$error	;display error if 1 occurred
	rc			;return if user aborted...
	lxi	h,jmptbl	;else point to special code dispatch addresses
	dad	d		;add in index offset
	dad	d
	mov	e,m		;get dispatch address to [de]
	inx	h
	mov	d,m
	xchg			;and then to [hl]
	pchl			;off to auxilliary code...


	;;;;; Setid
	; initialize the sector id fields of all sectors within the track
	; image in memory for the current track to format --
	;
	;	on entry:	[b] = tracks left to format
	;			[ix] = ptr to format block for format type
	;
	;	on exit:	no parameters returned
	;
	;	registers:
	;
setid:
	; get the track # and side # for current formatting:
	mov	a,b		;get tracks left to format
	neg			;negate it
	addx	TRACKS		;add total tracks / disk to get track #
	ora	a		;C=0
	bitx	1,ACTSIDES	;Z=0 if 1-sided disk
	jrz	setid0
	rar			;physical track = track / 2 if 2-sided
setid0:	mov	c,a		;[c] = physical track #
	mvi	a,0		;get side # to [a]
	ral
	sta	phyhead		;save physical head #
	ora	a		;side 0 ?
	jrz	stid00		;yes -- then skip next...
	ldx	a,HDSIDE2	;else get side 1 bit from format block
stid00:	mov	d,a		;keep side # in [d]

	; adjust N sectors within track image:
	ldx	b,SECTORS	;get # sectors to [b]
	ldx	l,SKEWPTR	;get skew table pointer to [hl]
	ldx	h,SKEWPTR+1
	shld	skwptr		;save in temporary variable
	lxi	h,secids	;point to start of sector id pointer table
setid1:	push	d
	mov	e,m		;get address of next sector id field
	inx	h
	mov	d,m
	inx	h		;update to next table pointer for next time
	push	d		;get sector id field address to [iy]
	popiy
	pop	d
	sty	c,0		;store track #
	sty	d,1		;then the head #
	push	h		;save pointer into sector id table
	lhld	skwptr		;get current skew table pointer
	mov	a,l		;do we have hard sector skew ?
	ora	h
	jrz	setid2		;no...
	mov	a,m		;yes -- get next sector # from table
	inx	h		;update skew table pointer
	shld	skwptr		;save for next time through
	jr	setid3
setid2:	mov	a,b		;get next sequential sector #
	neg
	addx	SECTORS		;gets sector # in range 0 - (n-1)
	addx	SECONE		;add in 1st sector bias
setid3:	lxi	h,phyhead	;side 1 format ?
	bit	0,m
	jrz	setid4		;no -- skip next...
	addx	ALTSEC		;add in sector continuation factor
setid4:	sty	a,2		;store sector # in sector id field
	pop	h		;recover pointer into sector id table
	djnz	setid1		;loop for all sector id fields to adjust...
	ret


	;;;;; Bldfmt
	; build a partial track image in memory from table pointed to by
	; [iy] --
	;
	;	on entry:	[b] = loop count
	;			[hl] = memory pointer
	;
	;	on exit:	no parameters returned
	;
	;	registers:
	;
bldfmt:
	push	b		;save loop count
	ldy	c,0		;get repeat count to [c]
	mvi	b,0		;make sure [b] = 0
	ldy	e,1		;get pattern to repeat to [e]
	call	rptfmt		;repeat format
	inxiy			;update index register
	inxiy
	pop	b		;get back loop count
	djnz	bldfmt
	ret


	;;;;; Rptfmt
	; repetitively deposit a pattern into memory --
	;
	;	on entry:	[e] = pattern to deposit
	;			[hl] = memory pointer
	;			[bc] = repetition count
	;
	;	on exit:	[bc] = 0
	;			[hl] = ptr to next memory location
	;			[e] = pattern
	;			[af] altered, [d] unaltered
	;
rptfmt:
	; check for end of loop:
	mov	a,c
	ora	b		; = 0 if done
	rz

	; not done -- deposit a pattern:
	mov	m,e		;(hl) = [e]
	inx	h		;point to next memory location
	dcx	b		;loop count = loop count - 1
	jr	rptfmt		;over and over...


	;;;;; Dpy$error
	; display disk formatting error message and give user an opportunity
	; to abort or continue --
	;
	;	on entry:	[a] = disk error code
	;
	;	on exit:	C=0 --> user wishes to ignore error
	;			C=1 --> user wants to abort the format op
	;
	;	registers:	all unaltered but [af]
	;
dpy$error:
	; save register state:
	push	b
	push	d
	push	h

	; display the appropriate error message:
	lxi	h,errmptrs	;point to base of pointer table
	mov	e,a		;get message # to [de]
	mvi	d,0
	dad	d		;get our particular message pointer
	dad	d
	mov	e,m
	inx	h
	mov	d,m		;got message address to [de]
	call	pbuff		;display it for user to see!

	; now wait for the user to choose their option:
	lxi	d,brk1msg	;display break message
	call	pbuff
dpye00:	call	conin		;get input character
	cpi	ESC		;user abort ?
	stc			;set carry in case it is
	jrz	dpye99		;yes -- then skip remaining...
	cpi	CR		;CR to continue ?
	jrnz	dpye00		;loop for 1 option or the other...
	call	dpyfmt		;continuing -- redisplay format screen
	ora	a		;C=0 for continuation return

	; restore register state:
dpye99:	pop	h
	pop	d
	pop	b
	ret


	;;;;; Dpyfmt
	; display screen show user the format chosen --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all altered
	;
dpyfmt:
	; display screen header message
	lxi	d,hdrmsg
	call	pbuff

	; set up format type message:
	lxi	b,0		;assume SDSS at first
	ldx	a,DENSITY	;get format density
	cpi	SDEN		;single density ?
	jrz	dpyf00		;yes -- skip next...
	inr	c		;bump it if double density
dpyf00:	ldx	a,ACTSIDES	;get # sides to format
	cpi	ONEHEAD		;single-sided disk ?
	jrz	dpyf01		;yes -- skip next...
	inr	c		;bump by two if double-sided
	inr	c
dpyf01:	lxi	h,SDSSmsg	;point to 1st disk type message
	dad	b		;add in offset to our specific type message
	dad	b
	dad	b
	dad	b
	dad	b
	dad	b
	dad	b		;7 bytes / message
	shld	typ0ptr		;store into message to display
	ldx	c,FMTTYP	;get this format type #
	lxi	h,typtbl	;point to table of pointers to particular
				; format type messages
	dad	b		;add in offset to our pointer
	dad	b
	mov	e,m
	inx	h		;get our format type message address
	mov	d,m
	xchg
	shld	typ1ptr		;store into message to display
	lxi	d,typmsg	;point to final message to display
	jmp	pbuff		;and do it...


	;;;;; Dpy$trkhd
	; display current track # and head # for format operation --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all altered
	;
dpy$trkhd:
	lhld	secids		;get current track # to [a]
	mov	a,m
	lxi	h,trknum	;deposit ascii decimal # here
	call	mbtod		;convert to ascii decimal
	lda	phyhead		;get current physical head #
	lxi	h,headnum	;deposit ascii decimal # here
	call	mbtod		;convert to ascii decimal in memory
	lxi	d,trkhdmsg	;now display
	jmp	pbuff


	;;;;; Mbtod
	; convert binary # in [a] to decimal # in memory --
	;
	;	on entry:	[a] = binary #
	;			[hl] = memory location to deposit decimal #
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all altered
	;
mbtod:	mvi	m,'0'		;assume 0 100's digit
	cpi	100		;< 100 ?
	jrc	mb00		;yes -- skip next...
	mvi	m,'1'		;else set to a 1 100's digit
mb00:	inx	h		;point to where 10's digit will go
	lxi	b,((10*256)+'0')
mb01:	sub	b		;[a] = [a] - 10
	jm	mb02		;if we had underflow we are done...
	inr	c		;else bump 10's digit
	jr	mb01		;loop until we have underflow
mb02:	adi	10+'0'		;convert 1's digit to ascii also
	mov	m,c		;deposit 10's digit
	inx	h
	mov	m,a		;then the 1's digit
	ret

;*									     *
;*****************************************************************************


;******************************************************************************
;*									      *
;*	Auxilliary code for IBM PC, CPM-86 disk initialization:		      *
;*									      *


	;;;;; CPM86$1
	; code to initialize IBM PC, CPM-86 single-sided disks:
	;
cpm86$1:
	; set up id byte for SS disks and fall through to init code:
	xra	a		;=0 for SS disks


cpminit:
	; initialize a sectors worth of bytes to the cpm formatting character:
	push	psw		;save id byte
	lxi	h,trk$buffer
	lxi	b,512
c0lp:	mvi	m,CPMFMT
	inx	h
	dcx	b
	mov	a,b
	ora	c
	jrnz	c0lp		;loop for all bytes to initialize...

	; for CPM-86 single-sided disks the last byte of the 1st sector
	; must be initialized:
	pop	psw		;recover id byte
	sta	trk$buffer+511	;ok -- fall through to sector write
				; routine...

	; set up physical parameters:
	lxi	h,trk$buffer	;point to transfer address
	shld	dmaadr		;set dma address to that
	mvi	a,1		;will be writing physical sector 1 on track 0
	sta	physec
	dcr	a		;so set up for head 0
	sta	phyhead
	sta	bytcnt		;=0 for transfer of 256 bytes each i/o
	mvi	a,2		;block i/o repeat factor (2 xfers of
	sta	rptxfer		; 256 bytes each)

	; now try actual sector write:
	call	DCBwrt
	rnc			;just return if everything hunky-dory...
	jmp	dpy$error	;else display error for user to see & return
				; to caller from error routine...


	;;;;; CPM86$2
	; initialize an IBM PC, CPM-86 DS disk:
	;
cpm86$2:
	; set up id byte for DS disks and go to code to initialize:
	mvi	a,1		;id byte = 1 for DS disks
	jmp	cpminit

;*									      *
;******************************************************************************


;******************************************************************************
;*									      *
;*	Auxilliary code for initializing IBM PC, MSDOS 1.1 & 2.x disks:	      *
;*									      *


	;;;;; MS11$1
	; initialize a SS MSDOS 1.1 disk:
	;
ms11$1:
	; build up track 0 sector images in memory:
	lxiy	ms11$1tbl	;point to image table
mscommon:
	lxi	h,trk$buffer	;and to place to deposit image
	push	h
	call	initfmt		;build it up in memory
	pop	h
	lxi	b,(1*256)+8	;[b] = 1 = 1st sector to write
				;[c] = 8 = last sector to write
	xra	a		;[a] = 0 = head to write to
				; fall through to routine to write multisectors


	;;;;; Mswrite
	; multisector write routine:
	;
	;	on entry:	[a] = head to write to
	;			[b] = 1st sector to write
	;			[c] = last sector to write to
	;			[hl] = initial dma address
	;
mswrite:
	; some initializations:
	sta	phyhead
	shld	dmaadr
	xra	a		;[a] = 0 = 256 bytes xferred in 1 block i/o
	sta	bytcnt
	inr	a
	inr	a		;[a] = 2 = # times to repeat block i/o
	sta	rptxfer

	; loop for writing:
mswlp:	push	b		;save start and end sectors
	mov	a,b		;get next sector to write
	sta	physec		;and store it for physical write routine
	call	DCBwrt		;try to write sector
	cc	dpy$error	;show user error if 1 occurred
	pop	b		;get back last and end sectors
	rc			;abort if user said to
	lhld	dmaadr		;get last dma address
	lxi	d,512		;sector size
	dad	d		;update to next dma address
	shld	dmaadr
	inr	b		;bump to next sector #
	mov	a,c		;get end sector
	sub	b		; - next sector
	jp	mswlp		;loop if more sectors to write...
	ora	a		;else C=0 for good return
	ret


	;;;;; MS11$2
	; initialize a DS MSDOS 1.1 disk:
	;
ms11$2:
	; point to table for this MSDOS format:
	lxiy	ms11$2tbl
	call	mscommon	;write 1st 8 sectors
	rc			;return if user abort!
	lxi	b,(1*256)+2	;[b] = 1 = start sector on 2nd side
				;[c] = 2 = end sector on 2nd side
	lhld	dmaadr		;get next dma address
	mvi	a,1		;now get set for write to 2nd side
	jmp	mswrite		;and go to multisector write routine...


	;;;;; MS2X$1
	; initialize a SS MSDOS 2.x disk:
	;
ms2x$1:
	; build up track 0 sector images in memory:
	lxiy	ms2x$1tbl	;point to image table
ms2common:
	lxi	h,trk$buffer	;and to place to deposit image
	push	h
	call	initfmt		;build it up in memory
	pop	h
	lxi	b,(1*256)+9	;[b] = 1 = 1st sector to write
				;[c] = 9 = last sector to write
	xra	a		;[a] = 0 = head to write to
	jmp	mswrite		;write track 0 sectors now...


	;;;;; MS2X$2
	; initialize a DS MSDOS 2.x disk:
	;
ms2x$2:
	; build up sector image in memory and write 0 track sectors
	lxiy	ms2x$2tbl	;point to image building table
	call	ms2common	;build image and write 1st 9 sectors
	rc			;return if user abort...

	; write 2nd side sectors:
	lxi	b,(1*256)+3	;[b] = 1 = start sector on 2nd side
				;[c] = 3 = end sector on 2nd side
	lhld	dmaadr		;get next dma address
	mvi	a,1		;now get set for write to 2nd side
	jmp	mswrite		;and go to multisector write routine...


	;;;;; Initfmt
	; build up a multiple byte image in memory from table pointed to by
	; [iy] --
	;
	;	on entry:	[iy] = pointer to image table
	;			[hl] = memory pointer
	;
	;	on exit:	no parameters returned
	;
	;	registers:
	;
initfmt:
	ldy	c,0		;get lo byte of repeat count to [c]
	ldy	b,1		;and the hi byte of repeat count to [b]
	inxiy
	inxiy			;point past repeat count to fill byte
	bit	7,b		;is this a macro invocation ?
	jrnz	initmacro	;yes -- go to code to handle that...

	; here to do simple non-macro image building:
	mov	a,c
	ora	b		;check for end of image table
	rz			;return if end of table...
	ldy	e,0		;get fill character to [e]
	call	rptfmt		;build image
	inxiy			;point to next repeat field
	jr	initfmt		;loop for all table entries...

	; here to do complex macro image building:
initmacro:
	res	7,b		;reset macro invocation bit
initf0:	pushiy			;save table starting macro point
	push	b		;save macro repeat count
initfa:	ldy	c,0		;get lo byte of repeat count to [c]
	ldy	b,1		;get hi byte of repeat count to [b]
	inxiy
	inxiy			;point past repeat count to fill byte
	mov	a,c
	ora	b		;check for end of macro
	jrnz	initf2

	; here for processing at end of macro:
	pop	b		;get back macro repeat count
	dcx	b		;drop it down 1
	mov	a,c
	ora	b		;done with macro loops ?
	jrz	initf1		;yes -- then skip next...
	popiy			;no -- get back of macro start point
	jr	initf0		;loop back up...
initf1:	pop	b		;throw away macro start address
	jmp	initfmt		;repeat from above...

	; here to do macro image building:
initf2:	ldy	e,0		;get fill character
	inxiy
	call	rptfmt		;build image
	jr	initfa		;loop back up...


	; table for MSDOS 1.1, SS, track 0 image:
ms11$1tbl:
	dw	512
	db	MSDOSFMT
	dw	8000h + 2
	dw	1
	db	0feh
	dw	2
	db	0ffh
	dw	470
	db	0
	dw	39
	db	MSDOSFMT
	dw	0
	dw	8000h + 64
	dw	1
	db	0e5h
	dw	31
	db	MSDOSFMT
	dw	0
	dw	512
	db	MSDOSFMT
	dw	0	;end of table


	; table for MSDOS 1.1, DS, 8 sector format:
ms11$2tbl:
	dw	512
	db	MSDOSFMT
	dw	8000h + 2
	dw	3
	db	0ffh
	dw	473
	db	0
	dw	36
	db	MSDOSFMT
	dw	0
	dw	8000h + (7 * 16)	;7 sectors for directory
	dw	1
	db	0e5h
	dw	31
	db	MSDOSFMT
	dw	0
	dw	0	;end of table

	; table for MSDOS 2.x, SS, 9 sector format:
ms2x$1tbl:
	dw	512
	db	MSDOSFMT
	dw	8000h + 2
	dw	1
	db	0fch
	dw	2
	db	0ffh
	dw	1021
	db	0
	dw	0
	dw	8000h + (4 * 16)	;4 sectors for directory
	dw	1
	db	0
	dw	31
	db	MSDOSFMT
	dw	0
	dw	0	;end of table

	; table for MSDOS 2.x, DS, 9 sector format:
ms2x$2tbl:
	dw	512
	db	MSDOSFMT
	dw	8000h + 2
	dw	1
	db	0fdh
	dw	2
	db	0ffh
	dw	1021
	db	0
	dw	0
	dw	8000h + (7 * 16)	;7 sectors for directory
	dw	1
	db	0
	dw	31
	db	MSDOSFMT
	dw	0
	dw	0	;end of table

;*									      *
;******************************************************************************


;******************************************************************************
;*									      *
;*	Primitive Disk Interface Routines:				      *
;*									      *

	;;;;; DCBlogin
	;
DCBlogin:
	; set up drive select bits:
	ldx	a,DISKSIZE	;get drive size select bit pattern
	cpi	SIZE5		;5" drive ?
	lbcd	step5rate	;assume it is -- set up...
	jrz	log00
	lbcd	step8rate	;else set up for 8" drive
log00:	ora	b		;add in relative drive select bits
	orx	DENSITY		;add in density selection bit
	sta	dselbits	;save as our drive select byte
	call	drvset		;set up in hardware also!
	mov	a,c		;set up default step rate also
	sta	steprate

	; set up transfer parameters:
	lda	dselbits	;get select byte
	bit	1,a		;8" drive ?
	jrz	log01		;no -- skip next...
	bit	DENBIT,a	;double density ?
	mvi	a,(DD8BYTES/256)+1	;assume so
	jrnz	log02
	mvi	a,(SD8BYTES/256)+1	;else set up for SD # bytes
	jr	log02
log01:	bit	DENBIT,a	;double density ?
	mvi	a,(DD5BYTES/256)+1	;assume so
	jrnz	log02
	mvi	a,(SD5BYTES/256)+1	;else set up for SD # bytes
log02:	sta	rptxfer		;store transfer repetition factor

	; make sure drive is ready and not write-protected:
	call	DCBstatus	;get drive status
	bit	WRTPROT,a	;test write-protect bit
	stc			;C=1 in case of error
	mvi	a,0		;return error code in case write-protected
	rnz
	call	DCBstatus	;get drive status again
	bit	DRVRDY,a	;drive should also be in ready condition
	stc			;C=1 in case of error
	mvi	a,1		;return error code in case not ready
	rnz

	; home the drive:
	jmp	DCBrecalibrate	;return with error status...


	;;;;; Drvset
	; output the hardware select byte to the Versafloppy select port --
	;
	;	on entry:	[dselbits] = current drive select bits
	;
	;	on exit:	no parameters returned
	;
	;	registers:	[af] altered, others unaltered
	;
drvset:
	lda	dselbits	;get current drive select byte
	cma			;invert for hardware
	out	VFL$select	;send to the Versafloppy select port
	ret			;that's it...


	;;;;; DCBstatus
	; get Type I status byte from WD179X --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	[a] = Type I status byte
	;
	;	registers:	all unaltered but [af]
	;
DCBstatus:
	mvi	a,FRCINT	;send out force interrupt command
	out	VFL$command
	mvi	a,0FFH	;;;;;0		;delay constant
DCBst0:	dcr	a		;delay till status is settled
	jrnz	DCBst0
	in	VFL$status	;get the status byte
	ret


	;;;;; DCBrecalibrate
	; routine to bring the head of the specified drive to track 000 --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	C = 1 --> unsuccessful restore to track 00
	;			C = 0 --> restore successful
	;
	;	registers:	all altered
	;
DCBrecalibrate:
	; set up retry counter:
	lxi	h,rrcount	;point to restore retry counter
	mvi	m,SEEKRETRY	;initialize to # of restore retries allowed

	; attempt to restore the drive:
recalp:	mvi	a,RECAL$179X	;[a] = WD179X recalibrate opcode
	lxi	h,steprate	;point to current step rate
	ora	m		;and set command up for that steping rate
	call	StartDCB	;start restore operation
	mvi	b,SEEKDLY	;delay for status bits to settle
recal0:	djnz	recal0
	call	WaitDCB		;wait for command completion
	bit	TRK00,a		;are we at track 0 ?
	jrz	recal$err	;skip success code if errors...

	; here on successful restore to track 00:
	xra	a		;C=0 for good return
	sta	curcyl		;set up current cylinder byte
	ret			;go back with C=0...

	; arrive here on recalibrate error:
recal$err:
	lxi	h,rrcount	;point to restore retry counter
	dcr	m		;retries = retries - 1
	jrnz	recalp		;retry if more available...
	mvi	a,-1		;invalidate current cylinder
	sta	curcyl
	stc			;set C=1 for error return
	mvi	a,2		;error code if recalibrate error
	ret			;go back...


	;;;;; DCBseek
	; seek to specified track on the current drive --
	;
	;	on entry:	[[secids]] = cylinder to seek to
	;
	;	on exit:	C = 1 --> unsuccessful seek
	;			C = 0 --> successful seek operation
	;
	;	registers:	all altered
	;
DCBseek:
	; set up retry count before we seek:
	lxi	h,srcount	;point to counter byte
	mvi	m,SEEKRETRY	;and initialize it

	; attempt to seek to requested cylinder:
seeklp:	lda	curcyl		;get drive current cylinder
	cpi	-1		;need to recalibrate ?
	jrnz	seek00		;no -- then skip next...
	call	DCBrecalibrate	;else try to recalibrate drive
	rc			;return if restore error...
seek00:	out	VFL$track	;tell WD179X current track position
	lhld	secids		;get requested track
	cmp	m		;are we already there ?
	rz			;yes -- then return with no physical seek...
	mov	a,m		;to [a]
	out	VFL$data	;tell WD179X of requested cylinder
	mvi	a,SKNV$179X	;[a] = seek command opcode
	lxi	h,steprate	;combine with current step rate
	ora	m
	call	StartDCB	;start seek operation
	mvi	b,SEEKDLY	;delay for status bits to settle after command
skdly:	djnz	skdly
	call	WaitDCB		;wait for seek completion
	ani	SKERMSK		;any errors ?
	jrnz	seek$err	;yes -- skip success code...

	; here if seek command executed correctly -- verify track seeked to
	; with requested track:
	in	VFL$track	;get cylinder seeked to
	sta	curcyl		;update current cylinder byte
	mov	b,a		;keep in [b]
	lhld	secids		;get cylinder requested
	mov	a,m
	cmp	b		;the same ?
	rz			;yes -- return with C=0...
				;else fall through to seek error code...

	; arrive here on seek errors:
seek$err:
	mvi	a,-1		;invalidate current cylinder byte
	sta	curcyl
	lxi	h,srcount	;point to retry counter
	dcr	m		;retries = retries - 1
	jrnz	seeklp		;try again if more retries available...

	; arrive here on hard seek error:
seek01:
	stc			;set C=1 for error return
	mvi	a,3		;error code if seek error
	ret			;go back...


	;;;;; DCBwtrk
	; write track and format it --
	;
DCBwtrk:
	; set up retry counter:
	lxi	h,rwrcount	;point to retry counter
	mvi	m,RWRETRY	;initialize to # retries

wtrk$retry:
	; seek to required cylinder:
	call	DCBseek
	rc			;return if hard seek error

	; make sure always side 0 to begin with:
	lxi	h,dselbits	;point to current select byte
	res	4,m		;reset side bit

	; set up side bit:
	mvi	b,WRTRK$179X	;[b] = write track opcode
	lxi	h,phyhead	;are we writing to side 1 ?
	bit	0,m		;Z=0 if we are
	jrz	wtrk01
	lda	dselbits	;get select bits
	setb	SIDBIT,a	;set side 1 bit
	sta	dselbits
	if	WD1795
	setb	1,b		;set side bit in command too if WD1795
	endif
wtrk01:	call	drvset		;do drive selection once again

	; set up registers for transfer:
	lxi	h,trk$buffer	;point to initial transfer address
	lda	rptxfer		;get block i/o repeat count
	mov	d,a		;save in [d]
	mov	a,b		;get command to [a]
	lxi	b,(0*256)+VFL$data	;[b] = 256 bytes to transfer at a shot
					;[c] = Versafloppy data port

	; conduct actual write track operation now:
	call	waitenable	;enable Versafloppy wait state generator
	out	VFL$command	;start command
wtrklp:
	outir			;block output 256 bytes
	dcr	d		;more block i/o's ?
	jrnz	wtrklp		;yes -- loop back up...
	call	WaitDCB		;get status byte at end
	call	waitdisable	;disable Versafloppy wait state generator
	ani	WRTERMSK	;any errors ?
	rz			;no -- go back with C=0...

	; here when disk i/o error:
	mvi	a,-1		;invalidate current cylinder
	sta	curcyl
	lxi	h,rwrcount	;point to retry counter
	dcr	m		;retries = retries - 1
	jrnz	wtrk$retry	;if more available loop back up...
	stc			;C=1 for hard error
	mvi	a,4		;error code if format track error
	ret


	;;;;; DCBrtrk
	; read all sectors on current track --
	;
DCBrtrk:
	; set up retry counter:
	lxi	h,rwrcount	;point to retry counter
	mvi	m,RWRETRY	;initialize to # retries

rtrk$retry:
	; set up sector register of WD179X:
	lhld	secids		;get 1st sector id field address
	inx	h		;point to sector # field
	inx	h
	mov	a,m		;get 1st sector # to [a]
	out	VFL$sector	;initialize sector register of WD179X

	; set up side bit:
	mvi	b,RTRK$179X	;[b] = read track opcode
	lxi	h,phyhead	;are we writing to side 1 ?
	bit	0,m		;Z=0 if we are
	jrz	rtrk01
	bitx	0,HDSIDE2	;was 2nd side given a side # of 1 or 0 ?
	jrz	rtrk01
	if	WD1795
	setb	1,b		;set side bit in command too if WD1795
	else
	setb	3,b		;set side bit in command
	setb	1,b		;enable side compare
	endif
rtrk01:

	; set up registers for transfer:
	lxi	h,trk$buffer+16384	;initial transfer address
	lda	rptxfer		;get block i/o repeat count
	mov	d,a		;save in [d]
	mov	a,b		;get command to [a]
	lxi	b,(0*256)+VFL$data	;[b] = 256 bytes to transfer at a shot
					;[c] = Versafloppy data port

	; conduct actual read track operation now:
	call	waitenable	;enable Versafloppy wait state generator
	out	VFL$command	;start command
rtrklp:
	inir			;block input 256 bytes
	dcr	d		;more block i/o's ?
	jrnz	rtrklp		;yes -- loop back up...
	call	WaitDCB		;get status byte at end
	call	waitdisable	;disable Versafloppy wait state generator
	ani	RDERMSK		;any errors ?
	rz			;no -- go back with C=0...

	; here when disk i/o error:
	lxi	h,rwrcount	;point to retry counter
	dcr	m		;retries = retries - 1
	jrnz	rtrk$retry	;if more available loop back up...
	stc			;C=1 for hard error
	mvi	a,5		;error code if verify track error
	ret


	;;;;; DCBwrt
	; write sector routine:
	;
DCBwrt:
	; set up retry counter:
	lxi	h,rwrcount	;point to retry counter
	mvi	m,RWRETRY	;initialize to # retries

wrt$retry:
	; make sure always side 0 to begin with:
	lxi	h,dselbits	;point to current select byte
	res	4,m		;reset side bit

	; set up side bit:
	mvi	b,WRT$179X	;[b] = write sector opcode
	lxi	h,phyhead	;are we writing to side 1 ?
	bit	0,m		;Z=0 if we are
	jrz	wrt01
	lda	dselbits	;get select bits
	setb	SIDBIT,a	;set side 1 bit
	sta	dselbits
	if	WD1795
	setb	1,b		;set side bit in command too if WD1795
	else
	setb	3,b		;else ditto for the WD1791-4 series
	endif
wrt01:	call	drvset		;do drive selection once again

	; tell WD179X chip of sector to be written:
	lda	physec		;get physical sector #
	out	VFL$sector	;and pass it on to the chip

	; set up registers for transfer:
	lhld	dmaadr		;get current transfer address
	lda	rptxfer		;get block i/o repeat count
	mov	d,a		;save in [d]
	lda	bytcnt		;get block i/o byte count
	mov	e,a		;keep in [e]
	mov	a,b		;get command to [a]
	mvi	c,VFL$data	;[c] = Versafloppy data port

	; conduct actual write sector operation now:
	call	waitenable	;enable Versafloppy wait state generator
	out	VFL$command	;start command
wrtlp:
	mov	b,e		;refresh byte i/o count from [e]
	outir			;block output n bytes
	dcr	d		;more block i/o's ?
	jrnz	wrtlp		;yes -- loop back up...
	call	WaitDCB		;get status byte at end
	call	waitdisable	;disable Versafloppy wait state generator
	ani	WRERMSK		;any errors ?
	rz			;no -- go back with C=0...

	; here when disk i/o error:
	mvi	a,-1		;invalidate current cylinder
	sta	curcyl
	lxi	h,rwrcount	;point to retry counter
	dcr	m		;retries = retries - 1
	jrnz	wrt$retry	;if more available loop back up...
	stc			;C=1 for hard error
	mvi	a,6		;error code if write sector error
	ret


	;;;;; StartDCB
	; load the WD179X with a command to be executed --
	;
	;	on entry:	[a] = opcode to be sent to WD179X
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all unaltered
	;
StartDCB:
	; wait for WD179X readiness to accept a command:
	push	psw		;save opcode to be sent out
	call	WaitDCB		;wait for chip ready to load command byte
	pop	psw		;get back command to send out

	; then send the the chip its next command:
	out	VFL$command	;send it to the WD179X
	ret



	;;;;; WaitDCB
	; wait for command completion and return status byte --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	[a] = error status byte
	;
	;	registers:	all unaltered but [af]
	;
WaitDCB:
				; wait for the WD179X to go into the non-busy state:
	push	b
	lxi	b,0		;load timeout delay count
waitlp:	in	VFL$status	;get the main status
	bit	WDBUSY,a	;test busy bit
	jrz	waitdone	;skip out if now unbusy...
	dcx	b		;else drop timeout count
	mov	a,c		;and check for timeout
	ora	b
	jrnz	waitlp		;loop until timed out or unbusy...

	; arrive here on controller hang-up condition:
	in	VFL$select	;get current select byte
	push	psw		;save for later restoral
	out	VFL$reset	;reset controller
	mvi	b,80		;assert reset for goodly time
rstlp:	djnz	rstlp
	in	VFL$reset	;remove reset condition
	pop	psw		;restore previous select byte
	out	VFL$select
	call	DCBstatus	;issue force interrupt command to terminate
				; auto-recalibrate
	pop	b		;sync stack
	mvi	a,0feh		;return an obvious error code
	ret

	; come here on normal wait till unbusy:
waitdone:
	pop	b		;sync stack
	ret			;go back with status in [a]


	;;;;; Wait$enable
	; enable Versafloppy wait state generator to allow r/w transfers --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all unaltered
	;
wait$enable:
	push	psw		;save [af]
	in	VFL$select	;get current select byte
	ani	7fh		;reset bit to enable wait states
	di			;no funny business after this!!
	out	VFL$select	;send back to select register
	pop	psw		;recover [af]
	ret


	;;;;; Wait$disable
	; disable Versafloppy wait state generator --
	;
	;	on entry:	no entry parameters
	;
	;	on exit:	no parameters returned
	;
	;	registers:	all unaltered
	;
wait$disable:
	push	psw		;save [af]
	in	VFL$select	;get current select byte
	ori	80h		;set bit to disable wait states
	out	VFL$select	;send back to select register
	ei			;end of critical area!!
	pop	psw		;recover [af]
	ret

