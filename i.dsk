   180  0100  ED73ED2E         	LD     	(SP_SAVE),SP
   181  0104  310330           	LD     	SP,STACK
   182  0107  C32501           	JP     	START
   183                  ;------------------------------------------------------
   184                  ;      	       	HARDWARE DEPENDENT STUFF
   185                  ; LINKS TO ROM BIOS at 0F000H (The only Monitor linkage
   186                  ; The only other hardware links are through the Versafl
   187                  ; Remember to make sure it is set to the correct 179x b
   188                  ;
   189                  ; If you have a video board that can use a single chara
   190                  ;
   191  010A  DB00      CONST: 	IN     	A,(0)  	       	;console status for SD 
   192  010C  E602             	AND    	A,02H  	       	;anything there
   193  010E  C8               	RET    	Z      	       	;return 0 if nothing
   194  010F  AF               	XOR    	A,A
   195  0110  3D               	DEC    	A      	       	;return NZ, & 0FFH in A
   196  0111  C9               	RET
   197                  ;
   198  0112  DB00      CI:    	IN     	A,(0)  	       	;console input
   199  0114  E602             	AND    	A,02H
   200  0116  28FA             	JR     	Z,CI
   201  0118  DB01             	IN     	A,(1)  	       	;return with character 
   202  011A  C9               	RET
   203                  ;      	       	
   204  011B  DB00      CO:    	IN     	A,(0)  	       	;console output (arrive
   205  011D  E604             	AND    	A,04H  	       	;Note character is in C
   206  011F  28FA             	JR     	Z,CO
