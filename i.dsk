  3850  1A3A  CDD41A           	CALL   	PACC   	       	;Print out HEX values o
  3851  1A3D  23               	INC    	HL     	       	
  3852  1A3E  1B               	DEC    	DE     	       	;Decrease DE count by 1
  3853  1A3F  7B               	LD     	A,E
