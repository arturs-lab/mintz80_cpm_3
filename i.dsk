  3983  1ADB  C8               	RET    	Z      	
  3984  1ADC  CD1201    CHECK1:	CALL   	CI
  3985  1ADF  FE1B             	CP     	A,ESC  	       	;ESC to abort
  3986  1AE1  2806             	JR     	Z,CABORT
  3987  1AE3  FE20             	CP     	A,' '  	       	;If spacebar then freez
  3988  1AE5  28F5             	JR     	Z,CHECK1
  3989  1AE7  AF               	XOR    	A,A
  3990  1AE8  C9               	RET
  3991  1AE9  AF        CABORT:	XOR    	A,A    	       	;Was ESC, so return wit
  3992  1AEA  3D               	DEC    	A      	       	;return NZ, & 0FFH in A
  3993  1AEB  C9               	RET
