(`P‰Nеv␀т85", DDSS, 512 byte, 10 sector TRS-80 MOD-III format␀	
␀␀␀␀.
;
;	EXCHANGE DESCRIPTORS
;
XCH$TBL:
N	DL	0
CMDXCH	ED			;COMMAND EXCHANGE
STSXCH	ED			;STATUS EXCHANGE
TOXCH	ED			;TO DATA PATH EXCHANGE
FRMXCH	ED			;FROM DATA PATH EXCHANGE
LOGXCH	ED			;LOG DELAY EXCHANGE
TRMDON	ED			;TERMINAL DELAY EXCHANGE
BSCSND	ED			;BISYNC SEND EXCHANGE
BSCRET	ED			;BISYNC RETURN EXCHANGE
PRTEVT	ED			;PROTOCOL EVENT EXCHANGE
DSRDLY	ED			;DSR DELAY EXCHANGE
CLSXCH	ED			;CLOSE COMPLETED EXCHANGE
FLSHRT:	ED			;XLOG FLUSH RETURN EXCHANGE
ACKXCH:	ED			;ACK WAIT FOR SLOW DISK
NUM$XCH:EQU	N		;NUMBER OF E.D.
TAB$LNG:EQU	$-TBL$VCT-1	;TABLE LENGTH-1
	FORM
;
;	STACK AREA
;
	ENTRY	RTXSTK
	DS	060H		;RTX STACK
RTXSTK:	DW	0
RTX$STK:
STK$BOT:DS	NSTK		;RESERVE TASK STACK STORAGE
;
;
	END
BRLP:	CALL	KBRD		;NOW TRY A READ
	MOV	A,E		;SET KEY TO ACR
;****
;****
	CPI	VX1-1+TRPKEY
	CZ	01EH
	JRZ	KBRLP		;SKIP SEND
;****
;****
;
	CALL	DOKEY
	CALL	DSP$CE		;SHOW CURSOR
	JMPR	KBRLP		;GO WAIT FOR NEXT CHAR
;
CTLLCK	=	7		;0111XXXXB LOCK KEY
CTLCYC	=	6		;1011XXXXB CYCLE KEY
CTLSFT	=	5		;1101XXXXB SHIFT KEY
CTLALH	=	4		;1110XXXXB ALPHA LOCK KEY
;
;
;	 CHECK FOR RESET KEY CONDITION
;
DOKEY:	CPI	VRESET		;JUMP IF RESET KEY
	JRZ	KRESET
	CPI	080H		;TEST IF CONTROL REQ LEGAL
	JRNC	KBENT0		;NO
	CPI	040H		;TEST IF CONTROL REQ LEGAL
	JRC	KBENT0		;NO
;
;	NOW CHECK IF CTL KEY ACTIVE
;
	BIT	CTLCYC,D	;TEST IF CNTRL KEY DOWN
	JRNZ	KBENT0		;NO, SKIP IF NOT FLAGGED
	ANI	01FH		;SAVE LOW BITS ONLY
	MOV	E,A		;CHANGE TO NEW VALUE
	JMP	KWRIT		;OUTPUT CNTL KEY
;
;	 RESET KEY PROCESSOR
;	  -----------------
;
KRESET: CALL	PBRESET 	;RESET PRINTER (IF ACTIVE)
	MVI	A,0		;CLEAR TABLE ENTRIES ...
	MOV	KLITE(X),A	;CLEAR ALL LUT LITES
	RET			;DONE
;
	.PAGE
;
;
;	SET FOR REPEAT KEYS FIRST
;
KBENT0: LDA	KYACTV		;GET CODE OF KEY ACTIVE
	LXI	H,KYRPT 	;GET ADDR OF REPEAT CHAR BYTE
	MOV	M,A		;ALLOW REPEATS ON THE KEY             65656B2C
