 12BB 5C10      		DW	TYP15
 12BD 7610      		DW	TYP16
 12BF 9310      		DW	TYP17
 12C1 A410      		DW	TYP18
 12C3 BD10      		DW	TYP19
 12C5 DC10      		DW	TYP20
 12C7 F110      		DW	TYP21
 12C9 0111      		DW	TYP22
 12CB 1011      		DW	TYP23
 12CD 2E11      		DW	TYP24
 12CF 3A11      		DW	TYP25
 12D1 4A11      		DW	TYP26
 12D3 6D11      		DW	TYP27
 12D5 7D11      		DW	TYP28
 12D7 9811      		DW	TYP29
 12D9 A711      		DW	TYP30
 12DB BA11      		DW	TYP31
 12DD C811      		DW	TYP32
 12DF DA11      		DW	TYP33
 12E1 E811      		DW	TYP34
 12E3 FA11      		DW	TYP35
 12E5 0B12      		DW	TYP36
 12E7 1E12      		DW	TYP37
 12E9 3012      		DW	TYP38
 12EB 3E12      		DW	TYP39
 12ED 5012      		DW	TYP40
 12EF 6B12      		DW	TYP41
 12F1 7D12      		DW	TYP42
                
                
                	; TABLE OF ADDRESSES TO JUMP TO FOR AUXILLIARY CODE FOR FORMATTING:
 12F3 F404      JMPTBL:		DW	CPM86$1		;IBM PC, CPM-86, SS
 12F5 2B05      		DW	MS11$1		;MSDOS 1.1, SS
 12F7 7C05      		DW	MS2X$1		;MSDOS 2.X, SS
 12F9 2605      		DW	CPM86$2		;IBM PC, CPM-86, DS
 12FB 6905      		DW	MS11$2		;MSDOS 1.1, DS
 12FD 8F05      		DW	MS2X$2		;MSDOS 2.X, DS
                
                
                	; SECTOR BYTES TABLE:
 12FF 8000      SIZETBL:	DW	128
 1301 0001      		DW	256
 1303 0002      		DW	512
 1305 0004      		DW	1024
                
                
                	; SINGLE DENSITY FORMAT MASTER TABLE:
                SDFMTTBL:
                	; START OF TRACK:
 1307 28FF      	DB	40,0FFH		;40 FF'S
 1309 0600      	DB	6,0		;6 0'S
 130B 00F6      	DB	0,0F6H		;0 F6'S
 130D 01FC      	DB	1,0FCH		;1 FC
 130F 1AFF      	DB	26,0FFH		;26 FF'S
                
                	; SECTOR IMAGE:
 1311 0600      	DB	6,0		;6 0'S
 1313 00F5      	DB	0,0F5H		;0 F5'S
 1315 01FE      	DB	1,0FEH		;1 FE
 1317 0100      SDTRK:	DB	1,0		;1 BYTE FOR TRACK #
 1319 0100      SDHEAD:	DB	1,0		;1 BYTE FOR HEAD #
 131B 0100      SDSECT:	DB	1,0		;1 BYTE FOR SECTOR #
 131D 0100      SDBYTE:	DB	1,0		;1 BYTE FOR SECTOR BYTES
 131F 01F7      	DB	1,0F7H		;1 F7
 1321 0BFF      	DB	11,0FFH		;11 FF'S
 1323 0600      	DB	6,0		;6 0'S
 1325 00F5      	DB	0,0F5H		;0 F5'S
 1327 01FB      	DB	1,0	TITLE	'I.C.M. Loader for MP/M II of 11-02-82'
;
;NOTE: -- This file must be assembled using MAC from Digital Research.
;
TRUE	EQU	0FFFFH			;define true
FALSE	EQU	00000H			;define false
;
;"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
;     this is the area you change for your situation
;"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
;
ZMODE2	EQU	FALSE	;true if using mode 2 intrps
DRVSRAT	EQU	0	;0=3ms,1=6ms,2=15ms,3=20ms(stp rate).
HLABSK	EQU	8	;8=head load at beginning of seek.
ERRCNT	EQU	10	;error retry count.
XIOBASE	EQU	10H	;base address of external i/o board
;
;"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
;	
IOBASE	EQU	80H	;default CPZ-48000 i/o base address
	MACLIB	Z80	;use z80 macro library
	MACLIB	IOEQU	;use cpz-48000 i/o library
;
CR	EQU	0DH
LF	EQU	0AH
;
FLPYRD	EQU	10000000B	;floppy read command
FLPYWT	EQU	10100000B	;floppy write command
FLPYID	EQU	11000000B	;read id command
BLK128	EQU	128		;sgl / dbl den. sect size
BLK512	EQU	512		;deblock sector size
;
;cp/m to host disk constants
;
BLKSIZ	EQU	2048		;cp/m allocation size
HSTSIZ	EQU	512		;host disk sector size
HSTSPT	EQU	16		;host disk sectors/trk
HSTBLK	EQU	HSTSIZ/128	;cp/m sects/host buff
CPMSPT	EQU	HSTBLK * HSTSPT	;cp/m sectors/track
SECMSK	EQU	HSTBLK-1	;sector mask
;
;bdos constants on entry to write
;
WRDIR	EQU	1		;write to directory
WRUAL	EQU	2		;write to unallocated
;
;define external console init constants
;
CCOM1	EQU	XIOBASE+1	;port 1 init equate
CCOM2	EQU	XIOBASE+3	;port 2 init equate
CCOM3	EQU	XIOBASE+5	;port 3 init equate
CCOM4	EQU	XIOBASE+7	;port 4 init equate
;
;start of loader bios
;
	ORG	1700H		;origin of this program
;
;jump vector for individual subroutines
;
	JMP	BOOT		;cold start
	JMP	WBOOT		;warm start
	JMP	CONST		;console status
	JMP	CONIN		;console character in
	JMP	CONOUT		;console character out
	JMP	LIST		;list character out
	JMP	PUNCH		;punch character out
	JMP	READER		;reader character out
	JMP	HOME		;move head to home
	JMP	SELDSK		;select disk
	JMP	SETTRK		;set track number
	JMP	SETSEC		;set sector number
	JMP	SETDMA		;set dma address
	JMP	READ		;read disk
	JMP	WRITE		;write disk
	JMP	LISTST		;return list status
	JMP	SECTRA		;sector translate
;
;	double density disk parameter block
;
DPBLK3:	DW	64		;sectors per track
	DB	4		;block shift factor
	DB	15		;block mask
	DB	0		;null mask
	DW	299		;disk size-1
	DW	127		;directory max
	DB	192		;alloc 0
	DB	0		;alloc 1
	DW	32		;check size
	DW	2		;track offset
;
;defines a double density / double side 512 x 16
;
DPBLK4:	DW	64
	DB	5
	DB	31
	DB	1
	DW	303
	DW	255
	DB	192
	DB	0
	DW	64
	DW	2
;
;	end of fixed tables
;
	IF	ZMODE2
	ORG	($+1) AND 0FFFEH	;force even boundry
;
;the following table is for mode 2 pointers
;
INTVEC:	DW	DSKINT
;
;disk interrupt handler routine
;
DSKINT:	IN	DSTAT		;get disk status and clr intrp
	EI			;enable intrps again
	RET			; and return it to caller
	ENDIF
;
;	disk parameter header for disk 00
;
DPBAS1:	DW	0000H,0000H
	DW	0000H,0000H
	DW	DIRBUF,DPBLK3
	DW	CHK00,ALL00
;
;print message until zero terminator
;
PRNTM:	MOV	C,M		;get a byte
	RES	7,C		;kill parity bit
	CALL	CONOUT		; on crt
	BIT	7,M		;terminator?
	RNZ			;return if yes
	INX	H
	JMPR	PRNTM		;loop till done.
;
;dma read / write routine
;
DMA:	MVI	A,0D0H		;force intrp cmnd (1793)
	OUT	DCOM		;send command
	LDA	DCMND		;get the command
	OUT	CMND		;tell dma chip
	LDA	DMODE		;get the mode
	OUT	MODE
	OUTP	E		;reg c = wct2
	OUTP	D		;length count-1
	DCR	C		;reg c = adr2 
	OUTP	L
	OUTP	H		;address for dma set up
	INX	D		;adjust length counter + 1
	DAD	D		;adjust hl = (hl + de)
	MVI	A,CLRREQ+CHAN2	;request chan 2
	OUT	FMASK		;allow this channel to request
;
;check for head load bit on in 1793
;
	IN	DSTAT		;get status from 1793
	BIT	5,A		;check head load bit
	MVI	A,4		;get head load set bit
	JRZ	HDLDED
	XRA	A		;get a zero
HDLDED:	ORA	B		;add in command for floppy
	OUT	DCOM		;send it to floppy
;
;general purpose wait routine
;
	IF	ZMODE2
IDLE:	HLT			;wait for disk to intrp
	RET			;return to caller

	ELSE

SLOOP:	IN	INTCMD
	RLC
	JRC	SLOOP
	MVI	A,40H
	OUT	INTCMD
	IN	DSTAT
	RET
	ENDIF
;
;warm boot
;
BOOT:
WBOOT:
CONIN:
LIST:
PUNCH:
READER:
LISTST:
WRITE:
WRITEHST:
	XRA	A		;empty return code
	RET
;
CONST:	IN	STATB		;console status
	BIT	CKBR,A		;check data ready
	MVI	A,0		;return it is ready
	RZ
	CMA			;ff = not ready
	RET
;
CONOUT:	IN	STATB		;check output status
	BIT	CPTR,A		;mask
	JRZ	CONOUT		;loop till not busy
	MOV	A,C		;get cpm character
	OUT	DATAB		;send to console
	RET
;
; translate the sector given by bc using the
; translate table given by de
;
SECTRA:	MOV	L,C		;double density part
	MOV	H,B
	RET
;
;home - move to track 0
;
HOME:	LXI	B,0		;restore
;
;settrk - select track 0 - 76
;
SETTRK:	SBCD	SEKTRK
	RET
;
;first time access byte 0 = first time
;
FIRST:	DB	0
;
;seldsk
;always done prior to settrk,setsec
;
SELDSK:	EXX			;save drive select
	LDA	FIRST		;first time here?
	ORA	A		;0=yes
	CZ	INIT		;call init if yes
	EXX			;recover drive select
	MOV	A,C
	LXI	H,0
	CPI	1		;only 1 drive for booting
	RNC			;return if not in range
	STA	SEKDSK		;system disk select save
	LXI	H,LOGBYT	;point to disk log vector
	MOV	A,M		;get format
	STA	DISKHF		;save it for system reference
	INX	H		;get disk pointer address
	ORA	A		;logged on?
	MOV	A,M
	STA	DISKHS		;store selected disk wait port
	JNZ	LOGGED
	PUSH	H		;save disk pointer address
	OUT	DCONT		;at single density
	CALL	RDYDRV		;check for drive ready
	LDA	USRSTP
	ORI	HLABSK+1	;get headload command
;
	IF	ZMODE2
	OUT	DCOM		;send command
	HLT 			;wait till done
	ELSE
	CALL	EXECC1
	ENDIF
;
	MVI	A,1
	OUT	SECTP		;address sector 1
	LXI	H,DIRBUF
	CALL	READLS		;read a logical sector
	LDA	DIRBUF+7EH
;
	CPI	0DEH		;double density 16 secs of 512?
	JRZ	DD64
;
DD642:	LXI	H,3 SHL 8 OR 48H
	LXI	D,DPBLK4
	JMPR	PUT1
;
DD64:	LXI	H,3 SHL 8 OR 8H	; 64 logical secs (16 by 512)
	LXI	D,DPBLK3
PUT1:	LXI	B,0
PUT:	MOV	A,L		;disk density mask
	XTHL			; pointer to disk hardware
	ORA	M		;add in density mask
	MOV	M,A		;and save
	STA	DISKHS		; (value for selected disk)
	DCX	H		;back up to format address
	XTHL
	MOV	A,H		;format type
	POP	H
	MOV	M,A		;save type (0, 1, 2, 3)
	STA	DISKHF
	PUSH	B
	LDA	SEKDSK		;fix up dpbase tables
	ADD	A
	ADD	A
	ADD	A
	ADD	A	
	MOV	C,A
	MVI	B,0
	LXI	H,DPBAS1	; reference table for this disk
	DAD	B
	POP	B
	MOV	M,C		;copy translate table address
	INX	H
	MOV	M,B
	LXI	B,9
	DAD	B
	MOV	M,E		;copy parameter block address
	INX	H
	MOV	M,D
LOGGED:	LXI	H,DPBAS1
	RET
;
;setsec - set sector from reg b,c
;
SETSEC:	SBCD	SEKSEC		;save the sector
	RET
;
;setdma - set dma address from bc
;
SETDMA:	SBCD	DMAADD		;bc to dmaadr
	RET
;
;common read setup routine
;
RDSET:	MVI	A,SINGLE+WRTXFR+CHAN2
	STA	DMODE
	MVI	A,DREQL+ROTPRI
	STA	DCMND
	RET
;
;read - read a sector
;
READ:	LDA	SEKTRK		;bypass format 3 if track 0
	ORA	A
	JRZ	READ1
	LDA	DISKHF		;if format 3 then deblock
	CPI	3
	JZ	READB
READ1:	LDA	SEKSEC
	MOV	D,A
	LDA	DISKHS
	MOV	B,A
	LDA	SEKTRK
	CALL	SEEKLS
	LHLD	DMAADD
;
; -read logical sector-  hl is dma address
;
READLS:	CALL	RDYDRV		;check drive ready
	MVI	A,ERRCNT	;retry count
RRTRY:	STA	RTCNT		;save it
	CALL	RDSET		;use common setup routine
	LXI	B,FLPYRD SHL 8 OR WCT2
	LDA	DISKHF		;check if deblocking
	CPI	3		;if = 3, deblocking
	LXI	D,(BLK512-1)
	JRNC	RSET		;we are deblocking
	LXI	D,(BLK128-1)
RSET:	PUSH	H		;save dma address
	CALL	DMA		;use common read/write
	POP	H
	ANI	9DH		;check for errors during read
	RZ			;return if no read errors
	LDA	RTCNT		;get retry count
	DCR	A		;decrement it
	JRNZ	RRTRY		;retry again
	LXI	H,RDERR		;retry exausted, print message
COMEXT:	CALL	PRNTM
	MVI	A,1		;error return code
	ORA	A		;set flags
	RET
;
;logical sector seek
;
;a=track, b=hardware and density for fdc
;d=sector (for future read)
;
SEEKLS:	PUSH	PSW		;save track
	MVI	A,10		;retrys
	STA	SEEKRTY		;save it
	LXI	H,TRKTAB	;point to start of trk table
	MOV	A,M		;get track value
	OUT	TRACK		;force into 1793 track reg.
	POP	PSW		;restore track value
	CPI	1
	MOV	C,A		;save track in reg c
	MOV	A,B		;get copy of drive and density
	JRNC	SEEKOK		;we are > than track 1?
	ANI	30H		;clear density & side bit
	JMPR	SEEK2		;going to trk < 1
;
SEEKOK:	BIT	6,B		;doing doub sided?
	JRZ	SEEK1		;< > 1, doing single sided
	RRCR	C		;divide track by 2
	JRC	SEEKK1		;side bit set,doing odd trk
	RES	6,B		;reset side bit, doing even trk
SEEKK1:	RES	7,C		;clear msb of track value
SEEK1:	MOV	A,B		;get drive select code
SEEK2:	OUT	DCONT		;select disk and density
	PUSH	B
	CALL	RDYDRV		;check drive ready
	POP	B
	MOV	A,D		;get sector number
	OUT	SECTP		;tell the controoller chip
	IN	TRACK		;read 1793 track register
	CMP	C		;is track the same?
	JRZ	SAVTRK		;save track value for next time.
	MOV	A,C		;not same, get new track number
	OUT	DDATA		;seek to track with head load
;
;execute seek command
;
	LDA	USRSTP
	ORI	14H+HLABSK	;seek with head load
EXECC1:	OUT	DCOM		;output disk command
;
	IF	ZMODE2
	HLT			;wait for intrp
	ELSE
	CALL	SLOOP
	ENDIF
;
	ANI	10010001B	;mask out junk bits
	JRZ	SAVTRK		;save track for next time
;
;we have an seek error,
;save primary registers
;and execute a read id.
;
RIDCOM:	EXX			;save regs
	LXI	H,IDBUF		;buffer area for read id
	CALL	RDSET		;use common setup routine
	LXI	B,FLPYID SHL 8 OR WCT2
	LXI	D,00005H	;dma read, length
	CALL	DMA		;read the id marks
	ANI	9DH		;any errors in reading?
	JRZ	DENOK		;no, density is correct.
	EXX			;yes, incorrect density
	MOV	A,B		;get density and drive byte
	RES	3,A		;set single density for retry
	OUT	DCONT		;on read id.
	JMPR	RIDCOM		;switch registers and retry.
;
DENOK:	IN	SECTP		;get track byte
	OUT	TRACK		;place value into trk reg.
	LDA	SEEKRTY		;get retry count
	DCR	A
	STA	SEEKRTY
	EXX			;restore registers
	JRNZ	SEEK1		;reseek to track
;
	LXI	H,SEEKER	;print error
	CALL	PRNTM		;print it
	JMP	WBOOT
;
SAVTRK:	LXI	H,TRKTAB	;point to track table
	IN	TRACK		;get 1793 track
	MOV	M,A		;save in table
	RET
;
;check drive ready. start slim line drives also.
;
RDYDRV:	IN	DSTAT		;check status of floppy chip
	RLC			;is it ready
	RNC			;return if ready
;
;if not ready, do time delay and try to start drive.
;drive may be a slim line type.
;
	IN	TRACK		;get present track number
	OUT	DDATA		;place into data register
	MVI	A,00011001B	;seek to same track
	OUT	DCOM
;
	IF	ZMODE2
	CALL	IDLE

	ELSE

	CALL	SLOOP		;wait till intrp
	ENDIF

	MVI	B,70
DELAY:	MVI	A,16
DELY1:	MVI	C,249
DLY1:	DCR	C
	JRNZ	DLY1
	DCR	A
	JRNZ	DELY1
	DCR	B
	JRZ	NOTRDY
	IN	DSTAT		;check for drive ready
	RLC
	RNC			;return if ready
	JMPR	DELAY		;try loop again
;
;drive has been found not ready.
;
NOTRDY:	PUSH	H		;save dma address
	LDA	SEKDSK		;get requested drive
	ADI	'A'		;ascii adjust it
	STA	NDSKR
	LXI	H,NTRDYM
	CALL	PRNTM
	POP	H
;
;hang waiting for drive to come ready.
;
DRVRDY:	IN	DSTAT
	RLC
	JRC	DRVRDY
	JMPR	RDYDRV		;recheck for ready condition
;
;data tables
;
RDERR:	DB	CR,LF,7,'* Loader READ Error ','*'+80H
SEEKER:	DB	CR,LF,7,'* Loader SEEK Error ','*'+80H
NTRDYM:	DB	CR,LF,7,'Drive '
NDSKR:	DB	' : is not READ','Y'+80H
;
;deblock read routine
;read the selected cp/m sector
;
READB:	MVI	A,1
	STA	READOP		;read operation
	MVI	A,WRUAL
	STA	WRTYPE		;treat as unalloc
;
;not an unallocated record, requires pre-read
;
ALLOC:	XRA	A		;0 to accum
	STA	UNACNT		;unacnt = 0
	INR	A		;1 to accum
	STA	RSFLAG		;rsflag = 1
;
;common code for read and write follows
;enter here to perform the read/write
;
RWOPER:	XRA	A		;zero to accum
	STA	ERFLAG		;no errors (yet)
	LHLD	SEKSEC
	MOV	A,H		;rotate h,l right 2 places
	RRC			;move lsb of h into carry
	MOV	A,L
	RAR
	STC
	CMC
	RAR
	STA	SEKHST		;host sector to seek
;
;active host sector?
;
	LXI	H,HSTACT	;host active flag
	MOV	A,M
	MVI	M,1		;always becomes 1
	ORA	A		;was it already?
	JRZ	FILHST		;fill host if not
;
;host buffer active, same as seek buffer?
;
	LDA	SEKDSK		;get sekdsk
	LXI	H,HSTDSK	;same disk?
	CMP	M		;sekdsk = hstdsk?
	JRNZ	NOMATCH
;
;same disk, same track?
;
	ORA	A		;clear flags
	LDED	HSTTRK
	LHLD	SEKTRK
	DSBB	D		;sektrk = hsttrk?
	JRNZ	NOMATCH
;
;same disk, same track, same buffer?
;
	LDA	SEKHST
	LXI	H,HSTSEC	;sekhst = hstsec?
	CMP	M
	JRZ	MATCH		;skip if match
;
;proper disk, but not correct sector
;
NOMATCH:LDA	HSTWRT		;host written?
	ORA	A
	CNZ	WRITEHST	;clear host buff
;
;may have to fill the host buffer
;
FILHST:	LXI	H,SEKHST	;source for move
	LXI	D,HSTSEC	;destination for move
	LXI	B,4		;count for move
	LDIR			;block move the data
	LDA	RSFLAG		;need to read?
	ORA	A
	CNZ	READHST		;yes, if 1
	XRA	A		;0 to accum
	STA	HSTWRT		;no pending write
;
;copy data to or from buffer
;
MATCH:	LDA	SEKSEC		;mask buffer number
	ANI	SECMSK		;least signif bits
	MOV	L,A		;ready to shift
	MVI	H,0		;double count
	MVI	B,7		;reg b = loop count
MTCH1:	DAD	H		;shift h,l by b counts
	DJNZ	MTCH1
;
;hl has relative host buffer address
;
	LXI	D,HSTBUF
	DAD	D		;hl = host address
	LDED	DMAADD		;get/put cp/m data
	LDA	READOP		;which way?
	ORA	A
	JRNZ	RWMOVE		;skip if read
;
;c initially 128, de is source, hl is dest
;
RWMOVE:
	LXI	B,128		;move size
	LDIR			;fast z-80 block move
;
;data has been moved to host buffer
;
	LDA	ERFLAG		;in case of errors
	RET			;no further processing
;
;readhst reads the physical disk.
;hstdsk = host disk #, hsttrk = host track #,
;hstsec = host sect #. read "hstsiz" bytes
;into hstbuf and return error flag in erflag.
;
READHST:
	CALL	SETIO		;get the selected disk parms
	CALL	READLS		;read the selected disk
XITIO:	MVI	A,0		;0 = no error
	STA	ERFLAG		;save it
	RZ			;return if no errors
	CMA			;else,, we have an error
	STA	ERFLAG		;save the error flag byte
	RET

SETIO:	LXI	H,LOGBYT	;point to disk log table
	LDA	HSTDSK		;get selected disk
	ADD	A		;double for index
	MOV	E,A		;move into reg e
	MVI	D,0		;clear reg d
	DAD	D		;add to h,l
	INX	H		;bump to disk select code
	MOV	B,M		;disk sel stuff in b
	LDA	HSTSEC		;get the sector to do
	INR	A		;sector on disk is 1-16
	MOV	D,A		;save in reg d for seek
	LDA	HSTTRK		;get the track to do
	CALL	SEEKLS		;seek to track in reg a
	LXI	H,HSTBUF	;point to host buffer
	RET			;return to caller
;
LOGBYT:	DW	0000H		;disk 0 log flag/den
;
;
;the following area is claimed as the
;host buffer after system is running
;
HSTBUF	EQU	$		;host buffer
;
;hide system init in this area. we only
;use this stuff once
;
INIT:	MVI	A,1		;reset first time byte
	STA	FIRST		;so we dont get here again
;
	IF	NOT ZMODE2
	DI			;kill intrps
	ENDIF
;
;init external i/o board
;
	LXI	H,ITAB		;point to init bytes
	MVI	B,4		;4 bytes to do
INITL:	MOV	A,M		;get a byte
	OUT	CCOM1
	OUT	CCOM2
	OUT	CCOM3
	OUT	CCOM4
	INX	H		;bump pointer
	DJNZ	INITL		;loop till all done
;
	IN	DATAB		;clear console
;
;stop timer from running
;
	MVI	A,CNTR2+RLWORD+MODE2+BINARY
	OUT	TCMND		;send mode of operation
	MVI	A,1
	OUT	TCH2
	XRA	A		;get a zero
	OUT	TCH2
;
	LXI	H,DISKHF	;clear scratch area
	LXI	D,DISKHF+1	;block transfer dest.
	LXI	B,DMAADD-DISKHF+1	;count
	MOV	M,A		;set first loc. = 0
	LDIR			;use block move to clear
;
;init interrupt controller
;
	IF	ZMODE2
	OUT	INTCMD		;reset intrp chip
	MVI	A,10000000B	;set mode of operation
	OUT	INTCMD
	MVI	A,00011001B	;clear imr bit 1
	OUT	INTCMD
	MVI	A,10101101B	;select mode reg, set bit 7
	OUT	INTCMD
	MVI	A,11000000B	;select acr register
	OUT	INTCMD
	MVI	A,00000010B	;set bit1 (vect 1) for auto clr
	OUT	INTDOT
	MVI	A,11100001B	;preselect response memory
	OUT	INTCMD
	LXI	H,INTVEC	;point to service routine
	MOV	A,H		;get high byte
	STAI			;set the interrupt register
	MOV	A,L		;get the low byte
	OUT	INTDOT		;set the response memory
	IM2			;set for interrupt mode 2
	IN	DSTAT		;clear any pending intrps
	EI			;enable interrupts

	ELSE

	XRA	A		;get a zero
	OUT	INTCMD		;reset intrp chip
	MVI	A,84H
	OUT	INTCMD
	MVI	A,29H
	OUT	INTCMD
	MVI	A,0A9H
	OUT	INTCMD		;use polled mode of operation
	ENDIF

	RET
;
;8251 usarts INIT bytes
;
ITAB:	DB	0AAH,040H,0CEH,037H
;
	DS	HSTSIZ-($-HSTBUF)
;
;ram storage area
;
USRSTP:	DB	DRVSRAT		;user step rate from boot
;
DISKHF:	DS	1		;disk hardware format (1, 2, 3)
DISKHS:	DS	1		;disk/density setting = hardware
TRKTAB:	DS	1		;track table for 1 drive
;
DIRBUF:	DS	128		;scratch directory area
ALL00:	DS	38		;allocation vector 0
CHK00:	DS	64		;check vector 0
SEKHST:	DS	1		;seek shr secshf
SEKDSK:	DS	1		;seek disk number
SEKTRK:	DS	2		;seek track number
SEKSEC:	DS	2		;seek sector number
;
UNADSK:	DS	1		;last unalloc disk
UNATRK:	DS	2		;last unalloc track
UNASEC:	DS	2		;last unalloc sector
;
HSTSEC:	DS	1		;host sector number
HSTDSK:	DS	1		;host disk number
HSTTRK:	DS	2		;host track number
;
HSTACT:	DS	1		;host active flag
HSTWRT:	DS	1		;host written flag
UNACNT:	DS	1		;unalloc rec cnt
RTCNT:	DS	1		;disk retry counter
SEEKRTY:DS	1		;seek retry counter
ERFLAG:	DS	1		;error reporting
RSFLAG:	DS	1		;read sector flag
READOP:	DS	1		;1 if read operation
WRTYPE:	DS	1		;write operation type
DMODE:	DS	1		;dma mode byte
DCMND:	DS	1		;dma command byte
BLKMVS:	DS	2		;dma m/m blk move size
CHNGFL:	DS	1		;new dsk change boolean
OLDDSK:	DS	1		;last drive select save
IDBUF:	DS	6		;disk read id buffer
DMAADD:	DS	2		;dma address
	END

	0		;AUXILLIARY CODE #0
                
