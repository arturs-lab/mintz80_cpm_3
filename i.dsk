  2410  1CAC  02               	DB     	2      	;GAPR (Flag for multiple repeat
  2411  1CAD  0B               	DB     	0bh    	;RESTORE CODE
  2412  1CAE  1B               	DB     	1bh    	;seek w/no verify cmd
