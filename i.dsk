              6D617400
  2420                  ;
  2421                  ;
  2422                  ;
  2423                  ; THE FOLLOWING RAM LOCATIONS ARE REQ
  2424                  ;
  2425  1CEA  00        TEMP   	       	DB     	0H     	
  2426  1CEB  00        TEMP1  	       	DB     	0H
  2427  1CEC  00        DRIVE_LETTER   	DB     	0H     	
  2428  1CED  0000      IXSAV  	       	DW     	0000H
  2429  1CEF  0000      IX_OLD_STORE   	DW     	0000H
  2430  1CF1  0000      IX_NEW_STORE   	DW     	0000H
  2431  1CF3  0000      IY_OLD_STORE   	DW     	0000H
  2432  1CF5  0000      IY_NEW_STORE   	DW     	0000H
  2433  1CF7  00        CRTDISP	       	DB     	0H
  2434  1CF8  (0006)    IDSV   	       	DS     	6H
