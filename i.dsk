	; Kaypro II, 5", DDSS, 10 sector format:
SS5$3:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	ONEHEAD		;single side
		dw	SS5$3skw	;pointer to skew table
		db	10		;10 sectors / track
		db	40		;40 tracks
		db	26		;GAP3
		dw	274		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	0		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	11		;format type 11
		db	-1		;no auxilliary code
SS5$3skw:	db	0,8,3,6,1,9,4,7,2,5

	; OSBORNE 1, 5", DDSS, 5 sector, 1024 byte format:
