  2753                  ;--------------------- DISPLAY SECTOR DATA CONTENTS ---
  2754                  ;Display the Sector read from disk to RAM location at (
  2755  12C0            SEC_DISPLAY:
  2756  12C0  3ADE2E           	LD     	A,(CRTDISP)    	;Do we have the more de
  2757  12C3  B7               	OR     	A,A
