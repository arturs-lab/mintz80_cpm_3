rbtediag/n,psdbddt,rbtdiag,iodep#1/e
  COMMON /PARMS/ CD
      COMMON /BFRS/ BD
#
      EQUIVALENCE (CD(8),PM(1)), (PM(3),RSIZ)
      EQUIVALENCE (BD(4),BSIZ1)
#
      DATA M$NORM/0/
#
      BSIZ1 = 513
      RECLNG = RSIZ + 2
      CRFLG = .FALSE.  #INDICATE RECORD NOT TERMINATED
      RETURN
      END
	TITLE	QUEUE SUBROUTINES
	LIST	NOGEN
	VERSON	0,13,2,12,14,I.XLOG,V.XLOG,D.XLOG
	ENTRY	PUTRAN,GETRAN
	ENTRY	T$STRT,T$TAKR,T$PUTR
T$PUTR:	DW	0		;PUTTER
T$TAKR:	DW	0		;TAKER
T$STRT:	DS	100		;TRANSACTION BUFFER
T$END	EQU	$-1
	TITLE	PUTRAN - PUT NEXT TRANSACTION IN BUFFER
;
;	PUTRAN (SUBROUTINE)
;
;		THIS SUBROUTINE PLACES THE SPECIFIED TRANSACTION (REG A)
;		INTO THE TRANSACTION CIRCULAR BUFFER, WHICH BEGINS AT T$STRT
;		AND ENDS AT T$END.
;		THE POINTER, T$PUTR, POINTS TO THE LAST TRANSACTION LOADED
;		INTO THE CIRCULAR BUFFER.
;		THE BUFFER IS FULL WHEN THE NEXT T$PUTR EQUALS T$TAKR.
;		WHEN THE BUFFER IS FULL, THE LAST TRANSACTION SLOT IS LOADED
;		WITH THE CURRENT TRANSACTION AND OVERFULL FLAG SET (BIT 7).
;		NOTE: THIS ROUTINE MUST BE CALLED WITH INTERRUPTS OFF AS THE
;		CALLING TASKS DIFFER IN PRIORITIES CAUSING RACXE CONDITIONS.
;
;		CALLING SEQUENCE:
;
;			LD	A,TRANS
;			CALL	PUTRAN
;
;		ENTRY:
;			REG A - TRANSACTION
;
;		EXIT:
;			ALL REGS PRESERVED
;
;		COME FROMS:
;			ISTST, TCMDT, TBSCR, TBSCT
;
	REL
PUTRAN:
	PUSH	HL		;SAVE
	PUSH	DE		;	REGISTERS
	PUSH	AF		;	...
	LD	HL,(T$PUTR)	;POINT REG HL TO
	CALL	NEXT		;	NEXT PUTR ADDRESS
	LD	DE,(T$TAKR)	;IS BUFFER FULL
	LD	A,D		;	(NEXT(T$PUTR) = T$TAKR)
	CP	H		;	...
	JR	NZ,P.INS	;NO, ROOM FOR TRANSACTION
	LD	A,E		;IS BUFFER FULL
	CP	L		;	...
	JR	NZ,P.INS	;NO, ROOM FOR TRANSACTION
	LD	HL,(T$PUTR)	;YES, BUFFER FULL
	POP	AF		;PLACE TRANSACTION WITH
	SET	7,A		;	WITH OVERFULL FLAG SET
	LD	(HL),A		;	INTO LAST TRANSACTION SLOT
	RES	7,A		;CLEAR OVERFULL FLAG
	POP	DE		;RESTORE
	POP	HL		;	REGISTERS
	RET
;
P.INS:	POP	AF		;PLACE TRANSACTION
	LD	(HL),A		;	IN BUFFER
	LD	(T$PUTR),HL	;SAVE NEW PUTR POINTER
	POP	DE		;RESTORE 
	POP	HL		;	REGISTERS
	RET
	TITLE	GETRAN - GET NEXT TRANSACTION FROM BUFFER
;
;	GETRAN (SUBROUTINE)
;
;		THE GET TRANSACTION SUBROUTINE (GETRAN) RETRIEVES THE NEXT
;		TRANSACTION FROM THE TRANSACTION CIRCULAR BUFFER, WHICH BEGINS
;		AT T$STRT AND ENDS AT T$END.
;		THE POINTER, T$TAKR, POINTS TO THE TRANSACTION TO BE RETRIEVED
;		THE CIRCULAR BUFFER IS EMPTY WHEN T$TAKR = T$PUTR.
;
;		CALLING SEQUENCE:
;
;			CALL	GETRAN
;
;		ENTRY CONDITIONS:
;			NONE
;
;		EXIT CONDITIONS:
;			REG A - TRANSACTION BYTE
;			FLAG Z = 0  TRANSACTION RETURNED
;			FLAG Z = 1  BUFFER EMPTY, NO TRANSACTION RETURNED
;			ALL OTHER REGS PRESERVED
;
;		COME FROM:
;			X$LOG (ONLY)
;
	REL
GETRAN:
	PUSH	HL		;SAVE
	PUSH	DE		;	REGISTERS
	LD	HL,(T$TAKR)	;IS BUFFER EMPTY
	LD	DE,(T$PUTR);	;	(T$TAKR = T$PUTR)
	LD	A,D		;	...
	CP	H		;	...
	JR	NZ,GETNXT	;NO, TRANSACTION AVL
	LD	A,E		;IS BUFFER EMPTY
	CP	L		;	...
	JR	NZ,GETNXT	;NO, TRANSACTION AVL
	POP	DE		;YES, RETURN FLAG Z=1
	POP	HL		;	& RETORE REGISTERS
	RET
;
GETNXT:
	CALL	NEXT		;POINT TO NEXT TRANSACTION SLOT
	LD	(T$TAKR),HL	;	& SAVE IT
	LD	A,(HL)		;GET TRANSACTION
	POP	DE		;RESTORE
	POP	HL		;	REGISTERS
	RET
	TITLE	NEXT - SET CURSOR TO NEXT BUFFER ADDRESS
;
;	NEXT (SUBROUTINE)
;
;		THIS ROUTINE SET THE CURSOR (REG HL) TO THE NEXT BUFFER
;		ADDRESS IN THE TRANSACTION BUFFER.
;
;		CALLING SEQUENCE:
;			LD	HL,ADR
;			CALL	NEXT
;			LD	(CURSOR),HL
;
;		ENTRY CONDITONS:
;			REG HL  POINTER IN CIRCULAR BUFFER
;
;		EXIT CONDITIONS:
;			REG HL  POINTS TO NEXT TRANSACTION
;			ALL OTHER REGS PRESERVED
;
;		COME FROM:
;			PUTRAN, GETRAN
;
	REL
NEXT:
	PUSH	DE		;	REGISTER
	PUSH	AF		;SAVE REGISTER
	LD	DE,…•••“ d’еeE%HX№YQIRD.VTRTљЌЂG␀␀2IrІў’¤pc++*)*GВІ!rІў’¤ґ␀‡FА␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀# `-1f2•“PУС#! aQMQJ2•	TСPЈ! P‘	N2‘Q”Ј" AIQQ	22&T‘’SЈ"аa5Q1f2*“TССc# M9Q	2p␀␀…PRS d’дФ”иX№5%:D.MAINЃђФХT• dDED”еHIJjњ␀␀Й%ЙЁ))СА,¬\љ‚’ќИ…ЙЁ))СР␀†¦Ё‚¤©
