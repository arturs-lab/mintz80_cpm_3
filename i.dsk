   382  02C4  3D               	DEC    	A      	       	;Because sectors are nu
   383  02C5  DDBE00           	CP     	A,(IX+NSCTRS)  	;Have we done a complet
   384  02C8  2035             	JR     	NZ,NOTEND
   385  02CA            
