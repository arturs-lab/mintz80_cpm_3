FS	ђт:␀µ`	ьYGАvmг	„58›NАCАh(€a:D3)Р@R2L‡‘ёЮtLgCIШК␀(D5Р›NАCЂh(€a:D3)Р@R2L‡‘„Жt4ќЊ р)›PЃ6d›NАCАh(¤e8ќL§3 ЂиoМ¦г ЂВc:NЖЎ”И␀ЫРFm;Ѓ ў)ёиe9"Ўј@t2њО‚°Кa9†сLКn2„␀mXXTИ|fШрA␀”C}Ѓґм0‚€fГ)„д :Д3)ёИ 7О‚	Њиi;@…†Ќ‚іiШ`.Н†S	И@t7€fSqђ@a1ќ'c(␀CNЃYґм0(‚€¦гЎ”д ,€†сРКs:†Ў„@C0њЋF“)И@D2ќ¦3 и@␀fХЂ'сd@UЩ·Ё@)ЧЂVm;Б ў!„иaМ'#‘¤Кr§C)Њи 4›Њ&3Ў¤мe␀"B
Н§`!Ђи4D0ќ"„дr4™NB!”иe1ќРТv2Ђ7›NАCРh(Ёh2€Жуa°Юw4›ЊвA”р 9ќF“qњ@w4›‚”@t9MЗ3i¤иt2™3yёиi7MзS™°т:␀hX36ќЂ† РPМd Њ„1ђЂf2" И@4ѓ1␀Рd #„b0ЂЊF€А<fУ°АT
"›Ћ†SђЂІ :Д3Ў„дt␀Ъ°ю,€‚АН§`!Ђ 4␀2@␀␀␀[љеjЅEU”›EЭҐєОz^µиЂ*¬ П[ьоЛ_ґ\,—‰ЬEYAљ.L·ШКХVpginІѓ—‚␀9нz ґ\,–mVpcуEВЙ–Љµ^Ўz^GµиЂ!­ П‹$FсhІc+ Y=9%9B2fђУУђТг%@y=9=UR2xQSђђТc"␀QIAN3hT‘’SЈ? 1	==R3†PУРТг-Ђ±Me920”‘TХSc0␀5Qa	%:3ЋRTЦSђг' Y1IZp␀␀ћ…ФС‘ d’е4D(X№AM
D.PSDBЂСT”¦Ё А␀’\ ¦€…КЕК
h€QАрј€\ ¦€…␀hЄJRР␀h␀␀Г␀␀% А7Ё†‘Ђ3i€…›NЂ,Ъt␀>і@␀р)›F@`␀␀4ЊA*I‚)H¤O)␀е»!›GЂa‡»”шН␀␀'Цm=␀dЖA␀*љў
’¤d$§$ў"*FH@"zz¤dФ Ё*ЄFPЂ*"љ‚Bд␀␀ћ	title	crtdrv.z80	CRT Driver Routines
	list	nogen
	verson	0,01,08,10,27,i.crtd,v.crtd,d.crtd
	list	off
*include mscequ.z80
	list	on
;
;	APUTS - DISPLAY CHAR OFFSET BY 32
;
APUTS:	MACRO	#REG,#VAL
	LD	A,#REG
	ADD	#VAL
	CALL	APUT
	MEND
;
;	APUT - DISPLAY CHAR ON CONSOLE
;
APUT:	MACRO	#VAL
	LD	A,#VAL
	CALL	APUT
	MEND
;
;	BINDF - convert binary to ascii
;
bindf:	macro	#var,#reslt
	ld	bc,#var
	ld	hl,#reslt
	call	bindf
	mend
;
;	PUTS - send character string to crt
;
PUTS:	macro	#string
	ld	hl,#string
	call	puts
	mend
	form
ESC	EQU	1BH
DLE	EQU	10H
VT	EQU	0BH
DC1	EQU	11H
RS	EQU	1EH
FORM	EQU	0CH
SUB	EQU	1AH
FS	EQU	1CH
ETB	EQU	17H
SI	EQU	0FH
GS	EQU	1DH
EOT	EQU	04H
BLANK	EQU	32
cr	equ	0dh
	title	POSR	Set cursor position
;	POSR
;
;		SET CURSOR TO SPECIFIED X Y COORDINATES
;
;	CALLING SEQUENCE:
;		LD	C,XADR
;		LD	B,YADR
;		CALL	POSR
;
;	ENTRY:
;		REG C	XADR - X COORD ADR (BYTE) (0,79)
;		REG B	YADR - Y COORD ADR (BYTE) (0,23)
;
;	EXIT:
;		ALL REGS PRESERVED
;
;
;	ASCII EQUATES
;
	ENTRY	POSR
	EXT	APUT,BINDF,CASE,TRMCOD
	REL
POSR:	PUSH	HL		;SAVE
	PUSH	DE		;	REGS
	PUSH	AF		;	...
	PUSH	BC		;SAVE CURSOR
	CASE	(TRMCOD),PLNG,PTAB	;CALCULATE CASE ADDR
	POP	BC			;GET CURSOR
	LD	DE,POSDON	;RETURN
	PUSH	DE		;	ADDRESS
	JP	(HL)
;
POSDON:	POP	AF		; RESTORE REG
	POP	DE		;RESTORE
	POP	HL		;	REGS
	RET
	form
PTAB:	DW	pos99		;OUT OF RANGE ERR
	DW	POS0		;BEEHIVE
	DW	POS1		;ADDS 580
	DW	POS2		;ADM 3A
	DW	POS3		;SOROC
	DW	POS4		;VDM
	DW	POS5		;HAZELTINE 1500
	DW	POS6		;VECTOR GRAPHIC MT
	DW	POS7		;PERKIN ELMER FOX
	DW	POS8		; HP 2621
	DW	POS9		; P-E BANTAM
	DW	POS10		; GNAT10
	DW	POS11		; TRS80 / P&T
	dw	pos12		; Zenith z89
	dw	pos13		; Televideo
	dw	pos14		; infoton
PLNG	EQU	[$-PTAB]/2-2
TTYCNT	EQU	PLNG		; NUMBER OF TERM TYPES
	FORM
POS0:	APUT	ESC		;BEEHIVE
	APUT	'F'
	APUTS	B,BLANK
	APUTS	C,BLANK
	RET
;
POS1:	APUT	DLE		;ADDS 580
	APUTS	B,BLANK
	APUT	VT
	APUTS	C,BLANK
	RET
;
POS13:				; Televideo
POS2:				;SOROC
POS3:				;ADM3A
POS10:	APUT	ESC		;GNAT10
	APUT	'='
	APUTS	B,BLANK
	APUTS	C,BLANK
	RET
;
POS4:	APUT	DLE		;VDM
	APUTS	C,0
	APUTS	B,0
	RET
;
POS5:	APUT	7EH		;HAZELTINE
	APUT	DC1
	APUTS	C,0
	APUTS	B,0
	RET
;
POS6:	APUT	ESC		;VECTOR GRAPHIC
	APUTS	C,0
	APUTS	B,0
	RET
;
POS9:				; P-E (BANTAM)
POS7:	APUT	ESC		;PERKIN ELMER (FOX)
	APUT	'X'
	APUTS	B,BLANK
	APUT	ESC
	APUT	'Y'
	APUTS	C,BLANK
	RET
;
POS8:	PUSH	BC		; SAVE XY COORD
	LD	B,0		; CONVERT
	LD	HL,XCASC	;	X COORDINATE
	CALL	BINDF		;	TO ASCII
	POP	BC		; CONVERT
	LD	C,B		;	Y COORDINATE
	LD	B,0		;	TO
	LD	HL,YCASC	;	ASCII
	CALL	BINDF		;	...
	APUT	ESC		; HP 2621
	APUT	'&'
	APUT	'a'
	APUT	(YCASC+3)
	APUT	(YCASC+4)
	APUT	'y'
	APUT	(XCASC+3)
	APUT	(XCASC+4)
	APUT	'C'
	RET
;
;
pos12:
POS11:	APUT	ESC		; P&T TRS80
	APUT	'Y'
	APUTS	B,BLANK
	APUTS	C,BLANK
	RET
;
pos14:	aput	esc		; Infoton
	aput	'f'
	aputs	c,blank
	aputs	b,blank
	ret
	form
pos99:	ld	a,(rowoff)	; add 
	add	b		;	row offset
	ld	(row),a		;	...
	ld	(cfrst),a	;	default row as first
	ld	a,(coloff)	; add 
	add	c		;	column
	ld	(col),a		;	offset
	ld	(csec),a	;	default column is second
	cpm	(colfst),true	; column number first?
	jr	nz,crs$1	; no
	mov	(cfrst),a,(col)	; yes, set column as first
	mov	(csec),a,(row)	; set row as second
crs$1:	puts	c$lead		; send leadin sequence
	cpm	(ascenc),true	; ascii encode row/column?
	jr	z,crs$2		; yes
	aput	(cfrst)		; no, send first position
	jr	crs$3
crs$2:	bindf	(cfrst),ascpos	; encode position to ascii
	aput	(ascpos+3)	; display first position char
	aput	(ascpos+4)	; send second position char
crs$3:	puts	c$mid		; send middle sequence
	cpm	(ascenc),true	; ascii encode row/column?
	jr	z,crs$4		; yes
	aput	(csec)		; no, send second position
	jr	crs$5
crs$4:	bindf	(csec),ascpos	; encode position into ascii
	aput	(ascpos+3)	; send first position char
	aput	(ascpos+4)	; send second position char
crs$5:	puts	c$end		; send trailing sequence
	mov	b,a,(crsnul)	; do null
	call	nulls		;	timing fill
	ret
;
	DATA
ascpos:	ds	0		; ascii encoded position
XCASC:	DS	6
YCASC:	DS	6
col:	db	0		; column position
row:	db	0		; row position
cfrst:	dw	0		; first position
csec:	dw	0		; second position
;
	entry	scntbl
	rel
scntbl:	ds	0
c$name:	ds	11		; ascii name of crt (count,string)
c$lead:	ds	11		; lead in sequence (count,string)
c$mid:	ds	11		; middle sequence (count,string)
c$end:	ds	11		; trailing sequence (count,string)
colfst:	ds	1		; column first flag (true=>1, false=>0)
coloff:	ds	1		; column offset
rowoff:	ds	1		; row offset
ascenc:	ds	1		; ascii encoding flag (true=>1, flase=>0)
crsnul:	ds	1		; cursor trailing nulls
csseq:	ds	11		; clear screen sequence (count,string)
csnul:	ds	1		; clear screen trailing nulls
clseq:	ds	11		; clear line sequence (count,string)
clnul:	ds	1		; clear line trailing nulls
	FORM
;
;	CLRSCN - CLEAR SCREEN
;
	ENTRY	CLRSCN
	REL
CLRSCN:	CASE	(TRMCOD),CLNG,CTAB	;COMPUTE CASE ADDR
	JP	(HL)			;DO CASE
;
CTAB:	DW	clr99	;OUT OF RANGE 
	DW	CLR0	;BEEHIVE
	DW	CLR1	;ADDS
	DW	CLR2	;ADM3A
	DW	CLR3	;SOROC
	DW	CLR4	;VDM
	DW	CLR5	;HAZELTINE
	DW	CLR6	;VECTOR GRAPHIC
	DW	CLR7	;PERKIN ELMER
	DW	CLR8	; HP 2621
	DW	CLR9	; PE BANTAM
	DW	CLR10	;GNAT10
	DW	CLR11	; P&T CP/M TRS80
	dw	clr12	; Zenith z89
	dw	clr13	; Televideo
	dw	clr14	; Infoton
CLNG	EQU	[$-CTAB]/2-2
;
clr12:
CLR0:	APUT	ESC		;BEEHIVE
	APUT	'E'
	LD	B,0FFH		; WAIT 255
	CALL	NULLS		;	CHAR TIMES
	RET
;
clr14:				; Infoton
CLR1:				;ADDS
CLR4:				;VDM
CLR11:				;TRS80 P&T
	APUT	FORM
	RET
;
CLR2:				;ADM3A
CLR10:	APUT	SUB		;GNAT10
	RET
;
CLR3:	APUT	ESC		; SOROC
	APUT	'*'		;
	LD	B,20		; WAIT 20
	CALL	NULLS		;	CHAR TIMES
	RET
	FORM
;
CLR5:	APUT	7EH		;HAZELTINE
	APUT	FS		;
	RET
;
CLR6:	APUT	EOT		; VG MINDLESS TERM
	RET
;
CLR7:	APUT	ESC		;P/E
	APUT	'K'		;
	RET
;
CLR8:	APUT	ESC		; HP 2621
	APUT	'H'		;
	APUT	ESC		;
	APUT	'J'		;
	RET
;
CLR9:	CALL	CLR7		; PE BANTAM
	LD	B,48		;
	CALL	NULLS		;
	RET
;
clr13:	aput	esc		; Televideo
	aput	'Y'
	ret
;
clr99:	puts	csseq		; send clear sequence
	mov	b,a,(csnul)	; send
	call	nulls		;	nulls
	ret
	FORM
;
;	CLRLIN - CLEAR TO END OF LINE
;
	ENTRY	CLRLIN
	REL
CLRLIN:	PUSH	BC			;SAVE
	PUSH	DE			;	REGS
	PUSH	HL			;	...
	CASE	(TRMCOD),LLNG,LTAB	;COMPUTE CASE
	LD	DE,CLLEXT		;RETURN
	PUSH	DE			;	ADDRESS
	JP	(HL)			;DO CASE
;
CLLEXT:	POP	HL			;RESTORE
	POP	DE			;	REGS
	POP	BC			;	....
	RET
;
LTAB:	DW	lin99	;OUT OF RANGE
	DW	LIN0	;BEEHIVE
	DW	LIN1	;ADDS
	DW	LIN2	;ADM3A
	DW	LIN3	;SOROC
	DW	LIN4	;VDM
	DW	LIN5	;HAZELTINE
	DW	LIN6	;V/G
	DW	LIN7	;P/E
	DW	LIN8	; HP2621
	DW	LIN9	; PE BANTAM
	DW	LIN10	; GNAT10
	DW	LIN11	; TRS80 P&T
	dw	lin12	; Zenith z89
	dw	lin13	; Televideo
	dw	lin14	; Infoton
LLNG	EQU	[$-LTAB]/2-2
	FORM
lin14:				; Infoton
lin12:
LIN0:	APUT	ESC		;BEEHIVE
	APUT	'K'
	RET
;
LIN1:				;ADDS
LIN2:	APUT	CR		; INSURE CURSOR AT BEGINNING OF LINE
	LD	B,79		; BLANK
L12:	APUT	BLANK		;	ENTIRE
	DJNZ	L12		;	LINE
	APUT	CR		; POSITION CURSOR AT BEGINNING OF LINE
	RET			;ADM3A
;
lin13:				; Televideo
LIN3:	APUT	ESC		;SOROC
	APUT	'T'
	RET
;
LIN4:	APUT	ETB		;VDM
	RET
;
LIN5:	APUT	7EH		;HAZELTINE
	APUT	SI
	RET
;
LIN6:	APUT	DC1		;V/G
	RET
;
LIN7:	APUT	ESC		;P/E
	APUT	'I'
	RET
;
LIN8:	APUT	ESC		; HP2621
	APUT	'K'
	RET
	FORM
LIN9:	CALL	LIN7		; PE BANTAM
	LD	B,20
	CALL	NULLS
	RET
;
LIN10:	APUT	ESC		;GNAT SYSTEM 10
	APUT	'$'
	RET
;
LIN11:	APUT	1		;TRS80 P&T
	RET
;
lin99:	puts	clseq		; send clear line sequence
	mov	b,a,(clnul)	; send
	call	nulls		;	nulls
	ret
;
NULLS:	cpm	b,0		; null count?
	ret	z		; yes, exit
null:	APUT	0
	APUT	0
	DJNZ	NULL
	RET
;
puts:	ld	b,(hl)		; get count
	cpm	b,0		; null count?
	ret	z		; yes, exit
puts1:	inc	hl		; no, point to first character
	aput	(hl)		; send next character
	djnz	puts1		; looop
	ret
;
;
	end
C
       BLOCK DATA BLKDAT
C
C
       LOGICAL CD(45)
       INTEGER CSIZ, CXCNT
C
       COMMON /PARMS/ CD
C
       EQUIVALENCE (CD(4),CSIZ), (CD(6),CXCNT)
C
       DATA CSIZ, CXCNT /32, 32/
C
       END
C
      BLOCK DATA BLKDT2
C
      INTEGER CNFRUL(5,20), PRMRUL(5,19)
C
      COMMON /CONFDT/ CNFRUL
C
      EQUIVALENCE  (CNFRUL(1,2),PRMRUL(1,1))
C
      DATA PRMRUL/  1,  2,128,512,512,      3,  2,  1,512, 80, 
     +              5,  1,  1,  2,  1,      6,  1,  0,255,  0,
     +              7,  1,  3,255,  4,      8,  1,  4,255,  4, 
     +              9,  1, 10,255,255,     10,  1, 10,255,255,
     +             11,  1,  1,  2,  1,     12,  1,  3,255, 20,
     +             13,  1,  1,  2,  1,     14,  1,  0,  8,  8,
     +             15,  1,  3,255,  3,     16,  1,  0,  1,  0,
     +             17,  1,  1,255,255,     18,  1,  3, 10,  4, 
     +             19,  1,  0, 15,  7,     20, 12,  0,  8,  0,
     +             33,  1,  0,  1,  0/
C
C    each entry here has the form:
C
C        | index into PARMS | len | min val | max val | default val |
C
      END
C
      BLOCK DATA BLKDT3
C
C
       LOGICAL FNL
       COMMON /GLB/ FNL
       DATA FNL /12/
C
C
      END
C
      BLOCK DATA BLKDT4
C
C
       LOGICAL BASE
       COMMON /CRT/ BASE
       DATA BASE /10/
C
C
      END
C
      BLOCK DATA BLKDT5
C
C
       LOGICAL VERMSG(20)
       COMMON /VRS/ VERMSG
       DATA VERMSG /'V','e','r','s','i','o','n',32,32,'2','.','4',
     + '0','B','H',32,32,32,32,32/
C
C
      END
C
      BLOCK DATA BLKDT6
C
C	SET OF FLAGS FOR DETERMINING VERSION DIFFERENCES.  CURRENTLY:
C	  AUTOLF is used (1 if no LF's, 0 if LF's after CR's)
C	  PFILTR is used (1 if filter on, 0 if filter off)
C	  OPSYS is used (0 = who cares?, 1 = CDOS, 2 = CP/M)
C	  PRTMAX is used (nn = max number of displayable chars/printline)
C	  OPEN is used (0 => use openwr in dowrt, 1 => use openw)
C	  IOP is used (0 => no IOP processor, 1 => IOP)
C	THE REST ARE SPARES.
C
      LOGICAL VFLAGS(8), AUTOLF, PFILTR, OPSYS, OPEN, IOP
      INTEGER PRTMAX
      COMMON /DIFFS/ VFLAGS
      EQUIVALENCE (VFLAGS(1),AUTOLF), (VFLAGS(2),PFILTR),
     +            (VFLAGS(3),OPSYS),  (VFLAGS(4),PRTMAX),
     +		  (VFLAGS(6),OPEN),   (VFLAGS(7),IOP)
      DATA VFLAGS /0,  0,  2,  132,0,  1,  0,  0/
C
      END

      BLOCK DATA BLKDT7
C
C	OPERATOR CONSOLE WINDOWING PARAMETERS
C	  STXY is XY position of status window
C	  STSMAX is the number of lines in the status window
C	  TRCSTR is the startting line number opf the trace window
C	  TRCMAX is the number of lines in the trace window
C
      LOGICAL STSMAX, TRCSTR, TRCMAX
C
      INTEGER STXY
C
      COMMON /CURS/ STXY, STSMAX, TRCSTR, TRCMAX
C
      DATA STXY,STSMAX,TRCSTR,TRCMAX/0,8,9,12/
C
      END

      LOGICAL SPCFLG, RPTNUM, RPTREM, CRFLG, RECREM
      INTEGER BSIZ, RSIZ, BUFREM, CHRREM, RECLNG, CNT
#
      COMMON /PARMS/ CD
      COMMON /PAK/BUFREM,CHRREM,RECREM,RECLNG,SPCFLG,RPTNUM,RPTREM,CRFLG
#
      EQUIVALENCE (CD(8),PM(1)), (PM(1),BSIZ), (PM(3),RSIZ), (PM(17),BFAC)
#
      DATA CNT/6/
#
      BD(CNT) = 1
      BD(CNT+1) = 0
      BUFREM = BSIZ - 4
      CHRREM = RSIZ
      RECREM = BFAC
      SPCFLG = .FALSE.
      RETURN
      END

      SUBROUTINE INIBUF
#	INITIALIZE MESSAGE BUFFERS
#
      LOGICAL BD(520), CD(45), PM(28)
      LOGICAL SPCFLG, RPTNUM, RPTREM, RECREM, CRFLG
      INTEGER RSIZ, BUFREM, CHRREM, RECLNG, BSIZ1
#
      COMMON /PAK/BUFREM,CHRREM,RECREM,RECLNG,SPCFLG,RPTNUM,RPTREM,CRFLG
      COMMON /PARMS/ CD
      COMMON /BFRS/ BD
#
      EQUIVALENCE (CD(8),PM(1)), (PM(3),RSIZ), (BD(4),BSIZ1)
#
#
      BSIZ1 = 513
      RECLNG = RSIZ + 2
      CRFLG = .FALSE.			# INDICATE RECORD NOT TERMINATED
      RETURN
      END
DEFINE(BEG,{)
DEFINE(GEB,})
      SUBROUTINE DORD (DORDCT)
#	STORE FILES RECEIVED FROM REMOTE TERMINAL ON DISK
#
#	CALLING SEQ:
#		CALL DORD (DORDCT)
#
#	ENTRY:
#		DORDCT = NUM TIMES TO TRY TO OPEN LINE
#
#	EXIT:
#		NONE
#
#	COME FROM:
#		TERMEM, DOWRT, MANMOD
#
#
      LOGICAL STS, CHKCON, OPENR, OPNR, CLSINP, FMT
      LOGICAL DSKDRV,WRTFLG,RFILE(13),TFILE(13,21),TFIL$N,TFIL$I,RFIL$N,RFI
      INTEGER IND, DORDCT
#
      COMMON /FILES/DSKDRV,WRTFLG,RFILE,TFILE,TFIL$N,TFIL$I,RFIL$N,RFI
#
      DATA OPNR/0/
#
#
      FMT = RFILE(1) - 65 		# TRANSPARENCY TYPE FOR OPENR CALL
      WHILE  ( CHKCON(IDMY) )		# WHILE CONNECTION IS GOOD,
         BEG
	    IND = DORDCT		# NUMBER OF TIMES TO TRY THIS...
	    REPEAT
	       BEG
		  STS = OPENR( FMT )		# TRY TO OPEN LINE FOR READ
		  IND = IND - 1			#    A FINITE NUMBER OF TIMES
		  IF  ( IND == 0 & STS < 0 )	# IF NO GOOD,
		     RETURN			#	GIVE UP.
	       GEB
	    UNTIL  ( STS == OPNR )		# OTHERWISE...
	    CALL RCVBSC( RFILE, DSKDRV, RFIL$N, RFI )
	    STS = CLSINP( IDMY )
	 GEB
      RETURN
      END

#
      SUBROUTINE RCVBSC( RFILE, DSKDRV, RFIL$N, RFI )
#	RECEIVE BSC TRANSMISSION AND COPY TO PRINTER OR DISK
#
#	CALLING SEQ:
#		CALL RCVBSC( RFILE, DSKDRV, RFIL$N, RFI )
#
#	ENTRY:
#		RFILE = FILE TO RECEIVE TO
#		DSKDRV - UNUSED
#		RFIL$N = SEQUENCE NUMBER OF FILE (IN BINARY)
#		RFI = INDEX INTO RFILE TO ASCII SEQUENCE NUMBER CHARS
#
#	EXIT:
#		NONE
#
#
      LOGICAL BD(520), RFILE(1), RFI, DSKDRV, RFIL$N, STS, RDBSC, MSG(6,11)
      LOGICAL BMODE, BUF(1), LINE(514), DOPENW, BINBUF, ASCBUF, FNL
      LOGICAL G1,G2,G3,G6,G7,G8
 ГFNULU 1.5   (11/01/85)
