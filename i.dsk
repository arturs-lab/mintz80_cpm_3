  3855  1A41  20F6             	JR     	NZ,HGAP4X
  3856  1A43  B2               	OR     	A,D
  3857  1A44  20F3             	JR     	NZ,HGAP4X      	;Not 0000
  3858  1A46  CD6B1A           	CALL   	ZCRLF
