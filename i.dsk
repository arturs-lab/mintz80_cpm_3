  3821  1A09  CD4E1A           	CALL   	PMSG
  3822  1A0C  ED5B843A         	LD     	DE,(E_DATA_MARK)       	;Move Start of 
  3823  1A10  D5               	PUSH   	DE     	       	       	;save it
