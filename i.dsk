 003A 0C05C21A00	inr c ! dcr b ! jnz d$init$loop		; and loop for each drive
 003F C36300    	jmp boot$1
                
                	cseg	; following in resident memory
                
                boot$1:
                if debug
                	call iputs
                	db 'BOOT ',0
                endif
 0063 CD7800    	call set$jumps
 0066 CD0000    	call ?ldccp				; fetch CCP for first time
                if debug
                	call iputs
                	db 'JMP '
                	call spamon
                endif
 0069 C30001    	jmp ccp
                
                
                	; WBOOT
                	;	Entry for system restarts.
                
                wboot:
 006C 31D200    	lxi sp,boot$stack
 006F CD7800    	call set$jumps		; initialize page zero
 0072 CD0000    	call ?rlccp		; reload CCP
 0075 C30001    	jmp ccp			; then reset jmp vectors and exit to ccp
                
                
                set$jumps:
                if debug
                	call iputs
                	db 'SETJMP ',0
                endif
                if banked
 0078 3E01CD5100	mvi a,1 ! call ?bnksl
                endif
                
 007D 3EC3      	mvi a,JMP
 007F 3200003205	sta 0 ! sta 5		; set up jumps in page zero
 0085 2103002201	lxi h,?wboot ! shld 1	; BIOS warm start entry
 008B 2A00002206	lhld @MXTPA ! shld 6	; BDOS system call entry
 0091 C9        	ret
                
                
 0092           		ds 64
 00D2 =         boot$stack	equ $
                
                	dseg	; this part can be banked
                
