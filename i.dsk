  2899  1363  C8               	RET    	Z      	       	;Don't echo an ESC
  2900  1364  F5               	PUSH   	AF     	       	;Save it
  2901  1365  C5               	PUSH   	BC
  2902  1366  4F               	LD     	C,A
  2903  1367  CD1B01           	CALL   	CO     	       	;Echo it
  2904  136A  C1               	POP    	BC
  2905  136B  F1               	POP    	AF     	       	;get it back
  2906  136C  C9               	RET
  2907  136D            
  2908  136D  F5        ZCRLF: 	PUSH   	AF     	       	;Send CR/LF to CRT
  2909  136E  C5               	PUSH   	BC
  2910  136F  0E0D             	LD     	C,CR
  2911  1371  CD1B01           	CALL   	CO
  2912  1374  0E0A             	LD     	C,LF
  2913  1376  CD1B01           	CALL   	CO
  2914  1379  C1               	POP    	BC
  2915  137A  F1               	POP    	AF
  2916  137B  C9               	RET
  2917                  ;      	       	       	       	;Convert LC to UC
  2918  137C  FE61      UCASE: 	CP     	A,'a'  	       	;must be >= lowercase a
  2919  137E  D8               	RET    	C      	       	; else go back...
  2920  137F  FE7B             	CP     	A,'z'+1	       	;must be <= lowercase z
  2921  1381  D0               	RET    	NC     	       	; else go back...
  2922  1382  D620             	SUB    	A,'a'-'A'      	;subtract lowercase bia
  2923  1384  C9               	RET
  2924                  ;
  2925                  ;
  2926                  ; Return with 2 HEX digits in [A]. If abort, Carry flag
  2927  1385            GET_HEX:
  2928  1385  C5               	PUSH   	BC     	       	       	
  2929  1386  CD5B13           	CALL   	GETCMD 	       	;Get a character from k
  2930  1389  FE1B             	CP     	A,ESC
  2931  138B  282A             	JR     	Z,HEX_ABORT
  2932  138D  FE2F             	CP     	'/'    	       	;check 0-9, A-F
  2933  138F  3826             	JR     	C,HEX_ABORT
  2934  1391  FE47             	CP     	'F'+1
  2935  1393  3022             	JR     	NC,HEX_ABORT
  2936  1395  CDCE13           	CALL   	ASBIN  	       	;Convert to binary
  2937  1398  CB27             	SLA    	A
  2938  139A  CB27             	SLA    	A
  2939  139C  CB27             	SLA    	A
  2940  139E  CB27             	SLA    	A      	       	;Shift to high nibble  
  2941  13A0  47               	LD     	B,A    	       	;Store it
  2942  13A1  CD5B13           	CALL   	GETCMD 	       	;Get 2nd character from
  2943  13A4  FE1B             	CP     	A,ESC
  2944  13A6  280F             	JR     	Z,HEX_ABORT
  2945  13A8  FE2F             	CP     	'/'    	       	;check 0-9, A-F
  2946  13AA  380B             	JR     	C,HEX_ABORT
  2947  13AC  FE47             	CP     	'F'+1
  2948  13AE  3007             	JR     	NC,HEX_ABORT
  2949  13B0  CDCE13           	CALL   	ASBIN  	       	;Convert to binary
  2950  13B3  B0               	OR     	A,B    	       	;add in the first digit
  2951  13B4  B7               	OR     	A,A    	       	;To return NC
  2952  13B5  C1               	POP    	BC
  2953  13B6  C9               	RET
  2954  13B7            HEX_ABORT:
  2955  13B7  37               	SCF    	       	       	;Set Carry flag 
  2956  13B8  3E1B             	LD     	A,ESC
  2957  13BA  C1               	POP    	BC
  2958  13BB  C9               	RET
  2959                  ;
  2960                  ;
  2961                  ; Put 4 HEX characters in [HL] (To set RAM location etc
  2962                  ;
  2963  13BC            GET_HEX4:      	
  2964  13BC  2600             	LD      H,0000H
  2965  13BE  CD8513           	CALL   	GET_HEX	       	;get 2 HEX digits
  2966  13C1  3809             	JR     	C,SCAN_ABORT
  2967  13C3  67               	LD     	H,A
  2968  13C4  CD8513           	CALL   	GET_HEX	       	;get 2 more HEX digits
  2969  13C7  3803             	JR     	C,SCAN_ABORT
  2970  13C9  6F               	LD     	L,A
  2971  13CA  B7               	OR     	A,A    	       	;To return NC
  2972  13CB  C9               	RET
  2973  13CC            SCAN_ABORT:
  2974  13CC  37               	SCF    	       	       	;Set Carry flag 
  2975  13CD  C9               	RET
  2976  13CE            
  2977                  ; ASCII TO BINARY CONVERSION ROUTINE
  2978  13CE  D630      ASBIN: 	SUB    	30H 
  2979  13D0  FE0A             	CP     	0AH 
  2980  13D2  F8               	RET    	M
  2981  13D3  D607             	SUB    	07H 
  2982  13D5  C9               	RET
  2983  13D6            
