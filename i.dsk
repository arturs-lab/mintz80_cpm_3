 06A9 C3BF06    	JMP	DCBRECALIBRATE	;RETURN WITH ERROR STATUS...
                
                
                	;;;;; DRVSET
                	; OUTPUT THE HARDWARE SELECT BYTE TO THE VERSAFLOPPY SELECT PORT --
                	;
                	;	ON ENTRY:	[DSELBITS] = CURRENT DRIVE SELECT BITS
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	[AF] ALTERED, OTHERS UNALTERED
                	;
                DRVSET:
 06AC 3AE213    	LDA	DSELBITS	;GET CURRENT DRIVE SELECT BYTE
 06AF 2F        	CMA			;INVERT FOR HARDWARE
 06B0 D353      	OUT	VFL$SELECT	;SEND TO THE VERSAFLOPPY SELECT PORT
 06B2 C9        	RET			;THAT'S IT...
                
                
                	;;;;; DCBSTATUS
                	; GET TYPE I STATUS BYTE FROM WD179X --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	[A] = TYPE I STATUS BYTE
                	;
                	;	REGISTERS:	ALL UNALTERED BUT [AF]
                	;
                DCBSTATUS:
 06B3 3ED0      	MVI	A,FRCINT	;SEND OUT FORCE INTERRUPT COMMAND
 06B5 D354      	OUT	VFL$COMMAND
 06B7 3EFF      	MVI	A,0FFH	;;;;;0		;DELAY CONSTANT
 06B9 3D        DCBST0:	DCR	A		;DELAY TILL STATUS IS SETTLED
                	JRNZ	DCBST0
 06BA+20        	DB	20H
 06BB+FD        	DB	DCBST0-$-1
 06BC DB54      	IN	VFL$STATUS	;GET THE STATUS BYTE
 06BE C9        	RET
                
                
                	;;;;; DCBRECALIBRATE
                	; ROUTINE TO BRING THE HEAD OF THE SPECIFIED DRIVE TO TRACK 000 --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	C = 1 --> UNSUCCESSFUL RESTORE TO TRACK 00
                	;			C = 0 --> RESTORE SUCCESSFUL
                	;
                	;	REGISTERS:	ALL ALTERED
                	;
                DCBRECALIBRATE:
                	; SET UP RETRY COUNTER:
 06BF 21E713    	LXI	H,RRCOUNT	;POINT TO RESTORE RETRY COUNTER
 06C2 3602      	MVI	M,SEEKRETRY	;INITIALIZE TO # OF RESTORE RETRIES ALLOWED
                
                	; ATTEMPT TO RESTORE THE DRIVE:
 06C4 3E08      RECALP:	MVI	A,RECAL$179X	;[A] = WD179X RECALIBRATE OPCODE
 06C6 21E113    	LXI	H,STEPRATE	;POINT TO CURRENT STEP RATE
 06C9 B6        	ORA	M		;AND SET COMMAND UP FOR THAT STEPING RATE
 06CA CD2208    	CALL	STARTDCB	;START RESTORE OPERATION
 06CD 0608      	MVI	B,SEEKDLY	;DELAY FOR STATUS BITS TO SETTLE
                RECAL0:	DJNZ	RECAL0
 06CF+10        	DB	10H
 06D0+FE        	DB	RECAL0-$-1
 06D1 CD2A08    	CALL	WAITDCB		;WAIT FOR COMMAND COMPLETION
                	BIT	TRK00,A		;ARE WE AT TRACK 0 ?
 06D4+CB57      	DB	0CBH,TRK00*8+A+40H
                	JRZ	RECAL$ERR	;SKIP SUCCESS CODE IF ERRORS...
 06D6+28        	DB	28H
 06D7+05        	DB	RECAL$ERR-$-1
                
                	; HERE ON SUCCESSFUL RESTORE TO TRACK 00:
 06D8 AF        	XRA	A		;C=0 FOR GOOD RETURN
 06D9 32DE13    	STA	CURCYL		;SET UP CURRENT CYLINDER BYTE
 06DC C9        	RET			;GO BACK WITH C=0...
                
                	; ARRIVE HERE ON RECALIBRATE ERROR:
                RECAL$ERR:
 06DD 21E713    	LXI	H,RRCOUNT	;POINT TO RESTORE RETRY COUNTER
 06E0 35        	DCR	M		;RETRIES = RETRIES - 1
                	JRNZ	RECALP		;RETRY IF MORE AVAILABLE...
 06E1+20        	DB	20H
 06E2+E1        	DB	RECALP-$-1
 06E3 3EFF      	MVI	A,-1		;INVALIDATE CURRENT CYLINDER
 06E5 32DE13    	STA	CURCYL
 06E8 37        	STC			;SET C=1 FOR ERROR RETURN
 06E9 3E02      	MVI	A,2		;ERROR CODE IF RECALIBRATE ERROR
 06EB C9        	RET			;GO BACK...
                
                
                	;;;;; DCBSEEK
                	; SEEK TO SPECIFIED TRACK ON THE CURRENT DRIVE --
                	;
                	;	ON ENTRY:	[[SECIDS]] = CYLINDER TO SEEK TO
                	;
                	;	ON EXIT:	C = 1 --> UNSUCCESSFUL SEEK
                	;			C = 0 --> SUCCESSFUL SEEK OPERATION
                	;
                	;	REGISTERS:	ALL ALTERED
                	;
                DCBSEEK:
                	; SET UP RETRY COUNT BEFORE WE SEEK:
 06EC 21E813    	LXI	H,SRCOUNT	;POINT TO COUNTER BYTE
 06EF 3602      	MVI	M,SEEKRETRY	;AND INITIALIZE IT
                
                	; ATTEMPT TO SEEK TO REQUESTED CYLINDER:
 06F1 3ADE13    SEEKLP:	LDA	CURCYL		;GET DRIVE CURRENT CYLINDER
 06F4 FEFF      	CPI	-1		;NEED TO RECALIBRATE ?
                	JRNZ	SEEK00		;NO -- THEN SKIP NEXT...
 06F6+20        	DB	20H
 06F7+04        	DB	SEEK00-$-1
 06F8 CDBF06    	CALL	DCBRECALIBRATE	;ELSE TRY TO RECALIBRATE DRIVE
 06FB D8        	RC			;RETURN IF RESTORE ERROR...
 06FC D355      SEEK00:	OUT	VFL$TRACK	;TELL WD179X CURRENT TRACK POSITION
 06FE 2A6113    	LHLD	SECIDS		;GET REQUESTED TRACK
 0701 BE        	CMP	M		;ARE WE ALREADY THERE ?
 0702 C8        	RZ			;YES -- THEN RETURN WITH NO PHYSICAL SEEK...
 0703 7E        	MOV	A,M		;TO [A]
 0704 D357      	OUT	VFL$DATA	;TELL WD179X OF REQUESTED CYLINDER
 0706 3E18      	MVI	A,SKNV$179X	;[A] = SEEK COMMAND OPCODE
 0708 21E113    	LXI	H,STEPRATE	;COMBINE WITH CURRENT STEP RATE
 070B B6        	ORA	M
 070C CD2208    	CALL	STARTDCB	;START SEEK OPERATION
 070F 0608      	MVI	B,SEEKDLY	;DELAY FOR STATUS BITS TO SETTLE AFTER COMMAND
                SKDLY:	DJNZ	SKDLY
 0711+10        	DB	10H
 0712+FE        	DB	SKDLY-$-1
 0713 CD2A08    	CALL	WAITDCB		;WAIT FOR SEEK COMPLETION
 0716 E690      	ANI	SKERMSK		;ANY ERRORS ?
                	JRNZ	SEEK$ERR	;YES -- SKIP SUCCESS CODE...
 0718+20        	DB	20H
 0719+0C        	DB	SEEK$ERR-$-1
                
                	; HERE IF SEEK COMMAND EXECUTED CORRECTLY -- VERIFY TRACK SEEKED TO
                	; WITH REQUESTED TRACK:
 071A DB55      	IN	VFL$TRACK	;GET CYLINDER SEEKED TO
 071C 32DE13    	STA	CURCYL		;UPDATE CURRENT CYLINDER BYTE
 071F 47        	MOV	B,A		;KEEP IN [B]
 0720 2A6113    	LHLD	SECIDS		;GET CYLINDER REQUESTED
 0723 7E        	MOV	A,M
 0724 B8        	CMP	B		;THE SAME ?
 0725 C8        	RZ			;YES -- RETURN WITH C=0...
                				;ELSE FALL THROUGH TO SEEK ERROR CODE...
                
                	; ARRIVE HERE ON SEEK ERRORS:
                SEEK$ERR:
 0726 3EFF      	MVI	A,-1		;INVALIDATE CURRENT CYLINDER BYTE
 0728 32DE13    	STA	CURCYL
 072B 21E813    	LXI	H,SRCOUNT	;POINT TO RETRY COUNTER
 072E 35        	DCR	M		;RETRIES = RETRIES - 1
                	JRNZ	SEEKLP		;TRY AGAIN IF MORE RETRIES AVAILABLE...
 072F+20        	DB	20H
 0730+C0        	DB	SEEKLP-$-1
                
                	; ARRIVE HERE ON HARD SEEK ERROR:
                SEEK01:
 0731 37        	STC			;SET C=1 FOR ERROR RETURN
 0732 3E03      	MVI	A,3		;ERROR CODE IF SEEK ERROR
 0734 C9        	RET			;GO BACK...
                
                
                	;;;;; DCBWTRK
                	; WRITE TRACK AND FORMAT IT --
