;
; 5", 1K byte, DDDS, 5 sector MORROW MD3 format
MORROW: DB	5		;sectors per track
	DB	40		;tracks per side
	DB	01110000B	;Disk HW_BYTE (DDDS)
	DB	80		;index header gap
	DB	12		;GAP 1
	DB	22		;GAP 2
	DB	50		;GAP 3
	DB	192		;GAP 4 (4E's) (574)
