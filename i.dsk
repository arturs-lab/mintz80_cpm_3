    99  0100            
   100        (0080)    NBYTES 	EQU    	128    	       	;BYTES PER SECTOR UNIT 
   101        (000A)    LF     	EQU    	0AH
   102        (000D)    CR     	EQU    	0DH
   103        (0007)    BELL   	EQU    	07H
   104        (001A)    CLEAR  	EQU    	1AH    	       	;SD Systems Video Board
   105        (0009)    TAB    	EQU    	09H
   106        (001B)    ESC    	EQU    	1BH
   107        (001C)    EOL    	EQU    	1CH    	       	;SD Systems Video Board
   108        (0010)    PAGE_SIZE EQU  	16     	       	;Number of lines at a t
   109        (0005)    STATUS_DELAY EQU 5     	       	;Time-out for waiting f
   110                  ;
   111        (0001)    RO_FLAG	EQU    	01     	       	;Flag for sequental sec
   112        (0002)    WO_FLAG	EQU    	02     	       	;Flag for sequental sec
   113        (0003)    RW_FLAG	EQU    	03     	       	;Flag for sequental sec
   114        (0004)    RRW_FLAG EQU   	04     	       	;Flag for random track 
   115        (0005)    TRK_RO_FLAG EQU	05     	       	;Flag for reading secto
   116        (0001)    CPM86_FLAG  EQU	01     	       	;Flag to indicate after
