   111                  ;Register IX is not used for anything else in this prog
   112  0100            
   113                  ; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
   114                  ;
   115        (0000)    NSCTRS 	EQU    	0      	;Sectors/Track for disk
   116        (0001)    NTRKS  	EQU    	1      	;Tracks/Side
   117        (0002)    HEADR  	EQU    	2      	;For Formatting
   118        (0003)    GAP1   	EQU    	3      	;      	"
   119        (0004)    GAP2   	EQU    	4      	;      	"
   120        (0005)    GAP3   	EQU    	5      	;      	"
   121        (0006)    GAP4   	EQU    	6      	;      	"
   122        (0007)    GAP4R  	EQU    	7      	;      	"
