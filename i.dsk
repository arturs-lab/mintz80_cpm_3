	POP	BC			; 	REGS
	RET				; EXIT
	FORM
;
;	GETBAT - GET RAW BATCH CHARACTER
;
;	EXIT:
;		REG A - CHARACTER (1AH = EOF)
;
GETBAT:	LD	HL,(BATCNT)		; BUFFER	
	LD	A,H			;	EMPTY?
	OR	L			;	....
	JR	NZ,GBOK			; NO
	MOV	(BBFR),HL,BATBFR	; YES, RESET CURRENT BFR ADR
	LD	HL,BATBFR		; READ
	LD	DE,BATCNT		;	NEXT
	CALL	READB			;	BATCH BUFFER; READ OKAY?
	JR	Z,GBOK			;YES
	LD	A,CNT$Z			; NO, INDICATE EOF
	RET				; EXIT
;
GBOK:	LD	HL,(BBFR)		; GET NEXT
	LD	A,(HL)			;	CHARACTER
	INC	HL			;	& UPDATE
	LD	(BBFR),HL		;	CURRENT BFR POINTER
	LD	HL,(BATCNT)		; INDICATE ONE
	DEC	HL			;	LESS CHAR IN BUFFER
	LD	(BATCNT),HL		;	.....
	RET				; EXIT
	DATA
BBFR:	DW	0			; CURRENT BATCH BUFFER POINTER
BATCNT:	DW	0			; CURRENT BATCH BUFFER COUNT
BATBFR:	DS	128			; BATCH BUFFER
;	POS
;
;		SET CURSOR TO SPECIFIED X Y COORDINATES
;
;	CALLING SEQUENCE:
;		CALL POS( X, Y )
;		LD	HL,XADR
;		LD	DE,YADR
;		CALL	POS
;
;	ENTRY:
;		REG HL	XADR - X COORD ADR (BYTE) (0,79)
;		REG DE	YADR - Y COORD ADR (BYTE) (0,23)
;
;	EXIT:
;		ALL REGS PRESERVED
;
;
;	ASCII EQUATES
;
	ENTRY	POS
	EXT	posr      
	REL
POS:	LD	C,(HL)		;GET X COORD
	EX	DE,HL		;GET Y
	LD	B,(HL)		;	COORD
	CALL	POSR		;DO POSITIONING
	RET
	FORM
;
;
	END
DEFINE(BEG,{)
DEFINE(GEB,})
      LOGICAL FUNCTION PACK( CHR, BD, TRAN )
#     PACK NEXT CHARACTER INTO BISYNC BUFFER
#     EXIT:
#         1 = FULL
#         2 = NOT FULL
      LOGICAL CHR, BD(1), FULL, DONXT, CR, NONTRN
      LOGICAL SPCFLG, RPTNl80
rbte#1/n,rbtelib,iodep#1/e
ISKIO.Z80
13/
      DATA NONTRN,ASCTRN,BINTRN/78,65,66/, BLANK/32/
#
      PACK = DONXT
      IF( CHR == CR )     #CHAR = CR?
          BEG             #YES
              IF( CRFLG & (TRAN ^= BINTRN) )  #RECORD TERMINATED?
                  BEG
                      CRFLG = .FALSE.  #IGNORE CR AFTER FULL RECORD
                      RETURN
                  GEB
              IF( TRAN == ASCTRN )    #ASCII TRANSPARENCY?
                  BEG     #YES
                      WHILE ( CHRREM > 0 )
                          CALL PUT( BD, BLANK )    #BLANK FILL REMAINING RECORD
                      PACK = RECTRM( BD, TRAN )      #TERMINATE RECORD
                      RETURN
                  GEB
              IF( TRAN == NONTRN )    #NON TRANSPARENT DATA?
                  BEG     #YES
                      CALL LOGMRK( BD, TRAN )     #ADD LOGICAL TERMINATOR
                      PACK = RECTRM( BD, TRAN )   #TERMINATE RECORD
                      RETURN
                  GEB
          GEB
      CRFLG = .FALSE.  #INDICATE RECORD NOT TERMINATED
      CALL COMPUT( BD, CHR, TRAN )    #PACK NEXT CHAR
      IF( CHRREM == 0 )    #RECORD FULL?
          BEG
              PACK = RECTRM( BD, TRAN )   #TERMINATE RECORD
              CRFLG = .TRUE.  #INDICATE RECORD TERMINATED
          GEB
      RETURN
      END

      LOGICAL FUNCTION RECTRM( BD, TRAN )
#     TERMINATE RECORD WITH PHYSICAL TERMINATOR & RETURN BUFFER STATUS
#     RECTRM = FULL (1) INDICATES BUFFER FULL
#     RECTRM = DONXT (2) INDICATES BUFFER NOT FULL
      LOGICAL FULL, DONXT, BD(1), TRAN
      LOGICAL SPCFLG, RPTNUM, RPTREM, RECREM, CRFLG
#
      INTEGER BUFREM, CHRREM, RECLNG
#
      COMMON/PAK/BUFREM,CHRREM,RECREM,RECLNG,SPCFLG,RPTNUM,RPTREM,CRFLG
#
      DATA FULL,DONXT/1,2/
#
      RECTRM = FULL   #DEFAULT AS FULL
      CALL PHYMRK( BD, TRAN )     #ADD PHYSICAL TERMINATOR
      IF( RECREM == 0 )   #MAX RECORDS PACKED?
          RETURN  #YES
      IF( BUFREM < RECLNG )   #CAN ANOTHER RECORD FIT?
          RETURN  #NO
      RECTRM = DONXT      #INDICATE NOT FULL
      RETURN
      END

      SUBROUTINE LOGMRK( BD, TRAN )
#     INSERT LOGICAL TERMINATOR IF ENABLED
      LOGICAL BD(1), TRAN, NONTRN
      LOGICAL CD(35)
      LOGICAL PM(28), LTRM
#
      COMMON /PARMS/ CD
#
      EQUIVALENCE (CD(8),PM(1)), (PM(6),LTRM)
#
      DATA NONTRN/78/
#
      CALL TRMSPC( BD )
      IF( LTRM == 0 | TRAN ^= NONTRN )
          RETURN
      CALL PUT ( BD, LTRM )
      RETURN
      END

      SUBROUTINE PHYMRK( BD, TRAN )
#     INSERT PHYSICAL TERMINATOR
      LOGICAL BD(1), P$IRS, P$IUS, IRS, IUS, TRAN, NONTRN
      LOGICAL CD(35)
      LOGICAL PM(28), PTRM
      LOGICAL SPCFLG, RPTNUM, RPTREM, RECREM, CRFLG
#
      INTEGER BUFREM, CHRREM, RECLNG, RSIZ
#
      COMMON /PAK/BUFREM,CHRREM,RECREM,RECLNG,SPCFLG,RPTNUM,RPTREM,CRFLG
      COMMON /PARMS/ CD
#
      EQUIVALENCE (CD(8),PM(1)), (PM(5),PTRM), (PM(3),RSIZ)
#
      DATA P$IRS,P$IUS/1,2/, IRS,IUS/30,31/, NONTRN/78/
#
      RECREM = RECREM - 1
      IF(TRAN ^= NONTRN)
          BEG
              CHRREM = RSIZ
              RETURN
          GEB
      CALL TRMSPC( BD )
      IF( PTRM == P$IRS )
          CALL PUT( BD, IRS )
      ELSE
          CALL PUT( BD, IUS )
      CHRREM = RSIZ
      RETURN
      END

      SUBROUTINE COMPUT( BD, CHR, TRAN )
#     COMPRESS ALL REPEATED BLANK SEQUENCES TO (IGS)(N)
#     BEFORE PACKING INTO BUFFER
      LOGICAL BD(1), NONTRN, CHR, CMPOFF, SPACE, TRAN
      LOGICAL CD(35)
      LOGICAL PM(28), COMP
      LOGICAL SPCFLG, RPTNUM, RPTREM, RECREM, CRFLG
#
      INTEGER BUFREM, CHRREM, RECLNG
#
      COMMON /PAK/BUFREM,CHRREM,RECREM,RECLNG,SPCFLG,RPTNUM,RPTREM,CRFLG
      COMMON /PARMS/ CD
#
      EQUIVALENCE (CD(8),PM(1)), (PM(16),COMPC
       BLOCK DATA BLKDAT
C
C
       LOGICAL CD(45)
       INTEGER CSIZ, CXCNT
C
       COMMON /PARMS/ CD
C
       EQUIVALENCE (CD(4),CSIZ), (CD(6),CXCNT)
C
       DATA CSIZ, CXCNT /32, 32/
C
       END
C
      BLOCK DATA BLKDT2
C
      INTEGER CNFRUL(5,20), PRMRUL(5,19)
C
      COMMON /CONFDT/ CNFRUL
C
      EQUIVALENCE  (CNFRUL(1,2),PRMRUL(1,1))
C
      DATA PRMRUL/  1,  2,128,512,512,      3,  2,  1,512, 80, 
     +              5,  1,  1,  2,  1,      6,  1,  0,255,  0,
     +              7,  1,  3,255,  4,      8,  1,  4,255,  4, 
     +              9,  1, 10,255,255,     10,  1, 10,255,255,
     +             11,  1,  1,  2,  1,     12,  1,  3,255, 20,
     +             13,  1,  1,  2,  1,     14,  1,  0,  8,  8,
     +             15,  1,  3,255,  3,     16,  1,  0,  1,  0,
     +             17,  1,  1,255,255,     18,  1,  3, 10,  4, 
     +             19,  1,  0, 15,  7,     20, 12,  0,  8,  0,
     +             33,  1,  0,  1,  0/
C
C    each entry here has the form:
C
C        | index into PARMS | len | min val | max val | default val |
C
      END
C
      BLOCK DATA BLKDT3
C
C
       LOGICAL FNL
       COMMON /GLB/ FNL
       DATA FNL /12/
C
C
      END
C
      BLOCK DATA BLKDT4
C
C
       LOGICAL BASE
       COMMON /CRT/ BASE
       DATA BASE /10/
C
C
      END
C
      BLOCK DATA BLKDT5
C
C
       LOGICAL VERMSG(20)
       COMMON /VRS/ VERMSG
       DATA VERMSG /'V','e','r','s','i','o','n',32,32,'2','.','4',
     + '0','B','H',32,32,32,32,32/
C
C
      END
C
      BLOCK DATA BLKDT6
C
C	SET OF FLAGS FOR DETERMINING VERSION DIFFERENCES.  CURRENTLY:
C	  AUTOLF is used (1 if no LF's, 0 if LF's after CR's)
C	  PFILTR is used (1 if filter on, 0 if filter off)
C	  OPSYS is used (0 = who cares?, 1 = CDOS, 2 = CP/M)
C	  PRTMAX is used (nn = max number of displayable chars/printline)
C	  OPEN is used (0 => use openwr in dowrt, 1 => use openw)
C	  IOP is used (0 => no IOP processor, 1 => IOP)
C	THE REST ARE SPARES.
C
      LOGICAL VFLAGS(8), AUTOLF, PFILTR, OPSYS, OPEN, IOP
      INTEGER PRTMAX
      COMMON /DIFFS/ VFLAGS
      EQUIVALENCE (VFLAGS(1),AUTOLF), (VFLAGS(2),PFILTR),
     +            (VFLAGS(3),OPSYS),  (VFLAGS(4),PRTMAX),
     +		  (VFLAGS(6),OPEN),   (VFLAGS(7),IOP)
      DATA VFLAGS /0,  0,  2,  132,0,  1,  0,  0/
C
      END

      BLOCK DATA BLKDT7
C
C	OPERATOR CONSOLE WINDOWING PARAMETERS
C	  STXY is XY position of status window
C	  STSMAX is the number of lines in the status window
C	  TRCSTR is the startting line number opf the trace window
C	  TRCMAX is the number of lines in the trace window
C
      LOGICAL STSMAX, TRCSTR, TRCMAX
C
      INTEGER STXY
C
      COMMON /CURS/ STXY, STSMAX, TRCSTR, TRCMAX
C
      DATA STXY,STSMAX,TRCSTR,TRCMAX/0,8,9,12/
C
      END
w#ВЂЙ·И6 #=Г‰ЇХВ”СЙ!␀␀
