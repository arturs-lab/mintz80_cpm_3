 03AA CD3507    	CALL	DCBWTRK		;FORMAT TRACK
 03AD C1        	POP	B		;GET BACK THE LOOP COUNT
 03AE DC5B04    	CC	DPY$ERROR	;DISPLAY FORMATTING ERROR
