	; 8", 128 byte, DDSS, 50 sector format:
SS8$1:		db	SIZE8		;8" disk
		db	DDEN		;double density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no skew table
		db	50		;50 sectors / track
		db	77		;77 tracks
		db	13		;GAP3
		dw	204		;GAP4
		db	CPMFMT		;format character
		db	SEC128		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	5		;format type 5
		db	-1		;no auxilliary code

	; 8", 512 byte, DDSS, 15 sector format:
SS8$2:		db	SIZE8		;8" disk
		db	DDEN		;double density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no sector skew
		db	15		;15 sectors / track
		db	77		;77 tracks
		db	84		;GAP3
		dw	400		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	6		;format type 6
		db	-1		;no auxilliary code

