   119        (009F)    ID_ERR_MASK     EQU 9FH	       	;Sector ID read error m
   120        (00BF)    RS_ERR_MASK     EQU 0BFH       	;Read sector data error
   121        (00EF)    WS_ERR_MASK    	EQU 0EFh       	;Write sector data erro
   122        (0080)    RT_ERR_MASK     EQU 80H	       	;Read Track error mask
   123        (00E0)    WT_ERR_MASK     EQU 0E0H       	;Write Track error mask
   124                  ;
   125                  ;
   126        (4000)    FBUFFER	EQU    4000H   	       	;Buffer to build track 
   127        (5000)    FBUFFER2 EQU   5000H   	       	;2nd buffer here for se
   128                  ;
   129                  ;The Index register IX is used throughout the program t
   130                  ;table of the currently selected drive/disk format
   131                  ;[IX+HW_BYTE] will point to (DRIVE) and will contain th
   132                  ;hardware selection bits. Drive select 0,1,2,3 and side
   133                  ;other flags (see below) 
   134                  ;Remember the bits for disk selection, density and side
   135                  ;the actual Versafloppy II board hardware
   136                  ;Register IX is not used for anything else in this prog
   137  0100            
   138                  ; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
   139                  ;
   140        (0000)    NSCTRS 	EQU    	0      	;Sectors/Track for disk
   141        (0001)    NTRKS  	EQU    	1      	;Tracks/Side
   142        (0002)    HEADR  	EQU    	2      	;For Formatting
   143        (0003)    GAP1   	EQU    	3      	;      	"
   144        (0004)    GAP2   	EQU    	4      	;      	"
   145        (0005)    GAP3   	EQU    	5      	;      	"
   146        (0006)    GAP4   	EQU    	6      	;      	"
   147        (0007)    GAP4R  	EQU    	7      	;      	"
   148        (0008)    RSCMD  	EQU    	8      	;8" & 5" drives have differnt s
   149        (0009)    SKNCMD 	EQU    	9      	;SEEK NO VERIFY CMD
   150        (000A)    SKCMD  	EQU    	10     	;SEEK WITH VERIFY CMD
   151        (000B)    RDACMD 	EQU    	11     	;READ TRACK/SECTOR ID CMD
   152        (000C)    RDCMD  	EQU    	12     	;READ SECTOR CMD
   153        (000D)    WRCMD  	EQU    	13     	;WRITE SECTOR CMD
   154        (000E)    WRTCMD 	EQU    	14     	;Write a whole track command
   155        (000F)    RDTCMD 	EQU    	15     	;Read a whole track command
   156        (0010)    SIZE   	EQU    	16     	;1=128 Byte sectors.....4=1024 
   157        (0011)    HW_BYTE	EQU    	17     	;Will contain bit flags for:-
   158  0100                   	       	       	       	       	       	;Bits 0
   159  0100                   	       	       	       	       	       	;Bits 2
   160  0100                   	       	       	       	       	       	;Bit 4=
   161  0100                   	       	       	       	       	       	;Bit 5=
   162  0100                   	       	       	       	       	       	;Bit 6=
   163  0100                   	       	       	       	       	       	;Bit 7=
   164  0100                   	       	       	       	       	       	;      
   165  0100                   	       	       	       	       	       	;Note: 
   166  0100                   	       	       	       	       	       	;centra
   167  0100                   	       	       	       	       	       	;progra
   168        (0012)    GAP_FILL_CHAR  EQU 18  	;Byte used in disk formating
   169        (0013)    DATA_FILL_CHAR EQU 19  	;     "       "       "
   170        (0014)    TRK_SIZE       EQU 20  	;TWO bytes containing the track
   171        (0016)    SPECIAL_FLAG   EQU 22  	;flag byte for cases where afte
   172  0100                   	       	       	;normally 0, CPM86_FLAG = 1
   173        (0017)    SKEW   	       EQU 23  	;Low address of sector skew tab
   174        (0018)    SKEW1          EQU 24  	;High address of sector skew ta
   175        (0019)    TITLE  	       EQU 25  	;Text string describing the dis
   176  0100            
   177                  ;------------------------------------------------------
   178  0100                   	ORG    	100H
