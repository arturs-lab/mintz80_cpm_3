		db	32		;format type 32
		db	-1		;no auxilliary code

	; TELEVIDEO:
DS5$15:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$15skw	;pointer to hard sector skew table
		db	18		;18 sectors / track
		db	80		;80 tracks
		db	16		;GAP3
		dw	242		;GAP4
		db	CPMFMT		;format character
		db	SEC256		;sector size code
		db	0		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	33		;format type 33
		db	-1		;no auxilliary code
DS5$15skw:	skew	18,3,1

	; TOSHIBA T-100:
DS5$16:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no hard sector skew
		db	16		;16 sectors / track
		db	70		;70 tracks
		db	50		;GAP3
		dw	366		;GAP4
		db	CPMFMT		;format character
		db	SEC256		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	34		;format type 34
		db	-1		;no auxilliary code

	; ZENITH Z-100:
DS5$17:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no hard sector skew
		db	8		;8 sectors / track
		db	80		;80 tracks
		db	26		;GAP3
		dw	1454		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	35		;format type 35
		db	-1		;no auxilliary code

	; 3R AVATAR:
DS5$18:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no hard sector skew
		db	10		;10 sectors / track
		db	80		;80 tracks
		db	12		;GAP3
		dw	394		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	38		;format type 38
		db	-1		;no auxilliary code

	; CASIO FP-1000:
DS5$19:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	DS5$19skw	;ptr to hard sector skew table
		db	16		;16 sectors / track
		db	80		;80 tracks
		db	54		;GAP3
		dw	302		;GAP4
		db	CPMFMT		;format character
		db	SEC256		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	39		;format type 39
		db	-1		;no auxilliary code
DS5$19skw:	skew	16,8,1

	; COLUMBIA DATA, CP/M 86:
DS5$20:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no hard sector skew
		db	8		;8 sectors / track
		db	80		;80 tracks
		db	80		;GAP3
		dw	1022		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	40		;format type 40
		db	-1		;no auxilliary code

	; PMC MICROMATE:
DS5$21:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double-sided
		dw	NOSKEW		;no hard sector skew
		db	5		;5 sectors / track
		db	80		;80 tracks
		db	85		;GAP3
		dw	399		;GAP4
		db	CPMFMT		;format character
		db	SEC1024		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	41		;format type 41
		db	-1		;no auxilliary code

	; 5", IBM PC, MSDOS 2.x, 512 byte, DDDS, 9 sector format:
DS5$22:		db	SIZE5		;5" disk
		db	DDEN		;double density
		db	TWOHEAD		;double sided
		dw	NOSKEW		;no sector skew
		db	9		;9 sectors / track
		db	80		;80 tracks
		db	80		;GAP3
		dw	386		;GAP4
		db	CPMFMT		;format character
		db	SEC512		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	1		;2nd side is head #1
		db	42		;format type 42
		db	5		;auxilliary code #5

;*									      *
;******************************************************************************

	; program stack area  Note program uses a deep stack. So allow plenty of space
		ds	64	;32 level stack
stktop		equ	$


trk$buffer	DS	2000H	;format buffer for TRACK image. 
				;At end so plenty of space in case of overrun

;END
               ; Turn on or off the hardware wait state generator. Thi
  1564                  ; as bytes are read/written to the 179x/Disk
  1565                  ;
  1566                  ;      	DISABLE WAIT STATES
  1567  0ACF            WAIT_OFF:                ;*
                ;*		VERSAFLOPPY II/696 5" AND 8" DISK FORMATTER		      *
                ;*		-------------------------------------------		      *
                ;*		WRITTEN	BY		GEOFFREY SHAPIRO		      *
                ;*					AJS INDUSTRIES CORP.		      *
                ;*		VERSION 1.0		MARCH, 1984			      *
                ;*		(8-24-1984) -- CORRECTED FORMATTING OF IBM PC CPM-86 DISKS    *
                ;*									      *
                ;*	GENERAL EQUATES:						      *
                ;*									      *
                
                	; DEFINE LOGICAL VALUES:
 0000 =         FALSE		EQU	0
 FFFF =         TRUE		EQU	NOT FALSE
                
                	; DEFINE WHICH WD CHIP CONTROLLER IS BEING USED:
 0000 =         WD1795		EQU	FALSE
                
                	; DEFINE Z-80 CLOCK SPEED:
 0005 =         MHZ		EQU	5
 0006 #         SEEKDLY		SET	6
                	REPT	(MHZ-4)
                SEEKDLY		SET	SEEKDLY+2
                	ENDM
                
                	; INCLUDE Z-80 MACRO LIBRARY:
                	MACLIB	Z80
                
                	; INCLUDE CP/M 3.0 MACRO LIBRARY:
                	MACLIB	CPM3
                
                ;SD SYSTEMS S100 VERSAFLOPPY II HARDWARE
                ;BASE PORT FOR 179X FLOPPY CONTROLLER
                ;
 0050 =         VFL$BASE	EQU	50H	;<<<<<-- NOTE I USE A DIFFERENT PORT TO SD SYSTEMS >>>>	
 0050 =         VFL$RESET	EQU	VFL$BASE	;THEY USE 60H. THIS CONFLICTS WITH THE LOMAS VIDEO BOARD
 0053 =         VFL$SELECT	EQU	VFL$BASE+3
 0054 =         VFL$STATUS	EQU	VFL$BASE+4
 0054 =         VFL$COMMAND	EQU	VFL$BASE+4
 0055 =         VFL$TRACK	EQU	VFL$BASE+5
 0056 =         VFL$SECTOR	EQU	VFL$BASE+6
 0057 =         VFL$DATA	EQU	VFL$BASE+7
                ;
                	; SOME SCREEN ORIENTED DEFINITIONS:
 001A =         CLR1		EQU	1AH	;FOR CLEAR SCREEN ON SD SYSTEMS 8024 VDB BOARD
 0000 =         CLR2		EQU	0
 0000 =         CLR3		EQU	0
 0080 =         RPTCMD		EQU	80H	;CHARACTER REPETITION COMMAND FOR LINE OUTPUT
 00FF =         PTRCMD		EQU	0FFH	;RECURSIVE STRING PRINT COMMAND
 0008 =         BACKSPACE	EQU	8	;ASCII BACKSPACE CHARACTER
 0000 =         DELIMITER	EQU	0	;STRING TERMINATOR
 000D =         CR		EQU	13	;ASCII CARRIAGE RETURN
 000A =         LF		EQU	10	;ASCII LINEFEED
 001B =         ESC		EQU	1BH	;ASCII ESCAPE CHARACTER
                
                	; WD179X DISK OPERATION OPCODES:
 00D0 =         FRCINT		EQU	0D0H	;FORCE INTERRUPT COMMMAND
 0018 =         SKNV$179X	EQU	18H	;SEEK WITH NO VERIFY COMMAND
 0008 =         RECAL$179X	EQU	8	;RECALIBRATE COMMAND
                	IF	WD1795
                RTRK$179X	EQU	98H	;READ TRACK COMMAND FOR WD1795
                WRT$179X	EQU	0A8H	;WRITE SECTOR COMMAND FOR WD1795
                	ELSE
 0090 =         RTRK$179X	EQU	90H	;READ TRACK COMMAND FOR WD1791
 00A2 =         WRT$179X	EQU	0A2H	;WRITE SECTOR COMMAND FOR WD1791-4
                	ENDIF
 00F4 =         WRTRK$179X	EQU	0F4H	;WRITE TRACK AND FORMAT COMMAND
 0002 =         SEEKRETRY	EQU	2	;# TIMES TO RETRY RESTORES OR SEEKS
 0003 =         RWRETRY		EQU	3	;# TIMES TO RETRY READS OR WRITES
 0000 =         WDBUSY		EQU	0	;BIT TO TEST FOR WD179X BUSY STATE
 0002 =         TRK00		EQU	2	;BIT TO TEST FOR HEAD AT TRACK 0
 0006 =         WRTPROT		EQU	6	;BIT TO TEST FOR WRITE-PROTECTED DISK
 0007 =         DRVRDY		EQU	7	;BIT TO TEST FOR DRIVE NOT READY
 0090 =         SKERMSK		EQU	90H	;ERROR BITS TO TEST FOR AFTER SEEK
 008C =         RDERMSK		EQU	8CH	;ERROR BITS TO TEST AFTER MULTIPLE READ SECTOR
 00E4 =         WRTERMSK	EQU	0E4H	;ERROR BITS TO TEST FOR AFTER WRITE TRACK
                ;WRTERMSK	EQU	0E0H	;<--- 0E4H DOES NOT SEEM TO WORK FOR MY 1791 BOARD
                				;WITH GREATER THAN 128 BYTE SECTORS I GET
                				;THE DRQ BIT SET. YET THE TRACK SEEMS FINE.
 00BC =         WRERMSK		EQU	0BCH	;ERROR BITS TO TEST FOR AFTER WRITE SECTOR
                
                	; BDOS FUNCTION #'S AND OTHER RELATED VARIABLES:
 0000 =         WBOOT		EQU	0	;WARM BOOT VECTOR
 0005 =         BDOS		EQU	5	;BDOS ENTRY POINT
 005D =         FCB0		EQU	05DH	;ADDRESS OF DEFAULT FCB
 0002 =         COUTF		EQU	2	;NORMAL CONSOLE OUTPUT FUNCTION #
 0006 =         DCONOUT		EQU	6	;DIRECT CONSOLE OUTPUT
 0006 =         DCONIN		EQU	6	;DIRECT CONSOLE INPUT
 0006 =         DCONSTAT	EQU	6	;DIRECT CONSOLE STATUS
 0006 =         CURCOUTF	EQU	DCONOUT	;CURRENT METHOD OF CHARACTER OUTPUT
                
                ;******************************************************************************
                ;*									      *
                ;*	CODE FOLLOWS:							      *
                ;*									      *
                
 0100           	ORG	100H
                
                	; SOME INITIALIZATIONS FOLLOW:
 0100 316118    START:	LXI	SP,STKTOP	;SET UP OUR LOCAL STACK
 0103 C32201    	JMP	START2		;SKIP OVER CLEAR SCREEN CODES...
                
                	;----------------------------------------------------------------------
                	;	CONFIGURATION SECTION
                	;
                	; CLEAR SCREEN CODES KEPT HERE:
                CLRMSG:
 0106 1A        	DB	CLR1		;1AH FOR CLEAR SCREEN ON SD SYSTEMS 8024 VDB BOARD
 0107 00        	DB	CLR2
 0108 00        	DB	CLR3
 0109 00        	DB	DELIMITER
                
                	; CONTROLLER SELECT BITS AND STEP RATE FOR 5" DRIVE:
                STEP5RATE:
 010A 00        	DB	0000$0000B	;6 MILLISECOND STEP RATE FOR 5" DRIVES
 010B 04        RDRV2:	DB	0000$0100B	;SELECT BITS FOR 5" DRIVE
                
                	; CONTROLLER SELECT BITS AND STEP RATE FOR 8" DRIVES (TANDON'S):
                STEP8RATE:
 010C 01        	DB	0000$0001B	;6 MILLSECOND STEP RATE FOR 8" DRIVES
 010D 02        RDRV1:	DB	0000$0010B	;SELECT BITS FOR 8" DRIVE
                
                	; VERIFY FLAG:
 010E 00        VERFLG:	DB	FALSE		;=TRUE IF VERIFICATION OF TRACK FORMATTING
                	;
                	;
                ;
 010F DB00      ZCIN:	IN	0		;CONSOLE INPUT (FOR DEBUGGING ONLY)
 0111 E602      	ANI	02H
                	JRZ	ZCIN
 0113+28        	DB	28H
 0114+FA        	DB	ZCIN-$-1
 0115 DB01      	IN	1H		;RETURN WITH CHARACTER IN A
 0117 C9        	RET
                ;		
 0118 DB00      ZCO:	IN	0H		;CONSOLE OUTPUT (ARRIVE WITH CHARACTER IN C)
 011A E604      	ANI	04H		;NOTE CHARACTER IS IN C AND A ON RETURN.
                	JRZ	ZCO
 011C+28        	DB	28H
 011D+FA        	DB	ZCO-$-1
 011E 79        	MOV	A,C
 011F D301      	OUT	1H
 0121 C9        	RET
                
                	;	END CONFIGURATION SECTION
