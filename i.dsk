                	; FORMAT BLOCK OFFSET CONSTANTS:
 0000 =         DISKSIZE	EQU	0	;OFFSET CONSTANT TO DISK SIZE BYTE
 0001 =         DENSITY		EQU	1	;OFFSET CONSTANT TO DISK DENSITY BYTE
 0002 =         ACTSIDES	EQU	2	;OFFSET CONSTANT TO ACTIVE SIDES BYTE
 0003 =         SKEWPTR		EQU	3	;OFFSET CONSTANT TO SKEW TABLE POINTER
 0005 =         SECTORS		EQU	5	;OFFSET CONSTANT TO SECTORS/TRACK
 0006 =         TRACKS		EQU	6	;OFFSET CONSTANT TO # TRACKS TO FORMAT
 0007 =         GAP3		EQU	7	;OFFSET CONSTANT TO LENGTH OF GAP 3
 0008 =         GAP4		EQU	8	;OFFSET CONSTANT TO LENGTH OF GAP 4
 000A =         FMTCHR		EQU	10	;OFFSET CONSTANT TO CHARACTER TO FORMAT WITH
 000B =         SECSIZE		EQU	11	;OFFSET CONSTANT TO SECTOR SIZE
 000C =         SECONE		EQU	12	;OFFSET CONSTANT TO 1ST SECTOR # BIAS IF THERE
                				; IS NO SECTOR SKEW ON DISK
 000D =         ALTSEC		EQU	13	;OFFSET CONSTANT TO 2ND SIDE SECTOR
                				; CONTINUATION CONSTANT
 000E =         HDSIDE2		EQU	14	;OFFSET CONSTANT TO 2ND SIDE HEAD BYTE #
 000F =         FMTTYP		EQU	15	;OFFSET CONSTANT IN XDPH TO FORMAT TYPE #
 0010 =         AUXCODE		EQU	16	;OFFSET CONSTANT IN XDPH TO AUXILLIARY CODE
                
                	; MASTER FORMAT TABLE OFFSET CONSTANTS:
 0011 =         TRKOFF		EQU	17	;OFFSET CONSTANT TO TRACK #
 0013 =         SIDOFF		EQU	19	;OFFSET CONSTANT TO SIDE #
 0015 =         SECOFF		EQU	21	;OFFSET CONSTANT TO SECTOR #
 0017 =         BYTOFF		EQU	23	;OFFSET CONSTANT TO BYTES/SECTOR
 0022 =         DATOFF		EQU	34	;OFFSET CONSTANT TO SECTOR SIZE
 0024 =         FMTOFF		EQU	36	;OFFSET CONSTANT TO FORMAT CHARACTER
 0027 =         GP3OFF		EQU	39	;OFFSET CONSTANT TO GAP 3 LENGTH
 0029 =         GP4OFF		EQU	41	;OFFSET CONSTANT TO GAP 4 LENGTH
                
                	; FORMAT BLOCK CONSTANT DEFINITIONS:
