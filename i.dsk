zmac bios3
zmac sdmbr
zmac user
;zmac fnt6x8
;zmac VDP
zmac SIO
zmac PRNT
zmac CDTBL
zmac chario.z80

; linking ...
LINK BNKBIOS3[OS]=BIOSKRNL,SCB,BOOT,bios3,dump,user,MOVE,DRVTBL,sdmbr,cdtbl,sio,prnt,chario
;,vdp,fnt6x8

r System\bnkbdos3.spr
r System\resbdos3.spr
r System\gencpm.dat

; GENCPM
gencpm auto
; write output
w build\cpm3.sys b
