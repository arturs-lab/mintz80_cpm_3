    99                         	list on
   100                  ;      	
   101        (0000)    FALSE  	EQU    	0
   102        (0001)    TRUE   	EQU    	1
   103                  ;
   104        (0000)    CHIP_1795 EQU  	FALSE  	       	;<---- RD & WR sector c
   105        (0001)    CHIP_1791 EQU  	TRUE
   106  0100            
   107        (0080)    NBYTES 	EQU    	128    	       	;BYTES PER SECTOR UNIT 
   108        (000A)    LF     	EQU    	0AH
   109        (000D)    CR     	EQU    	0DH
   110        (0007)    BELL   	EQU    	07H
   111        (001A)    CLEAR  	EQU    	1AH    	       	;SD Systems Video Board
   112        (0009)    TAB    	EQU    	09H
   113        (001B)    ESC    	EQU    	1BH
   114        (001C)    EOL    	EQU    	1CH    	       	;SD Systems Video Board
   115        (0010)    PAGE_SIZE EQU  	16     	       	;Number of lines at a t
   116        (0005)    STATUS_DELAY EQU 5     	       	;Time-out for waiting f
   117                  ;
   118        (0001)    RO_FLAG	EQU    	01     	       	;Flag for sequental sec
   119        (0002)    WO_FLAG	EQU    	02     	       	;Flag for sequental sec
   120        (0003)    RW_FLAG	EQU    	03     	       	;Flag for sequental sec
   121        (0004)    RRW_FLAG EQU   	04     	       	;Flag for random track 
   122        (0005)    TRK_RO_FLAG EQU	05     	       	;Flag for reading secto
   123        (0001)    CPM86_FLAG  EQU	01     	       	;Flag to indicate after
   124  0100                   	       	       	       	;needs to be modified
   125        (0001)    TEST_FILL EQU  	01     	       	;Character to write for
   126                  ;
   127        (0000)    SIMPLE 	EQU    	00h    	       	;Output information det
   128        (00FF)    COMPLEX	EQU    	0FFH   	
   129                  ;
   130  0100                   	       	       	       	;Will place these value
   131  0100                   	       	       	       	;The rest go to the end
   132        (0040)    TADDR  	EQU    	40H    	       	;STORE FOR DMA ADDRESS
   133        (0043)    TRK    	EQU    	43H    	       	;NEW TRACK
   134        (0044)    SIDE   	EQU    	44H    	       	;NEW SIDE
   135        (0045)    SCTR   	EQU    	45H    	       	;NEW SECTOR
   136        (002E)    DRIVE  	EQU    	46     	       	;CURRENT DRIVE SELECT B
   137                  ;
   138                  ;
   139                  ;      	PORTS & COMMANDS FOR FOR 1791 or 1795
   140                  ;
   141        (0050)    RSET   	EQU    	50H    	       	;<----- VERSAFLOPPY BAS
   142        (0053)    SELECT 	EQU    	53H    	       	;DRIVE SELECT PORT
   143        (0054)    STATUS 	EQU    	54H    	       	;STATUS PORT
   144        (0055)    TRACK  	EQU    	55H    	       	;TRACK PORT
   145        (0056)    SECTOR 	EQU    	56H    	       	;SECTOR PORT
   146        (0057)    DATA   	EQU    	57H    	       	;DATA PORT
   147        (0054)    CMD    	EQU    	54H    	       	;COMMAND PORT
   148                  ;
   149                  ;Note: the 1791/5 chip for most commands used bits 0&1 
   150                  ;motor stepping rate. 00 being 3ms (@2MH clock),11 bein
   151                  ;Tandon 8" drives take the fastest rate. Older drives m
   152                  ;
   153        (000C)    RSCMD  	EQU    	00001100B      	;(0CH),RESTORE CMD     
   154        (0018)    SKNCMD 	EQU    	00011000B      	;(18H),SEEK NO VERIFY C
   155        (001C)    SKCMD  	EQU    	00011100B      	;(1CH),SEEK WITH VERIFY
   156        (00C4)    RDACMD 	EQU    	11000100B      	;(C0H),READ TRACK/SECTO
   157        (005C)    STEPIN 	EQU    	01011100B      	; Step-in verify on dst
   158  0100                   	
   159        (0080)    RDCMD91	EQU    	10000000B      	;(80H),READ SECTOR CMD 
   160        (00A0)    WRCMD91	EQU    	10100000B      	;(A0H),WRITE SECTOR CMD
   161  0100            
   162        (0088)    RDCMD95	EQU    	10001000B      	;(88H),READ SECTOR CMD 
   163        (00A8)    WRCMD95	EQU    	10101000B      	;(A8H),WRITE SECTOR CMD
   164  0100            
   165        (00F4)    WRTCMD 	EQU    	11110100B      	;(F4H),Write a whole tr
   166        (00E4)    RDTCMD 	EQU    	11100100B      	;(E4H),Read a whole tra
   167                  ;
   168                  ;
   169        (0004)    SEC_RETRY_MAX  	EQU    	4      	;Number of times to try
   170        (0002)    SEEK_RETRY_MAX 	EQU    	2      	;Number of times to try
   171        (0080)    HOME_ERR_MASK   EQU    	80H    	;Error mask for Type I 
   172        (0090)    SIN_ERR_MASK   	EQU    	90H    	;Step head in one track
   173        (0090)    SK_ERR_MASK     EQU    	90H    	;Track Seek error bits 
   174        (009F)    ID_ERR_MASK     EQU    	9FH    	;Sector ID read error m
   175        (00BF)    RS_ERR_MASK     EQU    	0BFH   	;Read sector data error
   176        (00AF)    MRS_ERR_MASK    EQU    	0AFH   	;Multi-sector Read data
   177        (00EF)    WS_ERR_MASK    	EQU    	0EFh   	;Write sector data erro
   178        (00EF)    MWS_ERR_MASK   	EQU    	0EFh   	;Multi-sector Write dat
   179        (0080)    RT_ERR_MASK     EQU    	80H    	;Read Track error mask
   180        (00E0)    WT_ERR_MASK     EQU    	0E0H   	;Write Track error mask
   181                  ;
   182                  ;
   183        (5000)    FBUFFER	EQU    5000H   	       	;Buffer to build track 
   184        (6000)    FBUFFER2 EQU   6000H   	       	;2nd buffer here for se
   185                  ;
   186                  ;The Index register IX is used throughout the program t
   187                  ;table of the currently selected drive/disk format
   188                  ;[IX+HW_BYTE] will point to (DRIVE) and will contain th
   189                  ;hardware selection bits. Drive select 0,1,2,3 and side
   190                  ;other flags (see below) 
   191                  ;Remember the bits for disk selection, density and side
   192                  ;the actual Versafloppy II board hardware
   193                  ;Register IX is not used for anything else in this prog
   194  0100            
   195                  ; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
   196                  ;
   197        (0000)    NSCTRS 	EQU    	0      	;Sectors/Track for disk
   198        (0001)    NTRKS  	EQU    	1      	;Tracks/Side
   199        (0002)    HW_BYTE	EQU    	2      	;Will contain bit flags for:-
   200  0100                   	       	       	       	       	;Bits 0,1 are u
   201  0100                   	       	       	       	       	;Bits 2 & 3 are
   202  0100                   	       	       	       	       	;Bit 4=0 For SS
   203  0100                   	       	       	       	       	;Bit 5=0 8" dis
   204  0100                   	       	       	       	       	;Bit 6=0 Single
   205  0100                   	       	       	       	       	;Bit 7=0 if CUR
   206  0100                   	       	       	       	       	;      1 if CUR
   207  0100                   	       	       	       	       	;Note: handle t
   208  0100                   	       	       	       	       	;central to man
   209  0100                   	       	       	       	       	;program.
   210        (0003)    HEADR  	EQU    	3      	;For Formatting
   211        (0004)    GAP1   	EQU    	4      	;      	"
   212        (0005)    GAP2   	EQU    	5      	;      	"
   213        (0006)    GAP3   	EQU    	6      	;      	"
   214        (0007)    GAP4   	EQU    	7      	;      	"
   215        (0008)    GAP4R  	EQU    	8      	;      	"
   216        (0009)    SIZE   	EQU    	9      	;1=128 Byte sectors.....4=1024 
   217        (000A)    GAP_FILL_CHAR  EQU 10  	;Byte used in disk formating
   218        (000B)    DATA_FILL_CHAR EQU 11  	;     "       "       "
   219        (000C)    TRK_SIZE       EQU 12  	;TWO bytes containing the track
   220        (000E)    SPECIAL_FLAG   EQU 14  	;flag byte for cases where afte
   221  0100                   	       	       	;normally 0, CPM86_FLAG = 1
   222        (000F)    SKEW   	       EQU 15  	;Low address of sector skew tab
   223        (0010)    SKEW1          EQU 16  	;High address of sector skew ta
   224        (0011)    FORMAT_NUM     EQU 17  	;Each format will have a unique
   225        (0012)    SYS_TRKS       EQU 18  	;How many tracks for system usu
   226        (0013)    TITLE  	       EQU 19  	;Text string describing the dis
   227                  ;
   228                  ;------------------------------------------------------
   229  0100                   	ORG    	100H
   230                  ;
   231  0100  ED733F3A         	LD     	(SP_SAVE),SP
   232  0104  315B3B           	LD     	SP,STACK
   233  0107  C32501           	JP     	START
   234                  ;------------------------------------------------------
   235                  ;      	       	HARDWARE DEPENDENT STUFF
   236                  ; The only other hardware links are through the Versafl
   237                  ; Remember to make sure it is set to the correct 1791/5
   238                  ;
   239                  ; 
   240  010A  DB00      CONST: 	IN     	A,(0)  	       	;console status for SD 
   241  010C  E602             	AND    	A,02H  	       	;anything there
   242  010E  C8               	RET    	Z      	       	;return 0 if nothing
   243  010F  AF               	XOR    	A,A
   244  0110  3D               	DEC    	A      	       	;return NZ, & 0FFH in A
   245  0111  C9               	RET
   246                  ;
   247  0112  DB00      CI:    	IN     	A,(0)  	       	;console input
   248  0114  E602             	AND    	A,02H
   249  0116  28FA             	JR     	Z,CI
   250  0118  DB01             	IN     	A,(1)  	       	;return with character 
   251  011A  C9               	RET
   252                  ;      	       	
   253  011B  DB00      CO:    	IN     	A,(0)  	       	;console output (arrive
   254  011D  E604             	AND    	A,04H  	       	;Note character is in C
   255  011F  28FA             	JR     	Z,CO
   256  0121  79               	LD     	A,C
   257  0122  D301             	OUT    	(1),A
   258  0124  C9               	RET
   259                  ;------------------------------------------------------
   260  0125  3E00      START: 	LD     	A,SIMPLE
   261  0127  32303A           	LD     	(CRTDISP),A    	;Start off with simple 
   262  012A  21161B    OVER:  	LD     	HL,SIGNON
   263  012D  CD1D1A           	CALL   	PMSG
   264  0130  AF               	XOR    	A,A    	       	;set everything to zero
   265  0131  324500           	LD     	(SCTR),A
   266  0134  324300           	LD     	(TRK),A
   267  0137  324400           	LD     	(SIDE),A
   268  013A            
   269  013A  CD9016           	CALL   	GET_DRIVE_TYPE 	;Ask user which drive t
   270  013D  B7               	OR     	A,A    	       	;Returns with IX pointi
   271  013E  28EA             	JR     	Z,OVER 	       	;Invalid drive, start o
   272  0140  FE1B             	CP     	A,ESC
   273  0142  200A             	JR     	NZ,LOOP
   274  0144  CD3A1A           	CALL   	ZCRLF
   275  0147  ED7B3F3A         	LD     	SP,(SP_SAVE)
   276  014B  C30000           	JP     	0H     	       	;Reboot CP/M if ESC
   277  014E            
   278  014E  3A303A    LOOP:  	LD     	A,(CRTDISP)    	;Check if detailed disp
   279  0151  B7               	OR     	A,A
   280  0152  2005             	JR     	NZ,MENU1
   281  0154  215E21           	LD     	HL,MAIN_MENU0  	;Main Menu loop (Detail
   282  0157  1803             	JR     	LOOP1
   283  0159  21A521    MENU1: 	LD     	HL,MAIN_MENU1  	;Main Menu loop	(Detail
   284  015C  CD1D1A    LOOP1: 	CALL   	PMSG
   285  015F            
   286  015F  CDF117           	CALL   	SHOW_HW_TITLE  	;Describe the currently
   287  0162  CD0218           	CALL   	SHOW_HW_BYTE   	;Print out HW_BYTE info
   288  0165                   	
   289  0165  210050           	LD     	HL,FBUFFER
   290  0168  224000           	LD     	(TADDR),HL
   291  016B  DD22263A         	LD     	(IXSAV),IX
   292  016F                   	       	       	       	
   293  016F  CDA412           	CALL   	DRVSET 	       	;Select the drive in ha
   294  0172                   	       	       	       	;Will default to A side
   295  0172  CD230F           	CALL   	HOME1  	       	;Move head to track 0 w
   296  0175  C4B313           	CALL   	NZ,SHOW_ERRORS 	;If an error in restori
   297  0178                   	
   298  0178  CB47             	BIT    	0,A    	       	;If NZ, then timeout on
   299  017A  2013             	JR     	NZ,TO_MENU     	;Try another drive or f
   300  017C            
   301  017C  CD7118           	CALL   	SHOW_IX_TABLE  	;Show info about curren
   302  017F            
   303  017F  CDA60F           	CALL   	READ_ID	       	;Get Actual track ID
   304  0182  2805             	JR     	Z,ID_FINE      	;Was there errors
   305  0184  CDB313           	CALL   	SHOW_ERRORS    	;If an error show bit f
   306  0187  1806             	JR     	TO_MENU
   307  0189            
   308  0189  CD3A1A    ID_FINE:CALL   	ZCRLF
   309  018C  CDB018           	CALL   	SHOW_ID	       	;Show a typical Track I
   310  018F                   	       	       	       	
   311  018F            TO_MENU:
   312  018F  212623           	LD     	HL,MENU_OPTIONS
   313  0192  CD1D1A           	CALL   	PMSG
   314  0195  3A303A           	LD     	A,(CRTDISP)    	;Two menu lists (Set us
   315  0198  B7               	OR     	A,A    	       	;A detailed display or 
   316  0199  2005             	JR     	NZ,MENUA
   317  019B  213C25           	LD     	HL,MENU1_MSG
   318  019E  1803             	JR     	MENUB
   319  01A0  218F25    MENUA: 	LD     	HL,MENU2_MSG
   320  01A3  CD1D1A    MENUB: 	CALL   	PMSG
   321  01A6                   	       	       	       	;-----MAIN MENU----
   322  01A6  CD281A           	CALL   	GETCMD 	       	;Find out Menu Option i
   323  01A9  32373A           	LD     	(CMD_STORE),A
   324  01AC  FE1B             	CP     	A,ESC  	       	;Abort if ESC character
   325  01AE  2853             	JR     	Z,FIN
   326  01B0  FE30             	CP     	A,'0'  	       	;Get a new current disk
   327  01B2  CA2A01           	JP     	Z,OVER
   328  01B5  FE31             	CP     	A,'1'
   329  01B7  CC1802           	CALL   	Z,SEEK_TEST    	;Seek test
   330  01BA  FE32             	CP     	A,'2'
   331  01BC  CC6402           	CALL   	Z,SEC_READ_TEST	;Sequental Read sectors
   332  01BF  FE33             	CP     	A,'3'
   333  01C1  CCD102           	CALL   	Z,SEC_WRITE_TEST;Sequental Write sector
   334  01C4  FE34             	CP     	A,'4'
   335  01C6  CC5703           	CALL   	Z,SEC_RW_TEST  	;Sequental sec R/W test
   336  01C9  FE35             	CP     	A,'5'  	       	
   337  01CB  CCF603           	CALL   	Z,RAND_SEC_TEST	;Random Track/Sector re
   338  01CE  FE36             	CP     	A,'6'
   339  01D0  CCA404           	CALL   	Z,TRACK_TEST   	;Read continously secto
   340  01D3  FE37             	CP     	A,'7'
   341  01D5  CC4D05           	CALL   	Z,TRACK_DUMP   	;Load one whole track t
   342  01D8  FE38             	CP     	A,'8'
   343  01DA  CC4906           	CALL   	Z,LOAD_SECTORS 	;Load sectors into RAM
   344  01DD  FE39             	CP     	A,'9'
   345  01DF  CC9907           	CALL   	Z,DUMP_SECTORS 	;Write sectors to disk
   346  01E2  FE46             	CP     	A,'F'
   347  01E4  CCF808           	CALL   	Z,FORMAT_DISK  	;Go to disk formatting 
   348  01E7  FE43             	CP     	A,'C'
   349  01E9  CC0F0B           	CALL   	Z,COPY_DISK    	;Copy disk A: to B:
   350  01EC  FE56             	CP     	A,'V'
   351  01EE  CC720C           	CALL   	Z,VERIFY_DISK  	;Verify disk A:=B:
   352  01F1  FE44             	CP     	A,'D'
   353  01F3  CC0D02           	CALL   	Z,TOGGLE_CRT   	;Switch on/off detail i
   354  01F6  FE53             	CP     	A,'S'
   355  01F8  CCE10D           	CALL   	Z,COPY_CPM3_SYS	;Copy CPM system tracks
   356  01FB  FE49             	CP     	A,'I'
   357  01FD  CCE909           	CALL   	Z,IBMFORM_DISK 	;Quick format of blank 
