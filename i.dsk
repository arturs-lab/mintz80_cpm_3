   387  02CC  324500           	LD     	(SCTR),A       	;Store for loop test
   388  02CF            
   389  02CF                   	       	       	       	       	;Sides swap che
   390  02CF  DDCB1166         	BIT    	4,(IX+HW_BYTE) 	;Is it a 1 or 2 sided d
   391  02D3  2819             	JR     	Z,NO_SIDES     	;If 1 sided then skip s
   392  02D5            
   393  02D5  3A4400           	LD     	A,(SIDE)
