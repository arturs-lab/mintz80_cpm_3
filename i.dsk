                	; OSBORNE 1, 5", DDSS, 5 SECTOR, 1024 BYTE FORMAT:
 14C0 20        SS5$4:		DB	SIZE5		;5" DISK
 14C1 40        		DB	DDEN		;DOUBLE DENSITY
 14C2 01        		DB	ONEHEAD		;SINGLE SIDE
 14C3 0000      		DW	NOSKEW		;NO SECTOR SKEW
 14C5 05        		DB	5		;5 SECTORS / TRACK
