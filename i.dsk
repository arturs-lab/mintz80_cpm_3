                	;;;;; FMTDSK
                	; ROUTINE CONDUCTS THE ACTUAL FORMATTING OF DISKS --
                	;
                	;	ON ENTRY:	[IX] = POINTER TO FORMAT BLOCK FOR
                	;			       TYPE OF DISK TO BE FORMATTED
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL DESTROYED
                	;
                FMTDSK:
                	; SHOW USER THE FORMAT HE/SHE HAS SELECTED:
 02E5 CD8604    	CALL	DPYFMT
                
                	; SET UP THE SINGLE OR DOUBLE DENSITY MASTER FORMAT TABLE:
                	BITX	DENBIT,DENSITY	;FORMATTING SINGLE OR DOUBLE DENSITY ?
 02E8+DDCB0176  	DB	0DDH,0CBH,DENSITY,DENBIT*8+46H
                	LXIY	DDFMTTBL	;ASSUME DOUBLE DENSITY
 02EC+FD21      	DB	0FDH,21H
 02EE+3313      	DW	DDFMTTBL
                	JRNZ	FMT000
 02F0+20        	DB	20H
 02F1+04        	DB	FMT000-$-1
                	LXIY	SDFMTTBL	;ELSE SWITCH TO SINGLE DENSITY TABLE
 02F2+FD21      	DB	0FDH,21H
 02F4+0713      	DW	SDFMTTBL
                FMT000:	LDX	A,GAP3		;GET LENGTH OF GAP 3
 02F6+DD7E07    	DB	0DDH,A*8+46H,GAP3
                	STY	A,GP3OFF	;STORE IT INTO MASTER FORMAT TABLE
 02F9+FD7727    	DB	0FDH,70H+A,GP3OFF
                	LDX	A,GAP4		;GET LENGTH OF GAP 4
 02FC+DD7E08    	DB	0DDH,A*8+46H,GAP4
                	STY	A,GP4OFF	;STORE IT INTO MASTER FORMAT TABLE
 02FF+FD7729    	DB	0FDH,70H+A,GP4OFF
                	LDX	A,GAP4+1	; DO THE SAME FOR HI BYTE OF GAP 4
 0302+DD7E09    	DB	0DDH,A*8+46H,GAP4+1
                	STY	A,GP4OFF+1
 0305+FD772A    	DB	0FDH,70H+A,GP4OFF+1
                	LDX	A,FMTCHR	;GET FORMAT CHARACTER
 0308+DD7E0A    	DB	0DDH,A*8+46H,FMTCHR
                	STY	A,FMTOFF	;STORE INTO MASTER FORMAT TABLE
 030B+FD7724    	DB	0FDH,70H+A,FMTOFF
                	LDX	E,SECSIZE	;GET SECTOR SIZE ENCODING
 030E+DD5E0B    	DB	0DDH,E*8+46H,SECSIZE
 0311 1600      	MVI	D,0
 0313 21FF12    	LXI	H,SIZETBL
 0316 19        	DAD	D
 0317 19        	DAD	D
 0318 4E        	MOV	C,M
 0319 23        	INX	H
 031A 46        	MOV	B,M
                	STY	E,BYTOFF	;STORE SECTOR SIZE ENCODING INTO MASTER FORMAT
 031B+FD7317    	DB	0FDH,70H+E,BYTOFF
                	STY	C,DATOFF	;STORE LOW BYTE OF SECTOR SIZE
 031E+FD7122    	DB	0FDH,70H+C,DATOFF
                	STY	B,DATOFF+1	; THEN THE HI BYTE
 0321+FD7023    	DB	0FDH,70H+B,DATOFF+1
                
                	; CREATE TRACK IMAGE IN MEMORY -- 1ST THAT PART OF THE TRACK PRECEDING
                	; THE 1ST SECTOR:
 0324 216118    	LXI	H,TRK$BUFFER	;POINT TO WHERE IN MEMORY WE WILL BUILD IMAGE
 0327 0605      	MVI	B,5		;LOOP COUNT
 0329 CD3F04    	CALL	BLDFMT		;BUILD PARTIAL FORMAT
                
                	; CREATE N SECTORS WORTH OF TRACK IMAGE:
 032C 116113    	LXI	D,SECIDS	;INITIALIZE SECTOR ID ADDRESS TABLE
                	SDED	SECIDPTR
 032F+ED53      	DB	0EDH,53H
