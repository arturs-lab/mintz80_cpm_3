                	JRZ	PBUFF2		;NO -- THEN SKIP REPETITION LOOP...
 020D+28        	DB	28H
 020E+0C        	DB	PBUFF2-$-1
                
                	; HERE TO REPETITIVELY DISPLAY A CHARACTER:
 020F E67F      	ANI	127		;GET REPEAT COUNT AND PUT IN [B]
