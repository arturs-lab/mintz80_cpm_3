	; table of addresses to jump to for auxilliary code for formatting:
jmptbl:		dw	cpm86$1		;IBM PC, CPM-86, SS
		dw	ms11$1		;MSDOS 1.1, SS
		dw	ms2x$1		;MSDOS 2.x, SS
		dw	cpm86$2		;IBM PC, CPM-86, DS
		dw	ms11$2		;MSDOS 1.1, DS
		dw	ms2x$2		;MSDOS 2.x, DS


	; sector bytes table:
sizetbl:	dw	128
		dw	256
		dw	512
		dw	1024


	; Single density format master table:
SDfmttbl:
	; start of track:
	db	40,0ffh		;40 FF's
	db	6,0		;6 0's
	db	0,0f6h		;0 F6's
	db	1,0fch		;1 FC
	db	26,0ffh		;26 FF's

	; sector image:
	db	6,0		;6 0's
	db	0,0f5h		;0 F5's
	db	1,0feh		;1 FE
sdtrk:	db	1,0		;1 byte for track #
sdhead:	db	1,0		;1 byte for head #
sdsect:	db	1,0		;1 byte for sector #
sdbyte:	db	1,0		;1 byte for sector bytes
	db	1,0f7h		;1 F7
	db	11,0ffh		;11 FF's
	db	6,0		;6 0's
	db	0,0f5h		;0 F5's
	db	1,0fbh		;1 FB
sddata:	dw	0		;sector size bytes
	db	0		; of format characters
	db	1,0f7h		;1 F7
sdgap3:	db	0,0ffh		;gap 3 # FF's

	; end of track:
sdgap4:	dw	0		;gap 3 # of
	db	0ffh		; FF's


	; Double density format master table:
DDfmttbl:
	; start of track:
	db	80,4eh		;80 4E's
	db	12,0		;12 0's
	db	3,0f6h		;3 F6's
	db	1,0fch		;1 FC
	db	50,4eh		;50 4E's

	; sector image:
	db	12,0		;12 0's
	db	3,0f5h		;3 F5's
	db	1,0feh		;1 FE
ddtrk:	db	1,0		;1 byte for track #
ddhead:	db	1,0		;1 byte for head #
ddsect:	db	1,0		;1 byte for sector #
ddbyte:	db	1,0		;1 byte for sector bytes
	db	1,0f7h		;1 F7
	db	22,4eh		;22 4E's
	db	12,0		;12 0's
	db	3,0f5h		;3 F5's
	db	1,0fbh		;1 FB
dddata:	dw	0		;sector size bytes
	db	0		; of format characters
	db	1,0f7h		;1 F7
ddgap3:	db	0,4eh		;gap 3 # 4E's

	; end of track:
ddgap4:	dw	0		;gap 4 # of
	db	4eh		; 4E's


	; table to contain pointers to the sector id fields of each sector
	; within the track image:
secidptr:	ds	2	;current pointer into table
secids:		ds	120	;room for up to 60 physical sectors


	; miscellaneous variables:
conchar:	db	0	;1 character input buffer
skwptr:		ds	2	;current skew table pointer
menu$entry:	dw	menu1	;start off with menu 1 default
curcyl:		ds	1	;current cylinder byte
phyhead:	ds	1	;current physical head #
physec:		ds	1	;current physical sector # to be written
steprate:	ds	1	;current step rate byte
dselbits:	ds	1	;current Versafloppy drive select bits
rptxfer:	ds	1	;# block outputs for write track
bytcnt:		ds	1	;# bytes to transfer w/1 block i/o instruction
dmaadr:		ds	2	;transfer address for write sector
rrcount:	ds	1	;restore retry counter
srcount:	ds	1	;seek retry counter
rwrcount:	ds	1	;write retry counter

;*									      *
;******************************************************************************


;******************************************************************************
;*									      *
;*	Format blocks for different disk format types:			      *
;*									      *

	; format block offset constants:
DISKSIZE	equ	0	;offset constant to disk size byte
DENSITY		equ	1	;offset constant to disk density byte
ACTSIDES	equ	2	;offset constant to active sides byte
SKEWPTR		equ	3	;offset constant to skew table pointer
SECTORS		equ	5	;offset constant to sectors/track
TRACKS		equ	6	;offset constant to # tracks to format
GAP3		equ	7	;offset constant to length of gap 3
GAP4		equ	8	;offset constant to length of gap 4
FMTCHR		equ	10	;offset constant to character to format with
SECSIZE		equ	11	;offset constant to sector size
SECONE		equ	12	;offset constant to 1st sector # bias if there
				; is no sector skew on disk
ALTSEC		equ	13	;offset constant to 2nd side sector
				; continuation constant
HDSIDE2		equ	14	;offset constant to 2nd side head byte #
FMTTYP		equ	15	;offset constant in XDPH to format type #
AUXCODE		equ	16	;offset constant in XDPH to auxilliary code

	; master format table offset constants:
TRKOFF		equ	17	;offset constant to track #
SIDOFF		equ	19	;offset constant to side #
SECOFF		equ	21	;offset constant to sector #
BYTOFF		equ	23	;offset constant to bytes/sector
DATOFF		equ	34	;offset constant to sector size
FMTOFF		equ	36	;offset constant to format character
GP3OFF		equ	39	;offset constant to gap 3 length
GP4OFF		equ	41	;offset constant to gap 4 length

	; format block constant definitions:
DENBIT		equ	6		;bit to test for density
SIDBIT		equ	4		;bit to set/reset for side selection
SIZE5		equ	00$1$00000b	;5" drive select bit encoding
SIZE8		equ	00$0$00000b	;8" drive select bit encoding
SDEN		equ	0$0$000000b	;single density select bit encoding
DDEN		equ	0$1$000000b	;double density select bit encoding
ONEHEAD		equ	1		;1 side to format on drive
TWOHEAD		equ	2		;2 sides to format on drive
NOSKEW		equ	0		;value for no sector skew
SEC128		equ	0		;encoding for 128 byte sectors
SEC256		equ	1		;  ditto for 256 byte sector
SEC512		equ	2		;  ditto for 512 byte sector
SEC1024		equ	3		;  ditto for 1024 byte sector
CPMFMT		equ	0E5h		;format character for CP/M
MSDOSFMT	equ	0f6h		;format character for MSDOS
DD8BYTES	equ	10400		;# absolute bytes/track for 8" DD
SD8BYTES	equ	5200		;  ditto for SD
DD5BYTES	equ	6400		;# absolute bytes/track for 5" DD
SD5BYTES	equ	3300		;  ditto for SD

;*									      *
;******************************************************************************


;******************************************************************************
;*									      *
;*	SINGLE DENSITY, SINGLE-SIDED formats:				      *
;*									      *

	; IBM 3740, 8", SDSS, 128 byte, 26 sect/trk:
IBM3740:	db	SIZE8		;8" disk
		db	SDEN		;single density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no sector skew on disk
		db	26		;26 sectors / track
		db	77		;77 tracks
		db	27		;GAP3
		dw	256		;GAP4
		db	CPMFMT		;format character
		db	SEC128		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	0		;format type 0
		db	-1		;no auxilliary code

	; 5", OSBORNE 1, SDSS:
SD5$0:		db	SIZE5		;5" disk
		db	SDEN		;single density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no hard sector skew
		db	10		;10 sectors / track
		db	40		;40 tracks
		db	16		;GAP3
		dw	197		;GAP4
		db	CPMFMT		;format character
		db	SEC256		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	1		;format type 1
		db	-1		;no auxilliary code

	; 5", TRS-80 I (OMIKRON CP/M):
SD5$1:		db	SIZE5		;5" disk
		db	SDEN		;single density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no hard sector skew
		db	18		;18 sectors / track
		db	35		;35 tracks
		db	8		;GAP3
		dw	221		;GAP4
		db	CPMFMT		;format character
		db	SEC128		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	2		;format type 2
		db	-1		;no auxilliary code

	; 5", XEROX 820:
SD5$2:		db	SIZE5		;5" disk
		db	SDEN		;single density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no hard sector skew
		db	18		;18 sectors / track
		db	40		;40 tracks
		db	8		;GAP3
		dw	221		;GAP4
		db	CPMFMT		;format character
		db	SEC128		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	3		;format type 3
		db	-1		;no auxilliary code

	; 5", CROMEMCO CDOS:
SD5$3:		db	SIZE5		;5" disk
		db	SDEN		;single density
		db	ONEHEAD		;single side
		dw	NOSKEW		;no hard sector skew
		db	18		;18 sectors / track
		db	40		;40 tracks
		db	8		;GAP3
		dw	221		;GAP4
		db	CPMFMT		;format character
		db	SEC128		;sector size code
		db	1		;1st sector # bias
		db	0		;no 2nd side sector continuation
		db	0		;no 2nd side head byte
		db	4		;format type 4
		db	-1		;no auxilliary code

