 069A+CB77      	DB	0CBH,WRTPROT*8+A+40H
 069C 37        	STC			;C=1 IN CASE OF ERROR
 069D 3E00      	MVI	A,0		;RETURN ERROR CODE IN CASE WRITE-PROTECTED
 069F C0        	RNZ
 06A0 CDB306    	CALL	DCBSTATUS	;GET DRIVE STATUS AGAIN
                	BIT	DRVRDY,A	;DRIVE SHOULD ALSO BE IN READY CONDITION
 06A3+CB7F      	DB	0CBH,DRVRDY*8+A+40H
 06A5 37        	STC			;C=1 IN CASE OF ERROR
 06A6 3E01      	MVI	A,1		;RETURN ERROR CODE IN CASE NOT READY
 06A8 C0        	RNZ
                
