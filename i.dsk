CP/M RMAC ASSEM 1.1	#005	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

 0042 C9        	;lxi h,@ctbl ! ret
                
                
                	; GETDRV
                	;	Return address of drive table
                
                getdrv:
 0043 210000C9  	lxi h,@dtbl ! ret
                
                
                
                	; CONOUT
                	;	Console Output.  Send character in <C>
                	;			to all selected devices
                
                conout:
                
 0047 2A0000    	lhld @covec	; fetch console output bit vector
 004A C35600    	jmp out$scan
                
                
                	; AUXOUT
                	;	Auxiliary Output. Send character in <C>
                	;			to all selected devices
                
                auxout:
 004D 2A0000    	lhld @aovec	; fetch aux output bit vector
 0050 C35600    	jmp out$scan
                
                
                	; LIST
                	;	List Output.  Send character in <C>
                	;			to all selected devices.
                
                list:
 0053 2A0000    	lhld @lovec	; fetch list output bit vector
                
                out$scan:
 0056 0600      	mvi b,0		; start with device 0
                co$next:
 0058 29        	dad h		; shift out next bit
 0059 D26C00    	jnc not$out$device
 005C E5        	push h		; save the vector
 005D C5        	push b		; save the count and character
                not$out$ready:
 005E CD9900B7CA	call coster ! ora a ! jz not$out$ready
 0065 C1C5      	pop b ! push b	; restore and resave the character and device
 0067 CD0000    	call ?co	; if device selected, print it
 006A C1        	pop b		; recover count and character
 006B E1        	pop h		; recover the rest of the vector
                not$out$device:
 006C 04        	inr b		; next device number
 006D 7CB5      	mov a,h ! ora l	; see if any devices left
 006F C25800    	jnz co$next	; and go find them...
 0072 C9        	ret
                
CP/M RMAC ASSEM 1.1	#006	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

                
                	; CONOST
                	;	Console Output Status.  Return true if
                	;		all selected console output devices
                	;		are ready.
                
                conost:
 0073 2A0000    	lhld @covec	; get console output bit vector
 0076 C38200    	jmp ost$scan
                
                
                	; AUXOST
                	;	Auxiliary Output Status.  Return true if
                	;		all selected auxiliary output devices
                	;		are ready.
                
                auxost:
 0079 2A0000    	lhld @aovec	; get aux output bit vector
 007C C38200    	jmp ost$scan
                
                
                	; LISTST
                	;	List Output Status.  Return true if
                	;		all selected list output devices
                	;		are ready.
                
                listst:
 007F 2A0000    	lhld @lovec	; get list output bit vector
                
                ost$scan:
 0082 0600      	mvi b,0		; start with device 0
                cos$next:
 0084 29        	dad h		; check next bit
 0085 E5        	push h		; save the vector
 0086 C5        	push b		; save the count
 0087 3EFF      	mvi a,0FFh	; assume device ready
 0089 DC9900    	cc coster	; check status for this device
 008C C1        	pop b		; recover count
 008D E1        	pop h		; recover bit vector
 008E B7        	ora a		; see if device ready
 008F C8        	rz		; if any not ready, return false
 0090 04        	inr b		; drop device number
 0091 7CB5      	mov a,h ! ora l	; see if any more selected devices
 0093 C28400    	jnz cos$next
 0096 F6FF      	ori 0FFh	; all selected were ready, return true
 0098 C9        	ret
                
                coster:		; check for output device ready, including optional
                		;	xon/xoff support
 0099 682600    	mov l,b ! mvi h,0	; make device code 16 bits
 009C E5        	push h			; save it in stack
 009D 292929    	dad h ! dad h ! dad h	; create offset into device characteristics tbl
 00A0 11060019  	lxi d,@ctbl+6 ! dad d	; make address of mode byte
 00A4 7EE610    	mov a,m ! ani mb$xonxoff
 00A7 E1        	pop h			; recover console number in <HL>
 00A8 CA0000    	jz ?cost		; not a xon device, go get output status direct
CP/M RMAC ASSEM 1.1	#007	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

 00AB 11980119  	lxi d,xofflist ! dad d	; make pointer to proper xon/xoff flag
 00AF CDCA00    	call cist1		; see if this keyboard has character
 00B2 7EC4DC00  	mov a,m ! cnz ci1	; get flag or read key if any
 00B6 FE11C2BD00	cpi ctlq ! jnz not$q	; if its a ctl-Q,
 00BB 3EFF      	mvi a,0FFh 		;	set the flag ready
                not$q:
 00BD FE13C2C400	cpi ctls ! jnz not$s	; if its a ctl-S,
 00C2 3E00      	mvi a,00h		;	clear the flag
                not$s:
 00C4 77        	mov m,a			; save the flag
 00C5 CDD300    	call cost1		; get the actual output status,
 00C8 A6        	ana m			; and mask with ctl-Q/ctl-S flag
 00C9 C9        	ret			; return this as the status
                
                cist1:			; get input status with <BC> and <HL> saved
 00CA C5E5      	push b ! push h
 00CC CD0000    	call ?cist
 00CF E1C1      	pop h ! pop b
 00D1 B7        	ora a
 00D2 C9        	ret
                
                cost1:			; get output status, saving <BC> & <HL>
 00D3 C5E5      	push b ! push h
 00D5 CD0000    	call ?cost
 00D8 E1C1      	pop h ! pop b
 00DA B7        	ora a
 00DB C9        	ret
                
                ci1:			; get input, saving <BC> & <HL>
 00DC C5E5      	push b ! push h
 00DE CD0000    	call ?ci
 00E1 E1C1      	pop h ! pop b
 00E3 C9        	ret
                
                
                	; CONST
                	;	Console Input Status.  Return true if
                	;		any selected console input device
                	;		has an available character.
                
                const:
 00E4 2A0000    	lhld @civec	; get console input bit vector
 00E7 C3ED00    	jmp ist$scan
                
                
                	; AUXIST
                	;	Auxiliary Input Status.  Return true if
                	;		any selected auxiliary input device
                	;		has an available character.
                
                auxist:
 00EA 2A0000    	lhld @aivec	; get aux input bit vector
                
                ist$scan:
 00ED 0600      	mvi b,0		; start with device 0
                cis$next:
CP/M RMAC ASSEM 1.1	#008	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

 00EF 29        	dad h		; check next bit
 00F0 3E00      	mvi a,0		; assume device not ready
 00F2 DCCA00    	cc cist1	; check status for this device
 00F5 B7C0      	ora a ! rnz	; if any ready, return true
 00F7 04        	inr b		; drop device number
 00F8 7CB5      	mov a,h ! ora l	; see if any more selected devices
 00FA C2EF00    	jnz cis$next
 00FD AF        	xra a		; all selected were not ready, return false
 00FE C9        	ret
                
                
                	; CONIN
                	;	Console Input.  Return character from first
                	;		ready console input device.
                
                conin:
 00FF 2A0000    	lhld @civec
 0102 C30801    	jmp in$scan
                
                
                	; AUXIN
                	;	Auxiliary Input.  Return character from first
                	;		ready auxiliary input device.
                
                auxin:
 0105 2A0000    	lhld @aivec
                
                in$scan:
 0108 E5        	push h		; save bit vector
 0109 0600      	mvi b,0
