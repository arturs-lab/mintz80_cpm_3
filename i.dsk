 021B CD2502    PBUFF2:	CALL	CONOUT		;OUTPUT CHARACTER
 021E 23        PBUFF3:	INX	H		;UPDATE STRING POINTER
                	JR	PBUFF0		;LOOP FOR FULL STRING...
 021F+18        	DB	18H
 0220+D8        	DB	PBUFF0-$-1
                
                	; ORDERLY RETURN AT END...
                PBUFF$RET:
 0221 E1        	POP	H		;RESTORE REGISTER STATE
 0222 C1        	POP	B
 0223 F1        	POP	PSW
 0224 C9        	RET
                
                
