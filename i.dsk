; AUTHOR:	RICHARD CONN
; VERSION:	1.1
; DATE:		18 May 84
; DERIVATION:	UNERA 2.2 (25 July 83) for ZCPR2
; DERIVATION:	UNERA BY GENE COTTON
;
VERS	EQU	12		;version number
;
; PROGRAM TO RECOVER ERASED FILES, BY GENE COTTON
;
; From Interface Age December 1981 pg 146
;
; v2.0 - 07/23/83	Modified to be consistent in the ZCPR2 tool set.
;					- Rick Conn
; v1.0 - 05/18/84	Modified to be consistent in the ZCPR3 tool set.
;					- Rick Conn
;
; Contributors:
;	v1.6 - Dave Rand
;	v1.5 - Irv Hoff
;	v1.4 - Paul Traina
;	v1.3 - Irv Hoff
;	v1.2 - Charlie Strom
;	v1.1 - Bruce Blakeslee
; 	v1.0 - Retyped from Interface Age (Dec 81).	- Henry Rothberg
;
;
; System equates:
;
; Minor changes by Peter Schorn for CP/M 3 (19-Jan-2002)

	.Z80

BOOT	EQU	0000H		;CP/M WARM BOOT JUMP VECTOR
BDOS	EQU	BOOT+05H	;CP/M BDOS CALL JUMP VECTOR
TBUFF	EQU	BOOT+80H	;DISK I/O BUFFER
FCB	EQU	BOOT+5CH	;DEFAULT FILE CONTROL BLOCK
FCB2	EQU	BOOT+6CH	;SECONDARY FILE CONTROL AREA
CR	EQU	'M'-'@'		;CTL-M FOR CARRIAGE RETURN
LF	EQU	'J'-'@'		;CTL-J FOR LINE FEED
CTRLC	EQU	'C'-'@'		;ABORT
PRINTST	EQU	9
CONOUTC	EQU	2
VERSCMD	EQU	0CH
;
	ASEG	
	ORG	100H
;
; Start of Program -- Initialize ZCPR3 Environment
;
	LD	HL,0		;SAVE STACK PTR
	ADD	HL,SP
	LD	(STACK),HL
	LD	HL,CEND
	LD	(FNTAB),HL	;SET PTR TO FILE NAME TABLE
	LD	DE,512		;1/2 K
	ADD	HL,DE
	LD	SP,HL		;NEW STACK
	CALL	GETVERS
	CALL	HELLO		;SIGN ON MESSAGE
	CALL	HELPCHK		;CHECK FOR AND PRINT HELP MESSAGE
	CALL	PCHECK		;CHECK PARAMETERS
	LD	A,(FNCOUNT)	;NUMBER OF FILES SPECIFIED
	OR	A		;0=NONE
	CALL	NZ,TRYFIX	;DO THE RECOVERY
	CALL	BYE		;SIGN OFF MESSAGE
	JP	BOOT		;RETURN TO CP/M
MSG1:	DB	'UNERASE Version '
	DB	(VERS/10) + '0', '.', (VERS MOD 10) + '0', '$'
MSG2:	DB	CR,LF,'File(s) Recovered - DOUBLE CHECK Before Using$'
MSG3:	DB	CR,LF,'NO Files Recovered$'
MSG4:	DB	CR,LF,'Invalid Option -- $'
MSG5:	DB	CR,LF,'File(s) Recovered --$'
MSG6:	DB	CR,LF,'Erased File(s) --$'
MSG7:	DB	CR,LF,'ABORT - Error During Disk Write$'
MSG8:	DB	CR,LF,'Syntax:'
	DB	CR,LF,'  UNERASE afn,afn,afn,... o'
	DB	CR,LF,'Options:'
	DB	CR,LF,'  L - List Erased Files Only'
	DB	CR,LF,'  P - Pause for disk change'
	DB	CR,LF,'  Z - Place file in User 0 '
	DB	'(default is current)$'
MSG9:	DB	CR,LF,'ABORT - Illegal Disk Requested$'
MSG10:	DB	CR,LF,'  $'
MSG11:	DB	CR,LF,'Change Disk - Hit ^C to Abort, Anything Else to Cont - $'
MSG12:	DB	CR,LF,'$'
;
; ** Main Routines **
;
PRINT	MACRO	TEXT
	PUSH	DE
	LD	DE,TEXT
	CALL	DOPRNT
	POP	DE
	ENDM
	
DOPRNT:	PUSH	AF
	PUSH	BC
	PUSH	HL
	LD	C,PRINTST
	CALL	BDOS
	POP	HL
	POP	BC
	POP	AF
	RET	
COUT:	PUSH	BC
	PUSH	HL
	PUSH	DE
	LD	C,CONOUTC
	LD	E,A
	CALL	BDOS
	POP	DE
	POP	HL
	POP	BC
	RET	
GETVERS:
	LD	C,VERSCMD
	CALL	BDOS
	LD	A,L
	LD	(CPMVRS),A
	RET
;
; SAY WHO WE ARE
;
HELLO:	PRINT	MSG1
	RET	
;
; CHECK FOR VALID PARAMETERS AND SAY WHICH CP?M VERSION
;
PCHECK:	CALL	OPTCHK		;CHECK FOR OPTIONS AND SET FLAGS
	CALL	FCBCHK		;MAKE SURE FILE SPECIFIED
	CALL	CPMCHK		;ESTABLISH CP/M PARAMETERS
	CALL	PUSCHK		;CHECK IF USER WANTS TO CHANGE DISK
	RET	
;
; LOOK THROUGH DIRECTORY
;
TRYFIX:	CALL	NXTSEC		;GET A DIRECTORY SECTOR
	RET	Z␀		;RETURNS ZERO FLAG IF NO MORE
	CALL	CHKENT		;CHECK IT OUT AND MAYBE FIX
	JP	TRYFIX		;KEEP IT UP TILL DONE
;
; SIGN OFF AND RESET SYSTEM
;
BYE:	LD	C,13		;SYSTEM RESET
	CALL	BDOS
	LD	A,(LISTFL)	;LIST ONLY?
	OR	A		;0=NO
	JP	NZ,PRNF
	LD	A,(FIXCNT)	;CHECK FOR ACTIVITY
	OR	A
	JP	Z␀,PRNF		;SAY NONE FOUND
	PRINT	MSG2
	RET	
PRNF:	PRINT	MSG3
	RET	
;
; CHECKS FOR P AND 0 OPTIONS IN COMMAND LINE
;
OPTCHK:	XOR	A		;TURN OFF FLAGS
	LD	(CURUSR),A
	LD	(PAUSE),A
	LD	(FIXCNT),A
	LD	(LISTFL),A
	LD	(FNCOUNT),A	;NO FILE NAMES
	LD	HL,1		;SET SECTOR 1
	LD	(SECTOR),HL
	LD	HL,TBUFF	;SCAN THRU TBUFF, BUILDING A FILE NAME TABLE
	LD	A,(HL)		;GET CHAR COUNT
	INC	HL		;PT TO FIRST CHAR
	PUSH	HL		;SAVE PTR
	ADD	A,L		;PT TO AFTER LAST CHAR
	LD	L,A
	LD	(HL),0		;STORE ENDING ZERO
	LD	HL,(FNTAB)	;PT TO TABLE
	EX	DE,HL		;... IN DE
	POP	HL		;GET PTR TO FIRST CHAR
	CALL	SBLANK		;SKIP BLANKS
FNLOOP:	
	PUSH	DE		;SAVE TABLE PTR
	CALL	GETFN		;EXTRACT FILE NAME
	POP	DE
	PUSH	HL
	LD	HL,11		;PT TO NEXT TABLE ENTRY
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	LD	A,(FNCOUNT)	;INCREMENT COUNT
	INC	A
	LD	(FNCOUNT),A
	LD	A,(HL)		;GET TERMINATING CHAR
	INC	HL		;PT TO NEXT
	CP	','		;ANOTHER FOLLOWS?
	JP	Z␀,FNLOOP
	DEC	HL		;POINT BACK TO DELIM
	CALL	SBLANK		;SKIP TO NON-BLANK
OPTCK1:	LD	A,(HL)		;GET OPTION
	CALL	DELCHK		;DONE IF DELIM
	RET	Z␀
	CP	'L'		;LIST ONLY?
	JP	Z␀,OPTCKL
	CP	'P'		;PAUSE?
	JP	Z␀,OPTCKP
	CP	'Z'		;USER 0?
	JP	Z␀,OPTCKZ
	PRINT	MSG4
	LD	A,(HL)
	CALL	COUT
	JP	HCK1
OPTCKL:	LD	A,0FFH		;SET FLAG
	LD	(LISTFL),A
	INC	HL		;PT TO NEXT
	JP	OPTCK1
OPTCKP:	LD	A,0FFH		;SET FLAG
	LD	(PAUSE),A
	INC	HL		;PT TO NEXT
	JP	OPTCK1
OPTCKZ:	LD	A,0FFH		;SET FLAG
	LD	(CURUSR),A
	INC	HL
	JP	OPTCK1
GETFN:	PUSH	DE		;FILL TARGET FCB
	LD	B,11		;11 BYTES
	LD	A,' '		;SPACE FILL
GETFN0:	LD	(DE),A		;PUT SPACE
	INC	DE
	DEC	B
	JP	NZ,GETFN0
	POP	DE		;PT TO ENTRY AGAIN
	CALL	SCANCOL		;SCAN FOR COLON
	LD	B,8		;8 CHARS MAX
	CALL	GETFN1		;GET AND FILL ENTRY
	LD	A,(HL)		;GET CHAR
	CP	'.'		;DELIM?
	RET	NZ		;DONE
	INC	HL		;PT TO AFTER PERIOD
	LD	B,3		;3 CHARS MAX AND DO IT AGAIN
GETFN1:	LD	A,(HL)		;GET CHAR
	CP	'.'		;END OF FIELD?
	JP	Z␀,GETFN3
	CALL	DELCHK		;CHECK DELIMITER
	RET	Z␀
	CP	'*'		;WILD?
	JP	Z␀,GETFNQ
	LD	(DE),A		;STORE CHAR
	INC	HL		;PT TO NEXT
	INC	DE
	DEC	B		;COUNT DOWN
	JP	NZ,GETFN1
GETFN2:	LD	A,(HL)		;FLUSH CHARS TO DELIM
	CALL	DELCHK		;CHECK FOR DELIMITER
	RET	Z␀
	INC	HL		;PT TO NEXT
	JP	GETFN2
GETFN3:	INC	DE		;PT TO AFTER FIELD
	DEC	B		;COUNT DOWN
	JP	NZ,GETFN3
	RET	
GETFNQ:	LD	A,'?'		;FILL WITH QUESTION MARKS
	LD	(DE),A
	INC	DE
	DEC	B
	JP	NZ,GETFNQ
	JP	GETFN2		;SKIP TO DELIM
DELCHK:	OR	A		;END OF LINE?
	RET	Z␀
	CP	'.'		;END OF FIELD?
	RET	Z␀
	CP	','		;END OF ENTRY?
	RET	Z␀
	CP	' '
	RET	
SBLANK:	LD	A,(HL)		;SKIP TO NON-BLANK
	CP	' '
	RET	NZ
	INC	HL
	JP	SBLANK
SCANCOL:	
	PUSH	DE		;SAVE TABLE PTR
	PUSH	HL		;SAVE PTR
SCOL1:	LD	A,(HL)		;GET CHAR
	INC	HL		;PT TO NEXT
	CP	':'		;COLON?
	JP	Z␀,SCOLX
	CALL	DELCHK		;CHECK FOR DELIMITER
	JP	NZ,SCOL1
SCOL2:	POP	HL		;RESTORE
	POP	DE
	RET	
SCOLX:	EX	DE,HL		;DE PTS TO AFTER COLON
	POP	HL		;GET OLD PTR
	EX	DE,HL		;REPLACE IT
	POP	DE		;GET TABLE PTR
	RET	
;
; CHECKS THE CURRENT 4 DIRECTORY ENTRIES AGAINST ARGUMENT
; IF MATCH, REWRITES SECTOR WITH REACTIVATED 1ST BYTES
;
CHKENT:	XOR	A		;ASSUME NO REWRITE
	LD	(REWRT),A
	LD	B,4		;NUMBER OF ENTRIES PER SECTOR
	LD	HL,TBUFF	;BEGINNING OF BUFFER
CKLUP:	PUSH	BC
	LD	A,(HL)
	CP	0E5H		;CHECK FOR UNUSED
	JP	NZ,CKINC
	PUSH	HL
	LD	HL,(FNTAB)	;PT TO POTENTIAL FILES
	EX	DE,HL
	POP	HL
	LD	A,(FNCOUNT)	;NUMBER OF ENTRIES TO COUNT
	LD	B,A		;... IN B
CKLUP0:	PUSH	HL		;SAVE BEGINNING ADDRESS
	PUSH	DE		;SAVE PTR
	PUSH	BC		;SET NAME COUNT
	CALL	COMPAR		;COMPARE WITH ARGUMENT
	POP	BC		;GET NAME COUNT
	POP	DE		;GET PTR
	POP	HL
	JP	Z␀,CKLUP1	;MATCH!
	PUSH	HL		;SAVE PTR
	LD	HL,11		;PT TO NEXT ENTRY
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	DEC	B		;COUNT DOWN
	JP	NZ,CKLUP0
	JP	CKINC
CKLUP1:	LD	A,(LISTFL)	;LIST ONLY?
	OR	A		;0=NO
	JP	NZ,CKINC
	LD	(HL),0		;SET USER 0
	LD	A,(CURUSR)	;CHECK FOR CURRENT USER
	CP	0FFH
	JP	Z␀,CKLUP2
	PUSH	HL		;SAVE HL
	LD	E,0FFH		;GET USER VALUE
	LD	C,32		;GET USER AREA FUNCTION
	CALL	BDOS		;BDOS RETURNS CURRENT AREA IN 'A' REG.
	POP	HL		;RESTORE HL
	LD	(HL),A		;POKE IN CURRENT USER AREA
CKLUP2:	LD	A,0FH		;SAY NEED REWRITE
	LD	(REWRT),A
	LD	A,0FFH		;SET COUNT FLAG
	LD	(FIXCNT),A
CKINC:	POP	BC
	LD	DE,32		;LENGTH OF ENTRY
	ADD	HL,DE
	DEC	B
	JP	NZ,CKLUP
	LD	A,(REWRT)	;SEE IF NEED REWRITE
	OR	A
	JP	Z␀,CKDONE	;NO - DONE
;
; WRITE THE DIRECTORY SECTOR BACK TO THE DISK
;
	LD	HL,(TRACK)	;SET TRACK
	LD	C,L
	LD	B,H
	CALL	SETTRK
	LD	HL,(SECTOR)	;SET SECTOR
	DEC	HL		;sector needs to be 0 .. (SPT - 1)
	LD	B,H
	LD	C,L
	CALL	TRNSLT
	CALL	SETSEC
	CALL	WRITE		;WRITE THE SECTOR BACK
	OR	A
	JP	NZ,ERRWRT	;ABORT IF ERROR
CKDONE:	LD	HL,(DIRMAX)
	DEC	HL		;REDUCE SECTORS LEFT
	LD	(DIRMAX),HL
	LD	HL,(SECTOR)	;POINT TO NEXT SECTOR
	INC	HL
	LD	(SECTOR),HL
	EX	DE,HL
	LD	HL,(MAXSEC)	;REACHED LIMIT?
	INC	HL		;ONE MORE
	LD	A,H		;CHECK HIGH
	CP	D
	RET	NZ
	LD	A,L		;CHECK LOW
	CP	E
	RET	NZ
	LD	HL,(TRACK)	;NEXT TRACK
	INC	HL
	LD	(TRACK),HL
	LD	HL,1		;FIRST SECTOR OF NEXT TRACK
	LD	(SECTOR),HL
	RET	
;
; COMPARE 11 BYTES OF DIRECTORY ENTRY AGAINST ARGUMENT
;
COMPAR:	LD	(TEMP),HL	;Hold pointer in case of match
	INC	HL
	EX	DE,HL
	LD	C,11
CMPR1:	LD	A,(DE)		;GET DIRECTORY ENTRY CHARACTER
	AND	7FH		;STRIP ANY FLAGS
	CP	(HL)
	JP	NZ,CMPCKAM
CMPR2:	INC	DE
	INC	HL		;BUMP TO NEXT CHARACTER
	DEC	C
	JP	NZ,CMPR1	;LOOP FOR 11 CHARACTERS
	LD	A,(FIXCNT)	;CHECK FLAG
	OR	A		;0=FIRST TIME
	CALL	Z␀,PRFIX
	LD	HL,(TEMP)
	CALL	PRINTFCB
	XOR	A
	RET			;RETURNS 'ZERO' FLAG SET FOR MATCH
PRFIX:	LD	A,(LISTFL)	;LIST ONLY?
	OR	A		;0=NO
	JP	NZ,PRFIX1
	PRINT	MSG5
	RET	
PRFIX1:	LD	A,0FFH		;DON'T PRINT THIS AGAIN
	LD	(FIXCNT),A
	PRINT	MSG6
	RET	
CMPCKAM:	
	LD	A,(DE)
	CP	0E5H		;NON-ALLOCATED ENTRY?
	JP	Z␀,SKIP
	OR	A		;psco for CP/M 3
	JP	Z,SKIP
	LD	A,(HL)
	CP	'?'
	RET	NZ
	JP	CMPR2
SKIP:	LD	A,1
	OR	A
	RET			;SET NZ FLAG
;
; CHECK FOR CP/M VERSION AND SET THINGS
;
CPMCHK:	LD	DE,80H		;SET DMA TO TBUFF
	LD	C,26
	CALL	BDOS
	CALL	CPM22		;IF 2.2 GO SET THINGS
	CALL	GTBIOS		;ESTABLISH BIOS JUMP VECTOR
;
; SELECT DISK AND SETUP DISK PARAMETER HEADER
;
	LD	A,(FCB)		;GET THE DISK
	LD	E,A
	LD	C,14
	CALL	BDOS
	LD	A,(FCB)
	LD	C,A
	LD	B,0
	CALL	SELDSK		;MAKE SURE DRIVE IS
	LD	A,H		;	SELECTED
	OR	L
	JP	Z␀,ILDISK
	LD	E,(HL)		;GET THE ADDRESS
	INC	HL		;	OF THE XLTO
	LD	D,(HL)	
	EX	DE,HL
	LD	(DPH),HL	;SAVE THE ADDRESS
	RET	
;
; DETERMINE NUMBER OF DIRECTORY ENTRIES
;
CPM22:	LD	C,31		;GET DISK PARAMETERS ADDRESS
	CALL	BDOS		;DPB ADDRESS IN 'HL' ON RETURN
	LD	E,(HL)		;NUMBER OF SECTORS/TRACK
	INC	HL		;AS 2-BYTE QUANTITY IN DE
	LD	D,(HL)
	INC	HL
	EX	DE,HL
	LD	(MAXSEC),HL	;SET MAX SECTORS/TRACK
	EX	DE,HL
	INC	HL
	INC	HL
	LD	A,(HL)		;GET EXM
	LD	(EXTENT),A
	INC	HL		;PT TO DRM
	INC	HL
	INC	HL
	LD	E,(HL)		;GET NUMBER OF
	INC	HL		;	DIRECTORY ENTRIES
	LD	D,(HL)
	EX	DE,HL
	INC	HL		;ACCOUNT FOR - 1
	CALL	SHFHL2		;SHIFT 'HL' RIGHT 2
	LD	(DIRMAX),HL	;SAVE NUMBER DIRECTORY SECTORS
	LD	HL,5		;NOW POINT TO SYSTEM
	ADD	HL,DE		;	TRACK OFFSET
	LD	A,(HL)		;PICK UP NUMBER OF
	INC	HL
	LD	H,(HL)
	LD	L,A
	LD	(TRACK),HL
	RET	
;
; ERROR OCCURED DURING DISK WRITE - ABORT
;
ERRWRT:	PRINT	MSG7
	JP	BOOT		;ABORT
;
; MAKE SURE A LEGAL DISK IS SPECIFIED AND CHECK FOR HELP
;
FCBCHK:	LD	A,(FCB)		;GET DRIVE SPECIFICATION
	OR	A		;SEE IF DEFAULT
	JP	NZ,FCBCK1	;NO, GO CHECK FILENAME
	LD	C,25		;ASK FOR CURRENT DRIVE
	CALL	BDOS
	INC	A		;OFFSET FOR NEXT INSTRUCTION
FCBCK1:	DEC	A		;CURRENT DRIVE NUMBER
	LD	(FCB),A		;SAVE IT
	RET	
;
; CHECK FOR HELP REQUEST
;
HELPCHK:	
	LD	A,(FCB+1)	;GET 1ST BYTE OF FILENAME
	CP	'/'		;HELP?
	JP	Z␀,HCK1
	CP	' '		;MAKE SURE IT IS NON-BLANK
	RET	NZ		;OK - KEEP GOING
;	
; IF NO FILE NAME IS SPECIFIED, ABORT WITH NOTICE
;
HCK1:	PRINT	MSG8
CLEANRET:	
	LD	HL,(STACK)	;QUIET RETURN
	LD	SP,HL
	RET	
;
; GET BIOS JUMPS VECTORS FOR EASY REFERENCE
;
GTBIOS:	LD	HL,(BOOT+1)	;POINTS TO BIOS JUMP TABLE+3
	LD	DE,WBOOT	;WHERE WE WILL KEEP A COPY
	LD	B,JUMPEND-JUMPST	;MOVE 48 BYTES AND FALL THRU TO MOVE
;
; GENERAL PURPOSE MOVE ROUTINE
; FROM 'HL' TO 'DE' FOR COUNT OF B
;
MOVE:	LD	A,(HL)		;GET A BYTE
	LD	(DE),A		;PUT A BYTE
	INC	DE		;INCREMENT TO NEXT
	INC	HL
	DEC	B		;COUNT DOWN
	JP	NZ,MOVE
	RET	
;
;SPECIFIED AN ILLEGAL DISK DRIVE - ABORT
;
ILDISK:	PRINT	MSG9
	JP	BOOT		;ABORT
;
; READS NEXT SECTOR (GROUP OF FOUR DIRECTORY ENTRIES)
; RETURNS WITH ZERO FLAG SET IF NO MORE
;
NXTSEC:	LD	HL,(DIRMAX)	;SEE IF MORE SECTORS
	LD	A,H
	OR	L
	RET	Z␀		;RETURNS ZERO FLAG IF NO MORE
	LD	HL,(TRACK)	;SET TRACK
	LD	C,L
	LD	B,H
	CALL	SETTRK
	LD	HL,(SECTOR)	;SET SECTOR
	DEC	HL		;sector needs to be 0 .. (SPT - 1)
	LD	B,H
	LD	C,L
	CALL	TRNSLT
	CALL	SETSEC
	LD	BC,80H		;FOR CP/M 3 we need to set the DMA also via the BIOS calls
	CALL	SETDMA
	LD	A,(CPMVRS)	;are we using CP/M 3.0 or higher?
	CP	30H
	JP	C,SKIPSB	;this is not the case, skip the set bank business
	LD	A,1		;otherwise we have to set the bank correctly
	CALL	SETBNK		;in case we are running on a banked version
SKIPSB:	CALL	READ		;READ A SECTOR
	AND	1		;REVERSE SENSE OF ERROR FLAG
	XOR	1		;RETURNS WITH ZERO FLAG SET
	RET			;IF BAD READ
;
; FCB PRINTING ROUTINE
;
PRINTFCB:	
	PUSH	HL
	LD	DE,1+8+3
	ADD	HL,DE
	LD	A,(EXTENT)	;GET EXTENT MASK
	CP	(HL)		;COMPARE TO TARGET
	POP	HL
	RET	C␀		;PRINT ONLY FIRST EXTENT
	PRINT	MSG10		;NEW LINE WITH 2 LEADING SPACES
	INC	HL
	LD	B,8
	CALL	PR1
	LD	A,'.'
	CALL	COUT
	LD	B,3
PR1:	LD	A,(HL)
	AND	7FH
	CP	' '		;Check for blanks
	CALL	NZ,COUT
	INC	HL
	DEC	B
	JP	NZ,PR1	
	RET	
;
; DOES USER WANT TO PAUSE TO CHANGE DISKS OR SELECT USER 0?
;
PUSCHK:	LD	A,(PAUSE)	;GET OPTION
	OR	A
	RET	Z␀		;NOPE, SO RETURN
	PRINT	MSG11		;PRINT PAUSE MESSAGE
	LD	C,01
	CALL	BDOS		;INPUT A CHAR
	CP	CTRLC		;ABORT?
	JP	Z␀,CLEANRET
	PRINT	MSG12
	LD	C,0DH
	JP	BDOS		;RESET THE DISK
;
; SHIFT REGS 'HL' RIGHT 2 BITS LOGICAL
;
SHFHL2:	CALL	SHFHL		;ROTATE RIGHT 1 BIT AND FALL THRU
SHFHL:	XOR	A		;CLEAR CARRY
	LD	A,H
	RRA			;SHIFTED BIT IN CARRY
	LD	H,A
	LD	A,L
	RRA	
	LD	L,A
	RET	
;
; TRANSLATE REG 'BC' FROM LOGICAL TO PHYSICAL SECTOR NUMBER
;
TRNSLT:	LD	HL,(DPH)	;GET ADDRESS OF XLTO
	EX	DE,HL
	CALL	SECTRAN		;USE BIOS ROUTINE
	LD	C,L		;RETURN VALUE IN BC
	LD	B,H
	RET	
; THIS IS THE WORKING COPY OF THE BIOS JUMP TABLE
;
JUMPST	EQU	$
WBOOT:	DS	3
CONST:	DS	3
CONIN:	DS	3
CONOUT:	DS	3
LIST:	DS	3
PUNCH:	DS	3
READER:	DS	3
HOME:	DS	3
SELDSK:	DS	3
SETTRK:	DS	3
SETSEC:	DS	3
SETDMA:	DS	3
READ:	DS	3
WRITE:	DS	3
LISTST:	DS	3
SECTRAN:	
	DS	3
conost:	DS	3		; return console output status
auxist:	DS	3		; return aux device input status
auxost:	DS	3		; return aux device output status
devtbl:	DS	3		; return address of character i/o table
devini:	DS	3		; init character i/o devices
drvtbl:	DS	3		; return address of disk drive table
multio:	DS	3		; set number of consec. sec. to read/write
flush:	DS	3		; flush user [de]blocking buffers
movem:	DS	3		; copy memory to memory
time:	DS	3		; signal time and date operation
selmem:	DS	3		; select memory bank
setbnk:	DS	3		; set bank for next dma
xmove:	DS	3		; set banks for next move
JUMPEND	EQU	$
;
STACK:	DS	2		;LOCATION OF STACK
;
; DATA AREAS
;
FNCOUNT:	
	DS	1		;NUMBER OF FILE NAMES IN COMMAND LINE
CURUSR:	DS	1		;0 IF NOT IN CURRENT USER
PAUSE:	DS	1		;0 IF NO PAUSE FOR DISK CHANGE
LISTFL:	DS	1		;0 IF NOT LIST ONLY
DIRMAX:	DS	2		;NUMBER OF SECTORS IN DIRECTORY =
	;	MAXIMUM NUMBER OF DIRECTORY ENTRIES
	;	DIVIDED BY 4 (ENTRIES PER SECTOR)
TEMP:	DS	2		;TEMP STORAGE FOR FCB PRINT
EXTENT:	DS	1		;EXTENT MASK
MAXSEC:	DS	2		;MAXIMUM NUMBER OF SECTORS/TRACK
FIXCNT:	DS	1		;CHANGE FLAG
REWRT:	DS	1		;REWRITE FLAG 0=NO, F=YES
SECTOR:	DS	2		;CURRENT SECTOR NUMBER
TRACK:	DS	2		;TRACK NUMBER OF DIRECTORY
CPMVRS:	DS	1		;Version number of CP/M
;
; ADDRESS OF THE TRANSLATE TABLE
;
DPH:	DS	16
FNTAB:	DW	2		;FILE NAME BUFFER
CEND	EQU	$

	END	
ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее!␀␀9"з!"␀щНяН	НАН:й·ДН)Г␀␀UNERASE Version 1.2$
File(s) Recovered - DOUBLE CHECK Before Using$
NO Files Recovered$
Invalid Option -- $
File(s) Recovered --$
Erased File(s) --$
ABORT - Error During Disk Write$
Syntax:
  UNERASE afn,afn,afn,... o
Options:
  L - List Erased Files Only
  P - Pause for disk change
  Z - Place file in User 0 (default is current)$
ABORT - Illegal Disk Requested$
  $
