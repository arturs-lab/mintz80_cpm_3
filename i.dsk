  2775  12E7  2803             	JR     	Z,DISP1
  2776  12E9  110004           	LD     	DE,NBYTES*8    	;Must be 1024 byte sect
  2777  12EC            
  2778  12EC  7B        DISP1: 	LD     	A,E
  2779  12ED  E63F             	AND    	A,00111111B    	;64 characters /line
  2780  12EF  2003             	JR     	NZ,NOCR
  2781  12F1  CDD30F           	CALL   	ZCRLF
  2782  12F4  7E        NOCR:  	LD     	A,(HL)
  2783  12F5  E67F             	AND    	A,7FH
  2784  12F7  FE20             	CP     	' '    	       	;FILTER OUT CONTROL CHA
  2785  12F9  3002             	JR     	NC,T33
  2786  12FB  3E2E      T22:   	LD     	A,'.'
  2787  12FD  FE7C      T33:   	CP     	A,07CH
  2788  12FF  30FA             	JR     	NC,T22
  2789  1301  4F               	LD     	C,A    	
