  3727  18C6  2A1F39           	LD     	HL,(E_SEC_MARK)	       	;End+1 of GAP3 
  3728  18C9  2B               	DEC    	HL
  3729  18CA  ED52             	SBC    	HL,DE
  3730  18CC  EB               	EX     	DE,HL  	       	;Count now in DE
  3731  18CD  E1               	POP    	HL     	       	;DE on stack to HL
  3732  18CE  7E        HGAP3X:	LD     	A,(HL)
  3733  18CF  CD8919           	CALL   	PACC   	       	;Print out HEX values o
  3734  18D2  23               	INC    	HL     	       	
  3735  18D3  1B               	DEC    	DE     	       	;Decrease DE count by 1
  3736  18D4  7B               	LD     	A,E
  3737  18D5  B7               	OR     	A,A    	       	;Not XX00 at least
  3738  18D6  20F6             	JR     	NZ,HGAP3X
  3739  18D8  B2               	OR     	A,D    	       	
  3740  18D9  20F3             	JR     	NZ,HGAP3X      	;Not 0000
  3741  18DB            
  3742  18DB                   	       	       	       	;Now display the Track 
