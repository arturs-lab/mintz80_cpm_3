  3850  1971  CD3819           	CALL   	GET_HEX	       	;get 2 HEX digits
  3851  1974  3809             	JR     	C,SCAN_ABORT
  3852  1976  67               	LD     	H,A
  3853  1977  CD3819           	CALL   	GET_HEX	       	;get 2 more HEX digits
