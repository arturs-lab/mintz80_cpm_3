 0339 0603      	MVI	B,3		;BUILD NEXT 3 FIELDS
 033B CD3F04    	CALL	BLDFMT
 033E EB        	XCHG			;SAVE CURRENT MEMORY POINTER IN [DE]
 033F 2A5F13    	LHLD	SECIDPTR	;GET ADDRESS OF NEXT SLOT FOR SECTOR ID ADDR
 0342 73        	MOV	M,E		;STORE CURRENT SECTOR ID POINTER
 0343 23        	INX	H
