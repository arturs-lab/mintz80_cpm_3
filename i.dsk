                	;;;;; CONIN
                	; GET CHARACTER FROM CONSOLE KEYBOARD --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	[A] = CONSOLE CHARACTER GOTTEN
                	;
                	;	REGISTERS:	[BC],[DE],[HL] UNALTERED
                	;
                CONIN:
                	; SAVE REGISTER STATE:
 0234 C5        	PUSH	B
 0235 D5        	PUSH	D
 0236 E5        	PUSH	H
                
                	; CHECK LOCAL 1 CHARACTER BUFFER FOR CURRENT CONSOLE CHARACTER:
 0237 3AD913    CONIN0:	LDA	CONCHAR		;GET BUFFER CHARACTER
 023A B7        	ORA	A		;WILL BE 0 IF NONE AVAILABLE
                	JRNZ	CONIN$RET	;RETURN INPUT CHARACTER IF NON-ZERO...
 023B+20        	DB	20H
 023C+05        	DB	CONIN$RET-$-1
 023D CD4B02    	CALL	CONSTAT		;ELSE POLL CONSOLE
                	JR	CONIN0		;AND LOOP BACK UP...
 0240+18        	DB	18H
 0241+F5        	DB	CONIN0-$-1
                
                	; ORDERLY RETURN TO CALLER WITH INPUT CHARACTER:
                CONIN$RET:
 0242 21D913    	LXI	H,CONCHAR	;POINT TO 1 CHARACTER BUFFER
 0245 3600      	MVI	M,0		;INVALIDATE IT
 0247 E1        	POP	H		;RESTORE REGISTERS
 0248 D1        	POP	D
 0249 C1        	POP	B
 024A C9        	RET			;WITH INPUT CHARACTER IN [A]
                
                
                	;;;;; CONSTAT
                	; CHECK CONSOLE FOR INPUT STATUS --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	[A] = 0 IF NO CHARACTER AVAILABLE
                	;			      255 IF CHARACTER IS AVAILABLE
                	;			      FLAGS ARE SET TO REFLECT THE ABOVE
                	;
                	;	REGISTERS:	[BC],[DE],[HL] UNALTERED
                	;
                CONSTAT:
                	; SAVE REGISTER STATE:
 024B C5        	PUSH	B
 024C D5        	PUSH	D
 024D E5        	PUSH	H
                
                	; LET BDOS DO CONSOLE STATUS POLLING:
 024E 0E06      	MVI	C,DCONSTAT	;[C] = BDOS FUNCTION #
 0250 1EFF      	MVI	E,255		;[E] = STATUS REQUEST FLAG
 0252 CD0500    	CALL	BDOS		;EXECUTE STATUS REQUEST...
 0255 32D913    	STA	CONCHAR		;SAVE CHARACTER IF 1 WAS GOTTEN
 0258 B7        	ORA	A		;SET FLAGS ON RESULT
                	JRZ	CONST0
 0259+28        	DB	28H
 025A+02        	DB	CONST0-$-1
 025B 3EFF      	MVI	A,TRUE		;[A] = TRUE IF CHARACTER GOTTEN
                CONST0:
                
                	; RESTORE REGISTER STATE:
 025D E1        	POP	H
 025E D1        	POP	D
 025F C1        	POP	B
 0260 C9        	RET			;WITH RESULTS IN [A] AND FLAGS
                
                
                	;;;;; MULT$ERASE
                	; ERASE MULTIPLE CHARACTERS PREVIOUSLY DISPLAYED ON CURSOR LINE --
                	;
                	;	ON ENTRY:	[A] = # CHARACTERS TO ERASE
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL SAVED BUT [AF]
                	;
                MULT$ERASE:
                	; SAVE REGISTER STATE:
 0261 C5        	PUSH	B
 0262 D5        	PUSH	D
 0263 E5        	PUSH	H
                
                	; SETUP...
 0264 47        	MOV	B,A		;KEEP COUNT IN [B]
                
                	; ERASE LOOP:
                MULTELP:
 0265 3E08      	MVI	A,BACKSPACE	;1ST A BACKSPACE
 0267 CD2502    	CALL	CONOUT
 026A 3E20      	MVI	A,' '		;THEN ERASE THE CHARACTER THERE
 026C CD2502    	CALL	CONOUT
 026F 3E08      	MVI	A,BACKSPACE	;THEN BRING THE CURSOR BACK
 0271 CD2502    	CALL	CONOUT
                	DJNZ	MULTELP		;LOOP FOR ALL CHARACTERS TO ERASE
 0274+10        	DB	10H
 0275+EF        	DB	MULTELP-$-1
                
                	; RESTORE REGISTERS:
 0276 E1        	POP	H
 0277 D1        	POP	D
 0278 C1        	POP	B
 0279 C9        	RET
                
                
                	;;;;; UCASE
                	; TRANSLATE LOWER CASE TO UPPER CASE --
                	;
                	;	ON ENTRY:	[A] = CHARACTER TO TRANSLATE
                	;
                	;	ON EXIT:	[A] = TRANSLATED CHARACTER
                	;
                	;	REGISTERS:	NONE DESTROYED
                	;
 027A FE61      UCASE:	CPI	'a'		;MUST BE >= LOWERCASE A
 027C D8        	RC			; ELSE GO BACK...
 027D FE7B      	CPI	'z'+1		;MUST BE <= LOWERCASE Z
 027F D0        	RNC			; ELSE GO BACK...
 0280 D620      	SUI	'a'-'A'		;SUBTRACT LOWERCASE BIAS
 0282 C9        	RET
                
                
                	;;;;; AUTOEXEC
                	; PROCESS COMMAND LINE TAIL AND AUTOEXECUTE REQUEST --
                	;
                	;	ON ENTRY:	[A] = 1ST COMMAND LINE TAIL CHARACTER
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL ALTERED
                	;
                AUTOEXEC:
