                		; D;
;I/O EQUATES for the CPZ-48000 Board. (7-26-82)
;
;define sio registers
;
COMA	EQU	IOBASE+1H	;sio port a command reg
STATA	EQU	COMA		;sio port a status reg
DATAA	EQU	IOBASE+0H	;sio port a data reg
CKBR	EQU	0		;input ready bit
CPTR	EQU	2		;output ready bit
COMB	EQU	IOBASE+3H	;sio port b command reg
STATB	EQU	COMB		;sio port b status reg
DATAB	EQU	IOBASE+2H	;sio port b data reg
LRBIT	EQU	CPTR		;printer out ready bit
;
;define sio/dart options
;
;	(write reg 0)
;
NULLCD	EQU	00000000B	;nullcode
RSTRCRC	EQU	01000000B	;reset rx crc checker
RSTTCRC	EQU	10000000B	;reset tx crc checker
RSTCRCL	EQU	11000000B	;reset sending crc/sync latch
SNDABRT	EQU	00001000B	;send abort (sdlc)
RSTEXTI	EQU	00010000B	;reset ext. status interrupts
RSTCHAN	EQU	00011000B	;channel reset
RST1STC	EQU	00100000B	;reset rxint on 1st character
RSTTXIP	EQU	00101000B	;reset txint pending
RSTERR	EQU	00110000B	;error reset
RETINT	EQU	00111000B	;return from int (ch a only)
REG0	EQU	0		;reg 0
REG1	EQU	1		;reg 1
REG2	EQU	2		;reg 2
REG3	EQU	3		;reg 3
REG4	EQU	4		;reg 5
REG5	EQU	5		;reg 5
REG6	EQU	6		;reg 6
REG7	EQU	7		;reg 7
;
;	(write reg 1)
;
WRDYENB	EQU	10000000B	;wait| ready enable
WRDYFUN	EQU	01000000B	;wait| ready function
WRDYRT	EQU	00100000B	;wait| ready on r/t
INTRXNP	EQU	00011000B	;int on all rx char (parity no affect)
INTRXPV	EQU	00010000B	;int on all rx char (parity affects vect)
RXINT1	EQU	00001000B	;rx int on 1st character
RXINTD	EQU	00000000B	;rx interrupts disable
STATAV	EQU	00000100B	;status affects vector (chan b only)
TXINTE	EQU	00000010B	;tx int enable
EXTINTE	EQU	00000001B	;external interrupt enable
;
;	(write reg 2 chan b only)
;
CHBV7	EQU	10000000B	;vector 7 chan b
CHBV6	EQU	01000000B	;vector 6 chan b
CHBV5	EQU	00100000B	;vector 5 chan b
CHBV4	EQU	00010000B	;vector 4 chan b
CHBV3	EQU	00001000B	;vector 3 chan b
CHBV2	EQU	00000100B	;vector 2 chan b
CHBV1	EQU	00000010B	;vector 1 chab b
CHBV0	EQU	00000001B	;vector 0 chan b
;
;	(write reg 3)
;
RX8BITS	EQU	11000000B	;rx 8 bits/char
RX6BITS	EQU	10000000B	;rx 6 bits/char
RX7BITS	EQU	01000000B	;rx 7 bits/char
RX5BITS	EQU	00000000B	;rx 5 bits/char
AUTENB	EQU	00100000B	;auto enables
ENTHUNT	EQU	00010000B	;enter hunt phase
RXCRCEN	EQU	00001000B	;rx crc enable
ADDSRCH	EQU	00000100B	;address search mode (sdlc)
SYNCLI	EQU	00000010B	;sync char load inhibit
RXENBLE	EQU	00000001B	;rx enable
;
;	(write reg 4)
;
X64CLK	EQU	11000000B	;x 64 clock rate
X32CLK	EQU	10000000B	;x 32 clock rate
X16CLK	EQU	01000000B	;x 16 clock rate
X1CLK	EQU	00000000B	;x 1 clock rate
EXTSYNM	EQU	00110000B	;external sync mode
SDLCMOD	EQU	00100000B	;sdlc mode (01111110 flag)
SYNC16	EQU	00010000B	;16 bit sync character
SYNC8	EQU	00000000B	;8 bit sync character
STOP2	EQU	00001100B	;2 stop bits
STOP15	EQU	00001000B	;1.5 stop bits
STOP1	EQU	00000100B	;1 stop bit
SYNCMDE	EQU	00000000B	;sync mode enable
PEVEODD	EQU	00000010B	;parity even-odd|
PARENB	EQU	00000001B	;parity enable
;
;	(write register 5)
;
DTR	EQU	10000000B	;dtr (1 = set)
TX8BITS	EQU	01100000B	;tx 8 bits
TX6BITS	EQU	01000000B	;tx 6 bits
TX7BITS	EQU	00100000B	;tx 7 bits
TX5BITS	EQU	00000000B	;tx 5 bits or less
BREAK	EQU	00010000B	;send break character
TXENBLE	EQU	00001000B	;tx enable
CRC16	EQU	00000100B	;use crc-16
SDLC	EQU	00000000B	;use sdlc mode
RTS	EQU	00000010B	;rts (1 = set)
TXCRCE	EQU	00000001B	;tx crc enable
;
;	(write reg 6 & 7 are programmend
;	 with the 8 or 16 bit sync field)
;
;define floppy disk regs
;
DCOM	EQU	IOBASE+10H	;disk command register
DSTAT	EQU	DCOM		;disk status register
TRACK	EQU	DCOM+1		;disk track register
SECTP	EQU	DCOM+2		;disk sector register
DDATA	EQU	DCOM+3		;disk data register
WAIT	EQU	IOBASE+53H	;program data xfer wait port
DCONT	EQU	IOBASE+52H	;drv, side, den, motor on, port
;
;define disk control port
;
SIDE0	EQU	6		;side select bit (0=side0, 1=side1)
DENSITY	EQU	3		;density bit (0=sing, 1=doub)
MOTON	EQU	2		;motor on bit (0=off, 1=on)
;
;define wait port bits
;
FINT	EQU	7		;floppy interrupt bit (intrq)
;
;define floppy commands
;
RESTOR	EQU	00000000B	;restore command
SEEK	EQU	00010000B	;seek command
STEP	EQU	00100000B	;step command
STEPIN	EQU	01000000B	;step in command
STEPOUT	EQU	01100000B	;step out command
READSEC	EQU	10000000B	;read sector command
WRTSEC	EQU	10100000B	;write sector command
RDADDR	EQU	11000000B	;read address command
RDTRK	EQU	11100000B	;read track command
WRTTRK	EQU	11110000B	;write track command
FRCINT	EQU	11010000B	;force interrupt command
VERIF	EQU	00000100B	;verify flag bit
UPDATE	EQU	00010000B	;update flag bit
MULTI	EQU	00010000B	;multiple record flag
DLAY15	EQU	00000100B	;delay 15 ms
;
;floppy status register bits (type i some type ii & iii commands)
;
READY	EQU	10000000B	;floppy ready bit
PROTEC	EQU	01000000B	;write protect bit
HEADLD	EQU	00100000B	;head load bit
ERRSEK	EQU	00010000B	;seek error bit
ERRCRC	EQU	00001000B	;crc error bit
TRK0	EQU	00000100B	;track 0 bit
INDX	EQU	00000010B	;index bit
BUSY	EQU	00000001B	;busy bit
RECNF	EQU	00010000B	;record not found bit
LOSTD	EQU	00000100B	;lost data bit (type ii)
DRQ	EQU	00000010B	;data request (type ii)
;
;define pio registers
;
PDATA	EQU	IOBASE+20H	;pio port a data register
PCMDA	EQU	IOBASE+21H	;pio port a cmnd register
PDATB	EQU	IOBASE+22H	;pio port b data register
PCMDB	EQU	IOBASE+23H	;pio port b cmnd register
;
;pio options
;
PVECT7	EQU	10000000B	;vector # 7
PVECT6	EQU	01000000B	;vector # 6
PVECT5	EQU	00100000B	;vector # 5
PVECT4	EQU	00010000B	;vector # 4
PVECT3	EQU	00001000B	;vector # 3
PVECT2	EQU	00000100B	;vector # 2
PVECT1	EQU	00000010B	;vector # 1
;
;mode selection options
;
PMODE0	EQU	00001111B	;mode 0 (output from port)
PMODE1	EQU	01001111B	;mode 1 (input to a port)
PMODE2	EQU	10001111B	;mode 2 (bidirectional port)
PMODE3	EQU	11001111B	;mode 3 (control port)
;
;mode 3 i/o options (default = output)
;
BIT7IN	EQU	10000000B	;bit 7 = input
BIT6IN	EQU	01000000B	;bit 6 = input
BIT5IN	EQU	00100000B	;bit 5 = input
BIT4IN	EQU	00010000B	;bit 4 = input
BIT3IN	EQU	00001000B	;bit 3 = input
BIT2IN	EQU	00000100B	;bit 2 = input
BIT1IN	EQU	00000010B	;bit 1 = input
BIT0IN	EQU	00000001B	;bit 0 = input
PINTON	EQU	10000111B	;enable interrupts
ANDOR	EQU	01000111B	;select and/or function
HIGLOW	EQU	00100111B	;select high/low bit test
MSKFOL	EQU	00010111B	;mask follows
MSKBT7	EQU	10000000B	;mask bit 7
MSKBT6	EQU	01000000B	;mask bit 6
MSKBT5	EQU	00100000B	;mask bit 5
MSKBT4	EQU	00010000B	;mask bit 4
MSKBT3	EQU	00001000B	;mask bit 3
MSKBT2	EQU	00000100B	;mask bit 2
MSKBT1	EQU	00000010B	;mask bit 1
MSKBT0	EQU	00000001B	;mask bit 0
SETINT	EQU	10000011B	;set/reset int enable f/f
;
;define timer registers
;
TCH0	EQU	IOBASE+30H	;timer chan 0
TCH1	EQU	IOBASE+31H	;timer chan 1
TCH2	EQU	IOBASE+32H	;timer chan 2 (use for intrps)
TCMND	EQU	IOBASE+33H	;command port
;
;define timer options
;
CNTR0	EQU	00000000B	;counter 0
CNTR1	EQU	01000000B	;counter 1
CNTR2	EQU	10000000B	;counter 2
RLWORD	EQU	00110000B	;read/load lsb,msb
RLHBYT	EQU	00100000B	;read/load msb only
RLLBYT	EQU	00010000B	;read/load lsb only
CNTRLT	EQU	00000000B	;counter latching operation
BINARY	EQU	00000000B	;binary count select
BCD	EQU	00000001B	;bcd counter select
MODE0	EQU	00000000B	;interrupt on terminal count
MODE1	EQU	00000010B	;programmable one-shot
MODE2	EQU	00000100B	;rate generator
MODE3	EQU	00000110B	;square wave generator
MODE4	EQU	00001000B	;software triggered strobe
MODE5	EQU	00001010B	;hardware triggered strobe
;
;define interrupt controller regs
;
INTCMD	EQU	IOBASE+41H	;interrupt command register
INTSTS	EQU	IOBASE+41H	;interrupt status register
INTDOT	EQU	IOBASE+40H	;write pre-selected data reg.
INDIN	EQU	IOBASE+40H	;read pre-selected data reg.
;
;define interrupt controller options
;	(mode register)
;
INTDSB	EQU	00000000B	;disable interrupt chip
INTENB	EQU	10000000B	;enable interrupt chip
INTISR	EQU	00000000B	;interrupt service register
INTMSK	EQU	00100000B	;interrupt mask register
INTREQ	EQU	01000000B	;interrupt request register
INTAUTO	EQU	01100000B	;interrupt auto clear register
IREQL	EQU	00000000B	;interrupt request active low
IREQH	EQU	00010000B	;interrupt request active high
GINTL	EQU	00000000B	;group interrupt active low
GINTH	EQU	00001000B	;group interrupt active high
INTINT	EQU	00000000B	;use vector interrupts
INTPOL	EQU	00000100B	;use polled mode
INTINV	EQU	00000000B	;use individual vector
INTCOM	EQU	00000010B	;use common vector
INTFIX	EQU	00000000B	;use fixed priority
INTROT	EQU	00000001B	;use rotating priority
;
;define programming options
;
INTRST	EQU	00000000B	;interrupt chip reset command
CII	EQU	00010000B	;clear irr and imr
CSIIB	EQU	00011000B	;clear single imr and irr bit
CIMR	EQU	00100000B	;clear imr
CSIMRB	EQU	00101000B	;clear single imr bit
SETIMR	EQU	00110000B	;set imr
SSIMRB	EQU	00111000B	;set single imr bit
CIRR	EQU	01000000B	;clear irr
CSIRRB	EQU	01001000B	;clear single irr bit
SETIRR	EQU	01010000B	;set irr
SSIRRB	EQU	01011000B	;set single irr bit
CHPISRB	EQU	01100000B	;clear highest priority isr bit
CISR	EQU	01110000B	;clear isr
CSISRB	EQU	01111000B	;clear  single isr bit
LMB0TO4	EQU	10000000B	;load mode bits m0 to m4
CMB5TO7	EQU	10100000B	;control mode bits m5 to m7
PREIMR	EQU	10110000B	;preselect imr for writing
PREACR	EQU	11000000B	;preselect acr for writing
PREMEM	EQU	11100000B	;preselect response mem for write
;
;define register bits, mode bits
;
IBIT0	EQU	0		;register 0
IBIT1	EQU	1		;register 1
IBIT2	EQU	2		;register 2
IBIT3	EQU	3		;register 3
IBIT4	EQU	4		;register 4
IBIT5	EQU	5		;register 5
IBIT6	EQU	6		;register 6
IBIT7	EQU	7		;register 7
BCNT1	EQU	00000000B	;byte count = 1
BCNT2	EQU	00001000B	;byte count = 2
BCNT3	EQU	00010000B	;byte count = 3
BCNT4	EQU	00011000B	;byte count = 4
;
;interrupt status register bits
;
GRPINT	EQU	7		;group interrupt bit
ENBINT	EQU	6		;chip enable/disable bit
PRIMOD	EQU	5		;fixed/rotate bit check
MODINT	EQU	4		;interrupt mode (int/polled)
MSKBIT	EQU	3		;master mask bit (armed/disarmed)
VECT0	EQU	0		;vector # 0
VECT1	EQU	1		;vector # 1
VECT2	EQU	2		;vector # 2
VECT3	EQU	3		;vector # 3
VECT4	EQU	4		;vector # 4
VECT5	EQU	5		;vector # 5
VECT6	EQU	6		;vector # 6
VECT7	EQU	7		;vector # 7
;
;define prom and deselect registers
;
BOOTR	EQU	IOBASE+50H	;boot enable/disable reg
WINDOW	EQU	IOBASE+51H	;deselect window register
;
;define boot enable/disable bits
;
FIXPROM	EQU	00000001B	;fix prom location
DSBPROM	EQU	00000010B	;disable prom
DSBWIND	EQU	00000100B	;disable deselect window
;
;define memory management registers
;
MMPORT	EQU	IOBASE+60H	;base address of memory management
MMENB	EQU	00001000B	;enable memory management
;
;define dma registers
;
DMAP	EQU	IOBASE+70H	;base address of dma chip
ADR0	EQU	DMAP+0		;address reg chan 0
WCT0	EQU	DMAP+1		;word count chan 0
ADR1	EQU	DMAP+2		;address reg chan 1
WCT1	EQU	DMAP+3		;word count chan 1
ADR2	EQU	DMAP+4		;address reg chan 2
WCT2	EQU	DMAP+5		;word count chan 2
ADR3	EQU	DMAP+6		;address reg chan 3
WCT3	EQU	DMAP+7		;word count chan 3
CMND	EQU	DMAP+8		;command/status register
REQREG	EQU	DMAP+9		;software/hardware request reg
FMASK	EQU	DMAP+10		;single mask register select
MODE	EQU	DMAP+11		;mode register
CLRBP	EQU	DMAP+12		;clear byte pointer f/f
MSTRCL	EQU	DMAP+13		;master clear
MASK	EQU	DMAP+15		;write all mask registers
;
;command register options
;
DACKL	EQU	00000000B	;dack active low
DACKH	EQU	10000000B	;dack active high
DREQH	EQU	00000000B	;dreq active low
DREQL	EQU	01000000B	;dreq active high
LWRIT	EQU	00000000B	;late write selection
EXTWRT	EQU	00100000B	;extended write selection
FIXPRI	EQU	00000000B	;fixed priority mode
ROTPRI	EQU	00010000B	;rotating priority mode
NORTIM	EQU	00000000B	;normal timing mode
COMTIM	EQU	00001000B	;compressed timing mode
DMAENB	EQU	00000000B	;dma chip enable
DMADSB	EQU	00000100B	;dma chip disable
C0AHDD	EQU	00000000B	;chan 0 addr hold disable
C0AHDE	EQU	00000010B	;chan 0 addr hold enable
MTMDSB	EQU	00000000B	;memory to memory disable
MTMENB	EQU	00000001B	;memory to memory enable
;
;mode register options
;
DEMAND	EQU	00000000B	;demand mode
SINGLE	EQU	01000000B	;single mode
BLOCK	EQU	10000000B	;block mode
CASCADE	EQU	11000000B	;cascade mode
ADDRUP	EQU	00000000B	;addr increment mode
ADDRDN	EQU	00100000B	;addr decrement mode
AUTODSB	EQU	00000000B	;autoinitialize disable
AUTOENB	EQU	00010000B	;autoinitialize enable
VERIFYT	EQU	00000000B	;verify transfer
WRTXFR	EQU	00000100B	;write transfer
RDXFR	EQU	00001000B	;read transfer
CHAN0	EQU	00000000B	;channel 0 select
CHAN1	EQU	00000001B	;channel 1 select
CHAN2	EQU	00000010B	;channel 2 select
CHAN3	EQU	00000011B	;channel 3 select
;
;request register / mask register options
;	(note: uses regs shown above)
;
CLRREQ	EQU	00000000B	;reset request bit
SETREQ	EQU	00000100B	;set request bit
;
;mask register options
;
CLRCH0	EQU	00000000B	;clear chan 0 mask bit
SETCH0	EQU	00000001B	;set chan 0 mask bit
CLRCH1	EQU	00000000B	;clear chan 1 mask bit
SETCH1	EQU	00000010B	;set chan 1 mask bit
CLRCH2	EQU	00000000B	;clear chan 2 mask bit
SETCH2	EQU	00000100B	;set chan 2 mask bit
CLRCH3	EQU	00000000B	;clear chan 3 mask bit
SETCH3	EQU	00001000B	;set chan 3 mask bit
;
;bit positions for status reg.
;
CH3REQ	EQU	7		;chan 3 request bit
CH2REQ	EQU	6		;chan 2 reguest bit
CH1REQ	EQU	5		;chan 1 request bit
CH0REQ	EQU	4		;chan 0 request bit
CH3TC	EQU	3		;chan 3 terminal count
CH2TC	EQU	2		;chan 2 terminal count
CH1TC	EQU	1		;chan 1 terminal count
CH0TC	EQU	0		;chan 0 terminal count
