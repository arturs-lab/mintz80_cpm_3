#         STS     1 = CHAR AVL
#                 0 = CHAR AVL & EOF
#                -1 = READ ERROR
#
      LOGICAL STS, READ, RDOK, RDEOF, RDLST, RDSTS
      LOGICAL SECTOR(128), CAVL, EOF, ERR, DCLOSR
#
      INTEGER CHR$I, CHR$N
#
      DATA RDOK,RDLST,RDEOF/0,1,2/, CAVL,EOF,ERR/1,0,-1/
#
      IF ( CHR$N == 0 )
          BEG
              RDSTS = READ( SECTOR, CHR$N )
              CHR$I = 1
	      IF( RDSTS == RDEOF )			# empty file?
		 BEG
		    STS = ERR				# yes, indicate err
		    CALL DCLOSR( IDMY )			#	& close file
		    RETURN
		 GEB
              IF( RDSTS ^= RDOK )
                  BEG
                      CALL DSPSTS( 'DSKRD ERR ', 10, -RDSTS )
                      CALL DCLOSR( IDMY )
                  F38           	LD     	A,(CRTDISP)    	       	;If detailed CR
   500  02E3  B7               	OR     	A,A    	       	       	;will switch it
