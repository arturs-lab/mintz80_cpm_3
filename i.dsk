   498  02DE  28BE             	JR     	Z,READ_LOOP1   	       	;Loop until abo
   499  02E0  3AF#DES,#REG
	MEND
;
;
CPM:	MACRO	#ADR,#LIT
	LD	A,#ADR
	CP	#LIT
	MEND
;
;	MAKE CDOS CALL WITH INTERRUPTS ON
;		CPMIO	OPCODE
;
CPMIO:	MACRO	#OPCOD
	LD	C,#OPCOD
	CALL	5
	MEND
;
;	DELAY CONVERSATION WITH 8251
;
NOPS	MACRO
	NOP
	NOP
	NOP
	MEND
;
;
TRUE	EQU	1
FALSE	EQU	0
M$TRAN	EQU	2		;BSC BUFFER CONTAINS TRANSPARENT DATA
T.TSYN	EQU	3		;TEST MESSAGE SYN LEAD IN
	list	on
	list	off
;
;	REAL TIME CLOCK EQUATES
;
CTC	EQU	20H		;CTC BASE I/O ADDRESS
CTC0	EQU	CTC+0
CTC1	EQU	CTC+1
CTC2	EQU	CTC+2		;RBTE REAL TIME CLOCK
CTC3	EQU	CTC+3
CLKCTC	EQU	CTC3		;RBTE REAL TIME CLOCK
;
INTBAS	EQU	0000H		;INTERRUPT VECTOR BASE ADDRESS
V$CTC	EQU	20H		;CTC LOW BYTE INTERRUPT VECTOR BASE
V$CLK	EQU	INTBAS+V$CTC+6	;RBTE CLOCK
;
RSTCLK	EQU	3		;RESET CTC CHANNEL
TMRMOD	EQU	21H		;TIMER MODE COMMAND
CNTMOD	EQU	41H		;COUNT MODE COMMAND
CTCINT	EQU	80H		;INTERRUPT ENABLE
CTCLOD	EQU	4		;LOAD INTERVAL TIMER
;
;	CONSOLE EQUATES
;
SIO1	EQU	60H		;SIO 1 BASE ADDRESS
CONDAT	EQU	SIO1+2		;SIO1 CH. B - CONSOLE
CONCMD	EQU	SIO1+3		;SIO1 CH. B - CONSOLE COMMAND PATH
	FORM
;
;	MODEM & PRINTER EQUATES
;
SIO2	EQU	70H		;SIO 2 BASE ADDRESS
MDMDAT	EQU	SIO2+0		;SIO2 CH A DATA PATH
MDMCMD	EQU	SIO2+1		;SIO2 CH A COMMAND PATH
LPTDAT	EQU	SIO2+2		;SIO2 CH B DATA PATH
LPTCMD	EQU	SIO2+3		;SIO2 CH B COMMAND PATH
;
V$SIO2	EQU	10H		;SIO2 LOW BYTE ADDRESS OF INTERRUPT VECTOR
V$TXIM	EQU	INTBAS+V$SIO2+8		;MODEM TX INTERRUPT
V$EXTM	EQU	INTBAS+V$SIO2+10	;MODEM EXTERNAL INTERRUPT
V$RXIM	EQU	INTBAS+V$SIO2+12	;MODEM RECEIVE INTERRUPT
V$SPCM	EQU	INTBAS+V$SIO2+14	;MODEM SPECIAL RX INTERRUPT
V$TXIL	EQU	INTBAS+V$SIO2+0		;LPT TX INTERRUPT
V$EXTL	EQU	INTBAS+V$SIO2+2		;LPT EXTERNAL INTERRUPT
V$RXIL	EQU	INTBAS+V$SIO2+4		;LPT RECEIVE INTERRUPT
V$SPCL	EQU	INTBAS+V$SIO2+6		;LPT SPECIAL RX INTERRUPT
;
;	SIO WRITE REGISTER 0
;
REG0	EQU	0			;REGISTER 0 POINTER
REG1	EQU	1			;REGISTER 1 POINTER
REG2	EQU	2			;REGISTER 2 POINTER
REG3	EQU	3			;REGISTER 3 POINTER
REG4	EQU	4			;REGISTER 4 POINTER
REG5	EQU	5			;REGISTER 5 POINTER
REG6	EQU	6			;REGISTER 6 POINTER
REG7	EQU	7			;REGISTER 7 POINTER
;
SNABT	EQU	8			;SDLC SEND ABORT
EXTRST	EQU	10H			;RESET EXTERNAL STATUS
CHNRST	EQU	18H			;CHANNEL RESET
ENBNXT	EQU	20H			;ENABLE INT ON NEXT RX CHAR
TXIRST	EQU	28H			;RESET TX INTERRUPT PENDING
ERRRST	EQU	30H			;ERROR RESET
;
RXCRST	EQU	40H			;RESET RX CRC ACCUM.
TXCRST	EQU	80H			;RESET TX CRC ACCUM.
UNDRST	EQU	0C0H			;RESET TX UNDERRUN/EOM
	FORM
;
;	SIO WRITE REGISTER 1 - INTERRUPT ENABLES
;
EXTENB	EQU	1			;EXTERNAL STATUS ENABLE
TXINT	EQU	2			;TX INTERRUPT ENABLE
STSAFT	EQU	4			;ENABLE STATUS AFFECTS (CHAN B ONLY)
;
RXDISB	EQU	0			;RX INTERRUPT DISABLE
RXFST	EQU	8			;INTERRUPT ON FIRST RX CHAR ONLY
RXCHRP	EQU	10H			;INTERRUPT ON ALL CHAR WITH PARITY INT
RXCHR	EQU	18H			;INTERRUPT ON ALL CHARS WITHOUT PARITY
;
;	SIO WRITE REGISTER 3 - RECEIVE 
;
RXENBL	EQU	1			;RX ENABLE
SYNINH	EQU	2			;SYNC INHIBIT ENABLE
RXCENB	EQU	8			;RX CRC ENABLE
HUNT	EQU	10H			;ENABLE HUNT MODE
AUTENB	EQU	20H			;AUTO ENABLES
;
RSIZ5	EQU	0			;5 BIT RX CHAR
RSIZ6	EQU	80H			;6 BIT RX CHAR
RSIZ7	EQU	40H			;7 BIT RX CHAR
RSIZ8	EQU	0C0H			;8 BIT RX CHAR
	FORM
;
;	SIO WRITE REGISTER 4 - MODE SELECT
;
PAROFF	EQU	0			;PARITY CHECK DISABLED
PARODD	EQU	1			;ENABLE ODD PARITY CHECK
PAREVN	EQU	3			;ENABLE EVEN PARIY CHECK
;
STOP0	EQU	0			;SYNC MODE
STOP1	EQU	4			;1 STOP BITS
STOP15	EQU	8			;1.5 STOP BITS
STOP2	EQU	0CH			;2 STOP BITS
;
MOSYNC	EQU	0			;MONO SYNC
BISYNC	EQU	10H			;BINARY SYNC
SDSYNC	EQU	20H			;SDLC
EXSYNC	EQU	30H			;EXTERNAL SYNC
;
CLOK1	EQU	0			;1X CLOCK RATE (SYNC)
CLOK16	EQU	40H			;16X CLOCK RATE
CLOK32	EQU	80H			;32X CLOCK RATE
CLOK64	EQU	0C0H			;64X CLOCK RATE
;
;	SIO WRITE REGISTER 5 - TRANSMIT
;
TXCENB	EQU	1			;TX CRC ENABLE
RTS	EQU	2			;REQUEST TO SEND ENABLE
;
BICRC	EQU	4			;CRC-16 (BSC)
SDCRC	EQU	0			;SDLC CRC
;
TXENBL	EQU	8			;TX ENABLE
SNDBRK	EQU	10H			;SEND BREAK
;
TSIZ5	EQU	0			;5 BIT TX CHAR
TSIZ6	EQU	40H			;6 BIT TX CHAR
TSIZ7	EQU	20H			;7 BIT TX CHAR
TSIZ8	EQU	60H			;8 BIT TX CHAR
;
DTR	EQU	80H			;DATA TERMINAL READY
	FORM
;
;	SIO READ REGISTER 0 - EXTERNAL STATUS
;
RXAVL	EQU	1			;RX CHAR AVAILABLE
INTPND	EQU	2			;INTERRUPT PENDING
TXEMPT	EQU	4			;TX BUFFER EMPTY
DCD	EQU	8			;DATA CARRIER DETECT
;
SYNHNT	EQU	10H			;SYNC/HUNT
CTS	EQU	20H			;CLEAR TO SEND
TXUNDR	EQU	40H			;TX UNDERRUN/EOM
BREAK	EQU	80H			;BREAK/ABORT
;
;	SIO READ REGISTER 1 - RX ERRORS
;
PARERR	EQU	10H			;RX PARITY ERROR
RXOVRF	EQU	20H			;RX OVER RUN
CRCERR	EQU	40H			;CRC ERROR
	LIST	ON
	LIST	NOGEN
	VERSON	9,102,0,05,15,I.IOD,V.IOD,D.IOD
;
;	IODEP - I/O DEPENDENT CODE
;		THIS MODULE CONTAINS ALL CODE THAT PERTAINS TO SPECIFIC
;		DEVICE CONFIGURATIONS.
;
;	VERSION	DATE		CHANGE
;	22,0	08/12/80	WRITTEN FOR GNAT SYSTEM/10 (SEE GNAT9 & ONYX)
;	23,0	09.16/80	CLEAR ACRC IN CTXCRC/CRXCRC
;	23,1	10/30/80	ADDED XLOG TRACE=8 FEATURE
;
;      100,0	12/17/80	simplified for config doc
;      102,0	05/15/82	added exitck
;
;
;
	FORM
	ENTRY	FINCRS,STXY,PRXY
STXY	EQU	0000H		; STATUS MSG CURSOR ADDRESS
PRXY	EQU	1600H		; PROMPT MSG CURSOR ADDRESS
FINCRS	EQU	1500H		; FINAL CURSOR ADDRESS
;
;
;	ACK DELAY TIME CONSTANT FOR SLOW DISKS
;
	ENTRY	ACKDLY,TRMCOD,msgdly,xmtdly
TRMCOD:	DB	10			; GNAT-10 TERMINAL CODE
ACKDLY:	DW	0			; NO WAIT
msgdly:	dw	0			; delay after receiving msg
xmtdly:	dw	0			; delay before sending message
	FORM
;
;	BOOT
;
;		RBTE TERMINATION ROUTINE. DEACTIVATES ALL INTERRUPT DEVICES
;
;	CALLING SEQUENCE:
;		JP	BOOT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NONE
;
;	COME FROM:
;		RBTE: CEXIT (EMULSR), DDTINT (MAIN), ^C INTERCEPT
;		RBTEDIAG: DDTINT (RBTEDIAG), ^C INTERCEPT
;
	ENTRY	BOOT,CDOS$
	REL
BOOT:	DI
	CALL	DISDEV		;DISABLE ALL INTERRUPTS
CDOS$:	EI
	CPMIO	0		;SYSTEM EXIT/RESET
;
;	exitck
;
	entry	exitck
exitck:	ret			; return immed
	FORM
;
;	INIDDT
;
;		INITIALIZE INTERRUPT DEVICES
;
;	CALLING SEQUENCE:
;		CALL	INIDDT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REGS NOT PRESERVED
;
;	COME FROM:
;		RBTE ONLY: CSTART (MAIN)
;		RBTE WITH BDDT: CSTART (BDDT)
;		RBTEDIAG ONLY: CSTART (PSDBDDT)
;		RBTEDIAG WITH BDDT: CSTART (BDDT)
;
	ENTRY	INIDDT
INIDDT:	CALL	INTMOD		;SET INTERRUPT MODE
	CALL	INIINT		;INIT INTERRUPT CONTROLLER
	CALL	TRAPS		;SET TRAPS TO DEFAULT ROUTINES
	CALL	INITCI		;INIT CONSOLE INTERRUPT
	RET
	FORM
;
;	INIINT
;
;		INITIALIZE INTERRUPT CONTROLLER
;
;	CALLING SEQUENCE:
;		CALL	INIINT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
INIINT:	MOV	(CLKMSK),A,CNTMOD	; CLEAR CLOCK ENABLE MASK
	MOV	(MDMMSK),A,0		; CLEAR MODEM INTERRUPT MASK
	RET
;
	DATA
IMASK:	DB	0			;INTERRUPT MASK REG
	FORM
;
;	INTMOD
;		SET Z80 INTERRUPT MODE
;
;	CALLING SEQUENCE:
;		CALL	INTMOD
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
	REL
	ENTRY	INTMOD
INTMOD:	IM2				;SET Z-80 MODE 2 INTERRUPTS
	RET
	FORM
;
;	TRAPS
;		INITIALIZE UNIMPLENTED TRAPS
;
;	CALLING SEQUENCE:
;		CALL	TRAPS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
	ENTRY	TRAPS
TRAPS:	RET
	FORM
;
;	INITCI
;
;		INITIALIZE CONSOLE INTERRUPT DEVICE
;
;	CALLING SEQUENCE:
;		CALL	INITCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIDDT
;
	EXT	DDTINT
INITCI:	MOV	(0000H),A,0C3H		;LOAD DDTINT ADDR INTO
	MOV	(0001H),HL,DDTINT	;	CPM BOOT LOCATION
	RET
	FORM
;
;	ENBCI
;		ENABLE CONSOLE INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	ENBCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		NOT USED
;
	ENTRY	ENBCI
ENBCI:	RET
	FORM
;
;	DISCI
;		DISABLE CONSOLE INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	DISCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		NOT USED
;
	REL
DISCI:	RET
	FORM
	TITLE	IODEP - REAL TIME CLOCK DEPENDENCIES
;
;	CLOCK
;
;		REAL TIME CLOCK DEVICE INITIALIZER
;
;	CALLING SEQUENCE:
;		CALL	CLOCK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NONE
;
;	COME FROM:
;		RBTE: START (RTX)
;		RBTEDIAG: START (RBTEDIAG)
;
	REL
	ENTRY	CLOCK
CLKCNT	EQU	156			;9.984 MS CLOCK
T$20MS	EQU	2			;19.968 MS CLOCK
;
CLOCK:	MOV	(V$CLK),HL,CLKTRP	;SET CLOCK INTERRUPT VECTOR
	MOUT	CLKCTC,RSTCLK		;RESET CLOCK CHANNEL
	MOUT	CTC,V$CTC		;SET INTERNAL POINTER TO INT VECTOR
	MOUT	CLKCTC,TMRMOD+CTCLOD	;SET COUNT MODE &
	MOUT	CLKCTC,CLKCNT		;	LOAD COUNT.
	MOV	(CLKMSK),A,TMRMOD+CTCINT ;SET CLOCK INT MASK
	MOV	(CLOK),A,T$20MS		;SET CLOCK COUNTER
	CALL	ENBCLK			;ENABLE CLOCK INTERRUPTS
	RET
;
	DATA
CLKMSK:	DB	0		;CLOCK MASK
CLOK:	DB	0		;20MS CLOCK COUNTER
	FORM
;
;	ENBCLK
;
;		ENABLE CLOCK INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	ENBCLK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		ENBDEV
;
	REL
ENBCLK:	MOUT	CLKCTC,(CLKMSK)		;SET COUNT MODE WITH INTERRUPTS
	RET
;
;	DISCLK
;
;		DISABLE CLOCK INTERRUPTS
;
;	CALLING SEQUENCE:
;		CALL	DISCLK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		DISDEV
;
	REL
DISCLK:	MOUT	CLKCTC,TMRMOD		;SET COUNT MODE WITHOUT INTERRUPTS
	RET
	FORM
;
;	CLKTRP
;		REAL TIME CLOCK INTERRUPT SERVICE ROUTINE
;		ENTERED UPON CLOCK TICK EXPIRATION
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE - VIA INTERRUPT
;
	REL
	EXT	CLKISR
CLKTRP:	PUSH	AF			;SAVE
	PUSH	HL			;	REGS
	LD	HL,CLOK			;20 MS CLOCK
	DEC	(HL)			;	EXPIRATION?
	POP	HL			;(RESTORE HL)
	JR	Z,CLKEXP		;YES
	CALL	RESTIM			;NO, RESET 20 MS CLOCK
	POP	AF			;RESTORE AF
	EI				;RE-ENABLE
	RETI				;AND LEAVE.
;
CLKEXP:	MOV	(CLOK),A,T$20MS		;RESET 20MS COUNTER
	POP	AF			;RESTORE REG
	JP	CLKISR			;DO CLOCK INTERRUPT SERVICE ROUTINE
	FORM
;
;	RESTIM
;		RESTART REAL TIME CLOCK (FOR CLOCKS WHICH MUST BE RESTARTED
;		AFTER TIMER EXPIRATION).
;
;	CALLING SEQUENCE:
;		CALL	RESTIM
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		CLKTRP, CLKISR (RTX)
;
	ENTRY	RESTIM
RESTIM:	RET
	FORM
;
;	DISDEV
;
;		DISABLE ALL INTERRUPT DEVICES, BUT DON'T CLEAR INTERRUPT MASK.
;
;	CALLING SEQUENCE:
;		CALL	DISDEV
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		BOOT
;
;
	ENTRY	DISDEV
DISDEV:	PUSH	HL			;SAVE REG
	CALL	DISCI			;DISABLE CONSOLE INTERRUPT
	CALL	DISCLK			;DISABLE CLOCK INTERRUPT
	CALL	DISMDM			;DISABLE MODEM INTERRUPTS
	POP	HL			;RESTORE REG
	RET				;& EXIT
	FORM
;
;	CLRDEV
;
;		DISABLE CLOCK & MODEM INTERRUPT ENABLES & CLEAR INTERRUPT MASK
;
;	CALLING SEQUENCE:
;		CALL	CLRDEV
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		RBTEDIAG
;
	ENTRY	CLRDEV
CLRDEV:	PUSH	HL			; SAVE REG
	MOV	(MDMMSK),A,0		; CLEAR MODEM MASK
	MOV	(CLKMSK),A,TMRMOD	; AND CLOCK MASK
	CALL	DISCI			; DISABLE CONSOLE INTERRUPTS
	CALL	DISCLK			; DISABLE CLOCK
	CALL	DISMDM			; AND DISABLE MODEM.
	POP	HL			; GET REG BACK
	RET
	TITLE	IODEP - XLOG DEPENDENCIES
;
;	XINI
;		INITIALIZE XLOG TRACE WINDOW CURSOR
;
;	CALLING SEQUENCE:
;		CALL	XINI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XINI
	REL
COLSTR	EQU	0			;STARTING COLUMN (0,79)
COLMAX	EQU	79			;ENDING COLUMN WIDTH
LINSTR	EQU	9			;STARTING LINE NUMBER (0,23)
LINMAX	EQU	12			;WINDOW DEPTH
XINI:	MOV	(COLCNT),A,COLMAX	;WINDOW WIDTH
	MOV	(COLCRS),A,COLSTR	;WINDOW START COLUMN
	MOV	(LINCNT),A,LINMAX	;WINDOW LENGTH
	MOV	(LINCRS),A,LINSTR	;WINDOW START LINE
	RET
	FORM
;
;	XIBAUD
;
;		DO AUTO BAUD DETECT FOR XLOG TRACE PORT
;
;	CALLING SEQUENCE:
;		CALL	XIBAUD
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XIBAUD
	REL
XIBAUD:	RET			;BAUD RATE SET FOR CONSOLE
	FORM
;
;	XCLS
;		CLOSE EXTERNAL TRACE DEVICE
;
;	CALLING SEQUENCE:
;		CALL	XCLS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XCLS
	REL
XCLS:	RET
;
;	DSKPUT
;		COPY TRANSACTION CHARACTER TO DISK BUFFER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	DSKPUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
;
	ENTRY	DSKPUT
	REL
DSKPUT:	RET
	FORM
;
;	XPOS
;
;		POSITION CURSOR TO CURRENT POSITION IN XLOG TRACE WINDOW
;
;	CALLING SEQUENCE:
;		CALL	XPOS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XPOS
	EXT	POS
	REL
XPOS:	LD	HL,COLCRS		;COLUMN ADR
	LD	DE,LINCRS		;LINE ADR
	CALL	POS			;POSITION IT
	RET
;
;
	DATA
COLCNT:	DB	0	;COLUMN COUNTER
COLCRS:	DB	0	;COLUMN POINTER
LINCNT:	DB	0	;LINE COUNTER
LINCRS:	DB	0	;LINE POINTER
	FORM
;
;	XPUT
;
;		COPY CHAR TO XLOG TRACE WINDOW
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	XPUT
;
;	ENTRY:
;		REG A	CHARACTER TO DISPLAY
;
;	EXIT:
;		REGS BC, DE, HL PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XPUT
	EXT	CLRLIN
	REL
XPUT:	PUSH	DE			;SAVE
	PUSH	BC
	PUSH	HL			;	REGS
	CALL	APUT			;DISPLAY CHAR
	LD	HL,COLCRS		;NEXT CHAR
	INC	(HL)			;	POINTER
	LD	HL,COLCNT		;END OF
	DEC	(HL)			;	LINE?
	JR	NZ,XPEXIT		;NO, EXIT
	MOV	(COLCNT),A,COLMAX	;YES, RESET COLUMN COUNTER
	MOV	(COLCRS),A,COLSTR	;RESET COLUMN CURSOR
	LD	HL,LINCRS		;NEXT LINE
	INC	(HL)			;	POINTER
	LD	HL,LINCNT		;BOTTOM OF
	DEC	(HL)			;	WINDOW?
	JR	NZ,XP1			;NO
	MOV	(LINCRS),A,LINSTR	;YES, RESET LINE POINTER
	MOV	(LINCNT),A,LINMAX	;RESET LINE COUNTER
XP1:	LD	HL,COLCRS		;POSITION
	LD	DE,LINCRS		;	SCREEN
	CALL	POS			;	CURSOR
	CALL	CLRLIN			;CLEAR LINE
XPEXIT:	POP	HL			;RESTORE
	POP	BC
	POP	DE			;	REGS
	RET
	FORM
;
;	APUT
;
;		SEND CHARACTER TO CONSOLE
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	APUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		EMULSR, DISKIO
;
	ENTRY	APUT
APUT:
	CALL	CONOUT		;PRINT BYTE
	RET
	FORM
;
;	PRTCHR
;
;		COPY CHARACTER TO PRINTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	PRTCHR
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		DISKIO
;
	ENTRY	PRTCHR
PRTCHR:
;	CALL	PIOPRT		; PRINT CHAR VIA PROGRAM I/O
	CALL	CPMPRT		; PRINT CHAR VIA CPM
	RET
;
PIOPRT:	PUSH	AF		;SAVE CHAR
PRT1:	IN	A,LPTCMD	;PRINT BUFFER
	AND	TXEMPT		;	EMPTY?
	JR	Z,PRT1		;NOT YET.
	POP	AF		;YES, GET CHAR
	OUT	(LPTDAT),A	;	& PRINT
	RET
;
CPMPRT:	PUSH	BC		; SAVE
	PUSH	DE		;	REGS
	PUSH	HL		;	....
	LD	E,A		; PRINT
	CPMIO	5		; 	CHAR
	POP	HL		; RESTORE
	POP	DE		;	REGS
	POP	BC		;	....
	RET
	TITLE	IODEP - CDOS CONSOLE I/O
	ENTRY	CONOUT,CONINP,CONCHK
;
;	CONOUT
;
;		DISPLAY CHARACTER ON CONSOLE VIA CDOS CALL     
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	CONOUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		EMULSR, APUT 
;
CONOUT:	PUSH	HL
	PUSH	BC		;SAVE
	PUSH	DE		;	REGS
	LD	E,A		;SEND
	CPMIO	6		;	CHAR TO CONSOLE
	POP	DE		;RESTORE
	POP	BC		;	REGS
	POP	HL
	RET
	FORM
;
;	CONINP
;		READ KEYBOARD VIA CDOS CALL
;
;	CALLING SEQUENCE:
;		CALL	CONINP
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A	KEYBOARD DATA
;		ALL OTHER REGS PRESERVED
;
;	COME FROM:
;		EMULSR
;
CONINP:	PUSH	HL
	PUSH	BC		;SAVE
	PUSH	DE		;	REGS
CI.LOP:	LD	E,0FFH		;GET NEXT
	CPMIO	6		;NEXT KEYBOARD CHAR WITHOUT ECHO
	OR	A		; CHAR AVL?
	JR	Z,CI.LOP	; NO, TRY AGAIN
	POP	DE		;RESTORE
	POP	BC		;	REGS
	POP	HL
	RET
	FORM
;
;	CONCHK
;
;		CHECK IF KEYBOARD DATA AVAILABLE. RETURN CHARACTER IF
;		FOUND AVAILABLE
;
;	CALLING SEQUENCE:
;		CALL	CONCHK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A	= 0: IF NO CHARACTER AVAILABLE
;		       <> 0: IF CHARACTER AVAILABLE
;
;	COME FROM:
;		EMULSR
;
CONCHK:	PUSH	BC		; SAVE
	PUSH	DE		;	REGS
	PUSH	HL		;	...
	LD	E,0FFH		; GET NEXT
	CPMIO	6		;	CHARACTER IF AVL
	OR	A		; SET AVL STATUS
	POP	HL		; RESTORE
	POP	DE		;	REGS
	POP	BC		;	...
	RET
	TITLE	IODEP	SYNCHRONOUS ROUTINES
;
;	EXTINT
;		EXTERNAL STATUS INTERRUPT SERVICE ROUTINE
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE, VIA INTERRUPT
;
	EXT	PUTRAN
EXTINT:	PUSH	AF			;SAVE
	PUSH	HL			;	REGS
	MOUT	MDMCMD,REG0		;GET
	IN	A,(MDMCMD)		;	SIO STATUS
	LD	HL,(LSTSTS)		;REG L = LAST STATUS
	LD	(LSTSTS),A		;SAVE AS LAST STATUS
	XOR	L			;ANY CHANGE OF STATUS?
	JR	Z,EXT1			;NO
	BIT	6,A			;YES, UNDERUN CHANGE?
	JR	Z,EXT2			;NO
EXT1:	LD	HL,UNDRUN		;YES, INCREMENT
	INC	(HL)			;	UNDERRUN COUNTER
EXT2:	MOUT	MDMCMD,REG0+EXTRST	;RESET EXTERNAL INTERRUPT
	POP	HL			;RESTORE
	POP	AF			;	REGS
	EI
	RETI
	FORM
;
;	SPCINT
;		SPECIAL ERROR INTERRUPT SERVICE ROUTINE
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE VIA INTERRUPT
;
SPCINT:	PUSH	HL			;SAVE 
	PUSH	AF			;	REGS
	LD	HL,SPCCNT		;INCREMENT
	INC	(HL)			;	SPECIAL INT COUNTER
	MOUT	MDMCMD,REG1		;GET 
	IN	A,(MDMCMD)		;	ERROR STATUS
	AND	RXOVRF			;RX OVERFLOW
	JR	Z,SPC1			;NO
	LD	HL,OVRFLO		;YES, INCREMENT
	INC	(HL)			;	OVERFLOW COUNTER
SPC1:	MOUT	(MDMCMD),REG0+ERRRST	;RESET ERROR FLAG
	POP	AF			;RESTORE
	POP	HL			;	REGS
	EI
	RETI
	TITLE	IODEP	TXCHR/TXBIN
;
;	TXCHR
;		ACCUMULATE CRC & TRANSMIT CHARACTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	TXCHR
;
;	ENTRY:
;		REG A	CHARACTER TO SEND
;
;	EXIT:
;		REG A	PRESERVED
;
;	COME FROM:
;		TXISR
;
;	STACK USED:
;
	EXT	CRCGEN,IDATT,IDATR
	ENTRY	TXCHR
TXCHR:	PUSH	AF			; SAVE
	PUSH	BC			;    A COUPLA REGS
	CALL	CRCGEN			; ACCUMULATE CRC
	OUT	(MDMDAT),A		; SEND CHAR
	CALL	IDATT			; GIVE TO XLOG
	POP	BC
	POP	AF
	RET
	TITLE	IODEP	TXBIN
;
;	TXBIN
;		TRANSMIT CHARACTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	TXBIN
;
;	ENTRY:
;		REG A	CHARACTER TO SEND
;
;	EXIT:
;		REG A	PRESERVED
;
;	COME FROM:
;		TXCHR, TXISR
;
;	STACK USED:
;
	ENTRY	TXBIN
TXBIN:	PUSH	AF			; SAVE REGS
	PUSH	BC			; /
	OUT	(MDMDAT),A		; XMIT CHAR
	CALL	IDATT			; GIVE TO XLOG
	POP	BC
	POP	AF
	RET
	FORM
;
;	CTXCRC/CRXCRC
;
;		CLEAR TRANSMITTER OR RECIEVER CRC ACCUMULATOR
;
;	CALLING SEQUENCE:
;		CALL	CTXCRC/CRXCRC
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT HL PRESERVED
;
;	COME FROM:
;		SYNISR
;
	ENTRY	CTXCRC
	ENTRY	CRXCRC
	EXT	CRCH,ACRC
	REL
CTXCRC:
CRXCRC:	MOV	(CRCH),HL,0		;CLEAR CRC ACCUMULATION
	MOV	(ACRC),A,0		;
	RET
	TITLE	IODEP	RDBIN - READ CHARACTER FROM SERIAL INTERFACE
;
;	RDBIN
;		READ CHARACTER FROM SERIAL INTERFACE
;
;	CALLING SEQUENCE:
;		CALL	RDBIN
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A/B	 CHARACTER READ
;
;	COME FROM:
;		RXISR
;
;	STACK USED:
;		NONE
;
	ENTRY	RDBIN
RDBIN:	IN	A,(MDMDAT)		; READ CHARACTER
	LD	B,A			; RETURN CHAR IN REG B
	JP	RBIN			; ALLOW XLOG FEATURE (NOP TO REMOVE)
	RET
RBIN:	PUSH	BC			; SAVE REG
	CALL	IDATR			; GIVE TO XLOG (MAY TAKE TOO MUCH TIME)
	POP	BC			; UNSAVE BC
	RET
	TITLE	SYNC - CONTROL SYNC PORT
;
;	SYNC	(SUBROUTINE)
;
;		THIS ROUTINE CONTROLS AND SENSES THE SYNCHRONOUS COMMUNICATION
;		CHANNEL.  ALL HARDWARE SPECIFICS OF THE SERIALIZER ARE
;		CONTAINED IN THIS MODULE.
;
;	CALLING SEQUENCE:
;		LD	A,CMD
;		CALL	SYNC
;
;	ENTRY:
;		REG A	SERIALIZER COMMAND
;			0 = ACTIVATE DTR (DTRON)
;			1 = DEACTIVATE DTR (DTROFF)
;			2 = ENABLE RECEIVER (RXENB)
;			3 = DISABLE RECEIVER (RXDIS)
;			4 = ENABLE TRANSMITTER (TXENB)
;			5 = DISABLE TRANSMITTER (TXDIS)
;			6 = INIT SYNC PORT (SYNINI)
;			7 = SENSE DSR (DSRSNS)
;			8 = SENSE CTS (CTSSNS)
;			9 = ENABLE TRANSPARENT FILL (SETTRN)
;		       10 = ACTIVATE RTS (RTSON)
;		       11 = SENSE DCD (DCDSNS)
;
;	EXIT:
;		REG A	COMMAND STATUS FOR SENSE OPERATIONS
;			TRUE - DSRON OR CTSON
;			FALSE - DSROFF OR CTSOFF
;		FLAG Z	COMMAND STATUS OF SENSE OPERATIONS
;			SET - DSROFF OR CTSOFF
;			CLEAR - DSRON OR CTSON
;		ALL OTHER REGS PRESERVED
;
;	COME FROM:
;		BSCINT, TXISR, RXISR
;
;	STACK USED:
;
	ENTRY	SYNC
	EXT	TXERR,RXERR,ERR
	EXT	CASE,SYN,DLE,RXISR,TXISR
MODE3	EQU	RSIZ8+AUTENB		;RX 8BIT CHAR & AUTO ENABLES
MODE4	EQU	PAROFF+STOP0+BISYNC+CLOK1
MODE5	EQU	TSIZ8+BICRC
	REL
SYNC:	DI			;DISALLOW INTERRUPTIONS
	CALL	ISYNC		;DO SYNC FUNCTION
	EI			;ALLOW INTERRUPTIONS
	RET
	FORM
	ENTRY	ISYNC
;
ISYNC:	PUSH	HL		;SAVE REGS
	PUSH	DE		;.....
	LD	HL,S.CAS	;CALCULATE 
	LD	D,S.CNT		;	CASE
	CALL	CASE		;	ADDRESS
	LD	DE,ISYRET	;RETURN
	PUSH	DE		;	ADDRESS
	JP	(HL)		;DO CASE
;
ISYRET:	POP	DE		;RESTORE
	POP	HL		;	REGS
	RET			;EXIT
;
;	CASE TABLE
;
S.CAS:	DW	S.ERR		;ERROR
	DW	S.DTRN		;DTRON
	DW	S.DTRF		;DTROFF
	DW	S.RXE		;RXENB
	DW	S.RXD		;RXDIS
	DW	S.TXE		;TXENB
	DW	S.TXD		;TXDIS
	DW	S.INIT		;INIT
	DW	S.DSRS		;DSRSNS
	DW	S.CTSS		;CTSSNS
	DW	S.TRNS		;SETTRN
	DW	S.RTSN		;RTSON
	DW	S.DCDS		;DCDSNS
S.CNT	EQU	[$-S.CAS]/2-2
	FORM
S.ERR:	SYSERR	0
;
;	INITIALIZE SERIAL PORT
;
S.INIT:	MOV	(V$RXIM),HL,RXISR	;SET RX INTERRUPT VECTOR
	MOV	(V$TXIM),HL,TXISR	;SET RX INTERRUPT VECTOR
	MOV	(V$EXTM),HL,EXTINT	;SET EXTERNAL INTERRUPT VECTOR
	MOV	(V$SPCM),HL,SPCINT	;SET SPECIAL INTERRUPT VECTOR
	MOV	(SPCCNT),A,0		;CLEAR SPECIAL ERROR COUNTER
	MOV	(OVRFLO),A,0		;CLEAR UNDER RUN COUNTER
	MOV	(UNDRUN),A,0		;CLEAR TX UNDERRUN COUNTER
	MOUT	MDMCMD,REG0+CHNRST	;RESET CHANNEL
	MOUT	MDMCMD,REG0+CHNRST	;RESET CHANNEL
	MOUT	LPTCMD,REG2		;SET INTERRUPT
	MOUT	LPTCMD,V$SIO2		;	BASE ADDRESS
	MOUT	LPTCMD,REG1		;SET STATUS
	MOUT	LPTCMD,STSAFT		;	AFFECT VECTOR
	MOUT	LPTCMD,REG0+EXTRST	;CLEAR DSR(SYNC)  FLAG
	MOUT	LPTCMD,REG0+EXTRST	;CLEAR DSR (SYNC) FLAG
	MOUT	MDMCMD,REG4		;SET 1X CLOCK, 2 SYNC CHAR
	MOUT	MDMCMD,MODE4		;	SYNC MODE, NO PARITY
	MOUT	MDMCMD,REG5		;SET 8BIT TX CHAR
	MOV	(TXMSK),A,MODE5		;	& CRC-16
	OUT	(MDMCMD),A		;	...
	MOUT	MDMCMD,REG6		;SET FIRST
	MOUT	MDMCMD,(SYN)		;	SYNC CHAR
	MOUT	MDMCMD,REG7+EXTRST	;SET EXTERNAL RESET &
	MOUT	MDMCMD,(SYN)		;	SECOND SYNC CHAR
	MOUT	MDMCMD,REG1+EXTRST	;SET EXTERNAL RESET &
	MOV	(MDMMSK),A,TXINT+EXTENB+RXCHR	;	INTERRUPT ENABLES
	OUT	(MDMCMD),A			;	....
	MOUT	MDMCMD,REG3+EXTRST	;SET AUTO ENABLES
	MOUT	MDMCMD,MODE3		;	& 8 BIT RX CHARS
	MOV	(RXERR),A,0		;CLEAR UNEXPECTED RX INTERRUPT COUNTER
	MOV	(TXERR),A,0		;CLEAR UNEXPECTED TX INTERRUPT COUNTER
	RET
	FORM
;
;	SET DTR TO ON
;
S.DTRN:	MOUT	MDMCMD,REG5				; TURN ON
	MEM	OR,(TXMSK),DTR,(TXMSK)			;	DATA TERMINAL
	OUT	(MDMCMD),A				;	READY.
	RET
;
;	SET DTR TO OFF
;
S.DTRF:	MOUT	MDMCMD,REG5				;DISABLE
	MEM	AND,(TXMSK),-[DTR+1],(TXMSK)		;	DATA TERMINAL
	OUT	(MDMCMD),A				;	READY.
	RET
;
;	ENABLE TRANSMITTER
;
S.TXE:	MOUT	MDMCMD,REG6				;SET SIO FOR
	MOUT	MDMCMD,(SYN)				;	NONTRANS FILL
	MOUT	MDMCMD,REG5				;ENABLE
	MEM	OR,(TXMSK),[TXENBL+RTS],(TXMSK)		;TX INTERRUPT
	OUT	(MDMCMD),A				;	& RTS
	MOUT	MDMDAT,(SYN)				;SEND SYN CHAR
	RET
;
;	DISABLE TRANSMITTER
;
S.TXD:	MOUT	MDMCMD,REG5+TXIRST			;RESET TX INTERRUPT
	MEM	AND,(TXMSK),-[RTS+TXENBL+1],(TXMSK)	;DISABLE TX
	OUT	(MDMCMD),A				;	& CLEAR RTS
	RET
	FORM
;
;	ENABLE RECEIVER
;
S.RXE:	IN	A,(MDMDAT)			;DRAIN
	IN	A,(MDMDAT)			;	RX
	IN	A,(MDMDAT)			;	BUFFER
	MOUT	MDMCMD,REG6			;SET SIO FOR
	MOUT	MDMCMD,(SYN)			;	NONTRANSPARENT FILL
	MOUT	MDMCMD,REG3			;ENABLE RX
	MOUT	MDMCMD,MODE3+RXENBL+HUNT	;	AND HUNT MODE
	RET
;
;	DISABLE RECEIVER
;
S.RXD:	MOUT	MDMCMD,REG3			;DISABLE
	MOUT	MDMCMD,MODE3			;	RECEIVER
	RET
;
;	DSR SENSE
;
S.DSRS:	MOUT	LPTCMD,REG0			;GET LPT 
	IN	A,(LPTCMD)			;	STATUS
	PUSH	AF				;SAVE STATUS
	MOUT	LPTCMD,REG0+EXTRST		;CLEAR STATUS LATCH
	POP	AF				;GET STATUS
	AND	SYNHNT				;DATA SET READY?
	RET	Z				;NO
	LD	A,TRUE				;YES, RETURN FLAG
	RET
;
;	CTS SENSE
;
S.CTSS:	IN	A,MDMCMD		;GET STATUS WORD
	PUSH	AF			;SAVE STS
	MOUT	MDMCMD,REG0+EXTRST	;CLEAR STS REG
	POP	AF			;RESTORE STS
	AND	CTS			;CTS ACTIVE?
	RET	Z			;NO
	LD	A,TRUE			;YES
	RET
;
;	SETTRN - TRANSPARENT FILL
;
S.TRNS:	MOUT	MDMCMD,REG6		;SET SIO FOR
	MOUT	MDMCMD,(DLE)		;	TRANSPARENT FILL
	RET
;
;	ACTIVATE RTS
;
S.RTSN:	MOUT	MDMCMD,REG5		;SET
	MEM	OR,(TXMSK),RTS,(TXMSK)	;	REQUEST TO SEND
	OUT	MDMCMD,A		;	SIGNAL
	RET
;
;	SENSE DCD
;
S.DCDS:	IN	A,MDMCMD		;DATA CARRIER DETECT
	PUSH	AF			;SAVE STS
	MOUT	MDMCMD,REG0+EXTRST	;CLEAR STS REG
	POP	AF			;RESTORE STS
	AND	DCD			;	ACTIVE?
	RET	Z			;NO
	LD	A,TRUE			;YES
	RET
;
;	ENABLE MODEM INTERRUPTS
;
ENBMDM:	MOUT	MDMCMD,REG1		;SET
	MOUT	MDMCMD,(MDMMSK)		;	MASK
	RET
;
;	DISABLE MODEM INTERRUPTS
;
DISMDM:	MOUT	MDMCMD,REG1		;CLEAR
	MOUT	MDMCMD,0		;	MASK
	RET
	FORM
;
;
;
	DATA
DTRFLG:	DB	0
RTSFLG:	DB	0
LSTSTS:	DB	0	;LAST STATUS
UNDRUN:	DB	0	;UNDER RUN COUNTER
OVRFLO:	DB	0	;RX OVERFLOW COUNTER
SPCCNT:	DB	0	;SPECIAL ERROR COUNT
TXMSK:	DB	0	;REG5 
MDMMSK:	DB	0	;REG1 - INTERRUPT ENABLES
;
;
	END
l80
