; 5", 512 byte, DDDS, 5 sector ZENITH Z-100 format
ZENITH: DB	8		;sectors per track
	DB	40		;tracks per side
	DB	01110000B	;Disk HW_BYTE (DDDS)
	DB	80		;index header gap
	DB	12		;GAP 1
	DB	22		;GAP 2
	DB	26		;GAP 3
	DB	242		;GAP 4 (4E's) (1454)
