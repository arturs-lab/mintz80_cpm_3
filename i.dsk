   492  02D2  FD7E00           	LD     	A,(IY+TRK)     	       	;Store here
   493  02D5  DDBE01           	CP     	A,(IX+NTRKS)   	       	;Are we at the 
   494  02D8  CA7302           	JP     	Z,END_CMD      	       	;Yes we are don
   495                  ;      	
   496  02DB            SECTRK_DONE1:
