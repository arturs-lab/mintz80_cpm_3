  2417  10A7  CD680E           	CALL   	SEEK_TRACK_V   	;Re-seek to track
  2418  10AA  C3E10E           	JP     	AGAIN_RD
  2419  10AD  AF        BAD_WR 	XOR    	A,A
  2420  10AE  3D               	DEC    	A      	       	;Set to NZ
  2421  10AF  3A0839           	LD     	A,(ERSTAT)     	;Return with error bits
  2422  10B2  C9               	RET    	
  2423                  ;
  2424                  ; Multi_sector Write of multiple sectors on a TARCK. As
  2425                  ; Will place data at (TADDR) The currently selected sid
  2426                  ; (DMA_NEXT) is updated for repetative calls to this ro
  2427                  ; [D] contains the number of sectors (Max IX+NSCTRS), [
  2428                  ; Note this can be easily modified for CPM3 to multi se
  2429                  ; Also note, actual timing for data I/O is quite tight 
  2430                  ;
  2431  10B3            MULTI_SEC_WR:
  2432  10B3  3EEF             	LD     	A,WS_ERR_MASK  	       	;Setup for erro
  2433  10B5  320739           	LD     	(ERMASK),A
  2434  10B8  2A4000           	LD     	HL,(TADDR)
  2435  10BB  FD7E00           	LD     	A,(IY+TRK)
  2436  10BE  D355             	OUT    	(TRACK),A
  2437  10C0  7B               	LD     	A,E    	       	       	;first sector (
  2438  10C1  FD7702           	LD     	(IY+SCTR),A    	       	;For error dump
  2439  10C4  D356             	OUT    	(SECTOR),A
  2440  10C6  0E57             	LD     	C,DATA 	       	       	;C = DATA port 
  2441  10C8            
  2442  10C8  CD2F12           	CALL   	WAIT_ON	       	       	;Turn on VII bo
  2443  10CB            
  2444  10CB                if 	CHIP_1791
  2445  10CB  3EA0             	LD     	A,WRCMD91      	       	;Read sector co
  2446  10CD  320939           	LD     	(CHIP_CMDSV),A 	       	;store cmd here
  2447  10D0                 endif
  2448  10D0            
  2449                       if	CHIP_1795
  2450                         	LD     	A,WRCMD95      	       	;Read sector co
  2451                         	LD     	(CHIP_CMDSV),A 	       	;store cmd here
  2452                         	OR     	A,(IY+SIDE)    	       	;If B side need
  2453  10D0                 endif
  2454  10D0            
  2455  10D0  CBE7             	SET    	4,A    	       	       	;Multi sec bit
  2456  10D2  F5               	PUSH   	AF     	       	       	;Store for now
  2457  10D3  F3               	DI     	       	       	       	;Disable Interr
  2458  10D4            
  2459  10D4  DD7E09           	LD     	A,(IX+SIZE)    	       	;128=0,256=1,51
  2460  10D7  B7               	OR     	A,A    	       	       	;Block input [B
  2461  10D8  280A             	JR     	Z,MW128	       	       	;Do 128 byte re
  2462  10DA  FE01             	CP     	A,1
  2463  10DC  2814             	JR     	Z,MW256	       	       	;Do 256 byte re
  2464  10DE  FE02             	CP     	A,2
  2465  10E0  281E             	JR     	Z,MW512	       	       	;Do 512 byte re
  2466  10E2  182C             	JR     	MW1K   	       	       	;Must be 1K sec
  2467  10E4            
  2468  10E4  0680      MW128: 	LD     	B,128  	       	       	;Note the code 
  2469  10E6  F1               	POP    	AF     	       	       	;each sector ha
  2470  10E7  D354             	OUT    	(CMD),A	       	       	;send it to the
  2471  10E9  EDB3      MW128A:	OTIR   	       	       	       	;128 bytes (B=1
  2472  10EB  0680             	LD     	B,128
  2473  10ED  15               	DEC    	D
  2474  10EE  20F9             	JR     	NZ,MW128A
  2475  10F0  1832             	JR     	DONE_MW
  2476  10F2            
  2477  10F2  0600      MW256: 	LD     	B,0
  2478  10F4  F1               	POP    	AF
  2479  10F5  D354             	OUT    	(CMD),A	       	       	;send it to the
  2480  10F7  EDB3      MW256A:	OTIR   	       	       	       	;256 bytes 
  2481  10F9  0600             	LD     	B,0
  2482  10FB  15               	DEC    	D
  2483  10FC  20F9             	JR     	NZ,MW256A
  2484  10FE  1824             	JR     	DONE_MW
  2485  1100            
  2486  1100  0600      MW512: 	LD     	B,0
  2487  1102  F1               	POP    	AF
  2488  1103  D354             	OUT    	(CMD),A	       	       	;send it to the
  2489  1105  EDB3      MW512A:	OTIR   	       	       	       	;512 = 256x2
  2490  1107  EDB3             	OTIR
  2491  1109  0600             	LD     	B,0
  2492  110B  15               	DEC    	D
  2493  110C  20F7             	JR     	NZ,MW512A
  2494  110E  1814             	JR     	DONE_MW
  2495  1110            
  2496  1110  0600      MW1K:  	LD     	B,0
  2497  1112  F1               	POP    	AF
  2498  1113  D354             	OUT    	(CMD),A	       	       	;send it to the
  2499  1115  EDB3      MW1KA: 	OTIR   	       	       	       	;1K = 256x4
  2500  1117  EDB3             	OTIR
  2501  1119  EDB3             	OTIR
  2502  111B  EDB3             	OTIR
  2503  111D  0600             	LD     	B,0
  2504  111F  15               	DEC    	D
  2505  1120  20F3             	JR     	NZ,MW1KA
  2506  1122  1800             	JR     	DONE_MW
  2507  1124            
  2508  1124            DONE_MW:
  2509  1124  FB               	EI
  2510  1125  221239           	LD     	(DMA_NEXT),HL  	       	;Store "next" l
  2511  1128  CD6111           	CALL   	END_ROUTINE    	       	;Wait, turn off
  2512  112B  C8               	RET    	Z      	       	       	;RET Z if all i
  2513  112C  AF               	XOR    	A,A
  2514  112D  3D               	DEC    	A      	       	       	;Set to NZ
  2515  112E  3A0839           	LD     	A,(ERSTAT)     	       	;Return with er
  2516  1131  C9               	RET    	
  2517                  ;
  2518                  ;
  2519                  ;      	
  2520                  ; Write Track. Assumes head is over relevent track in (
  2521                  ; Track data at (TADDR)
  2522                  ; The currently selected side at (SIDE) is written to
  2523                  ; The total size of a track in bytes is in [DE]
  2524                  ;
  2525  1132            WRITE_TRACK:
  2526  1132  3EE0             	LD     	A,WT_ERR_MASK  	       	;Setup for erro
  2527  1134  320739           	LD     	(ERMASK),A
  2528  1137  2A4000           	LD     	HL,(TADDR)
  2529  113A  FD7E00           	LD     	A,(IY+TRK)
  2530  113D  D355             	OUT    	(TRACK),A
  2531  113F  CD2F12           	CALL   	WAIT_ON	       	       	;Turn on VII bo
  2532  1142  3EF4             	LD     	A,WRTCMD       	       	;setup for 179x
  2533  1144  320939           	LD     	(CHIP_CMDSV),A 	       	;Store it in ca
  2534  1147  F3               	DI     	       	       	       	;Disable Interr
  2535  1148  D354             	OUT    	(CMD),A	       	       	;send it to the
  2536  114A  7E        W_LOOP:	LD     	A,(HL)
  2537  114B  D357             	OUT    	(DATA),A       	       	;Send all track
  2538  114D  23               	INC    	HL
  2539  114E  1B               	DEC    	DE
  2540  114F  7B               	LD     	A,E
  2541  1150  B7               	OR     	A,A
  2542  1151  20F7             	JR     	NZ,W_LOOP
  2543  1153  B2               	OR     	A,D
  2544  1154  20F4             	JR     	NZ,W_LOOP      	;Have we sent DE bytes 
  2545  1156  FB               	EI
  2546  1157  CD6111           	CALL   	END_ROUTINE    	;Wait,  turn off wait h
  2547  115A  C8               	RET    	Z      	       	;RET Z if all is OK
  2548  115B  AF               	XOR    	A,A
  2549  115C  3D               	DEC    	A      	       	;Set to NZ
  2550  115D  3A0839           	LD     	A,(ERSTAT)
  2551  1160  C9               	RET    	
  2552                  ;
  2553                  ;
  2554                  ; END Routine comes after each Type I command is comple
  2555                  ; chip to time out then switches off the wait state gen
  2556                  ; Returns Z if no errors, otherewise NZ with error in (
  2557                  ; for status it forces a 1791/5 Interrupt CMD after ~ 5
  2558                  ; a hardware problem.
  2559                  ;
  2560  1161            END_ROUTINE:
  2561  1161  CDCE11           	CALL   	DELAY  	       	;Delay for hardware
  2562  1164  C5               	PUSH   	BC     	       	;Setup a loop count
  2563  1165  D5               	PUSH   	DE
  2564  1166  E5               	PUSH   	HL
  2565  1167  010000           	LD     	BC,0
  2566  116A  1E05             	LD     	E,STATUS_DELAY 	;time out about 5 secon
  2567  116C  DB54      ENDR2: 	IN     	A,(STATUS)     	;Wait until chip is not
  2568  116E  E601             	AND    	A,1
  2569  1170  2825             	JR     	Z,ENDR2_OK
  2570  1172  10F8             	DJNZ   	ENDR2  	       	;Try for ~5 seconds
  2571  1174  05               	DEC    	B
  2572  1175  0D               	DEC    	C
  2573  1176  20F4             	JR     	NZ,ENDR2
  2574  1178  05               	DEC    	B
  2575  1179  0D               	DEC    	C
  2576  117A  1D               	DEC    	E
  2577  117B  20EF             	JR     	NZ,ENDR2
  2578  117D  CD2812           	CALL   	WAIT_OFF       	;Disable Hardware wait 
  2579  1180  21F52B           	LD     	HL,TIMEOUT_ERR
  2580  1183  CD0319           	CALL   	PMSG
  2581  1186  CDBA17           	CALL   	SHOW_STAT_BITS
  2582  1189  320839           	LD     	(ERSTAT),A     	
  2583  118C  CD2019           	CALL   	ZCRLF
  2584  118F  CD3612           	CALL   	FRCINT
  2585  1192  E1               	POP    	HL
  2586  1193  D1               	POP    	DE
  2587  1194  C1               	POP    	BC
  2588  1195  1811             	JR     	ENDR3
  2589  1197            ENDR2_OK:
  2590  1197  E1               	POP    	HL
  2591  1198  D1               	POP    	DE
  2592  1199  C1               	POP    	BC
  2593  119A  CD2812           	CALL   	WAIT_OFF       	;Disable Hardware wait 
  2594  119D  DB54             	IN     	A,(STATUS)     	;(May already be off an
  2595  119F  57               	LD     	D,A
  2596  11A0  3A0739           	LD     	A,(ERMASK)     	;Error mask was stored 
  2597  11A3  A2               	AND    	A,D
  2598  11A4  320839           	LD     	(ERSTAT),A     	;Save error status for 
  2599  11A7  C8               	RET    	Z      	       	;RET Z if all is OK
  2600  11A8  AF        ENDR3: 	XOR    	A,A
  2601  11A9  3D               	DEC    	A      	       	;Set to NZ
  2602  11AA  3A0839           	LD     	A,(ERSTAT)
  2603  11AD  C9               	RET    	
  2604                  ;
  2605                  ;
  2606                  ;
  2607                  ;
  2608                  ; SELECT DRIVE IN HARDWARE, WILL BE THE NEW CURRENT DRI
  2609                  ; (IX+HW_BYTE) points to relevent drive selection, dens
  2610                  ; side(s) info for the current disk. Note: Sets head to
  2611                  ;
  2612  11AE            START_DRIVE_1:
  2613  11AE  3A4600           	LD     	A,(DRIVE_1)    	;Get the drive selectio
  2614  11B1  1803             	JR     	START_DR
  2615  11B3            
  2616  11B3            START_DRIVE_2:
  2617  11B3  3A4700           	LD     	A,(DRIVE_2)    	;Get the drive selectio
  2618  11B6            START_DR:
  2619  11B6  DDB602           	OR     	A,(IX+HW_BYTE) 	;OR in the density,side
  2620  11B9  324800           	LD     	(IOBYTE),A     	;For diagnostic display
  2621  11BC  E67F             	AND    	A,7FH  	       	;Strip off the current 
  2622  11BE  2F               	CPL    	       	       	;Hardware is inverted
  2623  11BF  CBE7             	SET    	4,A    	       	;Force to side A
  2624  11C1  D353             	OUT    	(SELECT),A
  2625  11C3  CDCE11           	CALL   	DELAY
  2626  11C6  DB54      RDYCK: 	IN     	A,(STATUS)     	;Drive select delay
  2627  11C8  E680             	AND    	80H
  2628  11CA  C2C611           	JP     	NZ,RDYCK       	;Return when ready
  2629  11CD  C9               	RET
  2630                  ;
  2631                  ; Delay for drive select hardware. Different for 8" and
  2632                  ;
  2633  11CE  DDCB026E  DELAY: 	BIT    	5,(IX+HW_BYTE) 	;8" or 5"
  2634  11D2  3E27             	LD     	A,39
  2635  11D4  2802             	JR     	Z,DELAY1  
  2636  11D6  3E3C             	LD     	A,60
  2637  11D8  0600      DELAY1:	LD     	B,0
  2638  11DA  10FE      M0:    	DJNZ   	M0
  2639  11DC  3D               	DEC    	A
  2640  11DD  20F9             	JR     	NZ,DELAY1  
  2641  11DF  C9               	RET
  2642                  ;      	
  2643                  ; This routine switches the active side of the current 
