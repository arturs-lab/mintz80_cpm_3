   133                  ;
   134        (0050)    RSET   	EQU    	50H    	       	;<----- VERSAFLOPPY BAS
   135        (0053)    SELECT 	EQU    	53H    	       	;DRIVE SELECT PORT
   136        (0054)    STATUS 	EQU    	54H    	       	;STATUS PORT
