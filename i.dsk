  3507  17B8  D0               	RET    	NC     	       	; else go back...
  3508  17B9  D620             	SUB    	A,'a'-'A'      	;subtract lowercase bia
  3509  17BB  C9               	RET
  3510                  ;
  3511                  ;
  3512                  ; Return with 2 HEX digits in [A]. If abort, Carry flag
  3513  17BC            GET_HEX:
  3514  17BC  C5               	PUSH   	BC     	       	       	
  3515  17BD  CD9217           	CALL   	GETCMD 	       	;Get a character from k
  3516  17C0  FE1B             	CP     	A,ESC
  3517  17C2  282A             	JR     	Z,HEX_ABORT
  3518  17C4  FE2F             	CP     	'/'    	       	;check 0-9, A-F
  3519  17C6  3826             	JR     	C,HEX_ABORT
  3520  17C8  FE47             	CP     	'F'+1
  3521  17CA  3022             	JR     	NC,HEX_ABORT
  3522  17CC  CD0518           	CALL   	ASBIN  	       	;Convert to binary
  3523  17CF  CB27             	SLA    	A
  3524  17D1  CB27             	SLA    	A
  3525  17D3  CB27             	SLA    	A
  3526  17D5  CB27             	SLA    	A      	       	;Shift to high nibble  
  3527  17D7  47               	LD     	B,A    	       	;Store it
  3528  17D8  CD9217           	CALL   	GETCMD 	       	;Get 2nd character from
  3529  17DB  FE1B             	CP     	A,ESC
  3530  17DD  280F             	JR     	Z,HEX_ABORT
  3531  17DF  FE2F             	CP     	'/'    	       	;check 0-9, A-F
  3532  17E1  380B             	JR     	C,HEX_ABORT
  3533  17E3  FE47             	CP     	'F'+1
  3534  17E5  3007             	JR     	NC,HEX_ABORT
  3535  17E7  CD0518           	CALL   	ASBIN  	       	;Convert to binary
  3536  17EA  B0               	OR     	A,B    	       	;add in the first digit
  3537  17EB  B7               	OR     	A,A    	       	;To return NC
  3538  17EC  C1               	POP    	BC
  3539  17ED  C9               	RET
  3540  17EE            HEX_ABORT:
  3541  17EE  37               	SCF    	       	       	;Set Carry flag 
  3542  17EF  3E1B             	LD     	A,ESC
  3543  17F1  C1               	POP    	BC
  3544  17F2  C9               	RET
  3545                  ;
  3546                  ;
  3547                  ; Put 4 HEX characters in [HL] (To set RAM location etc
  3548                  ;
  3549  17F3            GET_HEX4:      	
  3550  17F3  2600             	LD      H,0000H
  3551  17F5  CDBC17           	CALL   	GET_HEX	       	;get 2 HEX digits
  3552  17F8  3809             	JR     	C,SCAN_ABORT
  3553  17FA  67               	LD     	H,A
  3554  17FB  CDBC17           	CALL   	GET_HEX	       	;get 2 more HEX digits
  3555  17FE  3803             	JR     	C,SCAN_ABORT
  3556  1800  6F               	LD     	L,A
  3557  1801  B7               	OR     	A,A    	       	;To return NC
  3558  1802  C9               	RET
  3559  1803            SCAN_ABORT:
  3560  1803  37               	SCF    	       	       	;Set Carry flag 
  3561  1804  C9               	RET
  3562  1805            
  3563                  ; ASCII TO BINARY CONVERSION ROUTINE
  3564  1805  D630      ASBIN: 	SUB    	30H 
  3565  1807  FE0A             	CP     	0AH 
  3566  1809  F8               	RET    	M
  3567  180A  D607             	SUB    	07H 
  3568  180C  C9               	RET
  3569  180D            
  3570                  ;Print the acccumulator value on CRT in HEX-ASCII
  3571  180D  F5        PACC:  	PUSH   	AF
  3572  180E  C5               	PUSH   	BC
  3573  180F  F5               	PUSH   	AF
  3574  1810  0F               	RRCA
  3575  1811  0F               	RRCA
  3576  1812  0F               	RRCA
  3577  1813  0F               	RRCA
  3578  1814  CD1E18           	CALL   	ZCONV
  3579  1817  F1               	POP    	AF
  3580  1818  CD1E18           	CALL   	ZCONV
  3581  181B  C1               	POP    	BC
  3582  181C  F1               	POP    	AF
  3583  181D  C9               	RET
  3584  181E            
  3585  181E  E60F      ZCONV: 	AND    	A,0FH  	       	;HEX to ASCII
  3586  1820  C690             	ADD    	90H
  3587  1822  27               	DAA
  3588  1823  CE40             	ADC    	40H
  3589  1825  27               	DAA
  3590  1826  4F               	LD     	C,A
  3591  1827  CD1B01           	CALL   	CO
  3592  182A  C9               	RET
  3593                  ;
  3594                  ;DISPLAY BIT PATTERN IN [A]
  3595                  ;
