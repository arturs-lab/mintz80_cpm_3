 0443 0600      	MVI	B,0		;MAKE SURE [B] = 0
                	LDY	E,1		;GET PATTERN TO REPEAT TO [E]
 0445+FD5E01    	DB	0FDH,E*8+46H,1
 0448 CD5304    	CALL	RPTFMT		;REPEAT FORMAT
                	INXIY			;UPDATE INDEX REGISTER
 044B+FD23      	DB	0FDH,23H
                	INXIY
 044D+FD23      	DB	0FDH,23H
 044F C1        	POP	B		;GET BACK LOOP COUNT
