    98                         	list on
    99                  ;      	
   100        (0000)    FALSE  	EQU    	0
   101        (0001)    TRUE   	EQU    	1
   102                  ;
   103        (0001)    CHIP_1795 EQU  	TRUE   	       	;<---- RD & WR sector c
   104        (0000)    CHIP_1791 EQU  	FALSE
   105  0100            
   106        (0080)    NBYTES 	EQU    	128    	       	;BYTES PER SECTOR UNIT 
   107        (000A)    LF     	EQU    	0AH
   108        (000D)    CR     	EQU    	0DH
   109        (0007)    BELL   	EQU    	07H
   110        (001A)    CLEAR  	EQU    	1AH    	       	;SD Systems Video Board
   111        (0009)    TAB    	EQU    	09H
   112        (001B)    ESC    	EQU    	1BH
   113        (001C)    EOL    	EQU    	1CH    	       	;SD Systems Video Board
   114        (0010)    PAGE_SIZE EQU  	16     	       	;Number of lines at a t
   115        (0005)    STATUS_DELAY EQU 5     	       	;Time-out for waiting f
   116                  ;
   117        (0001)    RO_FLAG	EQU    	01     	       	;Flag for sequental sec
   118        (0002)    WO_FLAG	EQU    	02     	       	;Flag for sequental sec
   119        (0003)    RW_FLAG	EQU    	03     	       	;Flag for sequental sec
   120        (0004)    RRW_FLAG EQU   	04     	       	;Flag for random track 
   121        (0005)    TRK_RO_FLAG EQU	05     	       	;Flag for reading secto
   122        (0001)    CPM86_FLAG  EQU	01     	       	;Flag to indicate after
   123  0100                   	       	       	       	;needs to be modified
   124        (0001)    TEST_FILL EQU  	01     	       	;Character to write for
   125                  ;
   126        (0000)    SIMPLE 	EQU    	00h    	       	;Output information det
   127        (00FF)    COMPLEX	EQU    	0FFH   	
   128                  ;
   129  0100                   	       	       	       	;Will place these value
   130  0100                   	       	       	       	;The rest go to the end
   131        (0040)    TADDR  	EQU    	40H    	       	;STORE FOR DMA ADDRESS
   132        (0043)    TRK    	EQU    	43H    	       	;NEW TRACK
   133        (0044)    SIDE   	EQU    	44H    	       	;NEW SIDE
   134        (0045)    SCTR   	EQU    	45H    	       	;NEW SECTOR
   135        (002E)    DRIVE  	EQU    	46     	       	;CURRENT DRIVE SELECT B
   136                  ;
   137                  ;
   138                  ;      	PORTS & COMMANDS FOR FOR 1791 or 1795
   139                  ;
   140        (0050)    RSET   	EQU    	50H    	       	;<----- VERSAFLOPPY BAS
   141        (0053)    SELECT 	EQU    	53H    	       	;DRIVE SELECT PORT
   142        (0054)    STATUS 	EQU    	54H    	       	;STATUS PORT
   143        (0055)    TRACK  	EQU    	55H    	       	;TRACK PORT
   144        (0056)    SECTOR 	EQU    	56H    	       	;SECTOR PORT
   145        (0057)    DATA   	EQU    	57H    	       	;DATA PORT
   146        (0054)    CMD    	EQU    	54H    	       	;COMMAND PORT
   147                  ;
   148                  ;Note: the 1791/5 chip for most commands used bits 0&1 
   149                  ;motor stepping rate. 00 being 3ms (@2MH clock),11 bein
   150                  ;Tandon 8" drives take the fastest rate. Older drives m
   151                  ;
   152        (000F)    RSCMD  	EQU    	00001111B      	;(0CH),RESTORE CMD     
   153        (001B)    SKNCMD 	EQU    	00011011B      	;(18H),SEEK NO VERIFY C
   154        (001F)    SKCMD  	EQU    	00011111B      	;(1CH),SEEK WITH VERIFY
   155        (00C4)    RDACMD 	EQU    	11000100B      	;(C0H),READ TRACK/SECTO
   156        (005C)    STEPIN 	EQU    	01011100B      	; Step-in verify on dst
   157  0100                   	
   158                         	IF     	CHIP_1791
   159                  RDCMD91	EQU    	10000000B      	;(80H),READ SECTOR CMD 
   160                  WRCMD91	EQU    	10100000B      	;(A0H),WRITE SECTOR CMD
   161  0100                   	ENDIF
   162  0100            
   163  0100                   	IF     	CHIP_1795
   164        (0088)    RDCMD95	EQU    	10001000B      	;(88H),READ SECTOR CMD 
   165        (00A8)    WRCMD95	EQU    	10101000B      	;(A8H),WRITE SECTOR CMD
   166  0100                   	ENDIF
   167  0100            
   168        (00F4)    WRTCMD 	EQU    	11110100B      	;(F4H),Write a whole tr
   169        (00E4)    RDTCMD 	EQU    	11100100B      	;(E4H),Read a whole tra
   170                  ;
   171                  ;
   172        (0004)    RETRY_MAX EQU  	4      	       	;Number of times to try
   173        (0080)    HOME_ERR_MASK   EQU 80H	       	;Error mask for Type I 
   174        (0090)    SIN_ERR_MASK   	EQU 90H	       	;Step head in one track
   175        (0090)    SK_ERR_MASK     EQU 90H	       	;Track Seek error bits 
   176        (009F)    ID_ERR_MASK     EQU 9FH	       	;Sector ID read error m
   177        (00BF)    RS_ERR_MASK     EQU 0BFH       	;Read sector data error
   178        (00AF)    MRS_ERR_MASK    EQU 0AFH       	;Multi-sector Read data
   179        (00EF)    WS_ERR_MASK    	EQU 0EFh       	;Write sector data erro
   180        (00EF)    MWS_ERR_MASK   	EQU 0EFh       	;Multi-sector Write dat
   181        (0080)    RT_ERR_MASK     EQU 80H	       	;Read Track error mask
   182        (00E0)    WT_ERR_MASK     EQU 0E0H       	;Write Track error mask
   183                  ;
   184                  ;
   185        (5000)    FBUFFER	EQU    5000H   	       	;Buffer to build track 
   186        (6000)    FBUFFER2 EQU   6000H   	       	;2nd buffer here for se
   187                  ;
   188                  ;The Index register IX is used throughout the program t
   189                  ;table of the currently selected drive/disk format
   190                  ;[IX+HW_BYTE] will point to (DRIVE) and will contain th
   191                  ;hardware selection bits. Drive select 0,1,2,3 and side
   192                  ;other flags (see below) 
   193                  ;Remember the bits for disk selection, density and side
   194                  ;the actual Versafloppy II board hardware
   195                  ;Register IX is not used for anything else in this prog
   196  0100            
   197                  ; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
   198                  ;
   199        (0000)    NSCTRS 	EQU    	0      	;Sectors/Track for disk
   200        (0001)    NTRKS  	EQU    	1      	;Tracks/Side
   201        (0002)    HW_BYTE	EQU    	2      	;Will contain bit flags for:-
   202  0100                   	       	       	       	       	;Bits 0,1 are u
   203  0100                   	       	       	       	       	;Bits 2 & 3 are
   204  0100                   	       	       	       	       	;Bit 4=0 For SS
   205  0100                   	       	       	       	       	;Bit 5=0 8" dis
   206  0100                   	       	       	       	       	;Bit 6=0 Single
   207  0100                   	       	       	       	       	;Bit 7=0 if CUR
   208  0100                   	       	       	       	       	;      1 if CUR
   209  0100                   	       	       	       	       	;Note: handle t
   210  0100                   	       	       	       	       	;central to man
   211  0100                   	       	       	       	       	;program.
   212        (0003)    HEADR  	EQU    	3      	;For Formatting
   213        (0004)    GAP1   	EQU    	4      	;      	"
   214        (0005)    GAP2   	EQU    	5      	;      	"
   215        (0006)    GAP3   	EQU    	6      	;      	"
   216        (0007)    GAP4   	EQU    	7      	;      	"
   217        (0008)    GAP4R  	EQU    	8      	;      	"
   218        (0009)    SIZE   	EQU    	9      	;1=128 Byte sectors.....4=1024 
   219        (000A)    GAP_FILL_CHAR  EQU 10  	;Byte used in disk formating
   220        (000B)    DATA_FILL_CHAR EQU 11  	;     "       "       "
   221        (000C)    TRK_SIZE       EQU 12  	;TWO bytes containing the track
   222        (000E)    SPECIAL_FLAG   EQU 14  	;flag byte for cases where afte
   223  0100                   	       	       	;normally 0, CPM86_FLAG = 1
   224        (000F)    SKEW   	       EQU 15  	;Low address of sector skew tab
   225        (0010)    SKEW1          EQU 16  	;High address of sector skew ta
   226        (0011)    FORMAT_NUM     EQU 17  	;Each format will have a unique
   227        (0012)    SYS_TRKS       EQU 18  	;How many tracks for system usu
   228        (0013)    TITLE  	       EQU 19  	;Text string describing the dis
   229                  ;
   230                  ;------------------------------------------------------
   231  0100                   	ORG    	100H
   232                  ;
   233  0100  ED734F3A         	LD     	(SP_SAVE),SP
   234  0104  316A3B           	LD     	SP,STACK
   235  0107  C32501           	JP     	START
   236                  ;------------------------------------------------------
   237                  ;      	       	HARDWARE DEPENDENT STUFF
   238                  ; The only other hardware links are through the Versafl
   239                  ; Remember to make sure it is set to the correct 1791/5
   240                  ;
   241                  ; 
   242  010A  DB00      CONST: 	IN     	A,(0)  	       	;console status for SD 
   243  010C  E602             	AND    	A,02H  	       	;anything there
   244  010E  C8               	RET    	Z      	       	;return 0 if nothing
   245  010F  AF               	XOR    	A,A
   246  0110  3D               	DEC    	A      	       	;return NZ, & 0FFH in A
   247  0111  C9               	RET
   248                  ;
   249  0112  DB00      CI:    	IN     	A,(0)  	       	;console input
   250  0114  E602             	AND    	A,02H
   251  0116  28FA             	JR     	Z,CI
   252  0118  DB01             	IN     	A,(1)  	       	;return with character 
   253  011A  C9               	RET
   254                  ;      	       	
   255  011B  DB00      CO:    	IN     	A,(0)  	       	;console output (arrive
   256  011D  E604             	AND    	A,04H  	       	;Note character is in C
   257  011F  28FA             	JR     	Z,CO
   258  0121  79               	LD     	A,C
   259  0122  D301             	OUT    	(1),A
   260  0124  C9               	RET
   261                  ;------------------------------------------------------
   262  0125  3E00      START: 	LD     	A,SIMPLE
   263  0127  32403A           	LD     	(CRTDISP),A    	;Start off with simple 
   264  012A  21261B    OVER:  	LD     	HL,SIGNON
   265  012D  CD1F1A           	CALL   	PMSG
   266  0130  AF               	XOR    	A,A    	       	;set everything to zero
   267  0131  324500           	LD     	(SCTR),A
   268  0134  324300           	LD     	(TRK),A
   269  0137  324400           	LD     	(SIDE),A
   270  013A            
   271  013A  CDA016           	CALL   	GET_DRIVE_TYPE 	;Ask user which drive t
   272  013D  B7               	OR     	A,A    	       	;Returns with IX pointi
   273  013E  28EA             	JR     	Z,OVER 	       	;Invalid drive, start o
   274  0140  FE1B             	CP     	A,ESC
   275  0142  200A             	JR     	NZ,LOOP
   276  0144  CD3C1A           	CALL   	ZCRLF
   277  0147  ED7B4F3A         	LD     	SP,(SP_SAVE)
   278  014B  C30000           	JP     	0H     	       	;Reboot CP/M if ESC
   279  014E            
   280  014E  3A403A    LOOP:  	LD     	A,(CRTDISP)    	;Check if detailed disp
   281  0151  B7               	OR     	A,A
   282  0152  2005             	JR     	NZ,MENU1
   283  0154  216E21           	LD     	HL,MAIN_MENU0  	;Main Menu loop (Detail
   284  0157  1803             	JR     	LOOP1
   285  0159  21B521    MENU1: 	LD     	HL,MAIN_MENU1  	;Main Menu loop	(Detail
   286  015C  CD1F1A    LOOP1: 	CALL   	PMSG
   287  015F            
   288  015F  CDF317           	CALL   	SHOW_HW_TITLE  	;Describe the currently
   289  0162  CD0418           	CALL   	SHOW_HW_BYTE   	;Print out HW_BYTE info
   290  0165                   	
   291  0165  210050           	LD     	HL,FBUFFER
   292  0168  224000           	LD     	(TADDR),HL
   293  016B  DD22363A         	LD     	(IXSAV),IX
   294  016F                   	       	       	       	
