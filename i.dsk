  3948  1ABF  3809             	JR     	C,SCAN_ABORT
  3949  1AC1  67               	LD     	H,A
  3950  1AC2  CD831A           	CALL   	GET_HEX	       	;get 2 more HEX digits
  3951  1AC5  3803             	JR     	C,SCAN_ABORT
