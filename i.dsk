  3458  2B1C  01        SEC_TEST_FLAG  	DB     	1H     	;flag to decide if sect
  3459  2B1D  00        SEC_COUNT      	DB     	0H     	;number of sectors to l
  3460  2B1E  0000      DMA_NEXT       	DW     	0      	;Store for next (TADDR)
  3461  2B20            
  3462  2B20  0000      INDEX_MARK     	DW     	0000H  	;End of Index field +1
  3463  2B22  0000      S_DATA_MARK    	DW     	0000H  	;Pointer to start of Da
  3464  2B24  0000      E_DATA_MARK    	DW     	0000H  	;Pointer to end of Data
  3465  2B26  0000      E_SEC_MARK     	DW     	0000H  	;End Sector image +1
  3466  2B28  0000      S_GAP4_MARK    	DW     	0000H  	;start GAP4 area
  3467  2B2A  0000      E_GAP4_MARK    	DW     	0000H  	;End track +1
  3468  2B2C                   	
  3469  2B2C  (0100)           	       	DS     	100H
  3470        (2C2C)    STACK  	EQU    	$
  3471  2C2C            
  3472                  ;END
  3473  2C2C            
  3474  2C2C            
STACK  	EQU    	$
  3471  2C2C            
  3     	22     	;GAP 2
  2389  1C67  50               	DB     	80     	;GAP 3
  2390  1C68  CF               	DB     	207    	;GAP 4 (FF's)
  2391  1C69  05               	DB     	5      	;GAPR (Flag for multiple repeat
  2392  1C6A  0B               	DB     	0bh    	;RESTORE CODE
  2393  1C6B  1B               	DB     	1bh    	;seek w/no verify cmd
  2394  1C6C  1F               	DB     	1fh    	;seek w/verify cmd
  2395  1C6D  02               	DB     	2      	;512 Bytes/sec
  2396  1C6E  70               	DB     	01110000B      	;Disk HW_BYTE (DDDS)
  2397  1C6F  4E               	DB     	04EH   	;GAP Format fill character
  2398  1C70  E5               	DB     	0E5H   	;Data area fill character
  2399  1C71  0000             	DW     	0H     	;Size in bytes of 1 formatted t
  2400  1C73  35222C20         	DB     	'5", DDDS, 512 byte, 8 sector IBM PC CP
              44444453
