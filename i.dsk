  2414  1CB0  02               	DB     	2      	;512 Bytes/sec
  2415  1CB1  70               	DB     	01110000B      	;Disk HW_BYTE (DDDS)
  2416  1CB2  4E               	DB     	04EH   	;GAP Format fill character
  2417  1CB3  E5               	DB     	0E5H   	;Data area fill character
  2418  1CB4  0000             	DW     	0H     	;Size in bytes of 1 formatted t
