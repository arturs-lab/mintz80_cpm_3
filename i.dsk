 010B 29        	dad h		; shift out next bit
 010C 3E00      	mvi a,0		; insure zero a  (nonexistant device not ready).
 010E DCCA00    	cc cist1	; see if the device has a character
 0111 B7        	ora a
 0112 C21F01    	jnz ci$rdy	; this device has a character
