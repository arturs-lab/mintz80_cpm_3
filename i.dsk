              43504D2D
              38362066
              6F726D61
              7400
  2401                  ;
  2402                  ; 5", 512 byte, DDDS, 8 sector IBM PC MSDOS1.1 format:
  2403  1CA5  08        MSDOS: 	DB     	8      	;sectors per track
  2404  1CA6  28               	DB     	40     	;tracks per side
  2405  1CA7  14               	DB     	100-80 	;index header gap
  2406  1CA8  08               	DB     	8      	;GAP 1
