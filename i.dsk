                	JRZ	SETID0
 03E7+28        	DB	28H
 03E8+01        	DB	SETID0-$-1
 03E9 1F        	RAR			;PHYSICAL TRACK = TRACK / 2 IF 2-SIDED
 03EA 4F        SETID0:	MOV	C,A		;[C] = PHYSICAL TRACK #
 03EB 3E00      	MVI	A,0		;GET SIDE # TO [A]
 03ED 17        	RAL
 03EE 32DF13    	STA	PHYHEAD		;SAVE PHYSICAL HEAD #
 03F1 B7        	ORA	A		;SIDE 0 ?
