   329  0252            SEC_READ_TEST:
   330  0252  21761A           	LD     	HL,RDTST_MSG
   331  0255  CDA90B           	CALL   	PMSG
   332  0258  AF               	XOR    	A,A    	       	;Setup for the BIOS bel
   333  0259  324300           	LD     	(TRK),A	       	;Start with track 0 
   334  025C  324400           	LD     	(SIDE),A       	;Start on Side A 
   335  025F  3C               	INC    	A
   336  0260  324500           	LD     	(SCTR),A       	;Start at sector 1 
   337  0263  CD8B09           	CALL   	DRVSET 	       	;Select the drive in ha
   338  0266  CD7207           	CALL   	HOME1  	       	
   339  0269  C40D0A           	CALL   	NZ,SHOW_ERRORS 	;print out errors if an
   340  026C            
   341  026C  21B816    RDTST1:	LD     	HL,ATTRK       	;Announce current track
   342  026F  CDA90B           	CALL   	PMSG
   343  0272  3A4300           	LD     	A,(TRK)	       	
   344  0275  CD1D0C           	CALL   	PACC
