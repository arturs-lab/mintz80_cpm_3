  2436  1CFF  0000      RSEEK  	       	DW     	0000H
  ;  THIS IS A PROGRAM TO EXAMINE & FORMAT CPM DISKS USEING A VERSAFLOPPY II DISK 
;  CONTROLLER. NOTE IT IS SELF A CONTAINED PROGRAM (EXCEPT FOR CONSOLE I/O)
;
;	JOHN MONAHAN		27/4/2009	VERSION	1.0
;
;
;	V1	Basic Sector ID field working
;	V2	Seek test jumpy
;	V3	Seek done, before read sector core stuff
;	V5	Sector read OK for 8" SD
;	V7	Sector Read blanked out menu, itself OK. Seek redone.
;	V8	Reading 128 byte sectors with my READ_SECTOR routine OK
;	V9	Block read for sectors
;	V10	Start of Formatting OK
;	V11	Filled in comments of formatting
;	v12	Start of sectot track write image display
;	V12-Bad	- gets stuck on Format track 1
;	V14	Fixed abort etc. Sec formatting display working, ESC to stop display 
;	V15	Sec ID errors on display. general cleanup of abort stuff
;	V16	Variable sec size display. Second side not working
;	V17	Second side working before splitting UNIT into two sections (Hardware & Software)
;	V18	New format using IO_BYTE and IX pointer to tables for disk/drive info.
;	v19	Before simplifying moving IO_BYTE data to Disk paramater table
;	V20	Start of HW_BYTE in disk paramater table. No format yet.
;	V21	8" format done with new layout.
;	V22	Before New Format Routine & Tables
;	V24	Before switching to my memory track build routines
;	V25	My track image not working yet
;	V27	Software SD Track (no sides) working. No hardware yet
;	V28	8" format (CPM cannot read it). Cannot access 5" drives
;	V29	Straightened our 5". (DW in table). Still CPM read problem
;	V30	Start of track dump SD 8" Format now working
;	V31	Cleaned up seek no verify functions to one general function
;	V32-BAD	Sector read of > track 2 not working. Went back to V30
;	V33	Seems to be working now
;	V34	Random sector read test working (write not done yet)
;	V35	Start or read sec & seek error returns. Have seperate flag on CMD's 
;	V36-Partially done. Half way through streamlining errors etc. Will model on VF1 BIOS instead
;	V37	New error routines Seek done. Modeled after VF1 Bios
;	V38	New error routines, centralized Home, Seek etc started. 
;	V39	New format for sec read with seek_V done
;	V40	New side selection and redo of odds and ends
;	V41	Split menu's for 5" & 8" drives. All OK on Sec reads
;	V42	Dump track working again.
;	V43	Format not working
;	V44	Re-did disk format menues and selection. Started on Format stuff 
;	V45	Combine IY & IX reg flags into a single IX+HW_BYTE flag
;	V46	Put track size info in tables and use it for track dumps.
;	V48	Cleaned up things. END_ROUTINE put in.
;	v50	Sector Read/write done (track format broken)

;
;	To Do:-
;
	list on
;	

NBYTES	EQU	128		;BYTES PER SECTOR UNIT (eg, *2 FOR 256 BYTE SECTORS)
LF	EQU	0AH
CR	EQU	0DH
BELL	EQU	07H
CLEAR	EQU	1AH		;SD Systems Video Board Clear Screen
TAB	EQU	09H
ESC	EQU	1BH
EOL	EQU	1CH		;SD Systems Video Board Clear to end of line
PAGE_SIZE EQU	16		;Number of lines to display memory contents at a time on CRT
RETRY_MAX EQU	4		;Number of times to try R/W a sector before returning an error
;
SIMPLE	EQU	00h		;Output information detail to CRT
COMPLEX	EQU	0FFH	
;
				;Will place these values here for easy RAM analysis if a crash
				;The rest go to the end of the program
TADDR	EQU	40H		;STORE FOR DMA ADDRESS
TRK	EQU	43H		;NEW TRACK
SIDE	EQU	44H		;NEW SIDE
SCTR	EQU	45H		;NEW SECTOR
DRIVE	EQU	46		;CURRENT DRIVE SELECT BITS
;
;	PORTS FOR 1791
RSET	EQU	50H		;CONTROLLER RESET ADDRESS
SELECT	EQU	53H		;DRIVE SELECT PORT
STATUS	EQU	54H		;STATUS PORT
TRACK	EQU	55H		;TRACK PORT
SECTOR	EQU	56H		;SECTOR PORT
DATA	EQU	57H		;DATA PORT
CMD	EQU	54H		;COMMAND PORT
;
RDACMD	EQU	0C0H		;READ ADDRESS CODE
RDCMD	EQU	088H		;READ SECTOR CODE
WRCMD	EQU	0A8H		;WRITE SECTOR CODE
WRTCMD	EQU	0F4H		;Write a whole track command
RDTCMD	EQU	0E4H		;Read a whole track command
;
HOME_ERR_MASK   EQU 80H		;Error mask for Type I Home CMD
SK_ERR_MASK     EQU 090H	;Track Seek error bits 

ID_ERR_MASK     EQU 9FH		;Sector ID read error mask

RS_ERR_MASK     EQU 0BFH	;Read sector data error mask
WS_ERR_MASK	EQU 0EFh	;Write sector data error mask

RT_ERR_MASK     EQU 80H		;Read Track error mask
WT_ERR_MASK     EQU 0E0H	;Write Track error mask
;
;
FBUFFER	EQU    3000H		;Buffer to build track image OR display sectors reads
FBUFFER2 EQU   4000H		;2nd buffer here for sector R/W test	
;
;The Index register IX is used throughout the program to point to the disk paramater
;table of the currently selected drive/disk format
;[IX+HW_BYTE] will point to (DRIVE) and will contain the current DRIVE 
;hardware selection bits. Drive sel 0,1,2,3 and side A or side B bits as well as
;other flags (see below) 
;Remember the bits for disk selection and side selection are inverted on 
;the actual Versafloppy II board hardware
;Register IX is not used for anything else in this program.

; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
;
NSCTRS	EQU	0	;Sectors/Track for disk
NTRKS	EQU	1	;Tracks/Side
HEADR	EQU	2	;For Formatting
GAP1	EQU	3	;	"
GAP2	EQU	4	;	"
GAP3	EQU	5	;	"
GAP4	EQU	6	;	"
GAP4R	EQU	7	;	"
RSCMD	EQU	8	;8" & 5" drives have differnt seek stepping rates
SKNCMD	EQU	9	;so 1791/5 bit patterns are different
SKCMD	EQU	10	;
SIZE	EQU	11	;1=128 Byte sectors.....4=1024 Byte sectors
HW_BYTE	EQU	12	;Will contain bit flags for:-
						;Bits 0,1 are used for drive selection
						;Bits 2 & 3 are currently unused
						;Bit 4=0 For SS disk hardware, 1= DS disk
						;Bit 5=0 8" disk, 1= 5" disk
						;Bit 6=0 Single density, 1= Double density
						;Bit 7=0 if CURRENT selected side is A
						;      1 if CURRENT selected side is B
						;Note: handle this byte with care it is
						;central to many functions within the 
						;program.
GAP_FILL_CHAR EQU 13	;Byte used in disk formating
DATA_FILL_CHAR EQU 14	;     "       "       "
TRK_SIZE EQU	15	;Two bytes containing the track size of that disks format
TITLE	EQU	17	;Text string describing the disk format

;------------------------------------------------------------------------------
	ORG	100H
;
	LD	(SP_SAVE),SP
	LD	SP,STACK
	JP	START
;------------------------------------------------------------------------
;		HARDWARE DEPENDENT STUFF
; LINKS TO ROM BIOS at 0F000H (The only Monitor linkages used in the program)
; The only other hardware links are through the Versafloppy II board. 
; Remember to make sure it is set to the correct 179x base port mentioned above.
;
; If you have a video board that can use a single character to erase a line us it here
;
CONST:	IN	A,(0)		;console status for SD Systems 8024 Video board
	AND	A,02H		;anything there
	RET	Z		;return 0 if nothing
	XOR	A,A
	DEC	A		;return NZ, & 0FFH in A if something there
	RET
;
CI:	IN	A,(0)		;console input
	AND	A,02H
	JR	Z,CI
	IN	A,(1)		;return with character in A
	RET
;		
CO:	IN	A,(0)		;console output (arrive with character in C)
	AND	A,04H		;Note character is in C and A on return.
	JR	Z,CO
	LD	A,C
	OUT	(1),A
	RET
;-------------------------------------------------------------------------
START:	LD	A,SIMPLE
	LD	(CRTDISP),A	;Start off with simple diagnostic display
OVER:	LD	HL,SIGNON
	CALL	PMSG
	XOR	A,A		;set everything to zero
	LD	(SCTR),A
	LD	(TRK),A

	CALL	GET_DRIVE_TYPE	;Ask user which drive to examine (A,B,C.. 8"/5")
	OR	A,A		;Returns with IX pointing relevent Disk table
	JR	Z,OVER		;Invalid drive, start over
	CP	A,ESC
	JR	NZ,LOOP
	CALL	ZCRLF
	LD	SP,(SP_SAVE)
	JP	0H		;Reboot CP/M if ESC

LOOP:	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	NZ,MENU1
	LD	HL,MAIN_MENU0	;Main Menu loop (Detailed Diaplay OFF)
	JR	LOOP1
MENU1:	LD	HL,MAIN_MENU1	;Main Menu loop	(Detailed Display ON)
LOOP1:	CALL	PMSG

	CALL	SHOW_HW_TITLE	;Describe the currently selected drive
	CALL	SHOW_HW_BYTE	;Print out HW_BYTE info
	
	LD	HL,FBUFFER
	LD	(TADDR),HL
	LD	(IXSAV),IX
				
	CALL	DRVSET		;Select the drive in hardware ((IX+HW_BYTE) used)

	CALL	HOME1		;Move head to track 0 with a RESTORE CMD
	CALL	NZ,SHOW_ERRORS	;If an error in restoring head to TRK 0 say so.

	CALL	SHOW_IX_TABLE	;Show info about current disk parameters

	CALL	READ_ID		;Get Actual track ID
	JR	Z,ID_FINE	;Was there errors
	CALL	SHOW_ERRORS	;If an error show bit flags
	JR	TO_MENU
ID_FINE:CALL	SHOW_ID		;Show a typical Track ID field on track 0
				
TO_MENU:
	LD	HL,MENU_OPTIONS
	CALL	PMSG
	LD	A,(CRTDISP)	;Two menu lists (Set using menu # 8)
	OR	A,A		;A detailed display or a simple one.
	JR	NZ,MENUA
	LD	HL,MENU1_MSG
	JR	MENUB
MENUA:	LD	HL,MENU2_MSG
MENUB:	CALL	PMSG
				;-----MAIN MENU----
	CALL	GETCMD		;Find out Menu Option in A
	LD	(CMD_STORE),A
	CP	A,ESC		;Abort if ESC character
	JR	Z,FIN
	CP	A,'0'		;Get a new current disk
	JP	Z,OVER
	CP	A,'1'
	CALL	Z,SEEK_TEST	;Seek test
	CP	A,'2'
	CALL	Z,SEC_READ_TEST	;Sequental Read sectors test. 
	CP	A,'3'		;Will start at Trk 0 working inward
	CALL	Z,SEC_RW_TEST	;Random sector read/write test
	CP	A,'4'
	CALL	Z,TRACK_TEST	;Read continously sectors from a specific track
	CP	A,'5'
	CALL	Z,TRACK_DUMP	;Write one whole track to RAM at location 3000H
	CP	A,'8'
	CALL	Z,FORMAT_DISK	;Go to disk formatting section
	CP	A,'9'
	CALL	Z,TOGGLE_CRT	;Switch on/off detail info display option

	JP	LOOP
FIN:	CALL	ZCRLF
	LD	SP,(SP_SAVE)
	JP	Z,0H		;Return to CPM

;
;
;-------- TOGGLE ON/OFF DETAILED INFORMATION DISPLAY ON CRT/LCD FOR SOME COMMANDS
TOGGLE_CRT:
	LD	A,(CRTDISP)
	CPL
	LD	(CRTDISP),A
	LD	A,(CMD_STORE)	;So we dont pick up other menu items
	RET			;Back to main menu
;
;
;------------------ SEEK DIAGNOSTIC TEST --------------------
;
;Simply tests head movement control
SEEK_TEST:
	LD	HL,SEKMSG
	CALL	PMSG
	XOR	A,A
	LD	(TRK),A		;Start at track 0

	CALL	HOME1		;Move head to Track 0
	CALL	NZ,SHOW_ERRORS	;If error show error flags
	
	LD	HL,AT0MSG
	CALL	PMSG
SEKT:	LD	A,(TRK)
	INC	A
	CP	A,(IX+NTRKS)	;get max tracks on this disk
	JR	Z,SEEK_TEST	;start again

	LD	(TRK),A		;Store for next time

	CALL	SEEK_TRACK_NV	;Seek with no verify command to 1791/5
	JR	Z,FINE5
	CALL	SHOW_ERRORS	;If Error show error flags
	CALL	ZCRLF
FINE5:
	CALL	READ_ID		;Get current track ID
	JR	Z,FINE4
	CALL	SHOW_ERRORS	;print out the track ID errors
	LD	HL,ATYMSG	;For Track 
	CALL	PMSG
	LD	A,(TRK)		;Say what track we are now on.
	CALL	PACC		;Display current track number 
	LD	HL,ATX2MSG
	CALL	PMSG
	JR	SEKT1
FINE4:	LD	HL,ATXMSG	;CR,LF,Track'
	CALL	PMSG
	LD	A,(TRK)		;Say what track we are now on.
	CALL	PACC		;Display current track number 
	LD	HL,ATX2MSG
	CALL	PMSG
FINE3:	CALL	SHOW_ID		;Show track ID
SEKT1:	CALL	CHECKABORT	;SP will halt, ESC will abort
	LD	A,(CMD_STORE)	;So we dont pick up other menu items
	RET	NZ		;Return back to main menu
	JR	SEKT
;
; ------------------- READ SECTORS TEST -------------
; This routine will sequentially read all sectors on a disk. Both sides
; if a 2 sided disk.
;
SEC_READ_TEST:
	CALL	ZCRLF		;CR,LF at start. 
	XOR	A,A		;Setup for the BIOS below
	LD	(TRK),A		;Start with track 0 
	LD	(SIDE),A	;Start on Side A 
	INC	A
	LD	(SCTR),A	;Start at sector 1 
	CALL	DRVSET		;Select the drive in hardware
	CALL	HOME1		
	CALL	NZ,SHOW_ERRORS	;print out errors if any

RDTST1:	LD	HL,ATTRK	;Announce current track position
	CALL	PMSG
	LD	A,(TRK)		
	CALL	PACC
	LD	HL,ATSEC	;and sector position
	CALL	PMSG
	LD	A,(SCTR)		
	CALL	PACC
	
	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,SKIP_SIDES	;If 1 sided then skip side swap
	LD	A,(SIDE)	;which side WILL we write on
	OR	A,A
	JR	NZ,ON_B_SIDE
	LD	HL,HEAD0_MSG	;Announce side 0 (or A)
	CALL	PMSG
	JR	REED
ON_B_SIDE:
	LD	HL,HEAD1_MSG	;Announce side 1 (or B)
	CALL	PMSG
	JR	REED
SKIP_SIDES:
	LD	HL,HEADX_MSG	;If SS disk, no need for a HEAD# message
	CALL	PMSG
REED:
	LD	HL,FBUFFER	;Place sector data here
	LD	(TADDR),HL	;Setup DMA address for BIOS

	CALL	SEEK_TRACK_V	;Seek with verify command to 1791/5
	CALL	NZ,SHOW_ERRORS	;If any show error flags

	CALL	READ_SECTOR	;<<<<<<<< Read 1 Sector >>>>>>
	CALL	NZ,SHOW_ERRORS	;If any show error flags

	LD	A,(CRTDISP)	;Do we have the more detail display option on
	OR	A,A
	CALL	NZ,SEC_DISPLAY	;If yes, then list the sector contents

	LD	A,(SCTR)
	INC	A		;Get next sector
	LD	B,A		;Store new sec # in B
	DEC	A		;Because sectors are numbered 1,2,3...
	CP	A,(IX+NSCTRS)	;Have we done a complete track yet
	JR	NZ,NOTEND

	LD	A,1		;Back to sector 1 no matter what
	LD	(SCTR),A	;Store for loop test

					;Sides swap check
	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,NO_SIDES	;If 1 sided then skip sides swap

	LD	A,(SIDE)
	OR	A,A		;If 0 we have done A side now do B
	JR	Z,GOTO_B_SIDE	;switch over to B side
	XOR	A,A
	LD	(SIDE),A
	CALL	SET_SIDE	;update the hardware
	JR	NO_SIDES	;Need track increase now we are on side A
GOTO_B_SIDE:
	LD	A,80H
	LD	(SIDE),A	
	CALL	SET_SIDE	;Update the hardware	
	JR	NOTXEND		;No need for a track increase yet
NO_SIDES:
	LD	A,(TRK)		;Need to bump track up one
	INC	A		;Next track
	LD	B,A
	LD	A,(IX+NTRKS)	;Are we at the end yet
	CP	A,B
	JR	Z,DONE_SR2	;Yes we are done, back to Main Menu
	LD	A,B
	LD	(TRK),A	
	JR	NOTXEND
NOTEND:	LD	A,B
	LD	(SCTR),A	;Store for loop test	
NOTXEND:CALL	CHECKABORT	;SP will halt, ESC will abort
	JR	NZ,DONE_SR
	JP	RDTST1		;Loop until abort or all tracks done
DONE_SR:LD	A,(CRTDISP)	;If detailed CRT display is on then one ESC 
	OR	A,A		;will switch it off
	JP	Z,DONE_SR2	;If Z do not list the sector contents.
	XOR	A,A		;Just turn it off. Next time a real abort.
	LD	(CRTDISP),A
	JP	RDTST1
DONE_SR2:
	XOR	A,A
	LD	(TRK),A
	CALL	HOME1		;Move head back to Track 0
	LD	A,(CMD_STORE)	;So we dont pick up other menu items IF we return from here
	RET
;
; ------------------- RANDOM READ/WRITE SECTORS TEST -------------
; This routine will read and write back to randomly selected tracks and 
; sectors on a disk. Both sides, if a 2 sided disk.
;
SEC_RW_TEST:
	CALL	ZCRLF		;CR,LF at start. 
	XOR	A,A		;Setup for the BIOS below
	LD	(TRK),A		;Start with track 0 
	LD	(SIDE),A	;Start on Side A 
	INC	A
	LD	(SCTR),A	;Start at sector 1 
	CALL	DRVSET		;Select the drive in hardware
	CALL	HOME1		
	CALL	NZ,SHOW_ERRORS	;print out errors if any

RW_LOOP:LD	HL,ATTRK	;Announce current track position
	CALL	PMSG
	LD	A,(TRK)		
	CALL	PACC
	LD	HL,ATSEC	;and sector position
	CALL	PMSG
	LD	A,(SCTR)		
	CALL	PACC
	
	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,RW_SKIP_SIDES	;If 1 sided then skip side swap
	LD	A,(SIDE)	;which side are we on
	OR	A,A
	JR	NZ,RW_B_SIDE
	LD	HL,HEAD0_MSG	;Announce side 0 (or A)
	CALL	PMSG
	JR	RW_REED
RW_B_SIDE:
	LD	HL,HEAD1_MSG	;Announce side 1 (or B)
	CALL	PMSG
	JR	RW_REED
RW_SKIP_SIDES:
	LD	HL,HEADX_MSG	;If SS disk, no need for a HEAD# message
	CALL	PMSG
RW_REED:
	LD	HL,FBUFFER	;Place sector data here
	LD	(TADDR),HL	;Setup DMA address for BIOS

	CALL	SEEK_TRACK_V	;Seek with verify command to 1791/5
	CALL	NZ,SHOW_ERRORS	;If any show error flags

	CALL	READ_SECTOR	;<<<<<<<< READ 1 SECTOR >>>>>>
	CALL	NZ,SHOW_ERRORS	;If any, show error flags
				
	LD	A,(CRTDISP)	;Do we have the more detail display option on
	OR	A,A
	CALL	NZ,SEC_DISPLAY	;If yes, then list the sector contents

	LD	HL,FBUFFER	;write sector data back to disk
	LD	(TADDR),HL	;Setup DMA address for BIOS
	
	CALL	WRITE_SECTOR	;<<<<<<<< WRITE 1 SECTOR >>>>>>
	CALL	NZ,SHOW_ERRORS	;If any, show error flags

	LD	HL,FBUFFER2	;Place new sector data here
	LD	(TADDR),HL	;Setup DMA address for BIOS

	CALL	READ_SECTOR	;<<<<<<<< READ 1 SECTOR >>>>>>
	CALL	NZ,SHOW_ERRORS	;If any, show error flags

	CALL	COMPARE_BUFFERS	;Check for errors
	JR	Z,CMP_OK
	LD	HL,SECTOR_RW_ERROR
	CALL	PMSG
	LD	A,(SCTR)
	CALL	PMSG
	LD	HL,HEADX_MSG
	CALL	PMSG
CMP_OK:
	CALL	RANDOM		;Get a random sector#
	LD	B,(IX+NSCTRS)
	AND	A,B		;strip off extra bits
	OR	A,A		;No sector 0
	JR	NZ,SEC_OK
	INC	A
SEC_OK:	LD	(SCTR),A	;Store for SEC display and sector read routine

	CALL	RANDOM		;Get a random track #
	LD	B,(IX+NTRKS)
	DEC	B		;Tracks numbered 0,1,2...NTRKS-1
	AND	A,B		;strip off extra bits
	LD	(TRK),A		;Store for SEC display and sector read routine

	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,NO_SIDESX	;If 1 sided then skip sides swap

	CALL	RANDOM		;Get a random SIDE 
	AND	80H		;Isolate the SIDE bit
	LD	(SIDE),A	;Will be either 0 or 80H
	CALL	SET_SIDE

NO_SIDESX:
	CALL	CHECKABORT	;SP will halt, ESC will abort
	JR	NZ,DONE_RW
	JP	RW_LOOP		;Loop until abort or all tracks done
DONE_RW:LD	A,(CRTDISP)	;If detailed CRT display is on then one ESC 
	OR	A,A		;will switch it off
	JP	Z,DONE_RW2	;If Z do not list the sector contents.
	XOR	A,A		;Just turn it off. Next time a real abort.
	LD	(CRTDISP),A
	JP	RW_LOOP
DONE_RW2:
	XOR	A,A
	LD	(TRK),A
	CALL	HOME1		;Move head back to Track 0
	LD	A,(CMD_STORE)	;So we dont pick up other menu items IF we return from here
	RET
;
; Simple random number generator
;
RANDOM:	LD	A,0		; Seed will be modified each time
	LD	B,A		;Note this is slelf modifying code
	ADD	A,A
	ADD	A,A
	ADD	A,B
	ADD	A,7
	LD	(RANDOM+1),A
	RET
;
;
;
;
; -------- CONTINOUSLY READ SECTORS FROM A SPECIFIC TRACK -------------
; This routine will read continously from a selected track and side
;
TRACK_TEST:
	CALL	ZCRLF		;CR,LF at start. 
	XOR	A,A		;Setup for the BIOS below
	LD	(TRK),A		;Start with track 0 
	LD	(SIDE),A	;Start on Side A 
	INC	A
	LD	(SCTR),A	;Start at sector 1 
	CALL	DRVSET		;Select the drive in hardware
	CALL	HOME1		
	CALL	NZ,SHOW_ERRORS	;print out errors if any
;
	LD	HL,GET_TRACK_MSG ;get required track
	CALL	PMSG
	CALL	GET_HEX		;get 2 digits
	JP	C,DONE_TRW2	;Abort if C returned
	CALL	ZCRLF
	
	LD	B,(IX+NTRKS)	;Are we within disk range
	CP	A,B
	JR	C,GET_TSIDES	;Yes we are 
	LD	HL,TRACK_ERROR
	CALL	PMSG
	JR	TRACK_TEST	;Try again
GET_TSIDES:
	LD	(TRK),A		;Store requested track

	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,GET_TTRK	;If 1 sided then skip side question

	LD	HL,GET_SIDE_MSG ;get required track
	CALL	PMSG
	CALL	GETCMD		;get the input option
	CP	A,ESC		;Abort if ESC character
	JP	Z,DONE_TRW2
	CP	A,'B'
	JR	NZ,MUST_BE_TA
	LD	A,80H		;Set to side B
	LD	(SIDE),A
	JR	GET_TTRK
MUST_BE_TA:
	CP	A,'A'
	JR	Z,GET_TTRK	;Already on A
	LD	HL,SIDE_ERROR
	CALL	PMSG
	JR	TRACK_TEST	;Try again

GET_TTRK:
	CALL	SET_SIDE	;Update the side hardware (if required)	

	CALL	SEEK_TRACK_V	;seek to the new track position	(no verify)
	CALL	NZ,SHOW_ERRORS	;If any show error flags
;
;
TRW_LOOP:
	LD	HL,ATTRK	;Announce current track position
	CALL	PMSG
	LD	A,(TRK)		
	CALL	PACC
	LD	HL,ATSEC	;and sector position
	CALL	PMSG
	LD	A,(SCTR)		
	CALL	PACC
	
	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,RW_SKIP_TSIDES	;If 1 sided then skip side swap
	LD	A,(SIDE)	;which side are we on
	OR	A,A
	JR	NZ,RW_BT_SIDE
	LD	HL,HEAD0_MSG	;Announce side 0 (or A)
	CALL	PMSG
	JR	RW_TREED
RW_BT_SIDE:
	LD	HL,HEAD1_MSG	;Announce side 1 (or B)
	CALL	PMSG
	JR	RW_TREED
RW_SKIP_TSIDES:
	LD	HL,HEADX_MSG	;If SS disk, no need for a HEAD# message
	CALL	PMSG
RW_TREED:
	LD	HL,FBUFFER	;Place sector data here
	LD	(TADDR),HL	;Setup DMA address for BIOS

	CALL	SEEK_TRACK_V	;Seek with verify command to 1791/5
	CALL	NZ,SHOW_ERRORS	;If any show error flags

	CALL	READ_SECTOR	;<<<<<<<< Read 1 Sector >>>>>>
	CALL	NZ,SHOW_ERRORS	;If any, show error flags
				
	LD	A,(CRTDISP)	;Do we have the more detail display option on
	OR	A,A
	CALL	NZ,SEC_DISPLAY	;If yes, then list the sector contents

	LD	A,(SCTR)
	INC	A		;Get next sector
	LD	B,A		;Store in B
	DEC	A		;Because sectors are numbered 1,2,3...
	CP	A,(IX+NSCTRS)	;Have we done a complete track yet
	JR	NZ,SEC_TOK
	LD	B,1
SEC_TOK:
	LD	A,B
	LD	(SCTR),A	;Store for SEC display and sector read routine

	CALL	CHECKABORT	;SP will halt, ESC will abort
	JR	NZ,DONE_TRW
	JP	TRW_LOOP	;Loop until abort or all tracks done
DONE_TRW:
	LD	A,(CRTDISP)	;If detailed CRT display is on then one ESC 
	OR	A,A		;will switch it off
	JP	Z,DONE_TRW2	;If Z do not list the sector contents.
	XOR	A,A		;Just turn it off. Next time a real abort.
	LD	(CRTDISP),A
	JP	TRW_LOOP
DONE_TRW2:
	XOR	A,A
	LD	(TRK),A
	CALL	HOME1		;Move head back to Track 0
	LD	A,(CMD_STORE)	;So we dont pick up other menu items IF we return from here
	RET


;------------------------------------------------------------------------------
;Read one whole track to RAM (3000H). This is used to see what the Format routine actully
;placed on the disk and/or to see what track formats other computers used.
;Currently Side A only +++++++++++++++++
;
TRACK_DUMP:
	CALL	ZCRLF		;CR,LF at start. 
	XOR	A,A		;Setup for the BIOS below
	LD	(TRK),A		;Start with track 0 
	LD	(SIDE),A	;Start on Side A 
	INC	A
	LD	(SCTR),A	;Start at sector 1 
	CALL	DRVSET		;Select the drive in hardware
	CALL	HOME1		
	CALL	NZ,SHOW_ERRORS	;print out errors if any

	LD	HL,GET_TRACK_MSG ;get required track
	CALL	PMSG
	CALL	GET_HEX		;get 2 digits
	JP	C,DONE_DUMP
	CALL	ZCRLF
	
	LD	B,(IX+NTRKS)	;Are we within disk range
	CP	A,B
	JR	C,GET_SIDES	;Yes we are 
	LD	HL,TRACK_ERROR
	CALL	PMSG
	JR	TRACK_DUMP	;Try again
GET_SIDES:
	LD	(TRK),A		;Store requested track

	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,GET_TRK	;If 1 sided then skip side question

	LD	HL,GET_SIDE_MSG ;get required track
	CALL	PMSG
	CALL	GETCMD		;get the input option
	CP	A,ESC		;Abort if ESC character
	JP	Z,DONE_DUMP
	CP	A,'B'
	JR	NZ,MUST_BE_A
	LD	A,80H		;Set to side B
	LD	(SIDE),A
	JR	GET_TRK
MUST_BE_A:
	CP	A,'A'
	JR	Z,GET_TRK	;Already on A
	LD	HL,SIDE_ERROR
	CALL	PMSG
	JR	TRACK_DUMP	;Try again

GET_TRK:
	CALL	SET_SIDE	;Update the side hardware (if required)	

	CALL	SEEK_TRACK_V	;seek to the new track position	(no verify)
	CALL	NZ,SHOW_ERRORS	;If any show error flags
;
	LD	HL,FBUFFER	;Will build the complete sector image here (3000H)
	LD	(TADDR),HL	;Store the pointer here.
	LD	D,(IX+TRK_SIZE+1) ;Need to find out how large the track is
	LD	E,(IX+TRK_SIZE)	;Number of bytes per track for this disk into [DE]
	LD	(TRACK_SIZE),DE ;Store for below also

	LD	B,0
Z_LOOP:	LD	(HL),B		;Fill RAM with 0's before starting
	INC	HL
	DEC	DE
	LD	A,E
	OR	A,A
	JR	NZ,Z_LOOP
	OR	A,D
	JR	NZ,Z_LOOP	;Have we done DE bytes yet
	
	LD	HL,FBUFFER	;Start again
	LD	(TADDR),HL
	LD	DE,(TRACK_SIZE)	;Number of bytes per track 
				
	CALL	READ_TRACK	;<<<<<< Read one whole track
	CALL	NZ,SHOW_ERRORS	;If any, show error flags

	LD	HL,ATXMSG
	CALL	PMSG
	LD	A,(TRK)		;Say what track we are now on.
	CALL	PACC		;Display current track number 
	
	LD	HL,TRACK_CONTENTS
	CALL	PMSG
	LD	L,PAGE_SIZE	;20 lines per page
	LD	DE,(TRACK_SIZE)	;to count down 
	LD	BC,0		;to count up
	EXX
	LD	HL,FBUFFER	;will use alt reg HL' for data pointer
	EXX
RAMDUMP:EXX
	LD	A,(HL)
	CALL	PACC
	INC	HL
	EXX
	INC	BC
	LD	A,C
	AND	A,00011111B	;32 characters /line
	JR	NZ,NOCRX
	CALL	ZCRLF
	DEC	L
	JR	NZ,NOCRX
	PUSH	HL
	LD	HL,MORE_MSG
	CALL	PMSG
	CALL	GETCMD		;Ask if we wish to continue
	POP	HL
	CP	A,'Y'
	JR	NZ,DONECR
	CALL	ZCRLF
	LD	L,PAGE_SIZE
NOCRX:	DEC	DE
	LD	A,E
	OR	A,A
	JR	NZ,RAMDUMP
	OR	A,D
	JR	NZ,RAMDUMP	;Have we sent DE bytes yet
DONECR:	EXX			;We are done
	CALL	FRCINT		;Need to clear the 1791/5 because we may have 
;				;overrun reading the track
DONE_DUMP:	
	XOR	A,A		
	LD	(TRK),A
	CALL	HOME1		;Move head back to Track 0
	LD	A,(CMD_STORE)	;So we dont pick up other menu items
	RET			;Back to main menu	
;
;
;
;**************** DISK FORMAT ROUTINE ***************************
;
FORMAT_DISK:
	LD	(IX_OLD_STORE),IX	;Also store current disk paramater table

	CALL	GET_DRIVE_FORM		;Select new format from a table return with IX to it
	JR	Z,ERRORY

	LD	HL,FORMATTING_MSG
	CALL	PMSG
	LD	(IX_NEW_STORE),IX	;Will return with this [IX] pointer if format is OK

	CALL	FORM_DISK		;<<<<< Main Format Routine >>>>>>>

	JR	NZ,ERRORX
	LD	HL,END_FORM_MSG
	CALL	PMSG
	LD	HL,TRACK_SIZE
	LD	A,(HL)			;Fill in total byte count of a track
	CALL	PACC			;Is useful for building tables and track disply
	INC	HL			;was obtained in WRITE_1_TRACK below
	LD	A,(HL)
	CALL	PACC
	LD	HL,END_FORM1_MSG
	CALL	PMSG
	LD	IX,(IX_NEW_STORE)	;Get the new format IX pointer
	LD	A,(CMD_STORE)		;So we dont pick up other menu menu items on
	RET				;return back to MENU

ERRORX:	LD	HL,FORM_ERRMSG		;Say error formatting disk
	CALL	PMSG
ERRORY:	LD	IX,(IX_OLD_STORE)
	LD	A,(CMD_STORE)		;So we dont pick up other menu menu items on
	RET				;return back to MENU
;
;
;
; This routine will format a 5" or 8" disk using info from (IX+HW_BYTE) 
; It will update IX with new pointer values.
;
FORM_DISK:
	PUSH	IX

	LD	HL,FBUFFER	;Will build the complete sector image here
	LD	(TADDR),HL	;Store the pointer here.

	XOR	A,A		;Setup for the BIOS below
	LD	(TRK),A		;Start with track 0 
	LD	(SIDE),A	;Start on Side A 
	INC	A
	LD	(SCTR),A	;Start at sector 1 

	CALL	DRVSET		;Select the drive in hardware
	CALL	HOME1		
	CALL	NZ,SHOW_ERRORS	;print out errors if any

	XOR	A,A		;Store current track number
IDSET:	LD	(TRK),A		;store track info for eack loop
	
	CALL	BUILD_TRACK	;Build a complete track image in RAM

	CALL	SHOW_SEC_INFO	;Display the track if detailed info is on
	
	LD	A,(TRK)		;Get new track#
	CALL	SEEK_TRACK_NV	;Seek with verify command to 1791/5
	CALL	NZ,SHOW_ERRORS	;If any show error flags

	CALL	WRITE_1_TRACK	;<<<<<< Hardware write track >>>>>>>>

	CALL	CHECKABORT	;SP will halt, ESC will abort
	JR	NZ,FINISH1
AGAIN:	LD	A,(TRK)		;what was the track numbere just done
	INC	A
	CP	A,(IX+NTRKS)	;Check if we are on the last tarck
	JR	NZ,IDSET	;If not then back to updating tracks and doing it again.
FINISH:	POP	IX
	RET
;
FINISH1:LD	A,(CRTDISP)	;If detailed CRT display is on then one ESC 
	OR	A,A		;will switch it off
	JP	Z,FINISH	;If Z do not list the sector contents.
	XOR	A,A		;Just turn it off. Next time a real abort.
	LD	(CRTDISP),A
	JR	AGAIN
;
;
;---------------- BUILD TRACK IMAGE IN RAM ------------------------
; Assumes	IX points to the table or relevent Disk paramaters and
;		(TADDR) points to the buffer in RAM to build the track
;
BUILD_TRACK:
	LD	HL,(TADDR)	;This will be FBUFFER where track ins built in RAM
	BIT	6,(IX+HW_BYTE)	;Will build a different track image for SD or DD disks
	JP	NZ,DD_TRACK	;Seperate sector image for DD tracks
	
	CALL	SD_TRK_HEADER		;Drop in header and Index mark BEFORE first sector
	
	LD	D,1			;Start with sector 1
	LD	E,(IX+NSCTRS)		;Total Sectors/side
NEXT_SEC:
	CALL	SD_BUILD_SEC		;<<< Build a sector >>>>>
	INC	D			;Next sector
	DEC	E
	JR	NZ,NEXT_SEC		;All sectors ari in RAM
	
	CALL	SD_TRK_END		;Now need to flush out track to end
	RET
;
;
SD_TRK_HEADER:				;Lay down the track header before the 1st sector
	LD	A,(IX+GAP_FILL_CHAR)	;Do not alter [D] or [E]
	LD	B,40			;Header has 40 (FF's)
	CALL	DROP			;drop it at the end of the growing image (Count in B)
	XOR	A,A			;Now 6 0's
	LD	B,6
	CALL	DROP
	LD	A,0FCH			;Index ID mark
	LD	(HL),A			;drop into image
	INC	HL
	LD	A,(IX+GAP_FILL_CHAR)	;Now 26 (FF's)
	LD	B,26			;Header has the count of fill characters required
	CALL	DROP			;drop it at the end of the growing image (Count in B)
	LD	(INDEX_MARK),HL		;pointer+1 to end of track header
	RET				;return with [HL] pointing to first sector byte
;
SD_BUILD_SEC:			;Lay down a sector at current [HL]. Do not alter [D] or [E]
	XOR	A,A
	LD	B,(IX+GAP1)	;(6,0's)
	CALL	DROP
	LD	A,0FEH		;Sector ID Address mark
	LD	(HL),A		;drop it in the growing image
	INC	HL
	LD	A,(TRK)		;Drop in the track #
	LD	(HL),A
	INC	HL
	XOR	A,A		;Side# 0 for now+++++++++++++++
	LD	(HL),A
	INC	HL
	LD	(HL),D		;Drop in sector #
	INC	HL
	LD	A,(IX+SIZE)	;128=0,256=1,512=2, 1024=3
	LD	(HL),A		;drop in sector length byte
	INC	HL	
	LD	A,0F7H		;Dropping in a 0F7 will cause the 179x 	
	LD	(HL),A		;to write in the 2 CRC bytes
	INC	HL
	LD	A,(IX+GAP_FILL_CHAR)
	LD	B,(IX+GAP2)	;(11,FF's)
	CALL	DROP
	XOR	A,A
	LD	B,(IX+GAP1)	;(6,0's)
	CALL	DROP
	LD	A,0FBH		;Data address mark for 1791/5 	
	LD	(HL),A		;to write in the 2 CRC bytes
	INC	HL
	LD	A,D
	CP	A,1		;If first sector then store data marker
	JR	NZ,SDATA_FIELD 
	LD	(S_DATA_MARK),HL	;Pointer to start of sector data area
SDATA_FIELD:			;Now write in the sector data field itself
	LD	A,(IX+SIZE)	;128,256,512 or 1024 byte sector size
	LD	B,NBYTES
	LD	C,1		;1 loop of 128 bytes in WR_DATA_FIELD below
	OR	A,A
	JR	Z,SD_DATA_FIELD	;Do 128 byte write (B=128)
	LD	B,0		;Need 256 bytes for the rest of possible sectors
	LD	C,1		;One loop
	CP	A,1
	JR	Z,SD_DATA_FIELD	;Do 256 byte write
	LD	C,2		;2 loops of 256 bytes in WRITE_DATA_FIELD
	CP	A,2
	JR	Z,SD_DATA_FIELD	;Do 512 byte read
	LD	C,4		;(must be 3) so 1024 byte sector
SD_DATA_FIELD:
	LD	A,(IX+DATA_FILL_CHAR)	;get the sector fill character (usually E5)
SDF0:	CALL	DROP
	DEC	C
	JR	NZ,SDF0			;Decrese [C] to 0
	LD	A,D
	CP	A,1			;If first sector then store image mark 
	JR	NZ,NOT_FIRST
	LD	(E_DATA_MARK),HL	;For first sector will  diaplay data late
NOT_FIRST:
	LD	A,0F7H			;Dropping in a 0F7 will cause the 1791/5 
	LD	(HL),A			;to write in the 2 CRC bytes
	INC	HL
	LD	A,(IX+GAP_FILL_CHAR)
	LD	B,(IX+GAP3)		;(27,FF's)
	CALL	DROP
	LD	A,D
	CP	A,1			;If first sector then store image mark 
	RET	NZ
	LD	(E_SEC_MARK),HL		;For first sector will diaplay data later
	RET
;
SD_TRK_END
	LD	(S_GAP4_MARK),HL	;Mark beginning of end of track field (GAP4)
	LD	A,(IX+GAP_FILL_CHAR)
	LD	B,(IX+GAP4)		;247,FF's for IBM, >256 for DD's
	LD	C,(IX+GAP4R)		;Times to repeat DROP
SD_TRK1:CALL	DROP
	DEC	C
	JR	NZ,SD_TRK1
	LD	(E_GAP4_MARK),HL	;Mark end of Track
	RET
;
DROP:	LD	(HL),A		;DATA block loader
	INC	HL		;B= byte count,HL pointer
	DJNZ	DROP		;A = value to drop into image. Count in B
	RET
;
;
DD_TRACK:LD	HL,(CODE_NOT_DONE)
	CALL	PMSG
	HALT

;
;--------------------- ACTUAL DISK TRACK WRITE ROUTINE ----------------
; FBUFFER beginning of track image
; 
WRITE_1_TRACK:	
	LD	DE,FBUFFER		;Move Start of track image into DE
	PUSH	DE			;save it
	LD	HL,(E_GAP4_MARK)	;End+1 of track header
	DEC	HL
	SBC	HL,DE
	EX	DE,HL			;Count now in DE
	LD	HL,TRACK_SIZE		;Side step, need to store track byte count
	LD	(HL),D			;For display at end of format etc.
	INC	HL
	LD	(HL),E
	POP	HL			;DE on stack to --> HL

	CALL	WRITE_TRACK		;Write track with hardware
	CALL	NZ,SHOW_ERRORS
	RET
;
;==============================================================================
;================== 1791/5 COMMAND ROUTINES ===================================
;==============================================================================
;
; SEND A RESTORE COMMAND FOR THE CURRENT DISK. 
; On return: Z if no errors. NZ if errors with errors in (ERSTAT)and [A]
; Note (TRK) is NOT set to 0 & (IX+HW_BYTE) SIDE_BIT (7) is not changed
;
HOME1:	LD	A,HOME_ERR_MASK		;Error mask for Type I RESTORE CMD
	LD	(ERMASK),A		;Save error mask for end/error routine
	IN	A,(STATUS)
	AND	A,1
	JR	NZ,HOME1		;Wait until 1791/5 is ready
	CALL	WAIT_OFF		;Disable Wait State Hardware (just in case it is on)
	LD	A,(IX+RSCMD)
	LD	(CHIP_CMDSV),A		;Store it in case error flags are to be shown
	OUT	(CMD),A
	JP	END_ROUTINE		;Wait, check status and return
;
;
; Seek with track WITH verify. Assumes valid track in (TRK)
; On return: Z if no errors. NZ if errors, (ERSTAT)and [A] has errors 
;
SEEK_TRACK_V:
	LD	A,SK_ERR_MASK		;Error mask for Type I Seek CMD
	LD	(ERMASK),A		;Save error mask for end/error routine
	LD	A,(IX+SKCMD)		;Send seek (with verify) CMD
	LD	(CHIP_CMDSV),A		;Store it in case error flags are to be shown
	JR	SEEK_TRK
;
;
; Seek track with NO verify. Assumes valid track in (TRK)
; On return: Z if no errors. NZ if errors, (ERSTAT)and [A] has errors 
;
SEEK_TRACK_NV:	
	LD	A,SK_ERR_MASK		;Error mask for Type I Seek CMD
	LD	(ERMASK),A		;Save error mask for end/error routine
	LD	A,(IX+SKNCMD)		;Send seek CMD ((with NO verify)
	LD	(CHIP_CMDSV),A		;Store it in case error flags are to be shown

SEEK_TRK:
	IN	A,(STATUS)
	AND	A,1
	JR	NZ,SEEK_TRK		;wait until 1791/5 is ready
	CALL	WAIT_OFF		;Disable Wait State Hardware (in case it was on)
	LD	A,(TRK)			;Send required track to 1791/5
	OUT	(DATA),A
	LD	A,(CHIP_CMDSV)		;Was it a seek or seek_nv
	OUT	(CMD),A			
	JP	END_ROUTINE		;Wait, check status and return
;
;
;
; Read an ID from the track. Assumes valid track in (TRK) 
; Note any Sector ID from the track will be obtained depending where the head falls
; The currently selected side at (SIDE) is read
;
READ_ID:LD	A,ID_ERR_MASK
	LD	(ERMASK),A		;Store for error display
RDSC_1:	IN	A,(STATUS)
	AND	A,1
	JR	NZ,RDSC_1		;wait until 1791/5 is ready
	LD	HL,IDSV			;Will store the 6 bytes here
	LD	BC,600H+DATA		;6 bytes in B, Data port in C below
	CALL	WAIT_ON			;Enable hardware wait states
	LD	A,RDACMD		;Send the Read Track ID CMD
	LD	(CHIP_CMDSV),A		;Store it in case error flags are to be shown
	DI				;Just in case
	OUT	(CMD),A
	JR	MM2			;Slight delay
MM2:	JR	MM3
MM3:	INIR				;Block input 6 bytes
	EI
	JP	END_ROUTINE		;Wait, turn off wait hware, check status and return
;	
;
;
;
; CORE SECTOR READ ROUTINE. Assumes valid track in (TRK) & (SEC) 
; Address in (TADDR). The currently selected side at (SIDE) is setup
;
READ_SECTOR:
	LD	A,RS_ERR_MASK	;Error mask from 1791/5 after read is done
	LD	(ERMASK),A
	LD	A,RETRY_MAX	;In case of errors will retry reading sector 
	LD	(SEC_RT_COUNT),A	;a few times
AGAIN_RD:
	LD	HL,(TADDR)	;Deposit sector info here
	LD	A,(SCTR)
	OUT	(SECTOR),A
	LD	C,DATA		;C = DATA port for INIR below
	CALL	WAIT_ON
	LD	A,RDCMD		;Read sector command to 1791/5
	LD	(CHIP_CMDSV),A	;store cmd here for Error display (if any)
	DI
	OUT	(CMD),A
	LD	A,(IX+SIZE)	;128=0,256=1,512=2 or 1024=3 byte sector size
	LD	B,NBYTES
	OR	A,A		;Block input [B] Bytes->[HL] from port [C]
	JR	Z,R128256	;Do 128 byte read
	LD	B,0
	CP	A,1
	JR	Z,R128256	;Do 256 byte read
	CP	A,2
	JR	Z,R512		;Do 512 byte read
	INIR			;Must be 1024 byte sectors so 4X256		
	INIR
R512:	INIR			;256X2 bytes
R128256:INIR			;128 or 256 bytes (B=128 or 0)
	EI
	CALL	END_ROUTINE	;Wait, turn off wait hware, check status and return
	RET	Z		;RET Z if all is OK
				;Read failed. Do we retry again
	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	Z,MM6
	LD	HL,SEC_READ_RETRY     ;'Re-reading SECTOR XXH.'
	CALL	PMSG
	LD	A,(SCTR)
	CALL	PACC
	LD	HL,HEADX_MSG
	CALL	PMSG
MM6:	LD	A,(SEC_RT_COUNT)
	DEC	A			;Retrys 4,3 2,1... Will reseek on 3rd re-read try
	LD	(SEC_RT_COUNT),A
	JR	Z,BAD_RD
	CP	A,2
	JR	NZ,AGAIN_RD		;Try re-reading the sector
	LD	A,(CRTDISP)		;Check if detailed display flag is on
	OR	A,A
	JR	Z,MM7B
	LD	HL,SEC_RH_RETRY		;'Re-Seeking head for re-reading SECTOR XXH.'
	CALL	PMSG
	LD	A,(SCTR)
	CALL	PACC
	LD	HL,HEADX_MSG
	CALL	PMSG
MM7B:
	LD	A,(TRK)		;If it failed a second time, home, reseek and try again
	CALL	HOME1		;Restore to track 0 (Note assumes TRK is unchanged in HOME1)
	CALL	SEEK_TRACK_V	;Re-seek to track
	JP	AGAIN_RD
BAD_RD	XOR	A,A
	DEC	A		;Set to NZ
	LD	A,(ERSTAT)
	RET	
;
;
; Read Track. Assumes head is over relevent track in (TRK)
; Will place data at (TADDR)
; The currently selected side at (SIDE) is read
; The total size of a  track in bytes is in [DE]

READ_TRACK:
	LD	A,RT_ERR_MASK		;Setup for error checking
	LD	(ERMASK),A
	LD	(BYTE_COUNT),DE		;In case we have to repeat the track read
	LD	A,RETRY_MAX		;In case of errors will retry reading track 
	LD	(TRK_RT_COUNT),A	;a few times
AGAIN_TK:
	LD	HL,(TADDR)
	LD	DE,(BYTE_COUNT)
	LD	A,(TRK)
	OUT	(TRACK),A
	CALL	WAIT_ON			;Turn on VII board wait state hardware
	LD	A,RDTCMD		;setup for 179x read track command
	LD	(CHIP_CMDSV),A		;Store it in case error flags are to be shown
	DI				;Disable Interrupts
	OUT	(CMD),A			;send it to the 179x CMD port
	JR	MM7			;Slight delay
MM7:	JR	R_LOOP

R_LOOP:	IN	A,(DATA)	;Get all track bytes
	LD	(HL),A
	INC	HL
	DEC	DE
	LD	A,E
	OR	A,A
	JR	NZ,R_LOOP
	OR	A,D
	JR	NZ,R_LOOP	;Have we sent DE bytes yet
	EI
	CALL	END_ROUTINE	;Wait, turn off wait hware, check status and return
	RET	Z		;RET Z if all is OK
				;Read ID failed. Do we retry again
	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	Z,MM9
	LD	HL,TRK_READ_RETRY ;'ERROR. Will try re-reading TRACK XXH.'
	CALL	PMSG
	LD	A,(TRK)
	CALL	PACC
	LD	HL,HEADX_MSG
	CALL	PMSG
MM9:	LD	A,(TRK_RT_COUNT)
	DEC	A
	LD	(TRK_RT_COUNT),A
	JR	NZ,AGAIN_TK
	XOR	A,A
	DEC	A		;Set to NZ
	LD	A,(ERSTAT)
	RET	
;
;
; CORE SECTOR WRITE ROUTINE. Assumes valid track in (TRK) & (SEC) 
; Address in (TADDR). The currently selected side at (SIDE) is setup
;
WRITE_SECTOR:
	LD	A,WS_ERR_MASK	;Error mask from 1791/5 after read is done
	LD	(ERMASK),A
	LD	A,RETRY_MAX	;In case of errors will retry reading sector 
	LD	(SEC_RT_COUNT),A	;a few times
AGAIN_WR:
	LD	HL,(TADDR)	;Deposit sector info here
	LD	A,(SCTR)
	OUT	(SECTOR),A
	LD	C,DATA		;C = DATA port for OTIR below
	CALL	WAIT_ON
	LD	A,WRCMD		;Read sector command to 1791/5
	LD	(CHIP_CMDSV),A	;store cmd here for Error display (if any)
	DI
	OUT	(CMD),A
	LD	A,(IX+SIZE)	;128=0,256=1,512=2 or 1024=3 byte sector size
	LD	B,NBYTES
	OR	A,A		;Block input [B] Bytes->[HL] from port [C]
	JR	Z,W128256	;Do 128 byte read
	LD	B,0
	CP	A,1
	JR	Z,W128256	;Do 256 byte read
	CP	A,2
	JR	Z,W512		;Do 512 byte read
	OTIR			;Must be 1024 byte sectors so 4X256		
	OTIR
W512:	OTIR			;256X2 bytes
W128256:OTIR			;128 or 256 bytes (B=128 or 0)
	EI
	CALL	END_ROUTINE	;Wait, turn off wait hware, check status and return
	RET	Z		;RET Z if all is OK
				;Read failed. Do we retry again
	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	Z,MM6W
	LD	HL,SEC_WR_RETRY  ;'Re-writing SECTOR XXH.'
	CALL	PMSG
	LD	A,(SCTR)
	CALL	PACC
	LD	HL,HEADX_MSG
	CALL	PMSG
MM6W:	LD	A,(SEC_RT_COUNT)
	DEC	A			;Retrys 4,3 2,1... Will reseek on 3rd re-read try
	LD	(SEC_RT_COUNT),A
	JR	Z,BAD_WR
	CP	A,2
	JR	NZ,AGAIN_WR		;Try re-reading the sector
	LD	A,(CRTDISP)		;Check if detailed display flag is on
	OR	A,A
	JR	Z,MM7W
	LD	HL,SEC_WH_RETRY		;'Re-Seeking head for re-reading SECTOR XXH.'
	CALL	PMSG
	LD	A,(SCTR)
	CALL	PACC
	LD	HL,HEADX_MSG
	CALL	PMSG
MM7W:
	LD	A,(TRK)		;If it failed a second time, home, reseek and try again
	CALL	HOME1		;Restore to track 0 (Note assumes TRK is unchanged in HOME1)
	CALL	SEEK_TRACK_V	;Re-seek to track
	JP	AGAIN_RD
BAD_WR	XOR	A,A
	DEC	A		;Set to NZ
	LD	A,(ERSTAT)
	RET	
;
;
;	
; Write Track. Assumes head is over relevent track in (TRK)
; WTrack data at (TADDR)
; The currently selected side at (SIDE) is written to
; The total size of a track in bytes is in [DE]

WRITE_TRACK:
	LD	A,WT_ERR_MASK		;Setup for error checking
	LD	(ERMASK),A
	LD	A,RETRY_MAX		;In case of errors will retry reading track 
	LD	(TRK_RT_COUNT),A	;a few times
	LD	(BYTE_COUNT),DE		;In case we have to repeat the track write

AGAIN_WTK:
	LD	HL,(TADDR)
	LD	DE,(BYTE_COUNT)
	LD	A,(TRK)
	OUT	(TRACK),A
	CALL	WAIT_ON			;Turn on VII board wait state hardware
	LD	A,WRTCMD		;setup for 179x WRITE track command
	LD	(CHIP_CMDSV),A		;Store it in case error flags are to be shown
	DI				;Disable Interrupts
	OUT	(CMD),A			;send it to the 179x CMD port
	JR	MMA			;Slight delay
MMA:	JR	W_LOOP

W_LOOP:	LD	A,(HL)
	OUT	(DATA),A		;Send all track bytes
	INC	HL
	DEC	DE
	LD	A,E
	OR	A,A
	JR	NZ,W_LOOP
	OR	A,D
	JR	NZ,W_LOOP	;Have we sent DE bytes yet
	EI
	CALL	END_ROUTINE	;Wait,  turn off wait hware, check status and return
	RET	Z		;RET Z if all is OK
				;Read failed. Do we retry again
	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	Z,MMC
	LD	HL,TRK_WR_RETRY ;'ERROR. Will try re-writing TRACK XXH.'
	CALL	PMSG
	LD	A,(TRK)
	CALL	PACC
	LD	HL,HEADX_MSG
	CALL	PMSG
MMC:	LD	A,(TRK_RT_COUNT);How many times so far
	DEC	A
	LD	(TRK_RT_COUNT),A
	JR	NZ,AGAIN_WTK
	XOR	A,A
	DEC	A		;Set to NZ
	LD	A,(ERSTAT)
	RET	
;
;
;
; END Routine comes after each command is completed. It waits for the 1791/5 chip to time out
; then switches off the wait state generator and checks for errors. 
; Returns Z if no errors, otherewise NZ with error in (ERSTAT)
;
END_ROUTINE:
	CALL	DELAY		;Delay for hardware
ENDR2:	IN	A,(STATUS)	;Wait until chip is not busy
	AND	A,1
	JR	NZ,ENDR2
	CALL	WAIT_OFF	;Disable Hardware wait states
	IN	A,(STATUS)	;(May already be off anyway for Seeks etc)
	LD	D,A
	LD	A,(ERMASK)	;Error mask was stored here
	AND	A,D
	LD	(ERSTAT),A	;Save error status for error routine
	RET	Z		;RET Z if all is OK
	XOR	A,A
	DEC	A		;Set to NZ
	LD	A,(ERSTAT)
	RET	
;
;
;
;
; SELECT DRIVE SELECT IN HARDWARE 
; (IX+HW_BYTE) points to relevent drive selection, density and requested
; side(s) info for this current disk.
;
DRVSET:
	LD	A,(IX+HW_BYTE)	;and in the density,side and size bits
	AND	A,0E0H		;Remove the side bit (11100000)
	LD	C,A		;store in C
	LD	A,(IX+HW_BYTE)	;Get hardware selection again
	AND	03		;Strip to drive selection (A,B,C or D)
	LD	B,A		;Drive number in B
	LD	A,1
	JR	Z,DRVSEL  
CKDRV1:	RLCA			;Shift bits for hardware
	DJNZ	CKDRV1  
DRVSEL:	OR	A,C		;Combine Drive select Bits with density and size bits
	AND	7FH		;Remove the current side bit flag (01111111)
	CPL			;Hardware is inverted
	OUT	(SELECT),A	;select drive
	CALL	DELAY
RDYCK:	IN	A,(STATUS)	;Drive select delay
	AND	80H
	JP	NZ,RDYCK
	RET
;
;
;
; Set side for sector R/W if different than previously
; New side is 0 in (SIDE) if A side, 80H in (SIDE) if B side.
; No registers are altered. Note Hardware is updated here!
;
SET_SIDE:
	LD	A,(IX+HW_BYTE)	;Get current side info
	BIT	4,A		;Is it a 1 or 2 sided disk
	RET	Z		;Return if single sided
	OR	A,80H		;Isolate the current side bit flag (7)
	JR	NZ,OLD_IS_B
	LD	A,(SIDE)	;Get new side
	OR	A,A		;Is new side also A
	RET	Z		;if so simply return
	IN	A,(SELECT)	;get hardware selection
	RES	4,A		;Note hardware is inverted
	OUT	(SELECT),A	;Select side B in hardware
	SET	7,(IX+HW_BYTE)	;Set new current side to B
	JR	DONE_SET_SIDES
OLD_IS_B:
	LD	A,(SIDE)	;Get new side
	CP	A,80H		;Is new side also B
	RET	Z		;if so simply return
	IN	A,(SELECT)	;get hardware selection
	SET	4,A		;Note hardware is inverted
	OUT	(SELECT),A	;Select side A in hardware
	RES	7,(IX+HW_BYTE)	;Set new current side to A
DONE_SET_SIDES:
	PUSH	BC
	LD	B,256		;Slight delay for hardware
DELYS:	DJNZ	DELYS
	POP	BC
	RET
;
;
; Delay for drive select hardware. Different for 8" and 5" drives
;
DELAY:	BIT	5,(IX+HW_BYTE)	;8" or 5"
	LD	A,39
	JR	Z,DELAY1  
	LD	A,60
DELAY1:	LD	B,0
M0:	DJNZ	M0
	DEC	A
	JR	NZ,DELAY1  
	RET
;	
;
; Turn on or off the hardware wait state generator. This hardware stops and starts the CPU
; as bytes are read/written to the 179x/Disk
;
;	DISABLE WAIT STATES
WAIT_OFF:
	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	Z,WAIT_1
	PUSH	HL
	PUSH	BC
	LD	HL,WAIT_OFF_MSG
	CALL	PMSG
	POP	BC
	POP	HL
WAIT_1	IN	A,(SELECT)
	OR	80H
	OUT	(SELECT),A
	RET
;
;	ENABLE WAIT STATES
WAIT_ON:
	LD	A,(CRTDISP)	;Check if detailed display flag is on
	OR	A,A
	JR	Z,WAIT_2
	PUSH	HL
	PUSH	BC
	LD	HL,WAIT_ON_MSG
	CALL	PMSG
	POP	BC
	POP	HL
WAIT_2	IN	A,(SELECT)
	AND	7FH
	OUT	(SELECT),A
	RET
;
;
;	FORCE CHIP INTERUPT
FRCINT:	LD	A,0D0H
	OUT	(CMD),A
	LD	A,10
FRC1:	DEC	A
	JR	NZ,FRC1
	IN	A,(STATUS)
	RET
;
;
;
; General routine to print out the error status returned by the 1791/5 chip
; after seeks, sector reads etc.
;
SHOW_ERRORS:
	LD	A,(CHIP_CMDSV)	;What was the last command to the chip
	CP	A,RDCMD		;Was it a read sector CMD?
	JR	NZ,NOT_RDCMD
	LD	HL,SEC_READ_ERROR 
	JR	DONE_ERRS
NOT_RDCMD:
	CP	A,(IX+SKNCMD)	;Was it a seek no verify cmd (8" & 5" different)
	JR	NZ,NOT_SKNCMD
	LD	HL,SEEKNV_ERROR
	JR	DONE_ERRS
NOT_SKNCMD:
	CP	A,(IX+RSCMD)	;Was it a restore CMD (8" & 5" different)
	JR	NZ,NOT_RSCMD
	LD	HL,RSCMD_ERROR
	JR	DONE_ERRS
NOT_RSCMD:
	CP	A,RDACMD	;Was it a read track address command
	JR	NZ,NOT_RDACMD
	LD	HL,SEC_ID_ERROR
	JR	DONE_ERRS
NOT_RDACMD:
	CP	A,(IX+SKCMD)	;Was it seek cmd with verify
	JR	NZ,NOT_SKCMD
	LD	HL,SKCMD_ERROR
	JR	DONE_ERRS
NOT_SKCMD:
	CP	A,RDTCMD	;Was it a read track command
	JR	NZ,NOT_RDTCMD
	LD	HL,RDTCMD_ERROR
	JR	DONE_ERRS
NOT_RDTCMD:
	CP	A,WRTCMD	;Was it a write track cmd
	JR	NZ,NOT_WRTCMD
	LD	HL,WRTCMD_ERROR
	JR	DONE_ERRS
NOT_WRTCMD:
	CP	A,WRCMD		;Was it a sector write cmd
	JR	NZ,NOT_WRCMD
	LD	HL,WRCMD_ERROR
	JR	DONE_ERRS
NOT_WRCMD:
	LD	HL,UNKNOWN_ERROR
DONE_ERRS:
	CALL	PMSG
	LD	A,(ERSTAT)
	CALL	ZBITS		;Drop in bit pattern
	LD	HL,CLOSE_BRACKET
	CALL	PMSG
	RET
;
;
; This routine simply checks the written and re-read sectors in memory are the same.
; Z if all OK. NZ, if error(s)
;
COMPARE_BUFFERS:
	LD	HL,FBUFFER
	LD	DE,FBUFFER2
	LD	C,0		;Will flag errors
	LD	A,(IX+SIZE)	;128=0,256=1,512=2 or 1024=3 byte sector size
	LD	B,NBYTES
	OR	A,A		;Block size count
	JR	Z,C128256	;Do 128 byte compare
	LD	B,0
	CP	A,1
	JR	Z,C128256	;Do 256 byte read
	CP	A,2
	JR	Z,C512		;Do 512 byte read
	CALL	CHECK_BLOCK	;Must be 1024 byte sectors so 4X256		
	CALL	CHECK_BLOCK
C512:	CALL	CHECK_BLOCK	;256X2 bytes
C128256:CALL	CHECK_BLOCK
	XOR	A,A
	CP	A,C
	RET	
CHECK_BLOCK:
	LD	A,(DE)
	CP	A,(HL)		;Do they match
	CALL	NZ,MIS_MATCH
	INC	HL
	INC	DE
	DJNZ	CHECK_BLOCK	;Decrease count
	RET
MIS_MATCH:
	LD	C,1		:Flag for error
	RET	
;
;------------------ SUPPORT ROUTINES -----------------------------------
;
PMSG:	LD	A,(HL)		;PRINT MESSAGE STRING in [HL] up to 0
	OR	A
	RET	Z
	LD	C,A
	CALL	CO
	INC	HL
	JP	PMSG
;
GETCMD:	CALL	CI		;GET A CHARACTER, convert to UC, ECHO it
	CALL	UCASE
	CP	A,ESC
	RET	Z		;Don't echo an ESC
	PUSH	AF		;Save it
	PUSH	BC
	LD	C,A
	CALL	CO		;Echo it
	POP	BC
	POP	AF		;get it back
	RET

ZCRLF:	PUSH	AF		;Send CR/LF to CRT
	PUSH	BC
	LD	C,CR
	CALL	CO
	LD	C,LF
	CALL	CO
	POP	BC
	POP	AF
	RET
;				;Convert LC to UC
UCASE:	CP	A,'a'		;must be >= lowercase a
	RET	C		; else go back...
	CP	A,'z'+1		;must be <= lowercase z
	RET	NC		; else go back...
	SUB	A,'a'-'A'	;subtract lowercase bias
	RET
;
;
; Return with 2 HEX digits in [A]. If abort, Carry flag set + ESC in [A]
GET_HEX:
	PUSH	BC			
	CALL	GETCMD		;Get a character from keyboard & ECHO
	CP	A,ESC
	JR	Z,HEX_ABORT
	CP	'/'		;check 0-9, A-F
	JR	C,HEX_ABORT
	CP	'F'+1
	JR	NC,HEX_ABORT
	CALL	ASBIN		;Convert to binary
	SLA	A
	SLA	A
	SLA	A
	SLA	A		;Shift to high nibble	
	LD	B,A		;Store it
	CALL	GETCMD		;Get 2nd character from keyboard & ECHO
	CP	A,ESC
	JR	Z,HEX_ABORT
	CP	'/'		;check 0-9, A-F
	JR	C,HEX_ABORT
	CP	'F'+1
	JR	NC,HEX_ABORT
	CALL	ASBIN		;Convert to binary
	OR	A,B		;add in the first digit
	OR	A,A		;To return NC
	POP	BC
	RET
HEX_ABORT:
	SCF			;Set Carry flag 
	LD	A,ESC
	POP	BC
	RET
;
;
;
;
; ASCII TO BINARY CONVERSION ROUTINE
ASBIN:	SUB	30H 
	CP	0AH 
	RET	M
	SUB	07H 
	RET

;Print the acccumulator value on CRT in HEX-ASCII
PACC:	PUSH	AF
	PUSH	BC
	PUSH	AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL	ZCONV
	POP	AF
	CALL	ZCONV
	POP	BC
	POP	AF
	RET

ZCONV:	AND	A,0FH		;HEX to ASCII
	ADD	90H
	DAA
	ADC	40H
	DAA
	LD	C,A
	CALL	CO
	RET
;
;DISPLAY BIT PATTERN IN [A]
;
ZBITS:	PUSH	AF
	PUSH	BC
	PUSH	DE
	LD	E,A		
	LD	B,8
BQ2:	SLA	E
	LD	A,18H
	ADC	A
	LD	C,A
	CALL	CO
	DJNZ	BQ2
	POP	DE
	POP	BC
	POP	AF
	RET
;
;
; CHECK IF AN ABORT (ESC) CHARACTER IS PRESENT AT THE CONSOL
; HOLD EVERYTHING IF SPACEBAR IS PRESSED
;
CHECKABORT:			;see if an abort is required
	CALL	CONST
	RET	Z	
CHECK1:	CALL	CI
	CP	A,ESC		;ESC to abort
	JR	Z,CABORT
	CP	A,' '		;If spacebar then freeze CRT display
	JR	Z,CHECK1
	XOR	A,A
	RET
CABORT:	XOR	A,A		;Was ESC, so return with NZ flag
	DEC	A		;return NZ, & 0FFH in A if ESC there
	RET
;
;
;------ Find out a drives format ----------------------
;	Return	ESC in [A] if Abort and Z flag set 
;		0 in [A] if no selection, Z flag set
;		[IX] updated to (if formatting NEW) Drive paramater table
;		and NZ flag set
;
GET_DRIVE_FORM
	LD	IY,DRIVE	;Get current hardware drive select pointer
	BIT	5,(IX+HW_BYTE)	;See if current selected disk is 5" or 8"
	JP	NZ,GET_TABLE_5	;Is 5" disk
	JP	GET_TABLE_8	;Setup IX to (new) table parameters
;
;
;------ Find out which drive will be examined and its type ----------------------
;	Return	ESC in [A] if Abort and Z flag set 
;		0 in [A] if no selection, Z flag set
;		[IX] to Drive paramater table
;		and NZ flag set
;
GET_DRIVE_TYPE:
	LD	HL,GETDRV_MSG	;Ask which drive is the current drive
	CALL	PMSG
	CALL	GETCMD		;get the input option
	CP	A,ESC		;Abort if ESC character
	JP	Z,ABORT_CMD
	LD	(DRIVE_LETTER),A
	LD	IY,DRIVE	;will store drive selection here (as well)
				;useful for monitor debugging.
	CP	A,'A'		;Find out which drive we will be working on
	LD	(IY+0),0	;0 for hardware if A: drive
	JR	Z,GET_SIZE
	CP	A,'B'
	LD	(IY+0),1	;1 if B:
	JR	Z,GET_SIZE
	CP	A,'C'
	LD	(IY+0),2	;2 if C:
	JR	Z,GET_SIZE
	CP	A,'D'
	LD	(IY+0),3	;3 if D:
	JR	Z,GET_SIZE
	LD	HL,XXXDRV	;Invalid drive selection
	CALL	PMSG
	LD	A,'?'
	LD	(DRIVE_LETTER),A
	XOR	A,A		;Z Flag to indicate no selection
	RET

GET_SIZE:
	LD	HL,GETSIZE_MSG	;Ask if 5" or 8"
	CALL	PMSG
	CALL	GETCMD		;get the input option
	CP	A,ESC		;Abort if ESC character
	JP	Z,ABORT_CMD
	CP	A,'5'
	JR	Z,GET_TABLE_5
	CP	A,'8'
	JR	Z,GET_TABLE_8
BAD_CMD:LD	HL,BADCMD
	CALL	PMSG
	XOR	A,A			;Z Flag to indicate no selection
	RET
ABORT_CMD:
	XOR	A,A			;Abort with z flag but ESC in A
	LD	A,ESC
	RET

GET_TABLE_8:
	LD	HL,DISK_8_FORMATS	;Pointer for 8" disk table
	CALL	PMSG		
	CALL	GETCMD		;SELECT A DISK PARAMATER TABLE
	CP	A,ESC		;Abort if ESC character
	JP	Z,ABORT_CMD
	CP	A,'A'		;128 bytes/sec
	LD	IX,STDSDT	;Set to 128 byte sectors 8" SD IBM Disk
	JR	Z,GOT_DRIVE
	CP	A,'B'
	LD	IX,STDDDT	;Set to 128 byte sectors 8" DD format
	JR	Z,GOT_DRIVE	
	CP	A,'C'
	LD	IX,DDT256	;Set to 256 byte sectors IBM DDDS disk
	JR	Z,GOT_DRIVE			
	CP	A,'D'
	LD	IX,DDT1K	;Set for 1024 byte sectors 8" DD disk
	JR	Z,GOT_DRIVE	
	JP	BAD_CMD

GET_TABLE_5:
	LD	HL,DISK_5_FORMATS	;Pointer for 5" disk table
	CALL	PMSG		
	CALL	GETCMD		;SELECT A DISK PARAMATER TABLE
	CP	A,ESC		;Abort if ESC character
	JP	Z,ABORT_CMD
	CP	A,'A'
	LD	IX,MINSDT	;Set for 128 byte 5" SD disk
	JR	Z,GOT_DRIVE
	CP	A,'B'
	LD	IX,MINDDT	;Set for 128 byte 5" DD disk
	JR	Z,GOT_DRIVE
	CP	A,'C'
	LD	IX,MINCPM	;Set for 512 byte CPM-86 5" DD disk
	JR	Z,GOT_DRIVE
	JP	BAD_CMD
;
GOT_DRIVE:
	LD	C,(IY+0)	;Get HARDWARE SELECTION
	LD	A,(IX+HW_BYTE)	;Need to OR in SIZE, DENSITY, SIDES info
	OR	A,C	
	LD	(IX+HW_BYTE),A	;Bit 7 will always be 0, so side A by default
	LD	A,(DRIVE_LETTER)
	XOR	A,A		;NZ Flag to indicate a selection
	DEC	A
	RET
;
;
;-------------------------------------------------------------------------
; Describe on one line the type of disk selected
; Assumes a valid IX pointer to relevent disk table
;
SHOW_HW_TITLE:
	LD	HL,DISK_INFO		;CR,LF,'Current drive:-'
	CALL	PMSG
	PUSH	IX			;IX->HL
	POP	HL
	LD	DE,TITLE		;add in offset
	ADD	HL,DE			;HL now points to the title entry of the selected disk
	CALL	PMSG			;Show the title line
	RET
;
;--------------------------------------------------------------------------
; Decode HW_BYTE byte and print out hardware disk parameters on one line
; Assumes a valid IX pointer to relevent disk table
;
SHOW_HW_BYTE:
	LD	HL,DISK_INFO0		;CR,LF,'Drive '
	CALL	PMSG
	LD	A,(DRIVE_LETTER)	;Tell current drive letter
	LD	C,A
	CALL	CO
	LD	HL,DISK_INFO1
	CALL	PMSG
	LD	A,(IX+HW_BYTE)
	CALL	ZBITS			;Print out bit pattern in HW_BYTE of drive
	LD	HL,DISK_INFO2
	CALL	PMSG
	BIT	5,(IX+HW_BYTE)		;Say whether 8" or 5"
	JR	Z,INCH8
	LD	C,'5'
	JR	NEXT2
INCH8:	LD	C,'8'
NEXT2:	CALL	CO
	BIT	4,(IX+HW_BYTE)		;Say whether Single or Double sided disk
	JR	Z,S_SIDE
	LD	HL,DISK_INFO3
	JR	NEXT3
S_SIDE:	LD	HL,DISK_INFO4
NEXT3:	CALL	PMSG
	BIT	6,(IX+HW_BYTE)		;Say whether SD or DD disk
	JR	Z,DD_DSK
	LD	HL,DISK_INFO5
	JR	NEXT4
DD_DSK:	LD	HL,DISK_INFO6
NEXT4:	CALL	PMSG
	RET
;
;
;----------------------------------------------------------
; Display the disk paramater table pointed to by IX
;
SHOW_IX_TABLE:
	LD	HL,DISK_INFO7		;Print sectors/track
	CALL	PMSG
	LD	A,(IX+NSCTRS)
	CALL	PACC
	LD	HL,DISK_INFO8		;Print tracks/side
	CALL	PMSG
	LD	A,(IX+NTRKS)
	CALL	PACC
	LD	HL,DISK_INFO9		;Sector Size
	LD	A,(IX+SIZE)
	OR	A,A
	JR	NZ,NOT_128
	LD	HL,DISK_INFO10		;128 Bytes/sector
	JR	DONE_IX_TABLE
NOT_128:CP	1
	JR	NZ,NOT_256
	LD	HL,DISK_INFO11		;256 Bytes/Sector
	JR	DONE_IX_TABLE
NOT_256:CP	2
	JR	NZ,NOT_512
	LD	HL,DISK_INFO12		;512 Bytes/sector
	JR	DONE_IX_TABLE
NOT_512:LD	HL,DISK_INFO13		;1024 Bytes/Sector
DONE_IX_TABLE:
	CALL	PMSG
	RET
;
;----------------------------------------------------------
; Display the current track ID Field.
; NOTE this is NOT the current sector read. It's whatever sector 
; the head happens to be over at the time.
;
SHOW_ID:
	LD	HL,IDMSG0		;'Track/Side/Sec/Size/(CRC) TRACK ID field='
	CALL	PMSG
	LD	HL,IDSV			;Point to where data was saved
	LD	B,4			;4+2 bytes in ID
IDLOOP1:LD	A,(HL)
	CALL	PACC			;Print [A] in ASCII
	INC	HL
	DEC	B
	JR	NZ,IDLOOP1
	LD	C,' '
	CALL	CO
	LD	C,'('
	CALL	CO
	LD	B,2
IDLOOP5:LD	A,(HL)
	CALL	PACC			;Print CRC value
	INC	HL
	DEC	B
	JR	NZ,IDLOOP5
	LD	C,')'
	CALL	CO
	RET
;
;
; Display Bits of Versafloppy II Status Port
;
SHOW_STAT_BITS:
	LD	HL,STATUS_179x
	CALL	PMSG
	IN	A,(STATUS)
	CALL	ZBITS			;drop in bit pattern of [A]
	RET				;Will return with error in [A]
;
;
;--------------------- DISPLAY SECTOR DATA CONTENTS -------------------------
;Display the Sector read from disk to RAM location at (TADDR)
SEC_DISPLAY:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,SEC_MSG
	CALL	PMSG
	LD	HL,(TADDR)	;Move Transfer address into HL
	LD	A,(IX+SIZE)	;Get sector size
	OR	A,A
	LD	DE,NBYTES	;128 byte sectors
	JR	Z,DISP1
	CP	A,1
	LD	DE,NBYTES*2	;256 byte sectors
	JR	Z,DISP1
	CP	A,2
	LD	DE,NBYTES*4	;512 byte sectors
	JR	Z,DISP1
	LD	DE,NBYTES*8	;Must be 1024 byte sectors

DISP1:	LD	A,E
	AND	A,00111111B	;64 characters /line
	JR	NZ,NOCR
	CALL	ZCRLF
NOCR:	LD	A,(HL)
	AND	A,7FH
	CP	' ' 		;FILTER OUT CONTROL CHARACTERS'
	JR	NC,T33
T22:	LD	A,'.'
T33:	CP	A,07CH
	JR	NC,T22
	LD	C,A	
	CALL	CO
	INC	HL
	DEC	DE		;Decrease DE count by 1
	LD	A,E
	OR	A,A		;Not XX00 at least
	JR	NZ,DISP1
	OR	A,D		
	JR	NZ,DISP1	;Not 0000
	CALL	ZCRLF
NODISP:	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET
;
;------------ SHOW DETAILS OF RAW SECTOR IMAGE FOR TRACK WRITE -------------
SHOW_SEC_INFO:
	PUSH	AF		;Save everything since track formating uses all
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,FORM_TRK	;Formatting track...
	CALL	PMSG
	LD	A,(TRK)
	CALL	PACC
;;;
	BIT	4,(IX+HW_BYTE)	;Is it a 1 or 2 sided disk
	JR	Z,NO_SIDESF	;If 1 sided then skip sides info
	LD	A,(SIDE)
	OR	A,A		;If 0 we have done A side now do B
	JR	NZ,B_SIDEF	;is B side
	LD	HL,HEAD0_MSG
	JR	SEC_INFO1
B_SIDEF:LD	HL,HEAD1_MSG
	JR	SEC_INFO1
NO_SIDESF:
	LD	HL,HEADX_MSG	;H.
SEC_INFO1:
	CALL	PMSG
	LD	A,(CRTDISP)	;Do we have the more detail display option on
	OR	A,A
	JP	Z,NO_TDISPLAY	;If Z do not list the sector contents.

				;OK we are going to step along the image one
				;section at a time. Key locations were stored 
				;previously in the SCTRIM: routine.  
	LD	HL,TRACK_MSG	
	CALL	PMSG
	LD	DE,FBUFFER	;Move Start of track image into DE
	PUSH	DE		;save it
	LD	HL,(INDEX_MARK)	;End+1 of track header
	DEC	HL
	SBC	HL,DE
	EX	DE,HL		;Count now in DE
	POP	HL		;DE on stack to HL
HDRX:	LD	A,(HL)
	CALL	PACC		;Print out HEX values of HEADER Field
	INC	HL		
	DEC	DE		;Decrease DE count by 1
	LD	A,E
	OR	A,A		;Not XX00 at least
	JR	NZ,HDRX
	OR	A,D		
	JR	NZ,HDRX		;Not 0000

				;Now display the FIRST sector ID field area
	LD	HL,SECTOR_MSG	
	CALL	PMSG
	LD	DE,(INDEX_MARK)		;Move Start of sector image into DE
	PUSH	DE			;save it
	LD	HL,(S_DATA_MARK)	;End+1 of sec ID field
	DEC	HL
	SBC	HL,DE
	EX	DE,HL		;Count now in DE
	POP	HL		;DE on stack to HL
HSECX:	LD	A,(HL)
	CALL	PACC		;Print out HEX values of 1st Sector ID Field
	INC	HL		
	DEC	DE		;Decrease DE count by 1
	LD	A,E
	OR	A,A		;Not XX00 at least
	JR	NZ,HSECX
	OR	A,D		
	JR	NZ,HSECX	;Not 0000

				;Now display the FIRST sector DATA field area
	LD	HL,SEC_DATA_MSG	
	CALL	PMSG
	LD	DE,(S_DATA_MARK)	;Move Start of sector image into DE
	PUSH	DE			;save it
	LD	HL,(E_DATA_MARK)	;End+1 of DATA field
	DEC	HL
	SBC	HL,DE
	EX	DE,HL		;Count now in DE
	POP	HL		;DE on stack to HL
HDATAX:	LD	A,(HL)
	CALL	PACC		;Print out HEX values of 1st Sector DATA Field
	INC	HL		
	DEC	DE		;Decrease DE count by 1
	LD	A,E
	OR	A,A		;Not XX00 at least
	JR	NZ,HDATAX
	OR	A,D		
	JR	NZ,HDATAX	;Not 0000

				;Now display the FIRST sector GAP3 field area
	LD	HL,SEC_GAP3_MSG	
	CALL	PMSG
	LD	DE,(E_DATA_MARK)	;Move Start of sector image into DE
	PUSH	DE			;save it
	LD	HL,(E_SEC_MARK)		;End+1 of GAP3 field
	DEC	HL
	SBC	HL,DE
	EX	DE,HL		;Count now in DE
	POP	HL		;DE on stack to HL
HGAP3X:	LD	A,(HL)
	CALL	PACC		;Print out HEX values of 1st Sector GAP3 Field
	INC	HL		
	DEC	DE		;Decrease DE count by 1
	LD	A,E
	OR	A,A		;Not XX00 at least
	JR	NZ,HGAP3X
	OR	A,D		
	JR	NZ,HGAP3X	;Not 0000

				;Now display the Track GAP4 field area
	LD	HL,SEC_GAP4_MSG	
	CALL	PMSG
	LD	DE,(S_GAP4_MARK)	;Start of sector GAP4 into DE
	PUSH	DE		;save it
	LD	HL,(E_GAP4_MARK)	;End+1 of GAP3 field
	DEC	HL
	SBC	HL,DE
	EX	DE,HL		;Count now in DE
	POP	HL		;DE on stack to HL
HGAP4X:	LD	A,(HL)
	CALL	PACC		;Print out HEX values of 1st Sector GAP3 Field
	INC	HL		
	DEC	DE		;Decrease DE count by 1
	LD	A,E
	OR	A,A		;Not XX00 at least
	JR	NZ,HGAP4X
	OR	A,D
	JR	NZ,HGAP4X	;Not 0000
	CALL	ZCRLF
;
NO_TDISPLAY:
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET
;
;
;---------- Debug Routines -----------------------------
DEBUG_A:			;Display contents of A of CRT
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	C,'>'
	CALL	CO
	POP	AF
	CALL	PACC
	LD	C,'<'
	CALL	CO
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

DEBUG_B				;Display A on CRT wait for keyboard
	CALL	DEBUG_A
	PUSH	AF
	CALL	CI
	POP	AF
	RET
;---------------------------------------------------------------------------
;
SIGNON:		DB	CR,LF,LF
		DB	'Versafloppy II Diagnostic Program. (V1.0 by John Monahan 2009)',0
GETDRV_MSG:	DB	CR,LF,'Please select a drive. (A,B,C or D): ',0	
XXXDRV:		DB	CR,LF,'Sorry that is an invalid drive',0
GETSIZE_MSG:	DB	CR,LF,'Is this a 5" or 8" Drive (5,8): ',0	
DISK_8_FORMATS:	DB	CR,LF,LF,'Possible 8" disk formats:-'
		DB	CR,LF,	'A = 128 Bytes/Sec, 26 Sec/Ttk. 8" SDSS. (IBM 3740 Format)'  
		DB	CR,LF,	'B = 128 Bytes/Sec, 50 Sec/Ttk. 8" DDSS. (SD Systems 8" DD Format)'  
		DB	CR,LF,	'C = 256 Bytes/Sec, 26 Sec/Ttk. 8" DDDS. (IBM System 34 Format)'  
		DB	CR,LF,	'D = 1024 Bytes/Sec, 9 Sec/Trk. 8" DDDS. (For CPM3 System)'
		DB	CR,LF,	'Please select a disk format: ',0
DISK_5_FORMATS:	DB	CR,LF,LF,'Possible 5" disk formats:-'
		DB	CR,LF,	'A = 128 Bytes/Sec, 18 Sec/Ttk. 5" SDSS. (SD Systems 5" SD Format)'  
		DB	CR,LF,	'B = 128 Bytes/Sec, 29 Sec/Ttk. 5" DDSS. (SD Systems 5" DD Format)'  
		DB	CR,LF,	'C = 512 Bytes/Sec, 8 Sec/Ttk. 5" DDDS. (IBM PC CPM-86 Format)'
		DB	CR,LF,	'Please select a disk format: ',0
OPTION_ERROR:	DB	CR,LF,'Sorry invalid option',0

MAIN_MENU0:	DB	CR,LF,LF,'VERSAFLOPPY II DIAGNOSTICS ---- MAIN MENU ---- (Detail Display OFF)',0
MAIN_MENU1:	DB	CR,LF,LF,'VERSAFLOPPY II DIAGNOSTICS ---- MAIN MENU ---- (Detail Display ON)',0
DISK_INFO	DB	CR,LF,'Current drive:- ',0
DISK_INFO0:	DB	CR,LF,'Drive ',0
DISK_INFO1:	DB	': (HW_BYTE)=',0
DISK_INFO2:	DB	'  Size=',0
DISK_INFO3:	DB	'", Double Sided,  ',0
DISK_INFO4:	DB	'", Single Sided,  ',0
DISK_INFO5:	DB	'Double Density disk.',0
DISK_INFO6:	DB	'Single Density disk.',0

DISK_INFO7:	DB	CR,LF,'Current Disk [IX] Table: Sec/Track=',0
DISK_INFO8:	DB	'H, Tracks/Side=',0
DISK_INFO9:	DB	'H, Sec Size=',0
DISK_INFO10:	DB	'H,  128 Bytes/Sec.',0
DISK_INFO11:	DB	'H,  256 Bytes/Sec.',0
DISK_INFO12:	DB	'H,  512 Bytes/Sec.',0
DISK_INFO13:	DB	'H, 1024 Bytes/Sec.',0
IDMSG0:		DB	CR,LF,'Track/Side/Sec/Size/(CRC) TRACK ID field= ',0

MENU_OPTIONS	DB	CR,LF,LF, '0 = Select a DRIVE/DISK to analyze'
		DB	CR,LF,	'1 = Seek Test'
		DB	CR,LF,	'2 = Read Sector Test'
		DB	CR,LF,	'3 = Random Sector R/W Test'
		DB	CR,LF,  '4 = Continously Read sectors from a specific track' 
		DB	CR,LF,	'5 = Load one complet track to RAM (3000H)'
		DB	CR,LF,	'6 = Read specific sector(s) on current disk to RAM'
		DB	CR,LF,	'7 = Write RAM contents to specific sector(s) on current disk'
		DB	CR,LF,	'8 = Format the current disk',0
MENU1_MSG:	DB	CR,LF,	'9 = Turn ON detailed output display'
		DB	CR,LF,	'ESC To return to CPM'
		DB	CR,LF,	'Please enter a command:- ',0
MENU2_MSG:	DB	CR,LF,	'8 = Turn OFF detailed output display'
		DB	CR,LF,	'ESC To return to CPM'
		DB	CR,LF,	'Please enter a command:- ',0
AT0MSG:		DB	CR,LF,	'Track 0',0
ATXMSG:		DB	CR,LF,	'Track ',0
ATYMSG:		DB		' For Track ',0
ATX2MSG:	DB		'H. ',0
SEKMSG		DB	CR,LF,  'Disk seek test.',CR,LF,0
ATTRK:		DB	CR,LF,	'At TRACK ',0
ATSEC:		DB	'H,  SECTOR ',0
HEAD0_MSG	DB	'H,  HEAD 0',0
HEAD1_MSG	DB	'H,  HEAD 1',0
HEADX_MSG	DB	'H.',0
SEC_MSG:	DB	CR,LF,'Sector Contents=',0
FORMATTING_MSG:	DB	CR,LF,	'Formating Disk.',0
BADCMD		DB	CR,LF,BELL, 'Invalid command selected.',0
FORM_ERRMSG:	DB	CR,LF,BELL,'Disk formatting aborted or write error.',0
END_FORM_MSG:	DB	CR,LF,	'Disk has been formatted correctly. Each track is ',0
END_FORM1_MSG	DB	        'H Bytes long.',0
CODE_NOT_DONE:	DB	CR,LF,	'Sorry Code not done yet. HALT',0
FORM_TRK:	DB	CR,LF,'Formatting TRACK ',0
TRACK_MSG:	DB	'Track Image:- '
		DB	CR,LF,	'Index field up to First sector=',0
SECTOR_MSG:	DB	CR,LF,	'Sector ID Field=',CR,LF,0
SEC_DATA_MSG:	DB	CR,LF,	'Sector DATA Field=',CR,LF,0
SEC_GAP3_MSG:	DB	CR,LF,	'Sector GAP3 Field=',CR,LF,0
SEC_GAP4_MSG:	DB	CR,LF,	'End of Track GAP4 Field=',CR,LF,0
GET_TRACK_MSG:	DB	CR,LF,	'Please enter track number to read (Enter 2 HEX digits): ',0
GET_SIDE_MSG:	DB	CR,LF,	'Please select Disk SIDE A or B (A,B): ',0
SIDE_ERROR:	DB	CR,LF,BELL, 'Invalid SIDE selection',0
TRACK_CONTENTS:	DB	CR,LF,	'Track contents:-',CR,LF,0
MORE_MSG:	DB	CR,LF,	'Do you wish to see more (Y/N): ',0

GAP3_MSG:	DB	CR,LF,	'GAP3=',0
GAP1_MSG:	DB	CR,LF,	'GAP1=',0
ID_MSG:		DB	CR,LF,	'Sector ID Mark=',0
GAP2_MSG:	DB	CR,LF,	'GAP2=',0
SYNC_MSG:	DB	CR,LF,	'Data Sync=',0

STATUS_179x:	DB	CR,LF,	'Status Bits of 1791/5 Chip= ',0
ENDMSG:		DB	CR,LF,BELL,'Disk has been formatted ',CR,LF,0
ERRMSG:		DB	CR,LF,BELL,'SORRY COULD NOT SEEK NEXT TRACK',CR,LF,0
TRACK_ERROR:	DB	CR,LF,BELL,'That track is out of range for this disk',0
WAIT_ON_MSG	DB	CR,LF,	'Wait state hardware on Versafloppy II board turned ON',0
WAIT_OFF_MSG	DB	CR,LF,	'Wait state hardware on Versafloppy II board turned OFF',0
SEC_READ_RETRY:	DB	CR,LF,	'Re-reading SECTOR ',0
SEC_RH_RETRY	DB	CR,LF,	'Re-Seeking before re-reading SECTOR ',0
TRK_READ_RETRY:	DB	CR,LF,	'ERROR. Will try re-reading TRACK ',0
TRK_WR_RETRY	DB	CR,LF,	'ERROR. Will try re-writing TRACK ',0
SEC_WR_RETRY:	DB	CR,LF,	'Re-writing SECTOR ',0
SEC_WH_RETRY	DB	CR,LF,	'Re-Seeking before re-writing SECTOR ',0
SECTOR_RW_ERROR	DB	CR,LF,BELL,'R/W Error found on Sector ',0

SEC_READ_ERROR: DB	CR,LF,BELL,'SEC READ Error.'
		DB	' Bits: DNR,0,Record Type,RNF,'
		DB	'CRC,DATA,DRQ,Busy (',0

SEEKNV_ERROR:	DB	CR,LF,BELL,'SEEK (NV) Error.'
		DB	' Bits: DNR,WP,Head,Seek,'
		DB	'CRC,TRK0,INDEX,Busy (',0

RSCMD_ERROR:	DB	CR,LF,BELL,'RESTORE Error.'
		DB	' Bits: DNR,WP,Head,Seek,'
		DB	'CRC,TRK0,INDEX,Busy (',0

SEC_ID_ERROR:	DB	CR,LF,BELL,'SEC ID Error.'
		DB	' Bits: DNR,0,0,RNF,'
		DB	'CRC,DATA,DRQ,Busy (',0

SKCMD_ERROR:	DB	CR,LF,BELL,'SEEK Error.'
		DB	' Bits: DNR,WP,Head,Seek,'
		DB	'CRC,TRK0,INDEX,Busy (',0

RDTCMD_ERROR:	DB	CR,LF,BELL,'TRACK Read Error.'
		DB	' Bits: DNR,0,0,0,'
		DB	'0,DATA,DRQ,Busy (',0

WRTCMD_ERROR:	DB	CR,LF,BELL,'TRACK Write Error.'
		DB	' Bits: DNR,WP,WF,0,'
		DB	'0,DATA,DRQ,Busy (',0

WRCMD_ERROR:	DB	CR,LF,BELL,'SEC WRITE Error.'
		DB	' Bits: DNR,WP,WF,0,'
		DB	'CRC,DATA,DRQ,Busy (',0


CLOSE_BRACKET:	DB	')',0
UNKNOWN_ERROR:	DB	CR,LF,BELL,'Unknown Error. Status Bits= (',0
;
;
;	LOOKUP TABLES OF DISK PARAMETERS
;
;	8" SINGLE DENSITY DRIVE VARIABLES (IBM 3740 Format)
STDSDT:	DB	26	;SECTORS PER TRACK
	DB	77	;TRACKS PER SIDE
	DB	100-27	;INDEX HEADER GAP
	DB	6	;GAP 1 (0's)
	DB	11	;GAP 2 (FF's)
	DB	27	;GAP 3 (FF's)
	DB	247	;GAP 4 (FF's)
	DB	1	;GAPR (Flag for multiple repeats of GAP4)
	DB	9	;RESTORE CODE
	DB	19H	;SEEK NO VERIFY CODE
	DB	1DH	;SEEK WITH VERIFY
	DB	0	;128 Bytes/sec
	DB	00000000B	;Disk HW_BYTE (SDSS)
	DB	0FFH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	1423H	;Size in bytes of 1 formatted track
	DB	'8" SINGLE DENSITY (IBM 3740 Format)',0

;	8" DOUBLE DENSITY (128 BYTE SECTORS)
STDDDT:	DB	50	;SECTORS PER TRACK
	DB	77	;TRACKS PER SIDE
	DB	100-16	;HEADER GAP
	DB	8	;GAP 1 (4E's)
	DB	22	;GAP 2 (4E's)
	DB	16	;GAP 3 (4E's)
	DW	204	;GAP 4 (4E's)
	DB	1	;GAPR (Flag for multiple repeats of GAP4)
	DB	9	;RESTORE CODE
	DB	19H	;SEEK NO VERIFY
	DB	1DH	;SEEK WITH VERIFY
	DB	0	;128 Bytes/sec
	DB	01000000B	;Disk HW_BYTE  (DDSS)
	DB	4EH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'8" DOUBLE DENSITY (SD_Systems Format)',0

;
;	8" DOUBLE DENSITY (256 BYTE SECTORS) (IBM System 34 Format)
DDT256:	DB	26	;NBR SECTORS PER TRACK
	DB	77	;NBR TRACKS PER SIDE
	DB	100-54	;INDEX HEADER GAP
	DB	8	;GAP 1
	DB	22	;GAP 2
	DB	54	;GAP 3
	DB	200	;GAP 4 (3X200 = ~598)
	DB	3	;GAPR (Flag for multiple repeats of GAP4)
	DB	9	;RESTORE CODE
	DB	19H	;SEEK NO VERIFY
	DB	1DH	;SEEK WITH VERIFY
	DB	1	;256 Bytes/sec
	DB	01010000B	;Disk HW_BYTE (DDDS)
	DB	4EH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'8" DD (256 BYTE SECTORS) (IBM System 34 Format)',0

;
;	8" DOUBLE DENSITY (1024 BYTE SECTORS) 
DDT1K:	DB	9	;NBR SECTORS PER TRACK
	DB	77	;NBR TRACKS PER SIDE
	DB	100-54	;INDEX HEADER GAP
	DB	8	;NBR GAP 1
	DB	22	;NBR GAP 2
	DB	54	;NBR GAP 3
	DB	128	;GAP 4 
	DB	1	;GAPR (Flag for multiple repeats of GAP4)
	DB	9	;RESTORE CODE
	DB	19H	;SEEK NO VERIFY
	DB	1DH	;SEEK WITH VERIFY
	DB	3	;1024 Bytes/sec
	DB	01010000B	;Disk HW_BYTE (DDDS)
	DB	4EH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'8" DOUBLE DENSITY (1024 BYTE SECTORS)',0 

;
;	
; 5", 128 byte, SD SD-Systems Format
MINSDT: DB	18	;sectors per track
	DB	35	;tracks per side
	DB	20-8	;index header gap
	DB	6	;GAP 1
	DB	11	;GAP 2
	DB	8	;GAP 3
	DB	221	;GAP 4 (FF's)
	DB	1	;GAPR (Flag for multiple repeats of GAP4)
	DB	0bh	;RESTORE CODE
	DB	1bh	;seek w/no verify cmd
	DB	1fh	;seek w/verify cmd
	DB	0	;128 Bytes/sec
	DB	00100000B	;Disk HW_BYTE (SDSS)
	DB	0FFH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'5", SD, 128 byte, SD-Systems Format',0

;
; 5", 128 byte, DD SD-Systems Format
MINDDT: DB	29	;sectors per track
	DB	35	;tracks per side
	DB	100-16	;index header gap
	DB	8	;GAP 1
	DB	22	;GAP 2
	DB	16	;GAP 3
	DB	247	;GAP 4
	DB	1	;GAPR (Flag for multiple repeats of GAP4)
	DB	0bh	;RESTORE CODE
	DB	1bh	;seek w/no verify cmd
	DB	1fh	;seek w/verify cmd
	DB	0	;128 Bytes/sec
	DB	01100000B	;Disk HW_BYTE (DDSS)
	DB	4EH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'5", DD. 128 byte, SD-Systems Format',0

;
; 5", 512 byte, DDDS, 8 sector IBM PC CPM-86 format
MINCPM: DB	8	;sectors per track
	DB	40	;tracks per side
	DB	100-80	;index header gap
	DB	8	;GAP 1
	DB	22	;GAP 2
	DB	80	;GAP 3
	DB	207	;GAP 4 (FF's)
	DB	5	;GAPR (Flag for multiple repeats of GAP4)
	DB	0bh	;RESTORE CODE
	DB	1bh	;seek w/no verify cmd
	DB	1fh	;seek w/verify cmd
	DB	2	;512 Bytes/sec
	DB	01110000B	;Disk HW_BYTE (DDDS)
	DB	04EH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'5", DDDS, 512 byte, 8 sector IBM PC CPM-86 format',0
;
; 5", 512 byte, DDDS, 8 sector IBM PC MSDOS1.1 format:
MSDOS:	DB	8	;sectors per track
	DB	40	;tracks per side
	DB	100-80	;index header gap
	DB	8	;GAP 1
	DB	22	;GAP 2
	DB	80	;GAP 3
	DB	193	;GAP 4 (FF's)
	DB	2	;GAPR (Flag for multiple repeats of GAP4)
	DB	0bh	;RESTORE CODE
	DB	1bh	;seek w/no verify cmd
	DB	1fh	;seek w/verify cmd
	DB	2	;512 Bytes/sec
	DB	01110000B	;Disk HW_BYTE (DDDS)
	DB	04EH	;GAP Format fill character
	DB	0E5H	;Data area fill character
	DW	0H	;Size in bytes of 1 formatted track
	DB	'5", DDDS, 512 byte, 8 sector IBM PC MSDOS1.1 format',0
;
;
;
; THE FOLLOWING RAM LOCATIONS ARE REQ
;
TEMP		DB	0H	
TEMP1		DB	0H
DRIVE_LETTER	DB	0H	
IXSAV		DW	0000H
IX_OLD_STORE	DW	0000H
IX_NEW_STORE	DW	0000H
IY_OLD_STORE	DW	0000H
IY_NEW_STORE	DW	0000H
CRTDISP		DB	0H
IDSV		DS	6H
CMD_STORE	DB	0H	;Menu CMD Store (Note: NOT CHIP CMD,CHIP_CMDSV)
RSEEK		DW	0000H
ERMASK		DB	0H	;ERROR MASK
ERSTAT		DB	0H	;PRESENT ERROR STORE
CHIP_CMDSV	DB	0H	;COMMAND TO 1791/5 SAVE
SPSV		DW	0000H	;SP SAVE
SP_SAVE		DW	0000H
SEC_RT_COUNT	DB	0H	;Number of sector reads before setting error flag
TRK_RT_COUNT	DB	0H	;Number of track reads before setting error flag
BYTE_COUNT	DW	0000H	;Byte count for tack R/W's
TRACK_SIZE	DW	0000H	;Size in bytes of current formatted track


INDEX_MARK	DW	0000H	;End of Index field +1
S_DATA_MARK	DW	0000H	;Pointer to start of Data area
E_DATA_MARK	DW	0000H	;Pointer to end of Data area+1
E_SEC_MARK	DW	0000H	;End Sector image +1
S_GAP4_MARK	DW	0000H	;start GAP4 area
E_GAP4_MARK	DW	0000H	;End track +1
	
		DS	100H
STACK	EQU	$

;END

