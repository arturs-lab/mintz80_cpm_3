   348  0281  CD1D0C           	CALL   	PACC
   349  0284                   	
   350  0284  DDCB1166         	BIT    	4,(IX+HW_BYTE) 	;Is it a 1 or 2 sided d
   351  0288  2816             	JR     	Z,SKIP_SIDES   	;If 1 sided then skip s
   352  028A  3A4400           	LD     	A,(SIDE)       	;which side WILL we wri
