 0213 7E        	MOV	A,M
 0214 CD2502    PBUFF1:	CALL	CONOUT		;OUTPUT CHARACTER
                	DJNZ	PBUFF1		;THE REQUIRED # OF TIMES...
 0217+10        	DB	10H
