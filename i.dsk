  3597  182C  C5               	PUSH   	BC
  3598  182D  D5               	PUSH   	DE
  3599  182E  5F               	LD     	E,A    	       	
  3600  182F  0608             	LD     	B,8
  3601  1831  CB23      BQ2:   	SLA    	E
  3602  1833  3E18             	LD     	A,18H
  3603  1835  8F               	ADC    	A
  3604  1836  4F               	LD     	C,A
  3605  1837  CD1B01           	CALL   	CO
  3606  183A  10F5             	DJNZ   	BQ2
  3607  183C  D1               	POP    	DE
  3608  183D  C1               	POP    	BC
  3609  183E  F1               	POP    	AF
  3610  183F  C9               	RET
  3611                  ;
  3612                  ;
  3613                  ; CHECK IF AN ABORT (ESC) CHARACTER IS PRESENT AT THE C
  3614                  ; HOLD EVERYTHING IF SPACEBAR IS PRESSED
  3615                  ;
  3616  1840            CHECKABORT:    	       	       	;see if an abort is req
  3617  1840  CD0A01           	CALL   	CONST
  3618  1843  C8               	RET    	Z      	
  3619  1844  CD1201    CHECK1:	CALL   	CI
  3620  1847  FE1B             	CP     	A,ESC  	       	;ESC to abort
  3621  1849  2806             	JR     	Z,CABORT
  3622  184B  FE20             	CP     	A,' '  	       	;If spacebar then freez
  3623  184D  28F5             	JR     	Z,CHECK1
  3624  184F  AF               	XOR    	A,A
  3625  1850  C9               	RET
  3626  1851  AF        CABORT:	XOR    	A,A    	       	;Was ESC, so return wit
  3627  1852  3D               	DEC    	A      	       	;return NZ, & 0FFH in A
  3628  1853  C9               	RET
