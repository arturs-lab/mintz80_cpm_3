 03D2 21F312    	LXI	H,JMPTBL	;ELSE POINT TO SPECIAL CODE DISPATCH ADDRESSES
 03D5 19        	DAD	D		;ADD IN INDEX OFFSET
 03D6 19        	DAD	D
