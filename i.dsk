НY+Ї20!Њ/>x6 #=В,ЙG!Њ/~ю АpЙНі'И*&}ґК?,>Н*Г/,Н`&ш%Н€'Й:^0юКщ*Н+,!&6S#6Y#6M#Їw!&w:М%2Л%!␀␀"&Ні'Кщ*Ї2і%Н`&ш%ХН›'СН 'ЙН+,:Н%юК¶,:ё%·Д.*P0"¶%Н.*>&}ґК¶,>Н•*Г¦,␀␀␀:Н%юКК,Нl&&Н€'!“-Нx&Г␀␀CP/M MACRO ASSEM 2.0NO SOURCE FILE PRESENTNO DIRECTORY SPACESOURCE FILE NAME ERRORINVALID PARAMETER:SOURCE FILE READ ERROROUTPUT FILE WRITE ERRORCANNOT CLOSE FILESUNBALANCED MACRO LIBEND OF ASSEMBLYЕG:Н%юxКп-Хх!ё%~·КЫ-юЪГ-Н.ГЫ-*P0л*¶%O␀	{ЅВШ-zјКб-Н.*P0"¶%!ё%^4␀!№%сwСБЙхжН.схжН.с‚WЙЖђ'О@'Г•*>:Н•*!ё%^ЇWw*¶%{Нс-|Нс-}Нс-ЇНс-{·К?.!№%~#Нс-В6.Ї’Нс->Н•*>
Н•*ЙНћ*>
Нћ*Йчяяяяяяпяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяwчяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяsчяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее	INIDDT
;
	REL
	ENTRY	INTMOD
INTMOD:	IM0				;SET 8080 MODE INTERRUPTS
	RET
	FORM
;
;	TRAPS
;		INITIALIZE UNIMPLENTED TRAPS
;
;	CALLING SEQUENCE:
;		CALL	TRAPS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
	ENTRY	TRAPS
TRAPS:	RET
	FORM
;
;	INITCI
;
;		INITIALIZE CONSOLE INTERRUPT DEVICE
;
;	CALLING SEQUENCE:
;		CALL	INITCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIDDT
;
	EXT	DDTINT
INITCI:	MOV	(0000H),A,0C3H		;LOAD DDTINT ADDR INTO
	MOV	(0001H),HL,DDTINT	;	CPM BOOT LOCATION
	RET
	FORM
;
;	ENBCI
;		ENABLE CONSOLE INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	ENBCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIINT (NOT USED)
;
	ENTRY	ENBCI
ENBCI:	RET
	FORM
;
;	DISCI
;		DISABLE CONSOLE INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	DISCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIINT (NOT USED)
;
	REL
DISCI:	RET
	FORM
	TITLE	IODEP - REAL TIME CLOCK DEPENDENCIES
;
;	CLOCK
;
;		REAL TIME CLOCK DEVICE INITIALIZER
;
;	CALLING SEQUENCE:
;		CALL	CLOCK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NONE
;
;	COME FROM:
;		RBTE: START (RTX)
;		RBTEDIAG: START (RBTEDIAG)
;
	REL
	ENTRY	CLOCK
CLOCK:	CALL	RESTIM			; RESET REAL TIME CLOCK
	CALL	ENBCLK			; ENABLE CLOCK INTERRUPTS
	RET
	FORM
;
;	ENBCLK
;
;		ENABLE CLOCK INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	ENBCLK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		ENBDEV
;
ENBCLK:	LD	A,(INTMSK)		; SET CLOCK
	SET	CLKMB,A			;	MASK
	LD	(INTMSK),A		;	AND ENABLE
	OUT	PIOA,A			;	CLOCK INTERRUPT
	RET
	FORM
;
;	DISCLK
;
;		DISABLE CLOCK INTERRUPTS
;
;	CALLING SEQUENCE:
;		CALL	DISCLK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		DISDEV
;
DISCLK:	LD	A,(INTMSK)		; CLEAR CLOCK
	RES	CLKMB,A			;	MASK AND
	LD	(INTMSK),A		;	DISABLE
	OUT	PIOA,A			;	CLOCK
	RET
	FORM
;
;	CLKTRP
;
;		REAL TIME CLOCK INTERRUPT SERVICE ROUTINE
;		ENTERED UPON CLOCK TICK EXPIRATION
;		VECTOR GRAPHIC TICK = 18.18 MS
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE - VIA INTERRUPT
;
	REL
	EXT	CLKISR
CLKTRP:	JP	CLKISR			;DO CLOCK INTERRUPT
	FORM
;
;	RESTIM
;
;		RESTART REAL TIME CLOCK. (FOR CLOCKS WHICH MUST BE 
;		RESTARTED AFTER TIMER EXPIRATION.)
;
;	CALLING SEQUENCE:
;		CALL	RESTIM
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		CLKTRP, CLKISR (RTX)
;
	ENTRY	RESTIM
RESTIM:	PUSH	AF			; SAVE REG
	IN	A,PIOB			; RESET CLOCK
	POP	AF			; RESTORE REG
	RET
	FORM
;
;	XINI
;		INITIALIZE XLOG TRACE WINDOW CURSOR
;
;	CALLING SEQUENCE:
;		CALL	XINI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XINI
	REL
COLSTR	EQU	0			;STARTING COLUMN (0,79)
COLMAX	EQU	79			;ENDING COLUMN WIDTH
LINSTR	EQU	9			;STARTING LINE NUMBER (0,23)
LINMAX	EQU	12			;WINDOW DEPTH
XINI:	MOV	(COLCNT),A,COLMAX	;WINDOW WIDTH
	MOV	(COLCRS),A,COLSTR	;WINDOW START COLUMN
	MOV	(LINCNT),A,LINMAX	;WINDOW LENGTH
	MOV	(LINCRS),A,LINSTR	;WINDOW START LINE
	RET
	FORM
;
;	XIBAUD
;
;		DO AUTO BAUD DETECT FOR XLOG TRACE PORT
;
;	CALLING SEQUENCE:
;		CALL	XIBAUD
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XIBAUD
	REL
XIBAUD:	NOP			;BAUD RATE SET FOR CONSOLE
	RET
	FORM
;
;	XCLS
;		CLOSE EXTERNAL TRACE DEVICE
;
;	CALLING SEQUENCE:
;		CALL	XCLS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XCLS
	REL
XCLS:	RET
;
;	DSKPUT
;		COPY TRANSACTION CHARACTER TO DISK BUFFER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	DSKPUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
;
	ENTRY	DSKPUT
	REL
DSKPUT:	RET
	FORM
;
;	XPOS
;
;		POSITION CURSOR TO CURRENT POSITION IN XLOG TRACE WINDOW
;
;	CALLING SEQUENCE:
;		CALL	XPOS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XPOS
	EXT	POS
	REL
XPOS:	LD	HL,COLCRS		;COLUMN ADR
	LD	DE,LINCRS		;LINE ADR
	CALL	POS			;POSITION IT
	RET
;
;
	DATA
COLCNT:	DB	0	;COLUMN COUNTER
COLCRS:	DB	0	;COLUMN POINTER
LINCNT:	DB	0	;LINE COUNTER
LINCRS:	DB	0	;LINE POINTER
	FORM
;
;	XPUT
;
;		COPY CHAR TO XLOG TRACE WINDOW
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	XPUT
;
;	ENTRY:
;		REG A	CHARACTER TO DISPLAY
;
;	EXIT:
;		REGS BC, DE, HL PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XPUT
	EXT	CLRLIN
	REL
XPUT:	PUSH	DE			;SAVE
	PUSH	BC
	PUSH	HL			;	REGS
	CALL	APUT			;DISPLAY CHAR
	LD	HL,COLCRS		;NEXT CHAR
	INC	(HL)			;	POINTER
	LD	HL,COLCNT		;END OF
	DEC	(HL)			;	LINE?
	JR	NZ,XPEXIT		;NO, EXIT
	MOV	(COLCNT),A,COLMAX	;YES, RESET COLUMN COUNTER
	MOV	(COLCRS),A,COLSTR	;RESET COLUMN CURSOR
	LD	HL,LINCRS		;NEXT LINE
	INC	(HL)			;	POINTER
	LD	HL,LINCNT		;BOTTOM OF
	DEC	(HL)			;	WINDOW?
	JR	NZ,XP1			;NO
	MOV	(LINCRS),A,LINSTR	;YES, RESET LINE POINTER
	MOV	(LINCNT),A,LINMAX	;RESET LINE COUNTER
XP1:	LD	HL,COLCRS		;POSITION
	LD	DE,LINCRS		;	SCREEN
	CALL	POS			;	CURSOR
	CALL	CLRLIN			;CLEAR LINE
XPEXIT:	POP	HL			;RESTORE
	POP	BC
	POP	DE			;	REGS
	RET
	FORM
;
;	APUT
;
;		SEND CHARACTER TO CONSOLE
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	APUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		EMULSR, DISKIO
;
	ENTRY	APUT
APUT:
	CALL	CONOUT		;PRINT BYTE
	RET
	TITLE	IODEP - CDOS, CP/M CONSOLE I/O
	ENTRY	CONOUT,CONINP,CONCHK
;
;	CONOUT
;
;		DISPLAY CHARACTER ON CONSOLE VIA CDOS CALL     
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	CONOUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		EMULSR, APUT 
;
CONOUT:	PUSH	HL
	PUSH	BC		;SAVE
	PUSH	DE		;	REGS
	LD	E,A		;SEND
	CPMIO	6		;	CHAR TO CONSOLE
	POP	DE		;RESTORE
	POP	BC		;	REGS
	POP	HL
	RET
	FORM
;
;	CONINP
;		READ KEYBOARD VIA CDOS CALL
;
;	CALLING SEQUENCE:
;		CALL	CONINP
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A	KEYBOARD DATA
;		ALL OTHER REGS PRESERVED
;
;	COME FROM:
;		EMULSR
;
CONINP:	PUSH	HL
	PUSH	BC		;SAVE
	PUSH	DE		;	REGS
CI.LOP:	LD	E,0FFH		;GET NEXT
	CPMIO	6		;NEXT KEYBOARD CHAR WITHOUT ECHO
	OR	A		; CHAR AVL?
	JR	Z,CI.LOP	; NO, TRY AGAIN
	POP	DE		;RESTORE
	POP	BC		;	REGS
	POP	HL
	RET
	FORM
;
;	CONCHK
;
;		CHECK IF KEYBOARD DATA AVAILABLE. RETURN CHARACTER IF
;		FOUND AVAILABLE
;
;	CALLING SEQUENCE:
;		CALL	CONCHK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A	= 0: IF NO CHARACTER AVAILABLE
;		       <> 0: IF CHARACTER AVAILABLE
;
;	COME FROM:
;		EMULSR
;
CONCHK:	PUSH	BC		; SAVE
	PUSH	DE		;	REGS
	PUSH	HL		;	...
	LD	E,0FFH		; GET NEXT
	CPMIO	6		;	CHARACTER IF AVL
	OR	A		; SET AVL STATUS
	POP	HL		; RESTORE
	POP	DE		;	REGS
	POP	BC		;	...
	RET
	FORM
;
;	PRTCHR
;
;		COPY CHARACTER TO PRINTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	PRTCHR
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		DISKIO
;
	ENTRY	PRTCHR
PRTCHR:
;	CALL	PIOPRT		; PRINT CHAR VIA PROGRAM I/O
	CALL	CPMPRT		; PRINT CHAR VIA CPM
	RET
;
PIOPRT:	PUSH	AF		;SAVE CHAR
PRT1:	IN	A,LPTCMD	;PRINT BUFFER
	BIT	B$TXR,A		;	EMPTY?
	JR	Z,PRT1		;NO
	POP	AF		;YES, GET CHAR
	OUT	LPTDAT,A	;	& PRINT
	RET
;
CPMPRT:	PUSH	BC		; SAVE
	PUSH	DE		;	REGS
	PUSH	HL		;	....
	LD	E,A		; PRINT
	CPMIO	5		;	 CHAR
	POP	HL		; RESTORE
	POP	DE		;	REGS
	POP	BC		;	....
	RET
	TITLE	IODEP	SYNCHRONOUS ROUTINES
;
;	TXINT
;
;		MODEM TRANSMITTER INTERRUPT SERVICE ROUTINE
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE, VIA INTERRUPT
TXINT:	PUSH	AF			; SAVE REG
	IN	A,MDMCMD		; GET MODEM STATUS
	AND	TXUNDR			; TX UNDERRUN?
	JR	Z,TXIOK			; NO
	MEM	INC,(UNDRUN),A,(UNDRUN)	; YES, INCREMENT UNDERRUN COUNT
	LD	A,(MCMND)		; CLEAR
	OR	MRSTER			;	MODEM SIO
	OUT	MDMCMD,A		;	ERROR
TXIOK:	POP	AF			; RESTORE REG
	JP	TXISR			; DO INTERRUPT
	FORM
;
;	RXINT
;
;		MODEM RECEIVER INTERRUPT SERVICE ROUTINE
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE VIA INTERRUPT
;
;
RXINT:	PUSH	AF			; SAVE REG
	IN	A,MDMCMD		; GET MODEM STATUS
	AND	RXOVRF			; RX OVERFLOW?
	JR	Z,RXIOK			; NO
	MEM	INC,(OVRFLO),A,(OVRFLO)	; YES, INCREMENT OVERFLOW COUNTER
	LD	A,(MCMND)		; CLEAR ERROR
	OR	MRSTER			;	INDICATION
	OUT	MDMCMD,A		;	IN MODEM SIO
RXIOK:	POP	AF			; RESTORE REG
	JP	RXISR			; DO RX INTERRUPT
	TITLE	IODEP	TXCHR/TXBIN
;
;	TXCHR
;		ACCUMULATE CRC & TRANSMIT CHARACTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	TXCHR
;
;	ENTRY:
;		REG A	CHARACTER TO SEND
;
;	EXIT:
;		REG A	PRESERVED
;
;	COME FROM:
;		TXISR
;
;	STACK USED:
;
	EXT	CRCGEN,IDATT,IDATR
	ENTRY	TXCHR
TXCHR:	PUSH	AF			; SAVE
	PUSH	BC			;    A COUPLA REGS
	CALL	CRCGEN			; ACCUMULATE CRC
	OUT	(MDMDAT),A		; SEND CHAR
	CALL	IDATT			; GIVE TO XLOG
	POP	BC
	POP	AF
	RET
	TITLE	IODEP	TXBIN
;
;	TXBIN
;		TRANSMIT CHARACTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	TXBIN
;
;	ENTRY:
;		REG A	CHARACTER TO SEND
;
;	EXIT:
;		REG A	PRESERVED
;
;	COME FROM:
;		TXCHR, TXISR
;
;	STACK USED:
;
	ENTRY	TXBIN
TXBIN:	PUSH	AF			; SAVE REGS
	PUSH	BC			; /
	OUT	(MDMDAT),A		; XMIT CHAR
	CALL	IDATT			; GIVE TO XLOG
	POP	BC
	POP	AF
	RET
	FORM
;
;	CTXCRC/CRXCRC
;
;		CLEAR TRANSMITTER OR RECIEVER CRC ACCUMULATOR
;
;	CALLING SEQUENCE:
;		CALL	CTXCRC/CRXCRC
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT HL PRESERVED
;
;	COME FROM:
;		SYNISR
;
	ENTRY	CTXCRC
	ENTRY	CRXCRC
	EXT	CRCH,ACRC
	REL
CTXCRC:
CRXCRC:	MOV	(CRCH),HL,0		;CLEAR CRC ACCUMULATION
	MOV	(ACRC),A,0		;
	RET
	TITLE	IODEP	RDBIN - READ CHARACTER FROM SERIAL INTERFACE
;
;	RDBIN
;		READ CHARACTER FROM SERIAL INTERFACE
;
;	CALLING SEQUENCE:
;		CALL	RDBIN
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A/B	 CHARACTER READ
;
;	COME FROM:
;		RXISR
;
;	STACK USED:
;		NONE
;
	ENTRY	RDBIN
RDBIN:	IN	A,(MDMDAT)		; READ CHARACTER
	LD	B,A			; RETURN CHAR IN REG B
	JP	RBIN			; ALLOW XLOG FEATURE (NOP TO REMOVE)
	RET
RBIN:	PUSH	BC			; SAVE REG
	CALL	IDATR			; GIVE TO XLOG (MAY TAKE TOO MUCH TIME)
	POP	BC			; UNSAVE BC
	RET
	TITLE	SYNC - CONTROL SYNC PORT
;
;	SYNC	(SUBROUTINE)
;
;		THIS ROUTINE CONTROLS AND SENSES THE SYNCHRONOUS COMMUNICATION
;		CHANNEL.
;		ALL HARDWARE SPECIFICS OF THE SERIALIZER ARE CONTAINED IN 
;		THIS MODULE.
;
;	CALLING SEQUENCE:
;		LD	A,CMD
;		CALL	SYNC
;
;	ENTRY:
;		REG A	SERIALIZER COMMAND
;			0 = ACTIVATE DTR (DTRON)
;			1 = DEACTIVATE DTR (DTROFF)
;			2 = ENABLE RECEIVER (RXENB)
;			3 = DISABLE RECEIVER (RXDIS)
;			4 = ENABLE TRANSMITTER (TXENB)
;			5 = DISABLE TRANSMITTER (TXDIS)
;			6 = INIT SYNC PORT (SYNINI)
;			7 = SENSE DSR (DSRSNS)
;			8 = SENSE CTS (CTSSNS)
;			9 = ENABLE TRANSPARENT FILL (SETTRN)
;		       10 = ACTIVATE RTS (RTSON)
;		       11 = SENSE DCD (DCDSNS)
;
;	EXIT:
;		REG A	COMMAND STATUS FOR SENSE OPERATIONS
;			TRUE - DSRON OR CTSON
;			FALSE - DSROFF OR CTSOFF
;		FLAG Z	COMMAND STATUS OF SENSE OPERATIONS
;			SET - DSROFF OR CTSOFF
;			CLEAR - DSRON OR CTSON
;		ALL OTHER REGS PRESERVED
;
;	COME FROM:
;		BSCINT, TXISR, RXISR
;
;	STACK USED:
;
	ENTRY	SYNC
	EXT	TXERR,RXERR,ERR,TSTATE,TXMODE
	EXT	CASE,SYN,DLE,RXISR,TXISR
	REL
SYNC:	DI			;DISALLOW INTERRUPTIONS
	CALL	ISYNC		;DO SYNC FUNCTION
	EI			;ALLOW INTERRUPTIONS
	RET
	FORM
	ENTRY	ISYNC
;
ISYNC:	PUSH	HL		;SAVE REGS
	PUSH	DE		;.....
	LD	HL,S.CAS	;CALCULATE 
	LD	D,S.CNT		;	CASE
	CALL	CASE		;	ADDRESS
	LD	DE,ISYRET	;RETURN
	PUSH	DE		;	ADDRESS
	JP	(HL)		;DO CASE
;
ISYRET:	POP	DE		;RESTORE
	POP	HL		;	REGS
	RET			;EXIT
;
;	CASE TABLE
;
S.CAS:	DW	S.ERR		;ERROR
	DW	S.DTRN		;DTRON
	DW	S.DTRF		;DTROFF
	DW	S.RXE		;RXENB
	DW	S.RXD		;RXDIS
	DW	S.TXE		;TXENB
	DW	S.TXD		;TXDIS
	DW	S.INIT		;INIT
	DW	S.DSRS		;DSRSNS
	DW	S.CTSS		;CTSSNS
	DW	S.TRNS		;SETTRN
	DW	S.RTSN		;RTSON
	DW	S.DCDS		;DCDSNS
S.CNT	EQU	[$-S.CAS]/2-2
	FORM
S.ERR:	SYSERR	0
;
;	INITIALIZE SERIAL PORT
;
S.INIT:	MOV	(OVRFLO),A,0		;CLEAR UNDER RUN COUNTER
	MOV	(UNDRUN),A,0		;CLEAR TX UNDERRUN COUNTER
	MOV	(RXERR),A,0		;CLEAR UNEXPECTED RX INTERRUPT COUNTER
	MOV	(TXERR),A,0		;CLEAR UNEXPECTED TX INTERRUPT COUNTER
	MOV	(TXIERR),A,0		;TX SPURIOUS INTERRUPT COUNTER
	MOV	(RXIERR),A,0		;RX SPURIOUS INTERRUPT COUNTER
	MOV	(MCMND),A,0		;INIT MODEM COMMAND WORD
	MOUT	MDMCMD,0		;INSURE
	NOPS				;
	OUT	MDMCMD,A		;	MODEM USART
	NOPS				;
	OUT	MDMCMD,A		;	READY FOR RESET
	NOPS				;
	MOUT	MDMCMD,MRESET		;RESET MODEM CHIP
	NOPS				;
	MOUT	MDMCMD,MDMMOD		;SET SYNC MODE
	NOPS				;
	MOUT	MDMCMD,(SYN)		;SET FIRST SYNC
	NOPS				;
	OUT	MDMCMD,A		;SET SECOND SYNC
	RET
	FORM
;
;	SET DTR TO ON
;
S.DTRN:	MEM	OR,(MCMND),DTR,(MCMND)		;SET DATA TERMINAL
	OUT	(MDMCMD),A			;	READY.
	MEM	AND,(INTMSK),-[DTRM+1],(INTMSK)	; SET EXTERNAL
	OUT	PIOA,A				;	DTR
	RET
;
;	SET DTR TO OFF
;
S.DTRF:	MEM	AND,(MCMND),-[DTR+1],(MCMND)	;CLEAR DATA TERMINAL
	OUT	(MDMCMD),A			;	READY.
	MEM	OR,(INTMSK),DTRM,(INTMSK)	; CLEAR EXTERNAL
	OUT	PIOA,A				;	DTR
	RET
;
;	ENABLE TRANSMITTER
;	NEED TO CLEAR IRR FLAG?
;
S.TXE:	MEM	OR,(INTMSK),TXM,(INTMSK)	; ENABLE RECEIVE
	OUT	PIOA,A				;	INTERRUPTS
	MEM	OR,(MCMND),[TXENBL+RTS+DTR],(MCMND)	;SET RTS
	MOUT	MDMCMD,MRESET			;RESET CHIP
	NOPS					;
	MOUT	MDMCMD,MDMMOD			;SET SYNC MODE
	CPM	(TSTATE),T.TSYN			;DATA MESSAGE?
	JR	NZ,STESYN			;NO
	LD	A,(TXMODE)			;YES, TRANSPARENT
	AND	M$TRAN				;	DATA?
	JR	Z,STESYN			;NO
	MOUT	MDMCMD,(DLE)			;YES, USE TRANSP. SYN (DLE SYN)
	JR	STECOM
;
STESYN:	MOUT	MDMCMD,(SYN)			;USE NON TRANSP. SYN (SYN SYN)
	NOPS					;
STECOM:	MOUT	MDMCMD,(SYN)			;LOAD FIRST SYNC
	NOPS					;
	MOUT	MDMCMD,(MCMND)			;SET RTS & TX ENABLE
	NOPS					;
	MOUT	MDMDAT,(SYN)			;SEND SYN
	RET
	FORM
;
;	DISABLE TRANSMITTER
;
S.TXD:	MEM	AND,(INTMSK),-[TXM+1],(INTMSK)		; DISABLE TRANSMIT
	OUT	PIOA,A					;	INTERRUPT MASK
	MEM	AND,(MCMND),-[RTS+TXENBL+1],(MCMND)	;DISABLE TX
	OUT	MDMCMD,A
	RET
;
;	ENABLE RECEIVER
;
S.RXE:	MEM	OR,(INTMSK),RXM,(INTMSK)	; ENABLE RECEIVE
	OUT	PIOA,A				;	INTERRUPT MASK
	MEM	OR,(MCMND),[RXENBL+DTR],(MCMND)	;SET RX ENABLE
	MOUT	MDMCMD,MRESET			;RESET CHIP
	NOPS					;
	MOUT	MDMCMD,MDMMOD			;SET SYNC MODE
	NOPS					;
	MOUT	MDMCMD,(SYN)			;LOAD FIRST SYNC
	NOPS					;
	OUT	MDMCMD,A			;LOAD SECOND SYNC
	LD	A,(MCMND)			;ENABLE RX
	OR	HUNT				;	& HUNT MODE
	OUT	MDMCMD,A			;	....
	NOPS					;
	IN	A,MDMDAT			;DRAIN RX BUFFER
	NOPS					;
	IN	A,MDMDAT			;	....
	RET
;
;	DISABLE RECEIVER
;
S.RXD:	MEM	AND,(INTMSK),-[RXM+1],(INTMSK)	; DISABLE RECIEVE
	OUT	PIOA,A				;	INTERRUPT MASK
	MEM	AND,(MCMND),-[RXENBL+1],(MCMND)	;DISABLE RX
	OUT	MDMCMD,A			;	...
	RET
;
;	DSR SENSE
;
S.DSRS:	IN	A,MDMCMD			;GET MODEM STATUS
	AND	DSR				;DSR ACTIVE?
	RET	Z				;NO
	LD	A,TRUE				;YES
	RET
	FORM
;
;	CTS SENSE
;
S.CTSS:	XOR	A
	RET
;
;	SETTRN - TRANSPARENT FILL
;
S.TRNS:	RET
;
;	ACTIVATE RTS
;
S.RTSN:	MEM	OR,(MCMND),RTS,(MCMND)		; REQUEST TO SEND
	OUT	MDMCMD,A			;    SIGNAL
	RET
;
;	SENSE DCD
;
S.DCDS:	XOR	A
	RET
;
;
;
	DATA
TXIERR:	DB	0	;TX SPURIOUS INTERRUPT COUNTER
RXIERR:	DB	0	;RX SPURIOUS INTERRUPT COUNTER
UNDRUN:	DB	0	;UNDER RUN COUNTER
OVRFLO:	DB	0	;RX OVERFLOW COUNTER
MCMND:	DB	0	;MODEM COMMAND WORD
;
;
	END
	TITLE	IODEP	I/O DEPENDENT CODE FOR GNAT10 CP/M 2.0
VERSON	MACRO	#INO,#RHI,#RLO,#MTH,#DAY,#INM,#RNM,#DNM
	ENTRY	#INM,#RNM,#DNM
#INM	EQU	#INO
#RNM	EQU	[#RHI SHL 8] + #RLO
#DNM	EQU	[#MTH SHL 8] + #DAY
	MEND
;
;	MEM	OPCODE,VARDES,LITREG,VARSRC
;
MEM:	MACRO	#OP,#VD,#LIT,#VS
	LD	A,#VS
	#OP	#LIT
	LD	#VD,A
	MEND
;
;
SYSERR:	MACRO	#ERR
	CALL	ERR
	MEND
;
;
MOV:	MACRO	#DST,#REG,#SRC
	LD	#REG,#SRC
	LD	#DST,#REG
	MEND
;
;	MOUT	IOADR,VARIABLE
;
MOUT:	MACRO	#IOADR,#VAR
	LD	A,#VAR
	OUT	#IOADR,A
	MEND
;
;	MEMX	OPCODE,OPERAND,VARDES,REG,VARSRC
;
MEMX:	MACRO	#OP,#IOPR,#DES,#REG,#SRC
	LD	#REG,#SRC
	#OP	#IOPR
	LD	ГЁ COPYRIGHT (C) 1980 DIGITAL RESEARCH ю@ДзЙ:
