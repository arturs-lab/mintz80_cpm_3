 07A7 3AE313    	LDA	RPTXFER		;GET BLOCK I/O REPEAT COUNT
 07AA 57        	MOV	D,A		;SAVE IN [D]
 07AB 78        	MOV	A,B		;GET COMMAND TO [A]
 07AC 015700    	LXI	B,(0*256)+VFL$DATA	;[B] = 256 BYTES TO TRANSFER AT A SHOT
                					;[C] = VERSAFLOPPY DATA PORT
                
                	; CONDUCT ACTUAL READ TRACK OPERATION NOW:
 07AF CD5008    	CALL	WAITENABLE	;ENABLE VERSAFLOPPY WAIT STATE GENERATOR
 07B2 D354      	OUT	VFL$COMMAND	;START COMMAND
                RTRKLP:
                	INIR			;BLOCK INPUT 256 BYTES
 07B4+EDB2      	DB	0EDH,0B2H
 07B6 15        	DCR	D		;MORE BLOCK I/O'S ?
                	JRNZ	RTRKLP		;YES -- LOOP BACK UP...
 07B7+20        	DB	20H
 07B8+FB        	DB	RTRKLP-$-1
 07B9 CD2A08    	CALL	WAITDCB		;GET STATUS BYTE AT END
 07BC CD5A08    	CALL	WAITDISABLE	;DISABLE VERSAFLOPPY WAIT STATE GENERATOR
 07BF E68C      	ANI	RDERMSK		;ANY ERRORS ?
 07C1 C8        	RZ			;NO -- GO BACK WITH C=0...
                
                	; HERE WHEN DISK I/O ERROR:
 07C2 21E913    	LXI	H,RWRCOUNT	;POINT TO RETRY COUNTER
 07C5 35        	DCR	M		;RETRIES = RETRIES - 1
                	JRNZ	RTRK$RETRY	;IF MORE AVAILABLE LOOP BACK UP...
 07C6+20        	DB	20H
 07C7+C1        	DB	RTRK$RETRY-$-1
 07C8 37        	STC			;C=1 FOR HARD ERROR
 07C9 3E05      	MVI	A,5		;ERROR CODE IF VERIFY TRACK ERROR
 07CB C9        	RET
                
                
                	;;;;; DCBWRT
                	; WRITE SECTOR ROUTINE:
                	;
                DCBWRT:
                	; SET UP RETRY COUNTER:
 07CC 21E913    	LXI	H,RWRCOUNT	;POINT TO RETRY COUNTER
 07CF 3603      	MVI	M,RWRETRY	;INITIALIZE TO # RETRIES
                
                WRT$RETRY:
                	; MAKE SURE ALWAYS SIDE 0 TO BEGIN WITH:
 07D1 21E213    	LXI	H,DSELBITS	;POINT TO CURRENT SELECT BYTE
                	RES	4,M		;RESET SIDE BIT
 07D4+CBA6      	DB	0CBH,4*8+M+80H
                
                	; SET UP SIDE BIT:
 07D6 06A2      	MVI	B,WRT$179X	;[B] = WRITE SECTOR OPCODE
 07D8 21DF13    	LXI	H,PHYHEAD	;ARE WE WRITING TO SIDE 1 ?
                	BIT	0,M		;Z=0 IF WE ARE
 07DB+CB46      	DB	0CBH,0*8+M+40H
                	JRZ	WRT01
 07DD+28        	DB	28H
 07DE+0A        	DB	WRT01-$-1
 07DF 3AE213    	LDA	DSELBITS	;GET SELECT BITS
                	SETB	SIDBIT,A	;SET SIDE 1 BIT
 07E2+CBE7      	DB	0CBH,SIDBIT*8+A+0C0H
 07E4 32E213    	STA	DSELBITS
                	IF	WD1795
                	SETB	1,B		;SET SIDE BIT IN COMMAND TOO IF WD1795
                	ELSE
                	SETB	3,B		;ELSE DITTO FOR THE WD1791-4 SERIES
 07E7+CBD8      	DB	0CBH,3*8+B+0C0H
                	ENDIF
 07E9 CDAC06    WRT01:	CALL	DRVSET		;DO DRIVE SELECTION ONCE AGAIN
                
                	; TELL WD179X CHIP OF SECTOR TO BE WRITTEN:
 07EC 3AE013    	LDA	PHYSEC		;GET PHYSICAL SECTOR #
 07EF D356      	OUT	VFL$SECTOR	;AND PASS IT ON TO THE CHIP
                
                	; SET UP REGISTERS FOR TRANSFER:
 07F1 2AE513    	LHLD	DMAADR		;GET CURRENT TRANSFER ADDRESS
 07F4 3AE313    	LDA	RPTXFER		;GET BLOCK I/O REPEAT COUNT
 07F7 57        	MOV	D,A		;SAVE IN [D]
 07F8 3AE413    	LDA	BYTCNT		;GET BLOCK I/O BYTE COUNT
 07FB 5F        	MOV	E,A		;KEEP IN [E]
 07FC 78        	MOV	A,B		;GET COMMAND TO [A]
 07FD 0E57      	MVI	C,VFL$DATA	;[C] = VERSAFLOPPY DATA PORT
                
                	; CONDUCT ACTUAL WRITE SECTOR OPERATION NOW:
 07FF CD5008    	CALL	WAITENABLE	;ENABLE VERSAFLOPPY WAIT STATE GENERATOR
 0802 D354      	OUT	VFL$COMMAND	;START COMMAND
                WRTLP:
 0804 43        	MOV	B,E		;REFRESH BYTE I/O COUNT FROM [E]
                	OUTIR			;BLOCK OUTPUT N BYTES
 0805+EDB3      	DB	0EDH,0B3H
 0807 15        	DCR	D		;MORE BLOCK I/O'S ?
                	JRNZ	WRTLP		;YES -- LOOP BACK UP...
 0808+20        	DB	20H
 0809+FA        	DB	WRTLP-$-1
 080A CD2A08    	CALL	WAITDCB		;GET STATUS BYTE AT END
 080D CD5A08    	CALL	WAITDISABLE	;DISABLE VERSAFLOPPY WAIT STATE GENERATOR
 0810 E6BC      	ANI	WRERMSK		;ANY ERRORS ?
 0812 C8        	RZ			;NO -- GO BACK WITH C=0...
                
                	; HERE WHEN DISK I/O ERROR:
 0813 3EFF      	MVI	A,-1		;INVALIDATE CURRENT CYLINDER
 0815 32DE13    	STA	CURCYL
 0818 21E913    	LXI	H,RWRCOUNT	;POINT TO RETRY COUNTER
 081B 35        	DCR	M		;RETRIES = RETRIES - 1
                	JRNZ	WRT$RETRY	;IF MORE AVAILABLE LOOP BACK UP...
 081C+20        	DB	20H
 081D+B3        	DB	WRT$RETRY-$-1
 081E 37        	STC			;C=1 FOR HARD ERROR
 081F 3E06      	MVI	A,6		;ERROR CODE IF WRITE SECTOR ERROR
 0821 C9        	RET
                
                
                	;;;;; STARTDCB
                	; LOAD THE WD179X WITH A COMMAND TO BE EXECUTED --
                	;
                	;	ON ENTRY:	[A] = OPCODE TO BE SENT TO WD179X
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL UNALTERED
                	;
                STARTDCB:
                	; WAIT FOR WD179X READINESS TO ACCEPT A COMMAND:
 0822 F5        	PUSH	PSW		;SAVE OPCODE TO BE SENT OUT
 0823 CD2A08    	CALL	WAITDCB		;WAIT FOR CHIP READY TO LOAD COMMAND BYTE
 0826 F1        	POP	PSW		;GET BACK COMMAND TO SEND OUT
                
                	; THEN SEND THE THE CHIP ITS NEXT COMMAND:
 0827 D354      	OUT	VFL$COMMAND	;SEND IT TO THE WD179X
 0829 C9        	RET
                
                
                
                	;;;;; WAITDCB
                	; WAIT FOR COMMAND COMPLETION AND RETURN STATUS BYTE --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	[A] = ERROR STATUS BYTE
                	;
                	;	REGISTERS:	ALL UNALTERED BUT [AF]
                	;
                WAITDCB:
                				; WAIT FOR THE WD179X TO GO INTO THE NON-BUSY STATE:
 082A C5        	PUSH	B
 082B 010000    	LXI	B,0		;LOAD TIMEOUT DELAY COUNT
 082E DB54      WAITLP:	IN	VFL$STATUS	;GET THE MAIN STATUS
                	BIT	WDBUSY,A	;TEST BUSY BIT
 0830+CB47      	DB	0CBH,WDBUSY*8+A+40H
                	JRZ	WAITDONE	;SKIP OUT IF NOW UNBUSY...
 0832+28        	DB	28H
 0833+1A        	DB	WAITDONE-$-1
 0834 0B        	DCX	B		;ELSE DROP TIMEOUT COUNT
 0835 79        	MOV	A,C		;AND CHECK FOR TIMEOUT
 0836 B0        	ORA	B
                	JRNZ	WAITLP		;LOOP UNTIL TIMED OUT OR UNBUSY...
 0837+20        	DB	20H
 0838+F5        	DB	WAITLP-$-1
                
                	; ARRIVE HERE ON CONTROLLER HANG-UP CONDITION:
 0839 DB53      	IN	VFL$SELECT	;GET CURRENT SELECT BYTE
 083B F5        	PUSH	PSW		;SAVE FOR LATER RESTORAL
 083C D350      	OUT	VFL$RESET	;RESET CONTROLLER
 083E 0650      	MVI	B,80		;ASSERT RESET FOR GOODLY TIME
                RSTLP:	DJNZ	RSTLP
 0840+10        	DB	10H
 0841+FE        	DB	RSTLP-$-1
 0842 DB50      	IN	VFL$RESET	;REMOVE RESET CONDITION
 0844 F1        	POP	PSW		;RESTORE PREVIOUS SELECT BYTE
 0845 D353      	OUT	VFL$SELECT
 0847 CDB306    	CALL	DCBSTATUS	;ISSUE FORCE INTERRUPT COMMAND TO TERMINATE
                				; AUTO-RECALIBRATE
 084A C1        	POP	B		;SYNC STACK
 084B 3EFE      	MVI	A,0FEH		;RETURN AN OBVIOUS ERROR CODE
 084D C9        	RET
                
                	; COME HERE ON NORMAL WAIT TILL UNBUSY:
                WAITDONE:
 084E C1        	POP	B		;SYNC STACK
 084F C9        	RET			;GO BACK WITH STATUS IN [A]
                
                
                	;;;;; WAIT$ENABLE
                	; ENABLE VERSAFLOPPY WAIT STATE GENERATOR TO ALLOW R/W TRANSFERS --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL UNALTERED
                	;
                WAIT$ENABLE:
 0850 F5        	PUSH	PSW		;SAVE [AF]
 0851 DB53      	IN	VFL$SELECT	;GET CURRENT SELECT BYTE
 0853 E67F      	ANI	7FH		;RESET BIT TO ENABLE WAIT STATES
 0855 F3        	DI			;NO FUNNY BUSINESS AFTER THIS!!
 0856 D353      	OUT	VFL$SELECT	;SEND BACK TO SELECT REGISTER
 0858 F1        	POP	PSW		;RECOVER [AF]
 0859 C9        	RET
                
                
                	;;;;; WAIT$DISABLE
                	; DISABLE VERSAFLOPPY WAIT STATE GENERATOR --
                	;
                	;	ON ENTRY:	NO ENTRY PARAMETERS
                	;
                	;	ON EXIT:	NO PARAMETERS RETURNED
                	;
                	;	REGISTERS:	ALL UNALTERED
                	;
                WAIT$DISABLE:
 085A F5        	PUSH	PSW		;SAVE [AF]
 085B DB53      	IN	VFL$SELECT	;GET CURRENT SELECT BYTE
 085D F680      	ORI	80H		;SET BIT TO DISABLE WAIT STATES
 085F D353      	OUT	VFL$SELECT	;SEND BACK TO SELECT REGISTER
 0861 FB        	EI			;END OF CRITICAL AREA!!
 0862 F1        	POP	PSW		;RECOVER [AF]
 0863 C9        	RET
                
