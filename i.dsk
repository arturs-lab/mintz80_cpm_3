   187  0100            
   188                  ; EQUATES FOR [IX] REGISTAR INTO DISK PARAMATER TABLE
   189                  ;
   190        (0000)    NSCTRS 	EQU    	0      	;Sectors/Track for disk
   191        (0001)    NTRKS  	EQU    	1      	;Tracks/Side
   192        (0002)    HW_BYTE	EQU    	2      	;Will contain bit flags for:-
   193  0100                   	       	       	       	       	;Bits 0,1 are u
   194  0100                   	       	       	       	       	;Bits 2 & 3 are
   195  0100                   	       	       	       	       	;Bit 4=0 For SS
   196  0100                   	       	       	       	       	;Bit 5=0 8" dis
   197  0100                   	       	       	       	       	;Bit 6=0 Single
   198  0100                   	       	       	       	       	;Bit 7=0 if CUR
   199  0100                   	       	       	       	       	;      1 if CUR
   200  0100                   	       	       	       	       	;Note: handle t
   201  0100                   	       	       	       	       	;central to man
   202  0100                   	       	       	       	       	;program.
