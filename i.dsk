   520  0301  CDAE11           	CALL   	START_DRIVE_1  	       	;Select for "th
   521  0304  CD2D0E           	CALL   	HOME   	
   522  0307  C4A012           	CALL   	NZ,SHOW_ERRORS 	       	;print out erro
   523  030A            
   524  030A  210050           	LD     	HL,FBUFFER     	       	;Sector data to
   525  030D  224000           	LD     	(TADDR),HL     	       	;Setup DMA addr
