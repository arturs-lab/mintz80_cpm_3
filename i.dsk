  3868                  ;====================== SUPPORT ROUTINES ==============
  3869                  ;
  3870  1A4E  7E        PMSG:  	LD     	A,(HL) 	       	;PRINT MESSAGE STRING i
  3871  1A4F  B7               	OR     	A
  3872  1A50  C8               	RET    	Z
  3873  1A51  4F               	LD     	C,A
  3874  1A52  CD1B01           	CALL   	CO
  3875  1A55  23               	INC    	HL
  3876  1A56  C34E1A           	JP     	PMSG
  3877                  ;
  3878  1A59  CD1201    GETCMD:	CALL   	CI     	       	;GET A CHARACTER, conve
  3879  1A5C  CD7A1A           	CALL   	UCASE
  3880  1A5F  FE1B             	CP     	A,ESC
  3881  1A61  C8               	RET    	Z      	       	;Don't echo an ESC
  3882  1A62  F5               	PUSH   	AF     	       	;Save it
  3883  1A63  C5               	PUSH   	BC
  3884  1A64  4F               	LD     	C,A
  3885  1A65  CD1B01           	CALL   	CO     	       	;Echo it
  3886  1A68  C1               	POP    	BC
  3887  1A69  F1               	POP    	AF     	       	;get it back
  3888  1A6A  C9               	RET
  3889  1A6B            
  3890  1A6B  F5        ZCRLF: 	PUSH   	AF     	       	;Send CR/LF to CRT
  3891  1A6C  C5               	PUSH   	BC
  3892  1A6D  0E0D             	LD     	C,CR
  3893  1A6F  CD1B01           	CALL   	CO
  3894  1A72  0E0A             	LD     	C,LF
  3895  1A74  CD1B01           	CALL   	CO
  3896  1A77  C1               	POP    	BC
  3897  1A78  F1               	POP    	AF
  3898  1A79  C9               	RET
  3899                  ;      	       	       	       	;Convert LC to UC
  3900  1A7A  FE61      UCASE: 	CP     	A,'a'  	       	;must be >= lowercase a
  3901  1A7C  D8               	RET    	C      	       	; else go back...
  3902  1A7D  FE7B             	CP     	A,'z'+1	       	;must be <= lowercase z
  3903  1A7F  D0               	RET    	NC     	       	; else go back...
  3904  1A80  D620             	SUB    	A,'a'-'A'      	;subtract lowercase bia
  3905  1A82  C9               	RET
  3906                  ;
  3907                  ;
  3908                  ; Return with 2 HEX digits in [A]. If abort, Carry flag
  3909  1A83            GET_HEX:
  3910  1A83  C5               	PUSH   	BC     	       	       	
  3911  1A84  CD591A           	CALL   	GETCMD 	       	;Get a character from k
  3912  1A87  FE1B             	CP     	A,ESC
  3913  1A89  282A             	JR     	Z,HEX_ABORT
  3914  1A8B  FE2F             	CP     	'/'    	       	;check 0-9, A-F
  3915  1A8D  3826             	JR     	C,HEX_ABORT
  3916  1A8F  FE47             	CP     	'F'+1
  3917  1A91  3022             	JR     	NC,HEX_ABORT
  3918  1A93  CDCC1A           	CALL   	ASBIN  	       	;Convert to binary
  3919  1A96  CB27             	SLA    	A
  3920  1A98  CB27             	SLA    	A
  3921  1A9A  CB27             	SLA    	A
  3922  1A9C  CB27             	SLA    	A      	       	;Shift to high nibble  
  3923  1A9E  47               	LD     	B,A    	       	;Store it
  3924  1A9F  CD591A           	CALL   	GETCMD 	       	;Get 2nd character from
  3925  1AA2  FE1B             	CP     	A,ESC
  3926  1AA4  280F             	JR     	Z,HEX_ABORT
  3927  1AA6  FE2F             	CP     	'/'    	       	;check 0-9, A-F
  3928  1AA8  380B             	JR     	C,HEX_ABORT
  3929  1AAA  FE47             	CP     	'F'+1
  3930  1AAC  3007             	JR     	NC,HEX_ABORT
  3931  1AAE  CDCC1A           	CALL   	ASBIN  	       	;Convert to binary
  3932  1AB1  B0               	OR     	A,B    	       	;add in the first digit
  3933  1AB2  B7               	OR     	A,A    	       	;To return NC
  3934  1AB3  C1               	POP    	BC
  3935  1AB4  C9               	RET
  3936  1AB5            HEX_ABORT:
  3937  1AB5  37               	SCF    	       	       	;Set Carry flag 
  3938  1AB6  3E1B             	LD     	A,ESC
  3939  1AB8  C1               	POP    	BC
  3940  1AB9  C9               	RET
  3941                  ;
  3942                  ;
  3943                  ; Put 4 HEX characters in [HL] (To set RAM location etc
