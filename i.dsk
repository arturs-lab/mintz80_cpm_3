   281                  ;Simply tests head movement control
   282  01EB            SEEK_TEST:
   283  01EB  219E16           	LD     	HL,SEKMSG
   284  01EE  CDA30B           	CALL   	PMSG
   285  01F1  AF               	XOR    	A,A
   286  01F2  324300           	LD     	(TRK),A	       	;Start at track 0
   287  01F5            
   288  01F5  CD4D08           	CALL   	HOME1  	       	;Move head to Track 0
   289  01F8  C4E30A           	CALL   	NZ,SHOW_ERRORS 	;If error show error fl
   290  01FB                   	
   291  01FB  217B16           	LD     	HL,AT0MSG
   292  01FE  CDA30B           	CALL   	PMSG
   293  0201  3A4300    SEKT:  	LD     	A,(TRK)
   294  0204  3C               	INC    	A
   295  0205  DDBE01           	CP     	A,(IX+NTRKS)   	;get max tracks on this
   296  0208  28E1             	JR     	Z,SEEK_TEST    	;start again
   297  020A            
   298  020A  324300           	LD     	(TRK),A	       	;Store for next time
   299  020D            
   300  020D  CD7708           	CALL   	SEEK_TRACK_NV  	;Seek with no verify co
   301  0210  2806             	JR     	Z,FINE5
   302  0212  CDE30A           	CALL   	SHOW_ERRORS    	;If Error show error fl
   303  0215  CDC00B           	CALL   	ZCRLF
   304  0218            FINE5:
   305  0218  CD9808           	CALL   	READ_ID	       	;Get current track ID
   306  021B  2817             	JR     	Z,FINE4
   307  021D  CDE30A           	CALL   	SHOW_ERRORS    	;print out the track ID
   308  0220  218E16           	LD     	HL,ATYMSG      	;For Track 
   309  0223  CDA30B           	CALL   	PMSG
   310  0226  3A4300           	LD     	A,(TRK)	       	;Say what track we are 
   311  0229  CD170C           	CALL   	PACC   	       	;Display current track 
   312  022C  219A16           	LD     	HL,ATX2MSG
   313  022F  CDA30B           	CALL   	PMSG
   314  0232  1815             	JR     	SEKT1
   315  0234  218516    FINE4: 	LD     	HL,ATXMSG      	;CR,LF,Track'
   316  0237  CDA30B           	CALL   	PMSG
   317  023A  3A4300           	LD     	A,(TRK)	       	;Say what track we are 
   318  023D  CD170C           	CALL   	PACC   	       	;Display current track 
   319  0240  219A16           	LD     	HL,ATX2MSG
   320  0243  CDA30B           	CALL   	PMSG
   321  0246  CDDB0D    FINE3: 	CALL   	SHOW_ID	       	;Show track ID
   322  0249  CD4A0C    SEKT1: 	CALL   	CHECKABORT     	;SP will halt, ESC will
   323  024C  3A981E           	LD     	A,(CMD_STORE)  	;So we dont pick up oth
   324  024F  C0               	RET    	NZ     	       	;Return back to main me
   325  0250  18AF             	JR     	SEKT
   326                  ;
   327                  ; ------------------- READ SECTORS TEST -------------
   328                  ; This routine will sequentially read all sectors on a 
   329                  ; if a 2 sided disk.
   330                  ;
   331  0252            SEC_READ_TEST:
   332  0252  21701A           	LD     	HL,RDTST_MSG
   333  0255  CDA30B           	CALL   	PMSG
   334  0258  AF               	XOR    	A,A    	       	;Setup for the BIOS bel
   335  0259  324300           	LD     	(TRK),A	       	;Start with track 0 
   336  025C  324400           	LD     	(SIDE),A       	;Start on Side A 
   337  025F  3C               	INC    	A
   338  0260  324500           	LD     	(SCTR),A       	;Start at sector 1 
   339  0263  CD610A           	CALL   	DRVSET 	       	;Select the drive in ha
   340  0266  CD4D08           	CALL   	HOME1  	       	
   341  0269  C4E30A           	CALL   	NZ,SHOW_ERRORS 	;print out errors if an
   342  026C            
   343  026C  21B216    RDTST1:	LD     	HL,ATTRK       	;Announce current track
   344  026F  CDA30B           	CALL   	PMSG
   345  0272  3A4300           	LD     	A,(TRK)	       	
   346  0275  CD170C           	CALL   	PACC
   347  0278  21BE16           	LD     	HL,ATSEC       	;and sector position
   348  027B  CDA30B           	CALL   	PMSG
   349  027E  3A4500           	LD     	A,(SCTR)       	       	
   350  0281  CD170C           	CALL   	PACC
   351  0284                   	
   352  0284  DDCB0C66         	BIT    	4,(IX+HW_BYTE) 	;Is it a 1 or 2 sided d
   353  0288  2816             	JR     	Z,SKIP_SIDES   	;If 1 sided then skip s
   354  028A  3A4400           	LD     	A,(SIDE)       	;which side WILL we wri
   355  028D  B7               	OR     	A,A
   356  028E  2008             	JR     	NZ,ON_B_SIDE
   357  0290  21CA16           	LD     	HL,HEAD0_MSG   	;Announce side 0 (or A)
   358  0293  CDA30B           	CALL   	PMSG
   359  0296  180E             	JR     	REED
   360  0298            ON_B_SIDE:
   361  0298  21D516           	LD     	HL,HEAD1_MSG   	;Announce side 1 (or B)
   362  029B  CDA30B           	CALL   	PMSG
   363  029E  1806             	JR     	REED
   364  02A0            SKIP_SIDES:
   365  02A0  21E016           	LD     	HL,HEADX_MSG   	;If SS disk, no need fo
   366  02A3  CDA30B           	CALL   	PMSG
   367  02A6            REED:
   368  02A6  210030           	LD     	HL,FBUFFER     	;Place sector data here
   369  02A9  224000           	LD     	(TADDR),HL     	;Setup DMA address for 
   370  02AC            
   371  02AC  CD6A08           	CALL   	SEEK_TRACK_V   	;Seek with verify comma
   372  02AF  C4E30A           	CALL   	NZ,SHOW_ERRORS 	;If any show error flag
   373  02B2            
   374  02B2  CDBE08           	CALL   	READ_SECTOR    	;<<<<<<<< Read 1 Sector
   375  02B5  C4E30A           	CALL   	NZ,SHOW_ERRORS 	;If any show error flag
   376  02B8            
   377  02B8  3A911E           	LD     	A,(CRTDISP)    	;Do we have the more de
   378  02BB  B7               	OR     	A,A
   379  02BC  C4140E           	CALL   	NZ,SEC_DISPLAY 	;If yes, then list the 
   380  02BF            
   381  02BF  3A4500           	LD     	A,(SCTR)
   382  02C2  3C               	INC    	A      	       	;Get next sector
   383  02C3  47               	LD     	B,A    	       	;Store new sec # in B
   384  02C4  3D               	DEC    	A      	       	;Because sectors are nu
   385  02C5  DDBE00           	CP     	A,(IX+NSCTRS)  	;Have we done a complet
   386  02C8  2035             	JR     	NZ,NOTEND
   387  02CA            
   388  02CA  3E01             	LD     	A,1    	       	;Back to sector 1 no ma
   389  02CC  324500           	LD     	(SCTR),A       	;Store for loop test
   390  02CF            
   391  02CF                   	       	       	       	       	;Sides swap che
   392  02CF  DDCB0C66         	BIT    	4,(IX+HW_BYTE) 	;Is it a 1 or 2 sided d
   393  02D3  2819             	JR     	Z,NO_SIDES     	;If 1 sided then skip s
   394  02D5            
   395  02D5  3A4400           	LD     	A,(SIDE)
   396  02D8  B7               	OR     	A,A    	       	;If 0 we have done A si
   397  02D9  2809             	JR     	Z,GOTO_B_SIDE  	;switch over to B side
   398  02DB  AF               	XOR    	A,A
   399  02DC  324400           	LD     	(SIDE),A
   400  02DF  CD850A           	CALL   	SET_SIDE       	;update the hardware
   401  02E2  180A             	JR     	NO_SIDES       	;Need track increase no
   402  02E4            GOTO_B_SIDE:
   403  02E4  3E80             	LD     	A,80H
