   396  02DB  AF               	XOR    	A,A
   397  02DC  324400           	LD     	(SIDE),A
   398  02DF  CDAF09           	CALL   	SET_SIDE       	;update the hardware
   399  02E2  180A             	JR     	NO_SIDES       	;Need track increase no
