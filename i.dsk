   140        (0054)    CMD    	EQU    	54H    	       	;COMMAND PORT
   141                  ;
   142                  ;Note: the 1791/5 chip for most commands used bits 0&1 
   143                  ;motor stepping rate. 00 being 3ms (@2MH clock),11 bein
   144                  ;Tandon 8" drives take the fastest rate. Older drives m
   145                  ;
   146        (000C)    RSCMD  	EQU    	00001100B      	;(0CH),RESTORE CMD     
   147        (0018)    SKNCMD 	EQU    	00011000B      	;(18H),SEEK NO VERIFY C
   148        (001C)    SKCMD  	EQU    	00011100B      	;(1CH),SEEK WITH VERIFY
   149        (00C4)    RDACMD 	EQU    	11000100B      	;(C0H),READ TRACK/SECTO
   150        (005C)    STEPIN 	EQU    	01011100B
   151  0100                   	
   152  0100                   	IF     	CHIP_1791
   153        (0080)    RDCMD91	EQU    	10000000B      	;(80H),READ SECTOR CMD 
   154        (00A0)    WRCMD91	EQU    	10100000B      	;(A0H),WRITE SECTOR CMD
   155  0100                   	endif
   156  0100            
   157                         	IF     	CHIP_1795
   158                  RDCMD95	EQU    	10000000B      	;(80H),READ SECTOR CMD 
   159                  WRCMD95	EQU    	10100000B      	;(A0H),WRITE SECTOR CMD
   160  0100                   	ENDIF
   161  0100            
   162        (00F4)    WRTCMD 	EQU    	11110100B      	;(F4H),Write a whole tr
   163        (00E4)    RDTCMD 	EQU    	11100100B      	;(E4H),Read a whole tra
   164                  ;
   165                  ;
   166        (0004)    RETRY_MAX EQU  	4      	       	;Number of times to try
   167        (0080)    HOME_ERR_MASK   EQU 80H	       	;Error mask for Type I 
   168        (0090)    SK_ERR_MASK     EQU 090H       	;Track Seek error bits 
   169        (009F)    ID_ERR_MASK     EQU 9FH	       	;Sector ID read error m
   170        (00BF)    RS_ERR_MASK     EQU 0BFH       	;Read sector data error
   171        (00EF)    WS_ERR_MASK    	EQU 0EFh       	;Write sector data erro
   172        (0080)    RT_ERR_MASK     EQU 80H	       	;Read Track error mask
   173        (00E0)    WT_ERR_MASK     EQU 0E0H       	;Write Track error mask
   174                  ;
   175                  ;
   176        (4000)    FBUFFER	EQU    4000H   	       	;Buffer to build track 
   177        (5000)    FBUFFER2 EQU   5000H   	       	;2nd buffer here for se
   178                  ;
   179                  ;The Index register IX is used throughout the program t
   180                  ;table of the currently selected drive/disk format
   181                  ;[IX+HW_BYTE] will point to (DRIVE) and will contain th
   182                  ;hardware selection bits. Drive select 0,1,2,3 and side
   183                  ;other flags (see below) 
