   482  02BF  3D               	DEC    	A      	       	       	;Because sector
   483  02C0  DDBE00           	CP     	A,(IX+NSCTRS)  	       	;Have we done a
   484  02C3  2016             	JR     	NZ,SECTRK_DONE1
   485  02C5            
