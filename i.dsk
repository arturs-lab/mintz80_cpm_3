   213        (000E)    SPECIAL_FLAG   EQU 14  	;flag byte for cases where afte
   214  0100                   	       	       	;normally 0, CPM86_FLAG = 1
   215        (000F)    SKEW   	       EQU 15  	;Low address of sector skew tab
   216        (0010)    SKEW1          EQU 16  	;High address of sector skew ta
   217        (0011)    TITLE  	       EQU 17  	;Text string describing the dis
