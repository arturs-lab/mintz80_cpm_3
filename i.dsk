еееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее„ФРР d4•dT8=Y@AIVECЃђSХ‘PаdДхdT8	9-	@CRDMAЃђФ‘Таdd”дdшIM2@FXЃђTФђС dФЕD”шI5@ERDSKЃђQQP`d$dДu8Q@HOURЃRS D4T8эI)5B@MXTPA”␀␀M@␀#„_Щ%Y8IэђУХ‘Pг„ЯЩ%Y8QэђSХ‘Pг…_Щ1=Y8kэђ“’Р‘Ј‡џЩI58}эђФ‘Тг‡яЩY%9>8ѓэђ‘TСS#€Нb8‰эђTФђС#‰_Щ51Q%>8—эђT“QcЉ?ЩIM.8©эђQQPcЉяЩ	1N8±эPUc‹_Х!=UJ8·эRSЈ‹џСM8їэЏСT’“T#Њ_Щ5aQAp␀␀ћ- Rick Conn
; v1.0 - 05/18/84	Modified to be consistent in the ZCPR3 tool set.
;					- Rick Conn
;
; Contributors:
;	v1.6 - Dave Rand
;	v1.5 - Irv Hoff
;	v1.4 - Paul Traina
;	v1.3 - Irv Hoff
;	v1.2 - Charlie Strom
;	v1.1 - Bruce Blakeslee
; 	v1.0 - Retyped from Interface Age (Dec 81).	- Henry Rothberg
;
;
; System equates:
;
; Minor changes by Peter Schorn for CP/M 3 (19-Jan-2002)

	.Z80

BOOT	EQU	0000H		;CP/M WARM BOOT JUMP VECTOR
BDOS	EQU	BOOT+05H	;CP/M BDOS CALL JUMP VECTOR
TBUFF	EQU	BOOT+80H	;DISK I/O BUFFER
FCB	EQU	BOOT+5CH	;DEFAULT FILE CONTROL BLOCK
FCB2	EQU	BOOT+6CH	;SECONDARY FILE CONTROL AREA
CR	EQU	'M'-'@'		;CTL-M FOR CARRIAGE RETURN
LF	EQU	'J'-'@'		;CTL-J FOR LINE FEED
CTRLC	EQU	'C'-'@'		;ABORT
PRINTST	EQU	9
CONOUTC	EQU	2
VERSCMD	EQU	0CH
;
	ASEG	
	ORG	100H
;
; Start of Program -- Initialize ZCPR3 Environment
;
	LD	HL,0		;SAVE STACK PTR
	ADD	HL,SP
	LD	(STACK),HL
	LD	HL,CEND
	LD	(FNTAB),HL	;SET PTR TO FILE NAME TABLE
	LD	DE,512		;1/2 K
	ADD	HL,DE
	LD	SP,HL		;NEW STACK
	CALL	GETVERS
	CALL	HELLO		;SIGN ON MESSAGE
	CALL	HELPCHK		;CHECK FOR AND PRINT HELP MESSAGE
	CALL	PCHECK		;CHECK PARAMETERS
	LD	A,(FNCOUNT)	;NUMBER OF FILES SPECIFIED
	OR	A		;0=NONE
	CALL	NZ,TRYFIX	;DO THE RECOVERY
	CALL	BYE		;SIGN OFF MESSAGE
	JP	BOOT		;RETURN TO CP/M
MSG1:	DB	'UNERASE Version '
	DB	(VERS/10) + '0', '.', (VERS MOD 10) + '0', '$'
MSG2:	DB	CR,LF,'File(s) Recovered - DOUBLE CHECK Before Using$'
MSG3:	DB	CR,LF,'NO Files Recovered$'
MSG4:	DB	CR,LF,'Invalid Option -- $'
MSG5:	DB	CR,LF,'File(s) Recovered --$'
MSG6:	DB	CR,LF,'Erased File(s) --$'
MSG7:	DB	CR,LF,'ABORT - Error During Disk Write$'
MSG8:	DB	CR,LF,'Syntax:'
	DB	CR,LF,'  UNERASE afn,afn,afn,... o'
	DB	CR,LF,'Options:'
	DB	CR,LF,'  L - List Erased Files Only'
	DB	CR,LF,'  P - Pause for disk change'
	DB	CR,LF,'  Z - Place file in User 0 '
	DB	'(default is current)$'
MSG9:	DB	CR,LF,'ABORT - Illegal Disk Requested$'
MSG10:	DB	CR,LF,'  $'
MSG11:	DB	CR,LF,'Change Disk - Hit ^C to Abort, Anything Else to Cont - $'
MSG12:	DB	CR,LF,'$'
;
; ** Main Routines **
;
PRINT	MACRO	TEXT
	PUSH	DE
	LD	DE,TEXT
	CALL	DOPRNT
	POP	DE
	ENDM
	
DOPRNT:	PUSH	AF
	PUSH	BC
	PUSH	HL
	LD	C,PRINTST
	CALL	BDOS
	POP	HL
	POP	BC
	POP	AF
	RET	
COUT:	PUSH	BC
	PUSH	HL
	PUSH	DE
	LD	C,CONOUTC
	LD	E,A
	CALL	BDOS
	POP	DE
	POP	HL
	POP	BC
	RET	
GETVERS:
	LD	C,VERSCMD
	CALL	BDOS
	LD	A,L
	LD	(CPMVRS),A
	RET
;
; SAY WHO WE ARE
;
HELLO:	PRINT	MSG1
	RET	
;
; CHECK FOR VALID PARAMETERS AND SAY WHICH CP?M VERSION
;
PCHECK:	CALL	OPTCHK		;CHECK FOR OPTIONS AND SET FLAGS
	CALL	FCBCHK		;MAKE SURE FILE SPECIFIED
	CALL	CPMCHK		;ESTABLISH CP/M PARAMETERS
	CALL	PUSCHK		;CHECK IF USER WANTS TO CHANGE DISK
	RET	
;
; LOOK THROUGH DIRECTORY
;
TRYFIX:	CALL	NXTSEC		;GET A DIRECTORY SECTOR
	RET	Z␀		;RETURNS ZERO FLAG IF NO MORE
	CALL	CHKENT		;CHECK IT OUT AND MAYBE FIX
	JP	TRYFIX		;KEEP IT UP TILL DONE
;
; SIGN OFF AND RESET SYSTEM
;
BYE:	LD	C,13		;SYSTEM RESET
	CALL	BDOS
	LD	A,(LISTFL)	;LIST ONLY?
	OR	A		;0=NO
	JP	NZ,PRNF
	LD	A,(FIXCNT)	;CHECK FOR ACTIVITY
	OR	A
	JP	Z␀,PRNF		;SAY NONE FOUND
	PRINT	MSG2
	RET	
PRNF:	PRINT	MSG3
	RET	
;
; CHECKS FOR P AND 0 OPTIONS IN COMMAND LINE
;
OPTCHK:	XOR	A		;TURN OFF FLAGS
	LD	(CURUSR),A
	LD	(PAUSE),A
	LD	(FIXCNT),A
	LD	(LISTFL),A
	LD	(FNCOUNT),A	;NO FILE NAMES
	LD	HL,1		;SET SECTOR 1
	LD	(SECTOR),HL
	LD	HL,TBUFF	;SCAN THRU TBUFF, BUILDING A FILE NAME TABLE
	LD	A,(HL)		;GET CHAR COUNT
	INC	HL		;PT TO FIRST CHAR
	PUSH	HL		;SAVE PTR
	ADD	A,L		;PT TO AFTER LAST CHAR
	LD	L,A
	LD	(HL),0		;STORE ENDING ZERO
	LD	HL,(FNTAB)	;PT TO TABLE
	EX	DE,HL		;... IN DE
	POP	HL		;GET PTR TCP/M RMAC ASSEM 1.1	#001	BOOT LOADER MODULE FOR CP/M 3.0

                	title	'Boot loader module for CP/M 3.0'
                
 FFFF =         true equ -1
 0000 =         false equ not true
                
 FFFF =         banked	equ true
 0000 =         vdp		equ false
 0000 =         debug 	equ false
                
                	public	?init,?ldccp,?rlccp,?time
                	extrn	?pmsg,?conin
                	extrn	@civec,@covec,@aivec,@aovec,@lovec
                	extrn 	@cbnk,?bnksl,dumpivars
                	;extrn 	spamon,spamoff
                	extrn 	iputs,dumpregs,ictc3,usrfunc
                	extrn 	RIX,RIY
                
                	maclib ports
                	maclib z80
                
 0005 =         bdos	equ 5
                
                	if banked
 0001 =         tpa$bank	equ 1
 000E =         ccp$bank	equ 0Eh
                	else
                tpa$bank	equ 0
                ccp$bank	equ 0Eh
                	endif
                
                	dseg	; init done from banked memory
                
                ?init:
                if debug
                	call iputs
                	db '?INIT ',0
                endif
 0000 2A00002200	lhld RIY ! shld @civec 		; CIVEC from ROM Setup
 0006 220000    	;lxi h,08000h ! shld @civec 
 0009 2A00002200	lhld RIX ! shld @covec		; COVEC from ROM setup
 000F 220000    	;lxi h,09000h ! shld @covec	; assign console to CRT:
 0012 2100202200	lxi h,02000h ! shld @lovec 					; assign printer to LPT:
 0018 2100402200	lxi h,04000h ! shld @aivec ! shld @aovec	; assign AUX to CRT1:
                	;call ictc0
 0021 CD0000    	call ictc3	
 0024 217F00CD00	lxi h,signon$msg ! call ?pmsg		; print signon message
 002A C9        	ret	
                
                ;out$blocks:
 002B B7C847    	;mov a,m ! ora a ! rz ! mov b,a
 002E 4E23      	;inx h ! mov c,m ! inx h
                	;outir
                	;jmp out$blocks
                
                
                	cseg	; boot loading most be done from resident memory
CP/M RMAC ASSEM 1.1	#002	BOOT LOADER MODULE FOR CP/M 3.0

                	
                    ;	This version of the boot loader loads the CCP from a file
                    ;	called CCP.COM on the system drive (A:).
                
                
                ?ldccp:
                if debug
                	call iputs
                	db '?LDCCP ',0
                endif	
                	; First time, load the A:CCP.COM file into TPA
 0000 AF32CE00  	xra a ! sta ccp$fcb+15		; zero extent
 0004 21000022DF	lxi h,0 ! shld fcb$nr		; start at beginning of file
 000A 11BF00CD5D	lxi d,ccp$fcb ! call open	; open file containing CCP
 0010 3CCA3A00  	inr a ! jz no$CCP			; error if no file...
 0014 110001CD62	lxi d,0100h ! call setdma	; start of TPA
 001A 118000CD67	lxi d,128 ! call setmulti	; allow up to 16k bytes
 0020 3E01CD0000	mvi a,tpa$bank ! call ?bnksl	; select TPA
 0025 11BF00CD6C	lxi d,ccp$fcb ! call read	; load the thing
                					; now, copy CCP to bank 0 for reloading
 002B 3A0000F5  	lda @cbnk ! push psw		; save current bank
                	
 002F 010300    	lxi b,0003h					; B=0=sys,C=3=save CCP
 0032 CD0000    	call usrfunc
                
                if vdp	
                	lxi b,0001h					; B=0=sys,C=1=Init
                	lxi d,08000h				; window base=common memory
                	call usrfunc
                
                	lxi b,0103h					; B=1=vdp,C=3=read font
                	lxi h,08000h				; save to common memory
                	call usrfunc
                
                	lxi b,0000h					; B=0=sys,C=0=RW block
                	lxi d,01E2h					; D=1=write, block number E2 (E0+E1 used for CCP)
                	call usrfunc
                
                	lxi b,0104h					; B=1=vdp,C=4=convert font
                	lxi h,08000h				; save to common memory
                	call usrfunc
                
                	lxi b,0000h					; B=0=sys,C=0=RW block
                	lxi d,01E3h					; D=1=write, block number E3 (E0+E1 used for CCP, E2=ANSI font)
                	call usrfunc
                endif
                
 0035 F1CD0000  	pop psw ! call ?bnksl		; restore original bank
                if debug
                	call iputs
                	db '/LDCCP ',13,10,0
                endif	
                	
 0039 C9        	ret
                
                no$CCP:			; here if we couldn't find the file
CP/M RMAC ASSEM 1.1	#003	BOOT LOADER MODULE FOR CP/M 3.0

 003A 219E00CD00	lxi h,ccp$msg ! call ?pmsg	; report this...
 0040 CD0000    	call ?conin			; get a response
 0043 C30000    	jmp ?ldccp			; and try again
                
                ?rlccp:
 0046 010400    	lxi b,0004h					; B=0=sys,C=4=load CCP
 0049 CD0000    	call usrfunc
                
 004C 010100    	lxi b,0001h					; B=0=sys,C=1=Init
 004F 110080    	lxi d,08000h				; window base=common memory
 0052 CD0000    	call usrfunc
                
 0055 010101    	lxi b,0101h					; B=1=vdp,C=1=Init
 0058 CD0000    	call usrfunc
                
                if vdp	
                	lxi b,0000h					; B=0=sys,C=0=RW block
                	lxi d,00E3h					; D=0=read, block number E3 (font with inverted upper chars)
                	call usrfunc
                
                	lxi b,0102h					; B=1=vdp,C=2=load font
                	lxi h,08000h				; read from common memory
                	call usrfunc
                endif
 005B C9        	ret
                
                    ; No external clock.
                ?time:
 005C C9        	ret
                
                	; CP/M BDOS Function Interfaces
                
                open:
 005D 0E0FC30500	mvi c,15 ! jmp bdos		; open file control block
                
                setdma:
 0062 0E1AC30500	mvi c,26 ! jmp bdos		; set data transfer address
                
                setmulti:
 0067 0E2CC30500	mvi c,44 ! jmp bdos		; set record count
                
                read:
 006C 0E14C30500	mvi c,20 ! jmp bdos		; read records
                
 0071 0D0A42444Fopnmsg		db 	13,10,'BDOS OPEN: ',0
                
 007F 1A0D0A4350signon$msg	db	1Ah,13,10,'CP/M Plus for Z80 Retro!',13,10,10,0
                			
 009E 0D0A42494Fccp$msg		db	13,10,'BIOS Err on A: No CCP.COM file',0
                
 00BF 0143435020ccp$fcb		db	1,'CCP     ','COM',0,0,0,0
 00CF           		ds	16
 00DF 000000    fcb$nr		db	0,0,0
                
 00E2           end
ECIFIED AND CHECK FOR HELP
;
FCBCHK:	LD	A,(FCB)		;GET DRIVE SPECIFICATION
	OR	A		;SEE IF DEFAULT
	JP	NZ,FCBCK1	;NO, GO CHECK FILENAME
	LD	C,25		;ASK FOR CURRENT DRIVE
	CALL	BDOS
	INC	A		;OFFSET FOR NEXT INSTRUCTION
FCBCK1:	DEC	A		;CURRENT DRIVE NUMBER
	LD	(FCB),A		;SAVE IT
	RET	
;
; CHECK FOR HELP REQUEST
;
HELPCHK:	
	LD	A,(FCB+1)	;GET 1ST BYTE OF FILENAME
	CP	'/'		;HELP?
	JP	Z␀,HCK1
	CP	' '		;MAKE SURE IT IS NON-BLANK
	RET	NZ		;OK - KEEP GOING
;	
; IF NO FILE NAME IS SPECIFIED, ABORT WITH NOTICE
;
HCK1:	PRINT	MSG8
CLEANRET:	
	LD	HL,(STACK)	;QUIET RETURN
	LD	SP,HL
	RET	
;
; GET BIOS JUMPS VECTORS FOR EASY REFERENCE
;
GTBIOS:	LD	HL,(BOOT+1)	;POINTS TO BIOS JUMP TABLE+3
	LD	DE,WBOOT	;WHERE WE WILL KEEP A COPY
	LD	B,JUMPEND-JUMPST	;MOVE 48 BYTES AND FALL THRU TO MOVE
;
; GENERAL PURPOSE MOVE ROUTINE
; FROM 'HL' TO 'DE' FOR COUNT OF B
;
MOVE:	LD	A,(HL)		;GET A BYTE
	LD	(DE),A		;PUT A BYTE
	INC	DE		;INCREMENT TO NEXT
	INC	HL
	DEC	B		;COUNT DOWN
	JP	NZ,MOVE
	RET	
;
;SPECIFIED AN ILLEGAL DISK DRIVE - ABORT
;
ILDISK:	PRINT	MSG9
	JP	BOOT		;ABORT
;
; READS NEXT SECTOR (GROUP OF FOUR DIRECTORY ENTRIES)
; RETURNS WITH ZERO FLAG SET IF NO MORE
;
NXTSEC:	LD	HL,(DIRMAX)	;SEE IF MORE SECTORS
	LD	A,H
	OR	L
	RET	Z␀		;RETURNS ZERO FLAG IF NO MORE
	LD	HL,(TRACK)	;SET TRACK
	LD	C,L
	LD	B,H
	CALL	SETTRK
	LD	HL,(SECTOR)	;SET SECTOR
	DEC	HL		;sector needs to be 0 .. (SPT - 1)
	LD	B,H
	LD	C,L
	CALL	TRNSLT
	CALL	SETSEC
	LD	BC,80H		;FOR CP/M 3 we need to set the DMA alsoFFFF BANKED	0000 BC		0005 BDOS	000E CCPBANK	00BF CCPFCB
009E CCPMSG	0002 DE		0000 DEBUG	0000 DUMPIVARS	0000 DUMPREGS
0000 FALSE	00DF FCBNR	0004 HL		0000 ICTC3	0000 IPUTS
0004 IX		0004 IY		003A NOCCP	005D OPEN	0071 OPNMSG
0025 PBANKSELECT		000C PBAUDCON1	0030 PBAUDCON2	0031 PBAUDCON34
000E PBAUDLPT1	0032 PBAUDLPT2	0014 PBOOT	0011 PCENTDATA	0010 PCENTSTAT
002C PCON2DATA	002D PCON2STAT	002E PCON3DATA	002F PCON3STAT	002A PCON4DATA
002B PCON4STAT	0024 PCONFIGURATION		001C PCRTDATA	001D PCRTSTAT
0004 PFDCMND	0007 PFDDATA	0008 PFDINT	0009 PFDMISC	0006 PFDSECTOR
0004 PFDSTAT	0005 PFDTRACK	000F PINDEX	0028 PLPT2DATA	0029 PLPT2STAT
001E PLPTDATA	001F PLPTSTAT	0033 PRTC	0008 PSELECT	0004 PWD1797
000C PZCTC1	0030 PZCTC2	001C PZDART	0000 PZDMA	0008 PZPIO1
000A PZPIO1A	000B PZPIO1B	0010 PZPIO2	0012 PZPIO2A	0013 PZPIO2B
0024 PZPIO3	0026 PZPIO3A	0027 PZPIO3B	0028 PZSIO1	002C PZSIO2
006C READ	0000 RIX	0000 RIY	0062 SETDMA	0067 SETMULTI
007F SIGNONMSG	0001 TPABANK	FFFF TRUE	0000 USRFUNC	0000 VDP
0000 ?BNKSL	0000 ?CONIN	0000 ?INIT	0000 ?LDCCP	0000 ?PMSG
0046 ?RLCCP	005C ?TIME	0000 @AIVEC	0000 @AOVEC	0000 @CBNK
0000 @CIVEC	0000 @COVEC	0000 @LOVEC
A,L
	RRA	
	LD	L,A
	RET	
;
; TRANSLATE REG 'BC' FROM LOGICAL TO PHYSICAL SECTOR NUMBER
;
TRNSLT:	LD	HL,(DPH)	;GET ADDRESS OF XLTO
	EX	DE,HL
	CALL	SECTRAN		;USE BIOS ROUTINE
	LD	C,L		;RETURN VALUE IN BC
	LD	B,H
	RET	
; THIS IS THE WORKING COPY OF THE BIOS JUMP TABLE
;
JUMPST	EQU	$
WBOOT:	DS	3
CONST:	DS	3
CONIN:	DS	3
CONOUT:	DS	3
LIST:	DS	3
PUNCH:	DS	3
READER:	DS	3
HOME:	DS	3
SELDSK:	DS	3
SETTRK:	DS	3
SETSEC:	DS	3
SETDMA:	DS	3
READ:	DS	3
WRITE:	DS	3
LISTST:	DS	3
SECTRAN:	
	DS	3
conost:	DS	3		; return console output status
auxist:	DS	3		; return aux device input status
auxost:	DS	3		; return aux device output status
devtbl:	DS	3		; return address of character i/o table
devini:	DS	3		; init character i/o devices
drvtbl:	DS	3		; return address of disk drive table
multio:	DS	3		; set number of consec. sec. to read/write
flush:	DS	3		; flush user [de]blocking buffers
movem:	DS	3		; copy memory to memory
time:	DS	3		; signal time and date operation
selmem:	DS	3		; select memory bank
setbnk:	DS	3		; set bank for next dma
xmove:	DS	3		; set banks for next move
JUMPEND	EQU	$
;
STACK:	DS	2		;LOCATION OF STACK
;
; DATA AREAS
;
FNCOUNT:	
	DS	1		;NUMBER OF FILE NAMES IN COMMAND LINE
CURUSR:	DS	1		;0 IF NOT IN CURRENT USER
PAUSE:	DS	1		;0 IF NO PAUSE FOR DISK CHANGE
LISTFL:	DS	1		;0 IF NOT LIST ONLY
DIRMAX:	DS	2		;NUMBER OF SECTORS IN DIRECTORY =
	;	MAXIMUM NUMBER OF DIRECTORY ENTRIES
	;	DIVIDED BY 4 (ENTRIES PER SECTOR)
TEMP:	DS	2		;TEMP STORAGE FOR FCB PRINT
EXTENT:	DS	1		;EXTENT MASK
MAXSEC:	DS	2		;MAXIMUM NUMBER OF SECTORS/TRACK
FIXCNT:	DS	1		;CHANGE FLAG
REWRT:	DS	1		;REWRITE FLAG 0=NO, F=YES
SECTOR:	DS	2		;CURRENT SECTOR NUMBER
TRACK:	DS	2		;TRACK NUMBER OF DIRECTORY
CPMVRS:	DS	1		;Version number of CP/M
;
; ADDRESS OF THE TRANSLATE TABLE
;
DPH:	DS	16
FNTAB:	DW	2		;FILE NAME BUFFER
CEND	EQU	$

	END	
ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее!␀␀9"з!"␀щНяН	НАН:й·ДН)Г␀␀UNERASE Version 1.2$
