  2769  12D9  2811             	JR     	Z,DISP1
  2770  12DB  FE01             	CP     	A,1
  2771  12DD  110001           	LD     	DE,NBYTES*2    	;256 byte sectors
  2772  12E0  280A             	JR     	Z,DISP1
  2773  12E2  FE02             	CP     	A,2
