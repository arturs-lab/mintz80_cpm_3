GET_DMA_MSG	DB	CR,LF,	'Enter RAM loaction to recieve the data (Enter 4 HEX digits): ',0
LOADING_MSG:	DB	CR,LF,	'Loading data ',0
LOADING1_MSG:	DB	' To RAM at ',0
