                	;
                	;	REGISTERS:	[AF],[BC],[HL] UNALTERED
                	;
                PBUFF:
                	; SAVE REGISTER STATE:
 01F5 F5        	PUSH	PSW
 01F6 C5        	PUSH	B
 01F7 E5        	PUSH	H
                
                	; SEND BUFFER CHARACTERS TO CONSOLE UNTIL TERMINATOR RECOGNIZED:
 01F8 EB        	XCHG			;GET BUFFER ADDRESS TO [HL]
 01F9 7E        PBUFF0:	MOV	A,M		;GET NEXT BUFFER CHARACTER TO [A]
 01FA FE00      	CPI	DELIMITER	;BUFFER TERMINATOR ?
                	JRZ	PBUFF$RET	;YES -- RETURN TO CALLER...
 01FC+28        	DB	28H
 01FD+23        	DB	PBUFF$RET-$-1
 01FE FEFF      	CPI	PTRCMD		;POINTER TO NESTED STRING ?
                	JRNZ	PBUFFA		;NO CONTINUE ON BELOW...
 0200+20        	DB	20H
 0201+09        	DB	PBUFFA-$-1
                
                	; HERE TO DISPLAY A NESTED STRING -- TO BE SAFE YOU SHOULD ONLY
                	; NEST 1 OR 2 STRINGS AT THE MOST -- OUR STACK IS LIMITED YOU KNOW:
 0202 23        	INX	H		;GET NESTED STRING POINTER TO [DE]
 0203 5E        	MOV	E,M
 0204 23        	INX	H
 0205 56        	MOV	D,M
 0206 CDF501    	CALL	PBUFF		;OLD RECURSIVE JOE!
                	JR	PBUFF3		;CONTINUE BELOW WITH REST OF STRING...
 0209+18        	DB	18H
 020A+13        	DB	PBUFF3-$-1
                
                	; HERE IF NOT RECURSIVE CALL:
                PBUFFA:	BIT	7,A		;REPETITION BIT SET ?
