;	ENTRY:
;		REG HL	FILE NAME (12 CHARS )
;
;	EXIT:
;		REG A	STATUS	255 = NO FILE
;				1 = FILE OPENED
;
	REL
	ENTRY	DOPENR
DOPENR:	LD	DE,RFCB				;MOVE 
	LD	BC,12				;	FILE NAME
	LDIR					;	TO DCB
	MEM	SUB,(RDRV),64,(RDRV)		;MAKE DRIVE CODE
	MOV	(RCR),A,0			;SET CURRENT RECORD TO BEGINNING
	MOV	(REX),HL,0			;CLEAR
	LD	(RS2),HL			;	FCB
	LD	DE,RFCB				;READ
	CPMIO	15				;	NEXT BUFFER
	INC	A				;OPEN ERR?
	LD	A,1				;SUCCESS STATUS
	RET	NZ				;SUCCESS EXIT
	MOV	(RFIL),A,0			;INDICATE FILE NOT OPEN
	LD	A,255				;ERROR STAUS
	RET
;
	DATA
RFCB:
RDRV:	DS	1
RFIL:	DB	0
	DS	7
REXT:	DS	3
REX:	DS	1
RS1:	DS	1
RS2:	DS	1
RRC:	DS	1
	DS	16
RCR:	DS	1
	DS	2
	TITLE	CPM DISKIO	DCLOSR - CLOSE INPUT FILE
;
;	DCLOSR
;
;		CLOSE INPUT FILE
;
;	CALLING SEQUENCE:
;		STS = DCLOSR(IDMY)
;		CALL	DCLOSR
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
	ENTRY	DCLOSR
	REL
DCLOSR:	CPM	(RFIL),0	;FILE CLOSED?
	RET	Z		;YES, EXIT
	LD	DE,RFCB		;CLOSE
	CPMIO	16		;	FILE
	PUSH	AF		;INDICA	title	crtdrv.z80	CRT Driver Routines
	list	nogen
	verson	0,01,08,10,27,i.crtd,v.crtd,d.crtd
	list	off
*include mscequ.z80
	list	on
;
;	APUTS - DISPLAY CHAR OFFSET BY 32
;
APUTS:	MACRO	#REG,#VAL
	LD	A,#REG
	ADD	#VAL
	CALL	APUT
	MEND
;
;	APUT - DISPLAY CHAR ON CONSOLE
;
APUT:	MACRO	#VAL
	LD	A,#VAL
	CALL	APUT
	MEND
;
;	BINDF - convert binary to ascii
;
bindf:	macro	#var,#reslt
	ld	bc,#var
	ld	hl,#reslt
	call	bindf
	mend
;
;	PUTS - send character string to crt
;
PUTS:	macro	#string
	ld	hl,#string
	call	puts
	mend
	form
ESC	EQU	1BH
DLE	EQU	10H
VT	EQU	0BH
DC1	EQU	11H
RS	EQU	1EH
FORM	EQU	0CH
SUB	EQU	1AH
FS	EQU	1CH
ETB	EQU	17H
SI	EQU	0FH
GS	EQU	1DH
EOT	EQU	04H
BLANK	EQU	32
cr	equ	0dh
	title	POSR	Set cursor position
;	POSR
;
;		SET CURSOR TO SPECIFIED X Y COORDINATES
;
;	CALLING SEQUENCE:
;		LD	C,XADR
;		LD	B,YADR
;		CALL	POSR
;
;	ENTRY:
;		REG C	XADR - X COORD ADR (BYTE) (0,79)
;		REG B	YADR - Y COORD ADR (BYTE) (0,23)
;
;	EXIT:
;		ALL REGS PRESERVED
;
;
;	ASCII EQUATES
;
	ENTRY	POSR
	EXT	APUT,BINDF,CASE,TRMCOD
	REL
POSR:	PUSH	HL		;SAVE
	PUSH	DE		;	REGS
	PUSH	AF		;	...
	PUSH	BC		;SAVE CURSOR
	CASE	(TRMCOD),PLNG,PTAB	;CALCULATE CASE ADDR
	POP	BC			;GET CURSOR
	LD	DE,POSDON	;RETURN
	PUSH	DE		;	ADDRESS
	JP	(HL)
;
POSDON:	POP	AF		; RESTORE REG
	POP	DE		;RESTORE
	POP	HL		;	REGS
	RET
	form
PTAB:	DW	pos99		;OUT OF RANGE ERR
	DW	POS0		;BEEHIVE
	DW	POS1		;ADDS 580
	DW	POS2		;ADM 3A
	DW	POS3		;SOROC
	DW	POS4		;VDM
	DW	POS5		;HAZELTINE 1500
	DW	POS6		;VECTOR GRAPHIC MT
	DW	POS7		;PERKIN ELMER FOX
	DW	POS8		; HP 2621
	DW	POS9		; P-E BANTAM
	DW	POS10		; GNAT10
	DW	POS11		; TRS80 / P&T
	dw	pos12		; Zenith z89
	dw	pos13		; Televideo
	dw	pos14		; infoton
PLNG	EQU	[$-PTAB]/2-2
TTYCNT	EQU	PLNG		; NUMBER OF TERM TYPES
	FORM
POS0:	APUT	ESC		;BEEHIVE
	APUT	'F'
	APUTS	B,BLANK
	APUTS	C,BLANK
	RET
;
POS1:	APUT	DLE		;ADDS 580
	APUTS	B,BLANK
	APUT	VT
	APUTS	C,BLANK
	RET
;
POS13:				; Televideo
POS2:				;SOROC
POS3:				;ADM3A
POS10:	APUT	ESC		;GNAT10
	APUT	'='
	APUTS	B,BLANK
	APUTS	C,BLANK
	RET
;
POS4:	APUT	DLE		;VDM
	APUTS	C,0
	APUTS	B,0
	RET
;
POS5:	APUT	7EH		;HAZELTINE
	APUT	DC1
	APUTS	C,0
	APUTS	B,0
	RET
;
POS6:	APUT	ESC		;VECTOR GRAPHIC
	APUTS	C,0
	APUTS	B,0
	RET
;
POS9:				; P-E (BANTAM)
POS7:	APUT	ESC		;PERKIN ELMER (FOX)
	APUT	'X'
	APUTS	B,BLANK
	APUT	ESC
	APUT	'Y'
	APUTS	C,BLANK
	RET
;
POS8:	PUSH	BC		; SAVE XY COORD
	LD	B,0		; CONVERT
	LD	HL,XCASC	;	X COORDINATE
	CALL	BINDF		;	TO ASCII
	POP	BC		; CONVERT
	LD	C,B		;	Y COORDINATE
	LD	B,0		;	TO
	LD	HL,YCASC	;	ASCII
	CALL	BINDF		;	...
	APUT	ESC		; HP 2621
	APUT	'&'
	APUT	'a'
	APUT	(YCASC+3)
	APUT	(YCASC+4)
	APUT	'y'
	APUT	(XCASC+3)
	APUT	(XCASC+4)
	APUT	'C'
	RET
;
;
pos12:
POS11:	APUT	ESC		; P&T TRS80
	APUT	'Y'
	APUTS	B,BLANK
	APUTS	C,BLANK
	RET
;
pos14:	aput	esc		; Infoton
	aput	'f'
	aputs	c,blank
	aputs	b,blank
	ret
	form
pos99:	ld	a,(rowoff)	; add 
	add	b		;	row offset
	ld	(row),a		;	...
	ld	(cfrst),a	;	default row as first
	ld	a,(coloff)	; add 
	add	c		;	column
	ld	(col),a		;	offset
	ld	(csec),a	;	default column is second
	cpm	(colfst),true	; column number first?
	jr	nz,crs$1	; no
	mov	(cfrst),a,(col)	; yes, set column as first
	mov	(csec),a,(row)	; set row as second
crs$1:	puts	c$lead		; send leadin sequence
	cpm	(ascenc),true	; ascii encode row/column?
	jr	z,crs$2		; yes
	aput	(cfrst)		; no, send first position
	jr	crs$3
crs$2:	bindf	(cfrst),ascpos	; encode position to ascii
	aput	(ascpos+3)	; display first position char
	aput	(ascpos+4)	; send second position char
crs$3:	puts	c$mid		; send middle sequence
	cpm	(ascenc),true	; ascii encode row/column?
	jr	z,crs$4		; yes
	aput	(csec)		; no, send second position
	jr	crs$5
crs$4:	bindf	(csec),ascpos	; encode position into ascii
	aput	(ascpos+3)	; send first position char
	aput	(ascpos+4)	; send second position char
crs$5:	puts	c$end		; send trailing sequence
	mov	b,a,(crsnul)	; do null
	call	nulls		;	timing fill
	ret
;
	DATA
ascpos:	ds	0		; ascii encoded position
XCASC:	DS	6
YCASC:	DS	6
col:	db	0		; column position
row:	db	0		; row position
cfrst:	dw	0		; first position
csec:	dw	0		; second position
;
	entry	scntbl
	rel
scntbl:	ds	0
c$name:	ds	11		; ascii name of crt (count,string)
c$lead:	ds	11		; lead in sequence (count,string)
c$mid:	ds	11		; middle sequence (count,string)
c$end:	ds	11		; trailing sequence (count,string)
colfst:	ds	1		; column first flag (true=>1, false=>0)
coloff:	ds	1		; column offset
rowoff:	ds	1		; row offset
ascenc:	ds	1		; ascii encoding flag (true=>1, flase=>0)
crsnul:	ds	1		; cursor trailing nulls
csseq:	ds	11		; clear screen sequence (count,string)
csnul:	ds	1		; clear screen trailing nulls
clseq:	ds	11		; clear line sequence (count,string)
clnul:	ds	1		; clear line trailing nulls
	FORM
;
;	CLRSCN - CLEAR SCREEN
;
	ENTRY	CLRSCN
	REL
CLRSCN:	CASE	(TRMCOD),CLNG,CTAB	;COMPUTE CASE ADDR
	JP	(HL)			;DO CASE
;
CTAB:	DW	clr99	;OUT OF RANGE 
	DW	CLR0	;BEEHIVE
	DW	CLR1	;ADDS
	DW	CLR2	;ADM3A
	DW	CLR3	;SOROC
	DW	CLR4	;VDM
	DW	CLR5	;HAZELTINE
	DW	CLR6	;VECTOR GRAPHIC
	DW	CLR7	;PERKIN ELMER
	DW	CLR8	; HP 2621
	DW	CLR9	; PE BANTAM
	DW	CLR10	;GNAT10
	DW	CLR11	; P&T CP/M TRS80
	dw	clr12	; Zenith z89
	dw	clr13	; Televideo
	dw	clr14	; Infoton
CLNG	EQU	[$-CTAB]/2-2
;
clr12:
CLR0:	APUT	ESC		;BEEHIVE
	APUT	'E'
	LD	B,0FFH		; WAIT 255
	CALL	NULLS		;	CHAR TIMES
	RET
;
clr14:				; Infoton
CLR1:				;ADDS
CLR4:				;VDM
CLR11:				;TRS80 P&T
	APUT	FORM
	RET
;
CLR2:				;ADM3A
CLR10:	APUT	SUB		;GNAT10
	RET
;
CLR3:	APUT	ESC		; SOROC
	APUT	'*'		;
	LD	B,20		; WAIT 20
	CALL	NULLS		;	CHAR TIMES
	RET
	FORM
;
CLR5:	APUT	7EH		;HAZELTINE
	APUT	FS		;
	RET
;
CLR6:	APUT	EOT		; VG MINDLESS TERM
	RET
;
CLR7:	APUT	ESC		;P/E
	APUT	'K'		;
	RET
;
CLR8:	APUT	ESC		; HP 2621
	APUT	'H'		;
	APUT	ESC		;
	APUT	'J'		;
	RET
;
CLR9:	CALL	CLR7		; PE BANTAM
	LD	B,48		;
	CALL	NULLS		;
	RET
;
clr13:	aput	esc		; Televideo
	aput	'Y'
	ret
;
clr99:	puts	csseq		; send clear sequence
	mov	b,a,(csnul)	; send
	call	nulls		;	nulls
	ret
	FORM
;
;	CLRLIN - CLEAR TO END OF LINE
;
	ENTRY	CLRLIN
	REL
CLRLIN:	PUSH	BC			;SAVE
	PUSH	DE			;	REGS
	PUSH	HL			;	...
	CASE	(TRMCOD),LLNG,LTAB	;COMPUTE CASE
	LD	DE,CLLEXT		;RETURN
	PUSH	DE			;	ADDRESS
	JP	(HL)			;DO CASE
;
CLLEXT:	POP	HL			;RESTORE
	POP	DE			;	REGS
	POP	BC			;	....
	RET
;
LTAB:	DW	lin99	;OUT OF RANGE
	DW	LIN0	;BEEHIVE
	DW	LIN1	;ADDS
	DW	LIN2	;ADM3A
	DW	LIN3	;SOROC
	DW	LIN4	;VDM
	DW	LIN5	;HAZELTINE
	DW	LIN6	;V/G
	DW	LIN7	;P/E
	DW	LIN8	; HP2621
	DW	LIN9	; PE BANTAM
	DW	LIN10	; GNAT10
	DW	LIN11	; TRS80 P&T
	dw	lin12	; Zenith z89
	dw	lin13	; Televideo
	dw	lin14	; Infoton
LLNG	EQU	[$-LTAB]/2-2
	FORM
lin14:				; Infoton
lin12:
LIN0:	APUT	ESC		;BEEHIVE
	APUT	'K'
	RET
;
LIN1:				;ADDS
LIN2:	APUT	CR		; INSURE CURSOR AT BEGINNING OF LINE
	LD	B,79		; BLANK
L12:	APUT	BLANK		;	ENTIRE
	DJNZ	L12		;	LINE
	APUT	CR		; POSITION CURSOR AT BEGINNING OF LINE
	RET			;ADM3A
;
lin13:				; Televideo
LIN3:	APUT	ESC		;SOROC
	APUT	'T'
	RET
;
LIN4:	APUT	ETB		;VDM
	RET
;
LIN5:	APUT	7EH		;HAZELTINE
	APUT	SI
	RET
;
LIN6:	APUT	DC1		;V/G
	RET
;
LIN7:	APUT	ESC		;P/E
	APUT	'I'
	RET
;
LIN8:	APUT	ESC		; HP2621
	APUT	'K'
	RET
	FORM
LIN9:	CALL	LIN7		; PE BANTAM
	LD	B,20
	CALL	NULLS
	RET
;
LIN10:	APUT	ESC		;GNAT SYSTEM 10
	APUT	'$'
	RET
;
LIN11:	APUT	1		;TRS80 P&T
	RET
;
lin99:	puts	clseq		; send clear line sequence
	mov	b,a,(clnul)	; send
	call	nulls		;	nulls
	ret
;
NULLS:	cpm	b,0		; null count?
	ret	z		; yes, exit
null:	APUT	0
	APUT	0
	DJNZ	NULL
	RET
;
puts:	ld	b,(hl)		; get count
	cpm	b,0		; null count?
	ret	z		; yes, exit
puts1:	inc	hl		; no, point to first character
	aput	(hl)		; send next character
	djnz	puts1		; looop
	ret
;
;
	end
	CALL	TSTTRM		; CONVERT CONSOLE CODE
	LD	B,0		; INDICATE SEARCH OVER
	RET			; EXIT
	FORM
;
;	TSTTRM - CHANGE TERMINAL CODE 	TITLE	IODEP	I/O DEPENDENT CODE FOR VECTOR GRAPHIC CPM 2.2
	list	off
;
;
VERSON	MACRO	#INO,#RHI,#RLO,#MTH,#DAY,#INM,#RNM,#DNM
	ENTRY	#INM,#RNM,#DNM
#INM	EQU	#INO
#RNM	EQU	[#RHI SHL 8] + #RLO
#DNM	EQU	[#MTH SHL 8] + #DAY
	MEND
;
;	MEM	OPCODE,VARDES,LITREG,VARSRC
;
MEM:	MACRO	#OP,#VD,#LIT,#VS
	LD	A,#VS
	#OP	#LIT
	LD	#VD,A
	MEND
;
;
SYSERR:	MACRO	#ERR
	CALL	ERR
	MEND
;
;
MOV:	MACRO	#DST,#REG,#SRC
	LD	#REG,#SRC
	LD	#DST,#REG
	MEND
;
;	MOUT	IOADR,VARIABLE
;
MOUT:	MACRO	#IOADR,#VAR
	LD	A,#VAR
	OUT	#IOADR,A
	MEND
;
;	MEMX	OPCODE,OPERAND,VARDES,REG,VARSRC
;
MEMX:	MACRO	#OP,#IOPR,#DES,#REG,#SRC
	LD	#REG,#SRC
	#OP	#IOPR
	LD	#DES,#REG
	MEND
;
;
CPM:	MACRO	#ADR,#LIT
	LD	A,#ADR
	CP	#LIT
	MEND
;
;	MAKE CDOS CALL WITH INTERRUPTS ON
;		CPMIO	OPCODE
;
CPMIO:	MACRO	#OPCOD
	LD	C,#OPCOD
	CALL	5
	MEND
;
;	DELAY CONVERSATION WITH 8251
;
NOPS	MACRO
	NOP
	NOP
	NOP
	MEND
;
;
TRUE	EQU	1
FALSE	EQU	0
M$TRAN	EQU	2		;BSC BUFFER CONTAINS TRANSPARENT DATA
T.TSYN	EQU	3		;TEST MESSAGE SYN LEAD IN
	LIST	ON
	list	off
;
;	INTEL 8251 SERIAL I/O
;
BASE	EQU	02H		; BITSTREAMER II BASE ADDRESS
LPTDAT	EQU	BASE+04H	;LINE PRINTER DATA PORT
LPTCMD	EQU	BASE+05H	;LINE PRINTER COMMAND PORT
MDMDAT	EQU	BASE+02H	;MODEM DATA PORT
MDMCMD	EQU	BASE+03H	;MODEM COMMAND PORT
PIOA	EQU	BASE+06H	; INTERRUPT MASK
PIOB	EQU	BASE+07H	; REAL TIME CLOCK RESET
;
MDMMOD	EQU	00001100B	;MODEM MODE WORD
				;0XXX XXXX  2 SYNC CHAR
				;X0XX XXXX  SYNDET = INPUT
				;XX0X XXXX  ODD PARITY
				;XXX0 XXXX  PARITY DISABLED
				;XXXX 11XX  8 BIT CHARS
				;XXXX XX00  SYNC MODE
;
;	COMMAND FLAGS
;
HUNT	EQU	80H		;ENTER HUNT MODE
MRESET	EQU	40H		;CHIP RESET
RTS	EQU	20H		;RTS
MRSTER	EQU	10H		;RESET ERROR FLAGS
SNDBRK	EQU	8		;SEND BREAK
RXENBL	EQU	4		;ENABLE RX
DTR	EQU	2		;DTR
TXENBL	EQU	1		;ENABLE TX
;
;	STATUS FLAGS
;
DSR	EQU	80H		;DSR ACTIVE
SYNDET	EQU	40H		;SYNDET ACTIVE
FTLERR	EQU	20H		;FATEL ERROR
RXOVRF	EQU	10H		;RX OVEFLOW
PARERR	EQU	8		;PARITY ERROR
TXUNDR	EQU	4		;TX UNDERFLOW
RXRDY	EQU	2		;RX DATA AVAILABLE
TXRDY	EQU	1		;TX BUFFER EMPTY
B$RXR	EQU	1		;RX DATA AVL BIT NUMBER
B$TXR	EQU	0		;TX BUFFER EMPTY BIT NUMBER
;
;	INTERRUPT MASK ENABLES ( PIOA )
;
TXM	EQU	05H		; MODEM TX ENABLE MASK
TXMB	EQU	2		; MODEM TX ENABLE BIT #
RXM	EQU	08H		; MODEM RX ENABLE MASK
RXMB	EQU	3		; MODEM RX ENABLE BIT #
CLKM	EQU	40H		; REAL TIME CLOCK ENABLE MASK
CLKMB	EQU	6		; REAL TIME CLOCK ENABLE BIT #
DTRM	EQU	80H		; DATA TERMINAL READY ENABLE
DTRMB	EQU	7		; DATA TERMINAL READY ENABLE BIT #
	LIST	on		
	LIST	NOGEN
	VERSON	8,101,1,03,07,I.IOD,V.IOD,D.IOD
;
;	IODEP - I/O DEPENDENT CODE
;		THIS MODULE CONTAINS ALL CODE THAT PERTAINS TO SPECIFIC
;		DEVICE CONFIGURATIONS.
;
;	VERSION	DATE		MODIFICATION
;
;	22,0	07/21/80	IMPLEMENTED V/G VERSION
;	22,4	09/11/80	FIXED 8251 PROBLEM - ADDED DELAYS
;	23,0	09/16/80	CLEAR ACRC IN CTXCRC/CRXCRC
;	23,1	10/30/80	ADDED XLOG TRACE=8 FEATURE
;
;      100,0	12/17/80	simplified for config document
;      101,0	03/07/82	upgraded for rbte 2.40
;      102,0	05/15/82	added exitck
;
;
;
	form
	ENTRY	FINCRS,STXY,PRXY
STXY	EQU	0000H		; STATUS MSG CURSOR ADDRESS
PRXY	EQU	1600H		; PROMPT MSG CURSOR ADDRESS
FINCRS	EQU	1500H		; FINAL CURSOR ADDRESS
;
;
;	ACK DELAY TIME CONSTANT FOR SLOW DISKS
;
	ENTRY	ACKDLY,TRMCOD,msgdly,xmtdly
TRMCOD:	DB	6			; VECTOR GRAPHIC TERMINAL CODE
ACKDLY:	DW	40H			; WAIT 1.28 SECOND
msgdly:	dw	0			; ticks to wait before sending a messag
					; 	in response to receive message
xmtdly:	dw	0			; ticks to wait before sending a 
					; 	message
	FORM
;
;	BOOT
;
;		RBTE TERMINATION ROUTINE. DEACTIVATES ALL INTERRUPT DEVICES
;
;	CALLING SEQUENCE:
;		JP	BOOT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NONE
;
;	COME FROM:
;		RBTE: CEXIT (EMULSR), DDTINT (MAIN), ^C INTERCEPT
;		RBTEDIAG: DDTINT (RBTEDIAG), ^C INTERCEPT
;
	ENTRY	BOOT,CDOS$
	REL
BOOT:	DI
	CALL	DISDEV		;DISABLE ALL INTERRUPTS
CDOS$:	EI
	CPMIO	0		;SYSTEM EXIT/RESET
;
;	exitck
;
	entry	exitck
exitck:	ret			; return immed
	FORM
;
;	INTCHN
;		INTERRUPT SKIP CHAIN FOR 8080 MODE INTERRUPTS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NONE
;
;	COME FROM:
;		ANYWHERE, VIA INTERRUPT
;
	REL
INTCHN:	PUSH	AF			; SAVE
	PUSH	HL			;    REGS
	LD	HL,INTMSK		; MODEM TRANSMITTER
	BIT	TXMB,(HL)		;    INTERRUPT ENABLED?
	JR	Z,INT1			; NO
	IN	A,(MDMCMD)		; YES, TRANSMITTER
	AND	TXRDY			;    BUFFER EMPTY?
	JR	Z,INT1			; NO
	POP	HL			; YES, RESTORE
	POP	AF			;    REGS &
	JP	TXINT			;    BEGIN TX INTERRUPT SERVICE ROUTINE
;
INT1:	BIT	RXMB,(HL)		; MODEM RECEIVER INTERRUPT ENABLED?
	JR	Z,INT2			; NO
	IN	A,(MDMCMD)		; YES, RECEIVER
	AND	RXRDY			;	DATA AVAILABLE?
	JR	Z,INT2			; NO
	POP	HL			; YES, RESTORE
	POP	AF			;    REGS &
	JP	RXINT			;    ENTER RX INTERRUPT SERVICE ROUTINE
;
INT2:	BIT	CLKMB,(HL)		; REAL TIME CLOCK ENABLED?
	JR	Z,INT3			; NO
	POP	HL			; YES, RESTORE 
	POP	AF			;    REGS &
	JP	CLKTRP			;    ENTER CLOCK INTERRUPT SERVICE RTN
;
INT3:	IN	A,(MDMCMD)		; RESET SYNDET BIT
	IN	A,(PIOB)		; RESET CLOCK
	LD	A,(MCMND)		; RESET
	OR	MRSTER			;	MODEM SERIAL
	OUT	MDMCMD,A		;	PORT FOR ERRORS
	MEM	INC,(INTERR),A,(INTERR)	; INDICATE ANOTHER ERROR
	POP	HL			; RESTORE
	POP	AF			;	REGS &
	EI				;	RESUME
	RET				;	INTERRUPTED ROUTINE
;
	DATA
INTMSK:	DB	0			; INTERRUPT MASK REG
INTERR:	DB	0			; INTERRUPT CHAIN ERRORS
	FORM
;
;	DISDEV
;
;		DISABLE ALL INTERRUPT DEVICES, BUT DONT CLEAR INTERRUPT MASK.
;
;	CALLING SEQUENCE:
;		CALL	DISDEV
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		BOOT
;
;
	ENTRY	DISDEV
DISDEV:	MOUT	PIOA,DTRM			; DISABLE ALL DEVICES
	RET
	FORM
;
;	CLRDEV
;
;		DISABLE CLOCK & MODEM INTERRUPT ENABLES & CLEAR INTERRUPT MASK
;
;	CALLING SEQUENCE:
;		CALL	CLRDEV
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		RBTEDIAG
;		DDTINT/USRABT (RBTEDIAG)
;

	REL
	ENTRY	CLRDEV
CLRDEV:	MOV	(INTMSK),A,DTRM		; CLEAR INTERRUPT MASK
	OUT	PIOA,A			;	& DISABLE DEVICES
	RET
	TITLE	IODEP - XLOG DEPENDENCIES
;
;	INIDDT
;
;		INITIALIZE INTERRUPT DEVICES
;
;	CALLING SEQUENCE:
;		CALL	INIDDT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REGS NOT PRESERVED
;
;	COME FROM:
;		RBTE ONLY: CSTART (MAIN)
;		RBTE WITH BDDT: CSTART (BDDT)
;		RBTEDIAG ONLY: CSTART (PSDBDDT)
;		RBTEDIAG WITH BDDT: CSTART (BDDT)
;
	ENTRY	INIDDT
INIDDT:	CALL	INTMOD		;SET INTERRUPT MODE
	CALL	INIINT		;INIT INTERRUPT CONTROLLER
	CALL	TRAPS		;SET TRAPS TO DEFAULT ROUTINES
	CALL	INITCI		;INIT CONSOLE INTERRUPT
	RET
	FORM
;
;	INIINT
;
;		INITIALIZE INTERRUPT CONTROLLER
;
;	CALLING SEQUENCE:
;		CALL	INIINT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
INTVTR	EQU	18H				; INTERRUPT VECTOR ADDRESS
INIINT:	MOV	(INTVTR),A,0C3H			; ATTACH INTERRUPT VECTOR
	MOV	(INTVTR+1),HL,INTCHN		;    TO INTERRUPT CHAIN ROUTINE
	CALL	CLRDEV      			; CLEAR INTERRUPT CONTROLLER 
	RET
	FORM
;
;	INTMOD
;		SET INTERRUPT MODE
;
;	CALLING SEQUENCE:
;		CALL	INTMOD
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
	REL
	ENTRY	INTMOD
INTMOD:	IM0				;SET 8080 MODE INTERRUPTS
	RET
	FORM
;
;	TRAPS
;		INITIALIZE UNIMPLENTED TRAPS
;
;	CALLING SEQUENCE:
;		CALL	TRAPS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		INIDDT
;
	ENTRY	TRAPS
TRAPS:	RET
	FORM
;
;	INITCI
;
;		INITIALIZE CONSOLE INTERRUPT DEVICE
;
;	CALLING SEQUENCE:
;		CALL	INITCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIDDT
;
	EXT	DDTINT
INITCI:	MOV	(0000H),A,0C3H		;LOAD DDTINT ADDR INTO
	MOV	(0001H),HL,DDTINT	;	CPM BOOT LOCATION
	RET
	FORM
;
;	ENBCI
;		ENABLE CONSOLE INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	ENBCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIINT (NOT USED)
;
	ENTRY	ENBCI
ENBCI:	RET
	FORM
;
;	DISCI
;		DISABLE CONSOLE INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	DISCI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		INIINT (NOT USED)
;
	REL
DISCI:	RET
	FORM
	TITLE	IODEP - REAL TIME CLOCK DEPENDENCIES
;
;	CLOCK
;
;		REAL TIME CLOCK DEVICE INITIALIZER
;
;	CALLING SEQUENCE:
;		CALL	CLOCK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NONE
;
;	COME FROM:
;		RBTE: START (RTX)
;		RBTEDIAG: START (RBTEDIAG)
;
	REL
	ENTRY	CLOCK
CLOCK:	CALL	RESTIM			; RESET REAL TIME CLOCK
	CALL	ENBCLK			; ENABLE CLOCK INTERRUPTS
	RET
	FORM
;
;	ENBCLK
;
;		ENABLE CLOCK INTERRUPT
;
;	CALLING SEQUENCE:
;		CALL	ENBCLK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		ENBDEV
;
ENBCLK:	LD	A,(INTMSK)		; SET CLOCK
	SET	CLKMB,A			;	MASK
	LD	(INTMSK),A		;	AND ENABLE
	OUT	PIOA,A			;	CLOCK INTERRUPT
	RET
	FORM
;
;	DISCLK
;
;		DISABLE CLOCK INTERRUPTS
;
;	CALLING SEQUENCE:
;		CALL	DISCLK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		DISDEV
;
DISCLK:	LD	A,(INTMSK)		; CLEAR CLOCK
	RES	CLKMB,A			;	MASK AND
	LD	(INTMSK),A		;	DISABLE
	OUT	PIOA,A			;	CLOCK
	RET
	FORM
;
;	CLKTRP
;
;		REAL TIME CLOCK INTERRUPT SERVICE ROUTINE
;		ENTERED UPON CLOCK TICK EXPIRATION
;		VECTOR GRAPHIC TICK = 18.18 MS
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE - VIA INTERRUPT
;
	REL
	EXT	CLKISR
CLKTRP:	JP	CLKISR			;DO CLOCK INTERRUPT
	FORM
;
;	RESTIM
;
;		RESTART REAL TIME CLOCK. (FOR CLOCKS WHICH MUST BE 
;		RESTARTED AFTER TIMER EXPIRATION.)
;
;	CALLING SEQUENCE:
;		CALL	RESTIM
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		CLKTRP, CLKISR (RTX)
;
	ENTRY	RESTIM
RESTIM:	PUSH	AF			; SAVE REG
	IN	A,PIOB			; RESET CLOCK
	POP	AF			; RESTORE REG
	RET
	FORM
;
;	XINI
;		INITIALIZE XLOG TRACE WINDOW CURSOR
;
;	CALLING SEQUENCE:
;		CALL	XINI
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XINI
	REL
COLSTR	EQU	0			;STARTING COLUMN (0,79)
COLMAX	EQU	79			;ENDING COLUMN WIDTH
LINSTR	EQU	9			;STARTING LINE NUMBER (0,23)
LINMAX	EQU	12			;WINDOW DEPTH
XINI:	MOV	(COLCNT),A,COLMAX	;WINDOW WIDTH
	MOV	(COLCRS),A,COLSTR	;WINDOW START COLUMN
	MOV	(LINCNT),A,LINMAX	;WINDOW LENGTH
	MOV	(LINCRS),A,LINSTR	;WINDOW START LINE
	RET
	FORM
;
;	XIBAUD
;
;		DO AUTO BAUD DETECT FOR XLOG TRACE PORT
;
;	CALLING SEQUENCE:
;		CALL	XIBAUD
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XIBAUD
	REL
XIBAUD:	NOP			;BAUD RATE SET FOR CONSOLE
	RET
	FORM
;
;	XCLS
;		CLOSE EXTERNAL TRACE DEVICE
;
;	CALLING SEQUENCE:
;		CALL	XCLS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XCLS
	REL
XCLS:	RET
;
;	DSKPUT
;		COPY TRANSACTION CHARACTER TO DISK BUFFER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	DSKPUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
;
	ENTRY	DSKPUT
	REL
DSKPUT:	RET
	FORM
;
;	XPOS
;
;		POSITION CURSOR TO CURRENT POSITION IN XLOG TRACE WINDOW
;
;	CALLING SEQUENCE:
;		CALL	XPOS
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		NO REGS PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XPOS
	EXT	POS
	REL
XPOS:	LD	HL,COLCRS		;COLUMN ADR
	LD	DE,LINCRS		;LINE ADR
	CALL	POS			;POSITION IT
	RET
;
;
	DATA
COLCNT:	DB	0	;COLUMN COUNTER
COLCRS:	DB	0	;COLUMN POINTER
LINCNT:	DB	0	;LINE COUNTER
LINCRS:	DB	0	;LINE POINTER
	FORM
;
;	XPUT
;
;		COPY CHAR TO XLOG TRACE WINDOW
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	XPUT
;
;	ENTRY:
;		REG A	CHARACTER TO DISPLAY
;
;	EXIT:
;		REGS BC, DE, HL PRESERVED
;
;	COME FROM:
;		XLOG
;
	ENTRY	XPUT
	EXT	CLRLIN
	REL
XPUT:	PUSH	DE			;SAVE
	PUSH	BC
	PUSH	HL			;	REGS
	CALL	APUT			;DISPLAY CHAR
	LD	HL,COLCRS		;NEXT CHAR
	INC	(HL)			;	POINTER
	LD	HL,COLCNT		;END OF
	DEC	(HL)			;	LINE?
	JR	NZ,XPEXIT		;NO, EXIT
	MOV	(COLCNT),A,COLMAX	;YES, RESET COLUMN COUNTER
	MOV	(COLCRS),A,COLSTR	;RESET COLUMN CURSOR
	LD	HL,LINCRS		;NEXT LINE
	INC	(HL)			;	POINTER
	LD	HL,LINCNT		;BOTTOM OF
	DEC	(HL)			;	WINDOW?
	JR	NZ,XP1			;NO
	MOV	(LINCRS),A,LINSTR	;YES, RESET LINE POINTER
	MOV	(LINCNT),A,LINMAX	;RESET LINE COUNTER
XP1:	LD	HL,COLCRS		;POSITION
	LD	DE,LINCRS		;	SCREEN
	CALL	POS			;	CURSOR
	CALL	CLRLIN			;CLEAR LINE
XPEXIT:	POP	HL			;RESTORE
	POP	BC
	POP	DE			;	REGS
	RET
	FORM
;
;	APUT
;
;		SEND CHARACTER TO CONSOLE
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	APUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		EMULSR, DISKIO
;
	ENTRY	APUT
APUT:
	CALL	CONOUT		;PRINT BYTE
	RET
	TITLE	IODEP - CDOS, CP/M CONSOLE I/O
	ENTRY	CONOUT,CONINP,CONCHK
;
;	CONOUT
;
;		DISPLAY CHARACTER ON CONSOLE VIA CDOS CALL     
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	CONOUT
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		EMULSR, APUT 
;
CONOUT:	PUSH	HL
	PUSH	BC		;SAVE
	PUSH	DE		;	REGS
	LD	E,A		;SEND
	CPMIO	6		;	CHAR TO CONSOLE
	POP	DE		;RESTORE
	POP	BC		;	REGS
	POP	HL
	RET
	FORM
;
;	CONINP
;		READ KEYBOARD VIA CDOS CALL
;
;	CALLING SEQUENCE:
;		CALL	CONINP
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A	KEYBOARD DATA
;		ALL OTHER REGS PRESERVED
;
;	COME FROM:
;		EMULSR
;
CONINP:	PUSH	HL
	PUSH	BC		;SAVE
	PUSH	DE		;	REGS
CI.LOP:	LD	E,0FFH		;GET NEXT
	CPMIO	6		;NEXT KEYBOARD CHAR WITHOUT ECHO
	OR	A		; CHAR AVL?
	JR	Z,CI.LOP	; NO, TRY AGAIN
	POP	DE		;RESTORE
	POP	BC		;	REGS
	POP	HL
	RET
	FORM
;
;	CONCHK
;
;		CHECK IF KEYBOARD DATA AVAILABLE. RETURN CHARACTER IF
;		FOUND AVAILABLE
;
;	CALLING SEQUENCE:
;		CALL	CONCHK
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A	= 0: IF NO CHARACTER AVAILABLE
;		       <> 0: IF CHARACTER AVAILABLE
;
;	COME FROM:
;		EMULSR
;
CONCHK:	PUSH	BC		; SAVE
	PUSH	DE		;	REGS
	PUSH	HL		;	...
	LD	E,0FFH		; GET NEXT
	CPMIO	6		;	CHARACTER IF AVL
	OR	A		; SET AVL STATUS
	POP	HL		; RESTORE
	POP	DE		;	REGS
	POP	BC		;	...
	RET
	FORM
;
;	PRTCHR
;
;		COPY CHARACTER TO PRINTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	PRTCHR
;
;	ENTRY:
;		REG A	CHARACTER
;
;	EXIT:
;		ALL REGS BUT AF PRESERVED
;
;	COME FROM:
;		DISKIO
;
	ENTRY	PRTCHR
PRTCHR:
;	CALL	PIOPRT		; PRINT CHAR VIA PROGRAM I/O
	CALL	CPMPRT		; PRINT CHAR VIA CPM
	RET
;
PIOPRT:	PUSH	AF		;SAVE CHAR
PRT1:	IN	A,LPTCMD	;PRINT BUFFER
	BIT	B$TXR,A		;	EMPTY?
	JR	Z,PRT1		;NO
	POP	AF		;YES, GET CHAR
	OUT	LPTDAT,A	;	& PRINT
	RET
;
CPMPRT:	PUSH	BC		; SAVE
	PUSH	DE		;	REGS
	PUSH	HL		;	....
	LD	E,A		; PRINT
	CPMIO	5		;	 CHAR
	POP	HL		; RESTORE
	POP	DE		;	REGS
	POP	BC		;	....
	RET
	TITLE	IODEP	SYNCHRONOUS ROUTINES
;
;	TXINT
;
;		MODEM TRANSMITTER INTERRUPT SERVICE ROUTINE
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE, VIA INTERRUPT
TXINT:	PUSH	AF			; SAVE REG
	IN	A,MDMCMD		; GET MODEM STATUS
	AND	TXUNDR			; TX UNDERRUN?
	JR	Z,TXIOK			; NO
	MEM	INC,(UNDRUN),A,(UNDRUN)	; YES, INCREMENT UNDERRUN COUNT
	LD	A,(MCMND)		; CLEAR
	OR	MRSTER			;	MODEM SIO
	OUT	MDMCMD,A		;	ERROR
TXIOK:	POP	AF			; RESTORE REG
	JP	TXISR			; DO INTERRUPT
	FORM
;
;	RXINT
;
;		MODEM RECEIVER INTERRUPT SERVICE ROUTINE
;
;	CALLING SEQUENCE:
;		VIA INTERRUPT
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS PRESERVED
;
;	COME FROM:
;		ANYWHERE VIA INTERRUPT
;
;
RXINT:	PUSH	AF			; SAVE REG
	IN	A,MDMCMD		; GET MODEM STATUS
	AND	RXOVRF			; RX OVERFLOW?
	JR	Z,RXIOK			; NO
	MEM	INC,(OVRFLO),A,(OVRFLO)	; YES, INCREMENT OVERFLOW COUNTER
	LD	A,(MCMND)		; CLEAR ERROR
	OR	MRSTER			;	INDICATION
	OUT	MDMCMD,A		;	IN MODEM SIO
RXIOK:	POP	AF			; RESTORE REG
	JP	RXISR			; DO RX INTERRUPT
	TITLE	IODEP	TXCHR/TXBIN
;
;	TXCHR
;		ACCUMULATE CRC & TRANSMIT CHARACTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	TXCHR
;
;	ENTRY:
;		REG A	CHARACTER TO SEND
;
;	EXIT:
;		REG A	PRESERVED
;
;	COME FROM:
;		TXISR
;
;	STACK USED:
;
	EXT	CRCGEN,IDATT,IDATR
	ENTRY	TXCHR
TXCHR:	PUSH	AF			; SAVE
	PUSH	BC			;    A COUPLA REGS
	CALL	CRCGEN			; ACCUMULATE CRC
	OUT	(MDMDAT),A		; SEND CHAR
	CALL	IDATT			; GIVE TO XLOG
	POP	BC
	POP	AF
	RET
	TITLE	IODEP	TXBIN
;
;	TXBIN
;		TRANSMIT CHARACTER
;
;	CALLING SEQUENCE:
;		LD	A,CHAR
;		CALL	TXBIN
;
;	ENTRY:
;		REG A	CHARACTER TO SEND
;
;	EXIT:
;		REG A	PRESERVED
;
;	COME FROM:
;		TXCHR, TXISR
;
;	STACK USED:
;
	ENTRY	TXBIN
TXBIN:	PUSH	AF			; SAVE REGS
	PUSH	BC			; /
	OUT	(MDMDAT),A		; XMIT CHAR
	CALL	IDATT			; GIVE TO XLOG
	POP	BC
	POP	AF
	RET
	FORM
;
;	CTXCRC/CRXCRC
;
;		CLEAR TRANSMITTER OR RECIEVER CRC ACCUMULATOR
;
;	CALLING SEQUENCE:
;		CALL	CTXCRC/CRXCRC
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		ALL REGS BUT HL PRESERVED
;
;	COME FROM:
;		SYNISR
;
	ENTRY	CTXCRC
	ENTRY	CRXCRC
	EXT	CRCH,ACRC
	REL
CTXCRC:
CRXCRC:	MOV	(CRCH),HL,0		;CLEAR CRC ACCUMULATION
	MOV	(ACRC),A,0		;
	RET
	TITLE	IODEP	RDBIN - READ CHARACTER FROM SERIAL INTERFACE
;
;	RDBIN
;		READ CHARACTER FROM SERIAL INTERFACE
;
;	CALLING SEQUENCE:
;		CALL	RDBIN
;
;	ENTRY:
;		NONE
;
;	EXIT:
;		REG A/B	 CHARACTER READ
;
;	COME FROM:
;		RXISR
;
;	STACK USED:
;		NONE
;
	ENTRY	RDBIN
RDBIN:	IN	A,(MDMDAT)		; READ CHARACTER
	LD	B,A			; RETURN CHAR IN REG B
	JP	RBIN			; ALLOW XLOG FEATURE (NOP TO REMOVE)
	RET
RBIN:	PUSH	BC			; SAVE REG
	CALL	IDATR			; GIVE TO XLOG (MAY TAKE TOO MUCH TIME)
	POP	BC			; UNSAVE BC
	RET
	TITLE	SYNC - CONTROL SYNC PORT
;
;	SYNC	(SUBROUTINE)
;
;		THIS ROUTINE CONTROLS AND SENSES THE SYNCHRONOUS COMMUNICATION
;		CHANNEL.
;		ALL HARDWARE SPECIFICS OF THE SERIALIZER ARE CONTAINED IN 
;		THIS MODULE.
;
;	CALLING SEQUENCE:
;		LD	A,CMD
;		CALL	SYNC
;
;	ENTRY:
;		REG A	SERIALIZER COMMAND
;			0 = ACTIVATE DTR (DTRON)
;			1 = DEACTIVATE DTR (DTROFF)
;			2 = ENABLE RECEIVER (RXENB)
;			3 = DISABLE RECEIVER (RXDIS)
;			4 = ENABLE TRANSMITTER (TXENB)
;			5 = DISABLE TRANSMITTER (TXDIS)
;			6 = INIT SYNC PORT (SYNINI)
;			7 = SENSE DSR (DSRSNS)
;			8 = SENSE CTS (CTSSNS)
;			9 = ENABLE TRANSPARENT FILL (SETTRN)
;		       10 = ACTIVATE RTS (RTSON)
;		       11 = SENSE DCD (DCDSNS)
;
;	EXIT:
;		REG A	COMMAND STATUS FOR SENSE OPERATIONS
;			TRUE - DSRON OR CTSON
;			FALSE - DSROFF OR CTSOFF
;		FLAG Z	COMMAND STATUS OF SENSE OPERATIONS
;			SET - DSROFF OR CTSOFF
;			CLEAR - DSRON OR CTSON
;		ALL OTHER REGS PRESERVED
;
;	COME FROM:
;		BSCINT, TXISR, RXISR
;
;	STACK USED:
;
	ENTRY	SYNC
	EXT	TXERR,RXERR,ERR,TSTATE,TXMODE
	EXT	CASE,SYN,DLE,RXISR,TXISR
	REL
SYNC:	DI			;DISALLOW INTERRUPTIONS
	CALL	ISYNC		;DO SYNC FUNCTION
	EI			;ALLOW INTERRUPTIONS
	RET
	FORM
	ENTRY	ISYNC
;
ISYNC:	PUSH	HL		;SAVE REGS
	PUSH	DE		;.....
	LD	HL,S.CAS	;CALCULATE 
	LD	D,S.CNT		;	CASE
	CALL	CASE		;	ADDRESS
	LD	DE,ISYRET	;RETURN
	PUSH	DE		;	ADDRESS
	JP	(HL)		;DO CASE
;
ISYRET:	POP	DE		;RESTORE
	POP	HL		;	REGS
	RET			;EXIT
;
;	CASE TABLE
;
S.CAS:	DW	S.ERR		;ERROR
	DW	S.DTRN		;DTRON
	DW	S.DTRF		;DTROFF
	DW	S.RXE		;RXENB
	DW	S.RXD		;RXDIS
	DW	S.TXE		;TXENB
	DW	S.TXD		;TXDIS
	DW	S.INIT		;INIT
	DW	S.DSRS		;DSRSNS
	DW	S.CTSS		;CTSSNS
	DW	S.TRNS		;SETTRN
	DW	S.RTSN		;RTSON
	DW	S.DCDS		;DCDSNS
S.CNT	EQU	[$-S.CAS]/2-2
	FORM
S.ERR:	SYSERR	0
;
;	INITIALIZE SERIAL PORT
;
S.INIT:	MOV	(OVRFLO),A,0		;CLEAR UNDER RUN COUNTER
	MOV	(UNDRUN),A,0		;CLEAR TX UNDERRUN COUNTER
	MOV	(RXERR),A,0		;CLEAR UNEXPECTED RX INTERRUPT COUNTER
	MOV	(TXERR),A,0		;CLEAR UNEXPECTED TX INTERRUPT COUNTER
	MOV	(TXIERR),A,0		;TX SPURIOUS INTERRUPT COUNTER
	MOV	(RXIERR),A,0		;RX SPURIOUS INTERRUPT COUNTER
	MOV	(MCMND),A,0		;INIT MODEM COMMAND WORD
	MOUT	MDMCMD,0		;INSURE
	NOPS				;
	OUT	MDMCMD,A		;	MODEM USART
	NOPS				;
	OUT	MDMCMD,A		;	READY FOR RESET
	NOPS				;
	MOUT	MDMCMD,MRESET		;RESET MODEM CHIP
	NOPS				;
	MOUT	MDMCMD,MDMMOD		;SET SYNC MODE
	NOPS				;
	MOUT	MDMCMD,(SYN)		;SET FIRST SYNC
	NOPS				;
	OUT	MDMCMD,A		;SET SECOND SYNC
	RET
	FORM
;
;	SET DTR TO ON
;
S.DTRN:	MEM	OR,(MCMND),DTR,(MCMND)		;SET DATA TERMINAL
	OUT	(MDMCMD),A			;	READY.
	MEM	AND,(INTMSK),-[DTRM+1],(INTMSK)	; SET EXTERNAL
	OUT	PIOA,A				;	DTR
	RET
;
;	SET DTR TO OFF
;
S.DTRF:	MEM	AND,(MCMND),-[DTR+1],(MCMND)	;CLEAR DATA TERMINAL
	OUT	(MDMCMD),A			;	READY.
	MEM	OR,(INTMSK),DTRM,(INTMSK)	; CLEAR EXTERNAL
	OUT	PIOA,A				;	DTR
	RET
;
;	ENABLE TRANSMITTER
;	NEED TO CLEAR IRR FLAG?
;
S.TXE:	MEM	OR,(INTMSK),TXM,(INTMSK)	; ENABLE RECEIVE
	OUT	PIOA,A				;	INTERRUPTS
	MEM	OR,(MCMND),[TXENBL+RTS+DTR],(MCMND)	;SET RTS
	MOUT	MDMCMD,MRESET			;RESET CHIP
	NOPS					;
	MOUT	MDMCMD,MDMMOD			;SET SYNC MODE
	CPM	(TSTATE),T.TSYN			;DATA MESSAGE?
	JR	NZ,STESYN			;NO
	LD	A,(TXMODE)			;YES, TRANSPARENT
	AND	M$TRAN				;	DATA?
	JR	Z,STESYN			;NO
	MOUT	MDMCMD,(DLE)			;YES, USE TRANSP. SYN (DLE SYN)
	JR	STECOM
;
STESYN:	MOUT	MDMCMD,(SYN)			;USE NON TRANSP. SYN (SYN SYN)
	NOPS					;
STECOM:	MOUT	MDMCMD,(SYN)			;LOAD FIRST SYNC
	NOPS					;
	MOUT	MDMCMD,(MCMND)			;SET RTS & TX ENABLE
	NOPS					;
	MOUT	MDMDAT,(SYN)			;SEND SYN
	RET
	FORM
;
;	DISABLE TRANSMITTER
;
S.TXD:	MEM	AND,(INTMSK),-[TXM+1],(INTMSK)		; DISABLE TRANSMIT
	OUT	PIOA,A					;	INTERRUPT MASK
	MEM	AND,(MCMND),-[RTS+TXENBL+1],(MCMND)	;DISABLE TX
	OUT	MDMCMD,A
	RET
;
;	ENABLE RECEIVER
;
S.RXE:	MEM	OR,(INTMSK),RXM,(INTMSK)	; ENABLE RECEIVE
	OUT	PIOA,A				;	INTERRUPT MASK
	MEM	OR,(MCMND),[RXENBL+DTR],(MCMND)	;SET RX ENABLE
	MOUT	MDMCMD,MRESET			;RESET CHIP
	NOPS					;
	MOUT	MDMCMD,MDMMOD			;SET SYNC MODE
	NOPS					;
	MOUT	MDMCMD,(SYN)			;LOAD FIRST SYNC
	NOPS					;
	OUT	MDMCMD,A			;LOAD SECOND SYNC
	LD	A,(MCMND)			;ENABLE RX
	OR	HUNT				;	& HUNT MODE
	OUT	MDMCMD,A			;	....
	NOPS					;
	IN	A,MDMDAT			;DRAIN RX BUFFER
	NOPS					;
	IN	A,MDMDAT			;	....
	RET
;
;	DISABLE RECEIVER
;
S.RXD:	MEM	AND,(INTMSK),-[RXM+1],(INTMSK)	; DISABLE RECIEVE
	OUT	PIOA,A				;	INTERRUPT MASK
	MEM	AND,(MCMND),-[RXENBL+1],(MCMND)	;DISABLE RX
	OUT	MDMCMD,A			;	...
	RET
;
;	DSR SENSE
;
S.DSRS:	IN	A,MDMCMD			;GET MODEM STATUS
	AND	DSR				;DSR ACTIVE?
	RET	Z				;NO
	LD	A,TRUE				;YES
	RET
	FORM
;
;	CTS SENSE
;
S.CTSS:	XOR	A
	RET
;
;	SETTRN - TRANSPARENT FILL
;
S.TRNS:	RET
;
;	ACTIVATE RTS
;
S.RTSN:	MEM	OR,(MCMND),RTS,(MCMND)		; REQUEST TO SEND
	OUT	MDMCMD,A			;    SIGNAL
	RET
;
;	SENSE DCD
;
S.DCDS:	XOR	A
	RET
;
;
;
	DATA
TXIERR:	DB	0	;TX SPURIOUS INTERRUPT COUNTER
RXIERR:	DB	0	;RX SPURIOUS INTERRUPT COUNTER
UNDRUN:	DB	0	;UNDER RUN COUNTER
OVRFLO:	DB	0	;RX OVERFLOW COUNTER
MCMND:	DB	0	;MODEM COMMAND WORD
;
;
	END
7:уН—+Нy$y°К;`i#""м
