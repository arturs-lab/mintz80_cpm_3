  46
DPBLK1:	DW	26		;sectors per track
	DB	3		;block shift factor
	DB	7		;block mask
	DB	0		;null mask
	DW	242		;disk size-1
	DW	63		;directory max
	DB	192		;alloc 0
	DB	0		;alloc 1
	DW	16		;check size
	DW	2		;track offset
;
;defines a single density double sided disk
;
DPBLK2:	DW	26
	DB	4
	DB	15
	DB	1
	DW	242
	DW	127
	DB	192
	DB	0
	DW	32
	DW	2
;
;	double density disk parameter block
;
DPBLK3:	DW	64		;sectors per track
	DB	4		;block shift factor
	DB	15		;block mask
	DB	0		;null mask
	DW	299		;disk size-1
	DW	127		;directory max
	DB	192		;alloc 0
	DB	0		;alloc 1
	DW	32		;check size
	DW	2		;track offset
;
;defines a double density / double side 512 x 16
;
DPBLK4:	DW	64
	DB	5
	DB	31
	DB	1
	DW	303
	DW	255
	DB	192
	DB	0
	DW	64
	DW	2
;
; de is source, hl is dest
;
RWMOVE:	PUSH	D
	PUSH	H
	CALL	SWTUSER		;switch to user memory
	POP	H
	POP	D
	LXI	B,128
;
	IF	NOT MTOM
	LDIR
	ELSE
	CALL	MEMTOM
	ENDIF
;
	JMP	SWTSYS		;restore system and return
;
;dma memory to memory transfer routine
;this is 3 times faster than z80 ldir
;
;entry:	hl = source
;	de = destination
;    reg c = adr0 port
;	hl = 128-1 (after source is loaded)
;
	IF	MTOM
MEMTOM:	DCX	B		;decrease the count size -1
	SBCD	BLKMVS		;save the dma block size
	MVI	A,SETREQ+CHAN0	;stop any action here
	OUT	FMASK
	MVI	A,SETREQ+CHAN1
	OUT	FMASK
	MVI	C,ADR0		;dma addr 0
	OUTP	L		;send low byte
	OUTP	H		;send high byte
	LHLD	BLKMVS		;get the block size
	INR	C		;bump to wct0
	OUTP	L		;send low byte length
	OUTP	H		;send high byte length
	INR	C		;bump to adr1
	OUTP	E		;send low byte of dest.
	OUTP	D		;send high byte of dest
	INR	C		;bump to wct1
	OUTP	L		;send low byte length
	OUTP	H		;word count = 128 - 1
	MVI	A,DREQL+ROTPRI+MTMENB	;set dreq low, m / m xfer
	OUT	CMND		;send it
	MVI	A,BLOCK+RDXFR+CHAN0
	OUT	MODE		;ch 0 = source (read from mem)
	MVI	A,BLOCK+WRTXFR+CHAN1
	OUT	MODE		;ch 1 = dest (write to mem)
	MVI	A,CLRREQ+CHAN0
	OUT	FMASK
	MVI	A,CLRREQ+CHAN1
	OUT	FMASK		;clear chan 0 and chan 1 for req.
	MVI	A,SETREQ+CHAN0	;this causes the move to happen
	OUT	REQREG
	MVI	C,POLL
	MVI	E,PLDVM		;poll dma chip
	CALL	XDOS
;
;place dma into cascade mode for ch 0
;
CASMOD:	MVI	A,DREQL+ROTPRI
	OUT	CMND		;send it
	MVI	A,CASCADE+CHAN0
	OUT	MODE		;send it
	MVI	A,CLRREQ+CHAN0
	OUT	FMASK		;request chan 0
	RET
	ENDIF
;
;console status routine
;
CONST:	CALL	PTBLJP		;deternime which console stat to chk.
	DW	PT0ST		;console 00
	DW	PT1ST		;console 01
;
;console input routine
;
CONIN:	CALL	PTBLJP		;console input routine
	DW	PT0IN		;console 00
	DW	PT1IN		;console 01
;
;console output routine
;
CONOUT:	CALL	PTBLJP		;console output routine
	DW	PT0OUT		;console 00
	DW	PT1OUT		;console 01
;
;list status routine
;
LISTST:	CALL	PTBLJP		;determine which list device
	DW	LSTS0		;list device 00
;
;list output routine
;
LIST:	CALL	PTBLJP		;output to list device
	DW	LSTOT0		;list device 00
;
;	poll console #0 input
;
PT0ST:
POLCI0:	IN	CSTAT0		;input status
	ANI	CIMSK0		;is it ready?
	MVI	A,0		;return 0 if not
	RZ
	CMA			;return ff = ready
	RET
;
;	poll console #1 input
PT1ST:
POLCI1:	IN	CSTAT1		;get status
	ANI	CIMSK1		;is it ready?
	MVI	A,0		;return 0 if not ready
	RZ
	CMA			;return ff if ready
	RET
;
;	console #0 input
;
PT0IN:	CALL	POLCI0		;check for console ready
	ORA	A
	JRNZ	PTIN0		;if ready, skip poll operation
	MVI	C,POLL		;else, place on the poll list
	MVI	E,PLCI0		;using this device number
	CALL	XDOS		;and wait till ready
PTIN0:	IN	CDATA0		;get the keyboard char
	ANI	7FH		;strip off parity
	RET
;
;	poll #1 input
;
PT1IN:	CALL	POLCI1		;check for console ready
	ORA	A
	JRNZ	PTIN1		;if ready, skip poll operation
	MVI	C,POLL		;else, place on the poll list
	MVI	E,PLCI1		;using this device number
	CALL	XDOS		;and wait till ready
PTIN1:	IN	CDATA1		;get the keyboard char
	ANI	7FH		;strip parity
	RET
;
;	poll console #0 output
;
POLCO0:	IN	CSTAT0		;get status
	ANI	COMSK0		;is it ready?
	MVI	A,0		;return 00 if not
	RZ
	CMA			;else, return ff if ready
	RET
;
;	poll console #1 output
;
POLCO1:	IN	CSTAT1		;get status
	ANI	COMSK1		;is it ready?
	MVI	A,0		;return 00 if not
	RZ
	CMA			;return ff if ready
	RET
;
;	console #0 output
;
PT0OUT:	CALL	POLCO0		;check for busy console
	ORA	A		;is it
	JRNZ	CORDY0		;jump if console can accept char
	PUSH	B		;else,
	PUSH	D		;save device and character on stack
	MVI	C,POLL		;place this console on poll list
	MVI	E,PLCO0		;using this device number
	CALL	XDOS		;and wait till ready
	POP	D		;restore
	POP	B		;device and char from stack
CORDY0:	MOV	A,C		;place char into accum
	OUT	CDATA0		;and send to console
	RET
;
;	console #1 output
;
PT1OUT:	CALL	POLCO1		;check for busy console
	ORA	A		;is it
	JRNZ	CORDY1		;jump if console can accept char
	PUSH	B		;else,
	PUSH	D		;save device and character on stack
	MVI	C,POLL		;place this console on poll list
	MVI	E,PLCO1		;using this device number
	CALL	XDOS		;and wait till ready
	POP	D		;restore
	POP	B		;device and char from stack
CORDY1:	MOV	A,C		;place char into accum
	OUT	CDATA1		;and send to console
	RET
;
LSTS0:	IN	LSTAT0		;get printer status
	ANI	LOMSK0		;is it ready?
	MVI	A,0		;return 00 if not
	RZ
	CMA			;return ff if yes
	RET
;
LSTOT0:	CALL	LSTS0		;check for device ready
	ORA	A		;is it?
	JRNZ	LORDY0		;jump if ready and out the char
	PUSH	B		;else,
	PUSH	D		;save device and char on stack
	MVI	C,POLL		;poll this device
	MVI	E,PLLST0	;using this device number
	CALL	XDOS		;and wait till ready
	POP	D		;restore
	POP	B		;device and char from stack
LORDY0:	MOV	A,C		;place char into accum
	OUT	LDATA0		;and send to printer
	RET
;
PTBLJP:	MOV	A,D		;get device number
	CPI	CONS		;check console number range
	JRC	TBLJMP		;jump if range is <=
	POP	PSW		;else, waste 1 subroutine and return
EMPTY:	XRA	A		;empty code
	RET
;
TBLJMP:	POP	H		;recover address
INDXJP:	ADD	A		;double accum for index
	MOV	E,A		;place into reg E
	MVI	D,0		;clear reg D
	DAD	D		;hl = hl + de
	MOV	E,M		;get low byte
	INX	H		;bump pointer
	MOV	D,M		;get high byte
	XCHG			;place into hl
	PCHL			;and jump to it.
;
;poll device routine
;
POLL$DEVICE:
	MOV	A,C		;get device number
	CPI	NMBDEV		;check for the number of devices
	JRC	DEVOK		;jump if <=
	MVI	A,NMBDEV	;else, get the number of devices
DEVOK:	CALL	TBLJMP		;get the device to poll
;
DEVSTR:	DW	PLDV0		;poll floppy ready
	DW	POLCO0		;poll output status #0
	DW	POLCI0		;poll input status #0
	DW	LSTS0		;poll list status
;
	IF	MTOM
	DW	POLDV1		;poll mem to mem xfer
	ENDIF
;
	DW	POLCO1		;poll output status #1
	DW	POLCI1		;poll input status #1
;
	DW	EMPTY		;return empty code
DEVEND	EQU	$
NMBDEV	SET	(DEVEND-DEVSTR)/2
;
;poll disk drive ready and check slim line drives for ready
;
PLDV0:	IN	DSTAT		;check for drive ready
	RLC			;check bit 7 (ready bit)
	MVI	A,0FFH		;return ff = ready
	RNC			;return if ready
	CALL	KICKDR		;else, try to start slim line
	MVI	B,50		;set for 50 * (16 * 1ms) time delay
DELAY:	MVI	A,16		;16ms time constant
DELY1:	MVI	C,249		;1ms time constant
DLY1:	DCR	C		;decrease count
	JRNZ	DLY1
	DCR	A		;decrease count factor
	JRNZ	DELY1		;reset 1 ms counter
	DCR	B
	JRZ	NOTRDY		;return drive not ready
	IN	DSTAT		;check for drive ready
	RLC
	MVI	A,0FFH		;return ready byte if ready
	RNC
	JMPR	DELAY
;
NOTRDY:	XRA	A		;return not ready 1st time through
	RET			;  and cause it to try again
;
;poll memory to memory xfer busy
;
	IF	MTOM
POLDV1:	IN	CMND		;check dma status
	ANI	00000011B	;check for mem to mem active
	MVI	A,0		;return 00 if not ready
	RNZ
	CMA			;return ff if ready
	RET
	ENDIF
;
START$CLOCK:
	MVI	A,0FFH
TICKST:	STA	TICKN
	RET
;
STOP$CLOCK:
	XRA	A
	JMPR	TICKST
;
EXIT$REGION:
	LDA	PREEMP		;get the preemp flag
	ORA	A		;has it been set?
	RNZ			;return if yes
	EI			;else, enable intrps again
	RET
;
MAX$CONS:
	MVI	A,CONS		;get the number of consoles
	RET
;
;	the following table is for mode 2 pointers
;
	ORG	BASE+(($-BASE+17) AND 0FFF0H)
;
TIMVEC:	DW	INT1HND		;intrp handler (timer)
	DW	DSKINT		;intrp handler (disk)
	DW	NULL$INT	;do nothing routine for vect 2
	DW	NULL$INT	;   "     "		vect 3
	DW	NULL$INT	;   "     "		vect 4
	DW	NULL$INT	;   "     "		vect 5
	DW	NULL$INT	;   "     "		vect 6
	DW	NULL$INT	;   "     "		vect 7
;
NUMVEC	EQU	($-TIMVEC)/2	;number of vector interrupts used
;
;disk interrupt handler routine
;
DSKINT:	SHLD	HLSAVE		;save hl addr
	LXI	H,FDINT		;point to floppy handler
	JMP	INTSYS		;jump to system handler
;
FDINT:	IN	DSTAT		;get disk status
	STA	FSTAT		;save it
	MVI	C,FLAGST	;set the completion flag
	MVI	E,FLPYFLG
	CALL	XDOS
	JMP	NT1SEC		;finish and return
;
;null intrp routine (does nothing)
;
NULL$INT:
	SHLD	HLSAVE		;save h,l
	LXI	H,NULL$RET
	JMP	INTSYS
;
NULL$RET:
	EI			;enable intrps
	RETI			;restore chain
;
;interrupt 1 handler entry point
;
INT1HND:SHLD	HLSAVE		;save hl
	LXI	H,TIMHDL	;point to timer handler
	JMP	INTSYS		;jump to internal handler
;
TIMHDL:	LDA	TICKN		;get the value of the tick
	ORA	A		;is it zero?
	JRZ	NOTICK		;jump if zero tick
	MVI	C,FLAGST	;else, set the flag
	MVI	E,1		;1 = 16 ms tick set
	CALL	XDOS
NOTICK:	LXI	H,TICK		;point to tick counter
	DCR	M		;decrease it
	JRNZ	NT1SEC		;jump if not 1 second yet
	MVI	M,060		;reset the tick cntr to 060 seconds
	MVI	C,FLAGST	;set mpm flag # 2
	MVI	E,2
	CALL	XDOS
;
;all other intrp handlers enter here
;
NT1SEC:	XRA	A		;get a zero
	STA	PREEMP		;clear preemp flag
	POP	B
	POP	D
	LSPD	OLDSTK		;recover old stack
	POP	PSW		;recover psw
	LHLD	RTSAVE		;get return address
	PUSH	H		;place on the stack
	LXI	H,PDISP		;get dispatch address
	PUSH	H		;save it on the stack
	LHLD	HLSAVE		;get saved hl
	RETI			;ret from intrp
;
INTSYS:	SHLD	INTADR		;save intrp service address
	POP	H
	SHLD	RTSAVE		;save return address
	PUSH	PSW		;save accum and flags
	MVI	A,0FFH
	STA	PREEMP		;set preemp flag
	SSPD	OLDSTK		;save mpm stack
	LXI	SP,NEWSTK	;set local intrp stack
	PUSH	D
	PUSH	B
	LHLD	INTADR		;recover the intrp service addr
	PCHL			;go to it
;
SEL$MEMORY:
SEL$BNK:
	LDAX	B		;get base address
	CALL	RIGHTS		;shift right 4 places
	MOV	E,A		;save base start address
	ADI	0E0H		;add in memory management port
	MOV	D,A		;save in reg d
	INX	B		;point to bank size
	LDAX	B		;get it
	CALL	RIGHTS		;shift right 4 places
	EXAF			;save in alternate reg
	INX	B		;point to attrib byte
	INX	B		;point to bank number byte
	LDAX	B		;get it
	ADD	A		;*2
	ADD	A		;*4
	ADD	A		;*8
	ADD	A		;*16
	MOV	C,A		;memory bank table start
	MVI	B,0
	LHLD	MEMPTR		;get bank descriptor address
	DAD	B		;hl --> bank byte start
	MOV	C,E		;reg c = position to start
	DAD	B		;hl --> start within byte table
	EXAF			;recover size byte
	MOV	B,A		;reg b = count
	MOV	C,D		;reg c = memory m/m port start
	JMP	MEMSEL
;
MSELL1:	INR	C		;bump m/m port address
MEMSEL:	OUTI			;send the byte to memory management
	RZ			;return if done
	JMP	MSELL1		;loop till done
;
;get drive select code from reg b
;and shift it right 4 places for
;use as an index into track table
;
TRKINDX:MOV	A,B
	ANI	30H		;strip side and density
RIGHTS:	RAR			;shift
	RAR			;right
	RAR			;four
	RAR			;times
	ANI	0FH		;strip junk bits
	RET
;
;local commonbase storage
;
TICK:	DB	060		;1 second counter
TICKN:	DB	0		;tick flag
	REPT	6
	DW	0C7C7H,0C7C7H,0C7C7H,0C7C7H,0C7C7H ;local stack
	ENDM
NEWSTK:	DS	0
PREEMP:	DS	1		;preemp flag
HLSAVE:	DS	2		;reg hl save
RTSAVE:	DS	2		;return address save
INTADR:	DS	2		;physical intrp service addr save
OLDSTK:	DS	2		;old mpm stack pointer
MEMPTR:	DS	2		;memory byte table pointer save
;
	IF	MTOM
BLKMVS:	DS	2		;dma m/m blk move size
	ENDIF
;
;the following area is claimed as the
;host buffer after system is running
;
HSTBUF	EQU	$		;host buffer
;
;hide system init in this area. we only
;use this stuff once
;
SYS$INT:DI
	EXX			;save primary regs
	IN	DSTAT		;clear disk intrq
;
;place system into cascade mode for s-100 dma operations
;
	MVI	A,DREQL+ROTPRI
	OUT	CMND		;send it
	MVI	A,CASCADE+CHAN0
	OUT	MODE		;send it
	MVI	A,CLRREQ+CHAN0
	OUT	FMASK		;request chan 0
;
;init interrupt controller
;
	XRA	A		;clear reg a
	OUT	INTCMD		;clear the intrp chip
;
	MVI	A,10000001B	;select MODE REG, set bit 7
	OUT	INTCMD
	MVI	A,10110000B	;preselect MASK register
	OUT	INTCMD
	MVI	A,11111100B	;allow timer and floppy only
	OUT	INTDOT
	MVI	A,11000000B	;select ACR register
	OUT	INTCMD
	MVI	A,00000011B	;auto-clear timer and floppy intrps
	OUT	INTDOT
	LXI	H,TIMVEC	;point to mode 2 vector table
	MOV	A,H		;get high byte
	STAI			;place into Z80 intrp register
	LXI	B,8 SHL 8 OR 0E0H ;8 registers to set, port to do it at
;
;fill 9519A with response memory bytes
;
I9519A:	MOV	A,C		;get response port
	OUT	INTCMD
	MOV	A,L		;get low byte of vector address
	OUT	INTDOT
	INR	L
	INR	L		;point to next address byte of vectors
	INR	C		;bump response port
	DJNZ	I9519A		;loop till all done
;
	MVI	A,01000000B	;clear IRR bits
	OUT	INTCMD
	MVI	A,01110000B	;clear ISR bits
	OUT	INTCMD
	MVI	A,10101001B	;clear mstr MASK
	OUT	INTCMD
	IM2			;run using intrp MODE 2
;
	EXX
	SHLD	BIOSAD
	SDED	DEBUGA
	MOV	A,C
	RAL
	RAL
	RAL
	MVI	H,0
	MOV	L,A
	SHLD	DEBUGR
;
;init bank memory routine
;
	LHLD	SYSDAT		;get start of system data page
	PUSH	H		;save the address
	LXI	D,7
	DAD	D
	MOV	E,D		;clear reg e
	MOV	D,M
	XCHG
	LXI	D,4BH		;memory byte descriptor start
	DAD	D		;get the address
	SHLD	MEMPTR		;save the pointer
	POP	H		;recover sysdat address
	LXI	D,15		;offset to memory segs
	DAD	D
	MOV	B,M		;get number of segs to do
	INX	H		;point to main bank
	SHLD	MAINBK		;save the pointer
	DCR	B		;skip 1 page
	INX	H
	INX	H
	INX	H
	INX	H		;skip bank 0
INIT3:	SHLD	CNTLSG		;save control seg pointer
	SBCD	INITCT		;save the segment counter
	LBCD	CNTLSG		;get memory pointer
	LDAX	B		;check for non-zero bank start
	ORA	A
	JNZ	INIT4		;skip if non-zero bank
	CALL	SEL$BNK		;else, select the bank
	CALL	SETUP		;set low page values
INIT4:	LHLD	CNTLSG		;get control seg pointer
	INX	H
	INX	H
	INX	H
	INX	H		;point to next memory descriptor
	LBCD	INITCT		;get counter value
	DJNZ	INIT3		;init the reset of banks
 	LBCD	MAINBK		;get main bank pointer
	JMP	SEL$BNK		;init and return
;
;setup low memory with constants
;
SETUP:	MVI	A,0C3H		;get jump inst
	STA	0
	LHLD	DEBUGR
	MOV	M,A
	INX	H
	LDED	DEBUGA
	MOV	M,E
	INX	H
	MOV	M,D
	LHLD	BIOSAD
	SHLD	1
	RET
;
;init timer routine
;
INIT$TIME:
	XRA	A		;get a zero
	MOV	L,A
	MOV	H,A		;clear hl
	STA	SYS$IDLE	;dont return
	SHLD	SYS$IDLE+1	; here again
	MVI	A,CNTR2+RLWORD+MODE2+BINARY
	OUT	TCMND		;set the mode for ch 2
	LXI	D,33333		;set the time = 16 ms
	MVI	C,TCH2		;get ch 2 port addr
	OUTP	E		;send low byte
	OUTP	D		;send high byte
	RET
;
BIOSAD:	DS	2		;xios save address
DEBUGA:	DS	2
DEBUGR:	DS	2
MAINBK:	DS	2
INITCT:	DS	2
CNTLSG:	DS	2
;
	DS	HSTSIZ-($-HSTBUF)
DIRBUF:	DS	128		;scratch directory area
BUFFER:	DS	128		;transfer buffer
;
	DB	0
		DB	RPTCMD+18,' '
                
