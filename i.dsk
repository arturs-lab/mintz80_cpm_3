+QPNDIRRECA
;RPNDTARECA
KSPODIRDRVA
[TPODTADRVA
kUPOVLYDIRA
{VPOVLYDTAA
‹WPCRDATAF ›оPDBLALV  њпPяяяяА␀O␀яяяяяяяяяяяяяяяяя␀␀␀␀␀␀Ђ␀␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀А	␀␀␀А
␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀А␀␀␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀␀␀␀␀␀яя␀я␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀L
                	;	Bank Select.  Select CPU bank for further execution.
                
                bnksel:
 0192 32D200    	sta @cbnk 			; remember current bank
 0195 C30000    	jmp ?bank			; and go exit through users
                					; physical bank select routine
                
                
 0198 FFFFFFFFFFxofflist	db	-1,-1,-1,-1,-1,-1,-1,-1		; ctl-s clears to zero
 01A0 FFFFFFFFFF		db	-1,-1,-1,-1,-1,-1,-1,-1
                
                
CP/M RMAC ASSEM 1.1	#010	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

                
                	dseg	; following resides in banked memory
                
                
                
                ;	Disk I/O interface routines
                
                
                	; SELDSK
                	;	Select Disk Drive.  Drive code in <C>.
                	;		Invoke login procedure for drive
                	;		if this is first select.  Return
                	;		address of disk parameter header
                	;		in <HL>
                
                seldsk:
 01A8 79325602  	mov a,c ! sta @adrv			; save drive select code
 01AC 69260029  	mov l,c ! mvi h,0 ! dad h		; create index from drive code
 01B0 01000009  	lxi b,@dtbl ! dad b			; get pointer to dispatch table
 01B4 7E23666F  	mov a,m ! inx h ! mov h,m ! mov l,a	; point at disk descriptor
 01B8 B4C8      	ora h ! rz 				; if no entry in table, no disk
 01BA 7BE601C2D6	mov a,e ! ani 1 ! jnz not$first$select	; examine login bit
 01C0 E5EB      	push h ! xchg				; put pointer in stack & <DE>
 01C2 21FEFF197E	lxi h,-2 ! dad d ! mov a,m ! sta @RDRV	; get relative drive
 01CA 21FAFF19  	lxi h,-6 ! dad d			; find LOGIN addr
 01CE 7E23666F  	mov a,m ! inx h ! mov h,m ! mov l,a	; get address of LOGIN routine
 01D2 CD2301    	call ipchl				; call LOGIN
 01D5 E1        	pop h					; recover DPH pointer
                not$first$select:
 01D6 C9        	ret
                
                
                	; HOME
                	;	Home selected drive.  Treated as SETTRK(0).
                
                home:
 01D7 010000    	lxi b,0		; same as set track zero
                
                
                	; SETTRK
                	;	Set Track. Saves track address from <BC>
                	;		in @TRK for further operations.
                
                settrk:
 01DA 6960      	mov l,c ! mov h,b
 01DC 225802    	shld @trk
 01DF C9        	ret
                
                
                	; SETSEC
                	;	Set Sector.  Saves sector number from <BC>
                	;		in @sect for further operations.
                
                setsec:
 01E0 6960      	mov l,c ! mov h,b
 01E2 225A02    	shld @sect
CP/M RMAC ASSEM 1.1	#011	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

 01E5 C9        	ret
                
                
                	; SETDMA
                	;	Set Disk Memory Address.  Saves DMA address
                	;		from <BC> in @DMA and sets @DBNK to @CBNK
                	;		so that further disk operations take place
                	;		in current bank.
                
                setdma:
 01E6 6960      	mov l,c ! mov h,b
 01E8 225C02    	shld @dma
                
 01EB 3AD200    	lda @cbnk	; default DMA bank is current bank
                			; fall through to set DMA bank
                
                	; SETBNK
                	;	Set Disk Memory Bank.  Saves bank number
                	;		in @DBNK for future disk data
                	;		transfers.
                
                setbnk:
 01EE 325F02    	sta @dbnk
 01F1 C9        	ret
                
                
                	; SECTRN
                	;	Sector Translate.  Indexes skew table in <DE>
                	;		with sector in <BC>.  Returns physical sector
                	;		in <HL>.  If no skew table (<DE>=0) then
                	;		returns physical=logical.
                
                sectrn:
 01F2 6960      	mov l,c ! mov h,b
 01F4 7AB3C8    	mov a,d ! ora e ! rz
 01F7 EB096E2600	xchg ! dad b ! mov l,m ! mvi h,0
 01FC C9        	ret
                
                
                	; READ
                	;	Read physical record from currently selected drive.
                	;		Finds address of proper read routine from
                	;		extended disk parameter header (XDPH).
                
                read:
 01FD 2A56022600	lhld @adrv ! mvi h,0 ! dad h	; get drive code and double it
 0203 11000019  	lxi d,@dtbl ! dad d		; make address of table entry
 0207 7E23666F  	mov a,m ! inx h ! mov h,m ! mov l,a	; fetch table entry
 020B E5        	push h				; save address of table
 020C 11F8FF19  	lxi d,-8 ! dad d		; point to read routine address
 0210 C32602    	jmp rw$common			; use common code
                
                
                	; WRITE
                	;	Write physical sector from currently selected drive.
                	;		Finds address of proper write routine from
CP/M RMAC ASSEM 1.1	#012	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

                	;		extended disk parameter header (XDPH).
                
                write:
 0213 2A56022600	lhld @adrv ! mvi h,0 ! dad h	; get drive code and double it
 0219 11000019  	lxi d,@dtbl ! dad d		; make address of table entry
 021D 7E23666F  	mov a,m ! inx h ! mov h,m ! mov l,a	; fetch table entry
 0221 E5        	push h				; save address of table
 0222 11F6FF19  	lxi d,-10 ! dad d		; point to write routine address
                
                rw$common:
 0226 7E23666F  	mov a,m ! inx h ! mov h,m ! mov l,a	; get address of routine
 022A D1        	pop d				; recover address of table
 022B 1B1B      	dcx d ! dcx d			; point to relative drive
 022D 1A325702  	ldax d ! sta @rdrv		; get relative drive code and post it
 0231 1313      	inx d ! inx d			; point to DPH again
 0233 E9        	pchl				; leap to driver
                
                
                	; MULTIO
                	;	Set multiple sector count. Saves passed count in
                	;		@CNT
                
                multio:
 0234 325E02C9  	sta @cnt ! ret
                
                
                	; FLUSH
                	;	BIOS deblocking buffer flush.  Not implemented.
                
                flush:
 0238 AFC9      	xra a ! ret		; return with no error
                
                
                
                	; error message components
 023A 0D0A074249drive$msg	db	cr,lf,bell,'BIOS Error on ',0
 024C 3A20542D00track$msg	db	': T-',0
 0251 2C20532D00sector$msg	db	', S-',0
                
                
                    ; disk communication data items
                
 0256           @adrv	ds	1		; currently selected disk drive
 0257           @rdrv	ds	1		; controller relative disk drive
 0258           @trk	ds	2		; current track number
 025A           @sect	ds	2		; current sector number
 025C           @dma	ds	2		; current DMA address
 025E 00        @cnt	db	0		; record count for multisector transfer
 025F 00        @dbnk	db	0		; bank for DMA operations
                
                
                	cseg	; common memory
                
 00D2 00        @cbnk	db	0		; bank for processor operations
                
                
CP/M RMAC ASSEM 1.1	#013	ROOT MODULE OF RELOCATABLE BIOS FOR CP/M 3.0

 00D3           	end
